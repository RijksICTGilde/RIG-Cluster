/.idea/
__pycache__/
*.pyc
.venv/
/CLAUDE.md
/.claude/settings.local.json
# Security - ignore private keys, allow encrypted certs and readme
/security/*
!/security/readme.md
!/security/tls/
/security/tls/**/*.pem
/keys/
/operations-manager/python/scripts/.env.*
/operations-manager/python/log*
/operations-manager/python/.env.local
# Generated at build/dev time by `task version:generate` (see opi/core/version.py)
/operations-manager/python/opi/version.json
/operations-manager/python/.env.secrets
/operations-manager/python/.env.*.secrets
/.env-taskfile-current
/.sandbox-mode
/.sandbox-sso

# Local symlink to jinja-roos-components (for Docker builds)
/jinja-roos-components/
/operations-manager/python/jinja-roos-components

# Generated secret overview files (contains plain text passwords)
secrets-overview-*.txt
secrets-overview-*.yaml

# Pre-encryption SOPS files: hold secrets in plain text until encrypted to
# *.sops.yaml. Final backstop so a failed/aborted SOPS run can never leak
# plaintext secrets into a GitOps repo.
*.to-sops.yaml
/bootstrap/rig-system/kustomize/operations-manager/overlays/sandboxed-local/operations-manager-env-secrets.yaml
/output.yaml
/operations-manager/python/.env.my-machine
/keycloak-migration/custom-mapper/target/
/infrastructure/bootstrap/infrastructure/secrets/config/overlays/sandboxed-local/
/operations-manager/docs/interview.sh
/operations-manager/docs/business-case-interview-prompt.md
/operations-manager/docs/business-case-answers/
/keycloak-migration/sso-migration/steps.md
/keycloak-migration/sso-migration/backups/
/keycloak-migration/sso-migration/verify_sso_migration.py
/bootstrap/rig-system/kustomize/overlays/sandboxed-local/argocd-repo-secret-infrastructure-secret.yaml.sops.yaml
/bootstrap/rig-system/kustomize/overlays/sandboxed-local/argocd-repo-users-applications-secret.yaml.sops.yaml
/bootstrap/rig-system/kustomize/overlays/sandboxed-local/decrypt-sops.yaml
/bootstrap/rig-system/kustomize/overlays/sandboxed-local/argocd-admin-secret.yaml.sops.yaml
/.claude/worktrees/

# E2E test screenshots (generated artifacts)
/operations-manager/python/tests/e2e/screenshots/
/operations-manager/docs/
