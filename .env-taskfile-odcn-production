# Taskfile environment variables for ODCN-PRODUCTION cluster
# This file contains cluster-specific configuration for production environment

CLUSTER_TYPE=odcn-production
KIND_CLUSTER_NAME=
RIG_NAMESPACE=rig-prd-operations
INFRASTRUCTURE_CLUSTER_FOLDER=odcn
BOOTSTRAP_CLUSTER_FOLDER=odcn-production

# AGE-sleutel voor SOPS. Expliciet per cluster: een ontbrekende waarde moet stoppen,
# niet stilzwijgend terugvallen op de productiesleutel van een ander cluster.
AGE_KEY_FILE=security/key.txt

# ArgoCD praat hier via de Capsule-proxy en is tenant-scoped: hij mag geen namespaces,
# CRD-s of cluster-brede RBAC aanmaken. Operators worden buiten GitOps geinstalleerd.
ARGOCD_CLUSTER_SCOPED=false
