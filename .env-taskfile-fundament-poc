# Taskfile environment variables for the FUNDAMENT-POC cluster
# Fundament-platform (Gardener shoot op metal-stack), organisatie zad, cluster zad-cluster.
# kubectl-context: zad-fundament. Auth loopt via de exec-plugin `functl cluster token <uuid>`,
# dus functl moet op de PATH staan en `functl auth login` moet gedaan zijn.

CLUSTER_TYPE=fundament-poc
KIND_CLUSTER_NAME=
RIG_NAMESPACE=rig-system

# De installatietaken gebruiken deze context expliciet en controleren hem vooraf. Zonder dat
# landt een installatie op wat er toevallig in `kubectl config current-context` staat.
KUBE_CONTEXT=zad-fundament

# Beide bomen gebruiken dezelfde mapnaam. ODCN doet dat bewust niet
# (INFRASTRUCTURE_CLUSTER_FOLDER=odcn naast BOOTSTRAP_CLUSTER_FOLDER=odcn-production);
# hier gelijk houden scheelt een kustomize-build die naar een niet-bestaande map wijst.
INFRASTRUCTURE_CLUSTER_FOLDER=fundament-poc
BOOTSTRAP_CLUSTER_FOLDER=fundament-poc

# AGE-sleutel voor SOPS. Expliciet per cluster: een ontbrekende waarde moet stoppen,
# niet stilzwijgend terugvallen op de productiesleutel van een ander cluster.
# Genereren met: task generate-age-key (schrijft dit bestand als het nog niet bestaat).
AGE_KEY_FILE=security/fundament-poc-key.txt
