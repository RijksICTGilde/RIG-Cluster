# Taskfile environment variables for LOCAL cluster
# This file contains cluster-specific configuration for local development

CLUSTER_TYPE=local
KIND_CLUSTER_NAME=gitops-fluxcd
RIG_NAMESPACE=rig-system
INFRASTRUCTURE_CLUSTER_FOLDER=local
BOOTSTRAP_CLUSTER_FOLDER=local

# Controlepunten van cluster:check. KUBE_CONTEXT pint taken aan de juiste kubectl-context,
# CONTEXT_SERVER_MATCH is de waarborg dat die context echt naar dit cluster wijst, en
# AUTH_CHECK_COMMAND (optioneel) is het inlogcommando van het platform.
KUBE_CONTEXT=kind-gitops-fluxcd
CONTEXT_SERVER_MATCH=127.0.0.1
AUTH_CHECK_COMMAND=

# AGE-sleutel voor SOPS. Expliciet per cluster: een ontbrekende waarde moet stoppen,
# niet stilzwijgend terugvallen op de productiesleutel van een ander cluster.
AGE_KEY_FILE=security/key.txt
