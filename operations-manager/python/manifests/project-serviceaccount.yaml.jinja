apiVersion: v1
kind: ServiceAccount
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: "{{ name }}"
    app.kubernetes.io/component: project
    created-by: operations-manager
# Bewust geen imagePullSecrets: de default serviceaccount draagt elk gerepliceerd
# pull-secret in de namespace, ook dat van een ander project. Elke podspec draagt zelf wat
# hij nodig heeft, geleverd door resolve_image().
#
# En bewust ook geen automountServiceAccountToken: false; de default serviceaccount koppelt
# de token wel aan, en dat hier uitzetten zou elke pod die de API aanspreekt raken.
