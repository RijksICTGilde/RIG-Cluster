apiVersion: v1
kind: ServiceAccount
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: "{{ name }}"
    app.kubernetes.io/component: project
    created-by: operations-manager
# Bewust GEEN imagePullSecrets. De default serviceaccount draagt elk pull-secret dat het
# platform in de namespace repliceert -- ook dat van de proxy-organisatie van een ander
# project -- en dan is een private registry alleen op papier prive. Elke gegenereerde
# podspec draagt de secrets die hij zelf nodig heeft, geleverd door resolve_image().
automountServiceAccountToken: false
