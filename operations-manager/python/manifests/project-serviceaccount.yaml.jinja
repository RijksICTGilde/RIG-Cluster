{# Geen imagePullSecrets en geen automountServiceAccountToken: false. Waarom staat in
   features/image-registries.md, bij "De eigen serviceaccount per project". #}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: "{{ name }}"
    app.kubernetes.io/component: project
    created-by: operations-manager
