apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ clone_pvc_name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    app.kubernetes.io/managed-by: opi-backup
    backup.rig.nl/source-pvc: {{ source_pvc_name | yaml_scalar }}
    backup.rig.nl/timestamp: {{ timestamp | yaml_scalar }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ storage_class_name | yaml_scalar }}
  resources:
    requests:
      storage: {{ size | yaml_scalar }}
  dataSource:
    kind: VolumeSnapshot
    apiGroup: snapshot.storage.k8s.io
    name: {{ snapshot_name | yaml_scalar }}
