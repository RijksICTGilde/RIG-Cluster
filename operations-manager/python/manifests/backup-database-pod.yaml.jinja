apiVersion: v1
kind: Pod
metadata:
  name: "{{ pod_name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: database-backup
    app.kubernetes.io/component: backup-job
    app.kubernetes.io/managed-by: opi-backup
    backup.rig.nl/database: "{{ reference_name }}"
    backup.rig.nl/timestamp: "{{ timestamp }}"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: {{ timeout_seconds | default(3600) }}
  containers:
    - name: backup
      image: ghcr.io/minbzk/base-images/rig-backup:latest
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          echo "Starting database backup for: {{ reference_name }}"
          echo "Database Host: ${DB_HOST}"
          echo "Database Port: ${DB_PORT}"
          echo "Database Name: ${DB_NAME}"
          echo "Database User: ${DB_USER}"
          echo "Source Type: {{ source_type }}"
          echo "Namespace: {{ namespace }}"
          echo "S3 Endpoint: ${S3_ENDPOINT}"
          echo "S3 Bucket: ${S3_BUCKET}"
          echo "Backup Prefix: ${BACKUP_PREFIX}"
          echo "S3 Disable TLS: ${S3_DISABLE_TLS}"

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # Try to connect to existing repository, create if not exists
          echo "Connecting to Kopia repository..."
          if ! kopia repository connect s3 \
            --bucket="${S3_BUCKET}" \
            --prefix="${BACKUP_PREFIX}/" \
            --endpoint="${S3_ENDPOINT}" \
            --access-key="${S3_ACCESS_KEY}" \
            --secret-access-key="${S3_SECRET_KEY}" \
            --password="${KOPIA_PASSWORD}" \
            ${TLS_FLAG} 2>/dev/null; then

            echo "Repository does not exist, creating new repository..."
            kopia repository create s3 \
              --bucket="${S3_BUCKET}" \
              --prefix="${BACKUP_PREFIX}/" \
              --endpoint="${S3_ENDPOINT}" \
              --access-key="${S3_ACCESS_KEY}" \
              --secret-access-key="${S3_SECRET_KEY}" \
              --password="${KOPIA_PASSWORD}" \
              ${TLS_FLAG}
          fi

          echo "Repository connected successfully"

          # Test database connectivity
          echo "Testing database connectivity..."
          PGPASSWORD="${DB_PASSWORD}" psql \
            -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER}" -d "${DB_NAME}" \
            -c "SELECT 1" > /dev/null

          echo "Database connection successful"

          # Stream pg_dump through Kopia using stdin
          echo "Starting database dump and backup..."
          PGPASSWORD="${DB_PASSWORD}" pg_dump \
            -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER}" -d "${DB_NAME}" \
            --format=custom \
            --verbose \
            | kopia snapshot create --stdin-file="database-{{ reference_name }}.dump" - \
              --description="PostgreSQL backup: {{ reference_name }}" \
              --tags="resource_type:database" \
              --tags="cluster:{{ cluster }}" \
              --tags="namespace:{{ namespace }}" \
              --tags="project:{{ project_name | default('unknown') }}" \
              --tags="deployment:{{ deployment_name | default('unknown') }}" \
              --tags="component:{{ component_name | default('unknown') }}" \
              --tags="database:{{ reference_name }}" \
              --tags="source_host:{{ db_host }}" \
              --tags="source_type:{{ source_type }}" \
              --tags="generation:{{ generation | default('0') }}" \
              --tags="timestamp:{{ timestamp }}" \
              --tags="backup_run:{{ backup_run_id }}"

          echo "Snapshot created successfully"

          # Set retention policy
          echo "Setting retention policy..."
          kopia policy set --global \
            --keep-latest={{ retention_keep_latest | default(7) }} \
            --keep-daily={{ retention_keep_daily | default(7) }} \
            --keep-weekly={{ retention_keep_weekly | default(4) }} \
            --keep-monthly={{ retention_keep_monthly | default(0) }} \
            --keep-annual={{ retention_keep_annual | default(0) }}

          echo "Retention policy set"

          # Apply retention policy - delete old snapshots
          echo "Applying retention policy (expiring old snapshots)..."
          kopia snapshot expire --delete

          # Show snapshot list after cleanup
          echo "Current snapshots after retention:"
          kopia snapshot list

          echo "Database backup completed successfully for {{ reference_name }}"
      env:
        - name: DB_HOST
          value: "{{ db_host }}"
        - name: DB_PORT
          value: "{{ db_port | default(5432) }}"
        - name: DB_NAME
          value: "{{ db_name }}"
        - name: DB_USER
          value: "{{ db_user }}"
        - name: DB_PASSWORD
          value: "{{ db_password }}"
        - name: S3_ENDPOINT
          value: "{{ s3_endpoint }}"
        - name: S3_BUCKET
          value: "{{ s3_bucket }}"
        - name: S3_ACCESS_KEY
          value: "{{ s3_access_key }}"
        - name: S3_SECRET_KEY
          value: "{{ s3_secret_key }}"
        - name: S3_DISABLE_TLS
          value: "{{ s3_disable_tls | lower }}"
        - name: BACKUP_PREFIX
          value: "{{ backup_prefix }}"
        - name: KOPIA_PASSWORD
          value: "{{ kopia_password }}"
        # Use /tmp for Kopia cache (container filesystem is read-only)
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      resources:
        requests:
          memory: "256Mi"
          cpu: "100m"
        limits:
          memory: "2Gi"
          cpu: "1000m"
