apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "0"
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    project: {{ labels.project | yaml_scalar }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  description: {{ ("Project for " ~ labels.project) | yaml_scalar }}
  # Alleen de repo's van dit project, in dezelfde vorm als de Application ernaast ze
  # noemt: de uitvoer van make_argocd_repository_url_unique, userinfo incluis.
  sourceRepos:
{% for source_repo in source_repos %}
    - {{ source_repo | yaml_scalar }}
{% else %}
    []
{% endfor %}
  destinations:
    - namespace: {{ destination.namespace | yaml_scalar }}
      server: "https://kubernetes.default.svc"
  # Cluster-scoped dicht; namespaced open want destinations.namespace pint al de scope.
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
{% if signature_key_id %}
  # ArgoCD synct alleen een revisie waarvan de commit door deze sleutel is ondertekend: de
  # sleutel waarmee OPI commit. Zie features/ondertekende-gitops-commits.md.
  signatureKeys:
    - keyID: {{ signature_key_id | yaml_scalar }}
{% endif %}
