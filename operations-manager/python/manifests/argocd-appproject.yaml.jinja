apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "0"
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    project: "{{ labels.project }}"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  description: Project for {{ labels.project }}
  sourceRepos:
    - '*'
  destinations:
    - namespace: {{ destination.namespace }}
      server: "https://kubernetes.default.svc"
  # Cluster-scoped blocked (ODC Argo has no permissions; ZAD creates
  # namespaces out-of-band). Namespaced wide open so helm-chart deployments
  # are not blocked; destinations.namespace pinning above is the boundary.
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
