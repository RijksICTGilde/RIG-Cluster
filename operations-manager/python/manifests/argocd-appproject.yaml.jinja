apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "0"
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    project: "{{ labels.project }}"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  description: Project for {{ labels.project }}
  sourceRepos:
    - '*'
  destinations:
    - namespace: {{ destination.namespace }}
      server: "https://kubernetes.default.svc"
  # Defense in depth: restrict what synced Applications may create to the
  # explicit set of resource kinds OPI actually generates (see manifests/*.jinja).
  # This closes the amplifier where a template-injected podSpec could otherwise
  # be applied as any cluster/namespace resource. Cluster-scoped: only Namespace.
  clusterResourceWhitelist:
    - group: ''
      kind: Namespace
  namespaceResourceWhitelist:
    - group: ''
      kind: ConfigMap
    - group: ''
      kind: Secret
    - group: ''
      kind: Service
    - group: ''
      kind: PersistentVolumeClaim
    - group: apps
      kind: Deployment
    - group: networking.k8s.io
      kind: Ingress
    - group: networking.k8s.io
      kind: NetworkPolicy
    - group: cert-manager.io
      kind: Issuer
    - group: postgresql.cnpg.io
      kind: Cluster
    - group: snapshot.storage.k8s.io
      kind: VolumeSnapshot
