apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
spec:
{% if pod_selector %}
  podSelector:
    matchLabels:
{{ pod_selector | indent(6, first=True) }}
{% else %}
  podSelector: {}
{% endif %}
  ingress:
    # from_selector is verplicht: een policy zonder from-blok laat elke bron in het
    # cluster toe, en dat is nooit de bedoeling van een aanroeper die hem vergeet.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: "{{ from_selector.namespace }}"
{% if from_selector.pod_labels %}
          podSelector:
            matchLabels:
{% for label_key, label_value in from_selector.pod_labels.items() %}
              {{ label_key }}: "{{ label_value }}"
{% endfor %}
{% endif %}
      ports:
{% for port in ports %}
        - port: {{ port }}
          protocol: TCP
{% endfor %}
  policyTypes:
    - Ingress
