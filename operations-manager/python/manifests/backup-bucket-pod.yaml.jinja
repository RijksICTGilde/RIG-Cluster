apiVersion: v1
kind: Pod
metadata:
  name: "{{ pod_name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: bucket-backup
    app.kubernetes.io/component: backup-job
    app.kubernetes.io/managed-by: opi-backup
    # Match the deployment's tenant NetworkPolicy so this pod is allowed egress to
    # the source and backup MinIO (the baseline selects deployment=<name>).
    deployment: "{{ deployment_name | default('unknown') }}"
    backup.rig.nl/bucket: "{{ reference_name }}"
    backup.rig.nl/timestamp: "{{ timestamp }}"
    backup.rig.nl/trigger: "{{ trigger | default('scheduled') }}"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: {{ timeout_seconds | default(3600) }}
  containers:
    - name: backup
      image: ghcr.io/minbzk/base-images/rig-backup:latest
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          echo "Starting bucket backup for: {{ reference_name }}"
          echo "Source MinIO Endpoint: ${SOURCE_MINIO_ENDPOINT}"
          echo "Source Bucket: ${SOURCE_BUCKET_NAME}"
          echo "Source Type: {{ source_type }}"
          echo "Namespace: {{ namespace }}"
          echo "S3 Endpoint: ${S3_ENDPOINT}"
          echo "S3 Bucket: ${S3_BUCKET}"
          echo "Backup Prefix: ${BACKUP_PREFIX}"
          echo "S3 Disable TLS: ${S3_DISABLE_TLS}"

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # Configure mc alias for source MinIO
          echo "Configuring MinIO client for source..."
          mc alias set source "${SOURCE_MINIO_ENDPOINT}" "${SOURCE_ACCESS_KEY}" "${SOURCE_SECRET_KEY}" --api S3v4

          # Verify source bucket exists
          echo "Verifying source bucket exists..."
          if ! mc ls source/"${SOURCE_BUCKET_NAME}" > /dev/null 2>&1; then
            echo "ERROR: Source bucket '${SOURCE_BUCKET_NAME}' does not exist or is not accessible"
            exit 1
          fi

          # Pin a stable Kopia source identity per (project, deployment, bucket)
          # via the connect-time override flags. Manual backups connect with a
          # `-manual` suffix so scheduled retention never touches them.
          KOPIA_IDENTITY_ARGS="--override-hostname={{ kopia_hostname }} --override-username=opi-backup"
          KOPIA_S3_ARGS="--bucket=${S3_BUCKET} --prefix=${BACKUP_PREFIX}/ --endpoint=${S3_ENDPOINT} --access-key=${S3_ACCESS_KEY} --secret-access-key=${S3_SECRET_KEY} --password=${KOPIA_PASSWORD} ${TLS_FLAG}"

          echo "Connecting to Kopia repository as {{ kopia_source }}..."
          if kopia repository connect s3 ${KOPIA_S3_ARGS} ${KOPIA_IDENTITY_ARGS} 2>/dev/null; then
            echo "Connected to existing repository"
          elif kopia repository create s3 ${KOPIA_S3_ARGS} ${KOPIA_IDENTITY_ARGS} 2>/dev/null; then
            echo "Created new repository"
          else
            echo "WARNING: Normal create failed (stale data?), clearing prefix and reinitializing..."
            if [ "${S3_DISABLE_TLS}" = "true" ]; then
              MC_ENDPOINT="http://${S3_ENDPOINT}"
            else
              MC_ENDPOINT="https://${S3_ENDPOINT}"
            fi
            export MC_CONFIG_DIR=/tmp/mc
            mc alias set backup-s3 "${MC_ENDPOINT}" "${S3_ACCESS_KEY}" "${S3_SECRET_KEY}" --api S3v4
            mc rm --recursive --force backup-s3/${S3_BUCKET}/${BACKUP_PREFIX}/ 2>/dev/null || true
            kopia repository create s3 ${KOPIA_S3_ARGS} ${KOPIA_IDENTITY_ARGS}
            echo "Created new repository (after clearing stale data)"
          fi

          echo "Repository connected successfully"

          # Download bucket contents to temp directory
          echo "Downloading bucket contents to temp directory..."
          mkdir -p /tmp/bucket-backup

          mc mirror --preserve source/"${SOURCE_BUCKET_NAME}" /tmp/bucket-backup/

          # Get bucket stats
          OBJECT_COUNT=$(find /tmp/bucket-backup -type f | wc -l)
          TOTAL_SIZE=$(du -sh /tmp/bucket-backup 2>/dev/null | cut -f1 || echo "unknown")
          echo "Downloaded ${OBJECT_COUNT} objects, total size: ${TOTAL_SIZE}"

          echo "Creating Kopia snapshot..."
          kopia snapshot create /tmp/bucket-backup \
            --description="Bucket backup: {{ reference_name }}" \
            --tags="resource_type:bucket" \
            --tags="cluster:{{ cluster }}" \
            --tags="namespace:{{ namespace }}" \
            --tags="project:{{ project_name | default('unknown') }}" \
            --tags="deployment:{{ deployment_name | default('unknown') }}" \
            --tags="component:{{ component_name | default('unknown') }}" \
            --tags="bucket:{{ reference_name }}" \
            --tags="source_bucket:{{ source_bucket_name }}" \
            --tags="source_endpoint:{{ source_minio_endpoint }}" \
            --tags="source_type:{{ source_type }}" \
            --tags="generation:{{ generation | default('0') }}" \
            --tags="timestamp:{{ timestamp }}" \
            --tags="backup_run:{{ backup_run_id }}" \
            --tags="trigger:{{ trigger | default('scheduled') }}"

          echo "Snapshot created successfully"

{% if trigger | default('scheduled') != 'manual' %}
          # Scheduled backups apply retention scoped to this source only.
          # Manual snapshots (separate source identity) are never affected.
          echo "Setting retention policy for {{ kopia_source }}..."
          kopia policy set "{{ kopia_source }}" \
            --keep-latest={{ retention_keep_latest | default(30) }} \
            --keep-daily={{ retention_keep_daily | default(30) }} \
            --keep-weekly={{ retention_keep_weekly | default(4) }} \
            --keep-monthly={{ retention_keep_monthly | default(12) }} \
            --keep-annual={{ retention_keep_annual | default(0) }}

          echo "Retention policy set"

          echo "Applying retention policy (expiring old snapshots for this source)..."
          kopia snapshot expire "{{ kopia_source }}" --delete
{% else %}
          echo "Manual backup: skipping retention (protected from automatic deletion)"
{% endif %}

          # Cleanup temp directory
          echo "Cleaning up temp directory..."
          rm -rf /tmp/bucket-backup

          echo "Current snapshots after retention:"
          kopia snapshot list

          echo "Bucket backup completed successfully for {{ reference_name }}"
      env:
        - name: MC_CONFIG_DIR
          value: "/tmp/mc"
        - name: SOURCE_MINIO_ENDPOINT
          value: "{{ source_minio_endpoint }}"
        - name: SOURCE_BUCKET_NAME
          value: "{{ source_bucket_name }}"
        - name: SOURCE_ACCESS_KEY
          value: "{{ source_access_key }}"
        - name: SOURCE_SECRET_KEY
          value: "{{ source_secret_key }}"
        - name: S3_ENDPOINT
          value: "{{ s3_endpoint }}"
        - name: S3_BUCKET
          value: "{{ s3_bucket }}"
        - name: S3_ACCESS_KEY
          value: "{{ s3_access_key }}"
        - name: S3_SECRET_KEY
          value: "{{ s3_secret_key }}"
        - name: S3_DISABLE_TLS
          value: "{{ s3_disable_tls | lower }}"
        - name: BACKUP_PREFIX
          value: "{{ backup_prefix }}"
        - name: KOPIA_PASSWORD
          value: "{{ kopia_password }}"
        # Use /tmp for Kopia paths (HOME is not writable on OpenShift)
        - name: KOPIA_CONFIG_PATH
          value: "/tmp/kopia-repository.config"
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      volumeMounts:
        # /tmp holds the plaintext bucket mirror plus the Kopia cache, config and
        # logs. Without a volume that all lands on the node's own disk, unbounded:
        # a bucket larger than the node's free space fills it and kubelet starts
        # evicting pods, including neighbours. An emptyDir with a sizeLimit turns
        # that into a failed backup for this bucket only.
        - name: staging
          mountPath: /tmp
      resources:
        requests:
          memory: "512Mi"
          cpu: "100m"
          ephemeral-storage: "1Gi"
        limits:
          memory: "4Gi"
          cpu: "2000m"
          ephemeral-storage: "{{ staging_size_limit | default('5Gi') }}"
  volumes:
    - name: staging
      emptyDir:
        sizeLimit: {{ staging_size_limit | default('5Gi') }}
