apiVersion: v1
kind: Service
metadata:
  name: {{ (name | default('', true)) | tojson }}
  namespace: {{ (namespace | default('', true)) | tojson }}
  labels:
    app: {{ (name | default('', true)) | tojson }}
    project: {{ (project.name | default('', true)) | tojson }}
{% for k, v in (extra_labels or {}).items() %}
    {{ k }}: {{ v | tojson }}
{% endfor %}
spec:
  selector:
    app: {{ (name | default('', true)) | tojson }}
    component: application
  ports:
    - port: {{ service_port | default(80) }}
      targetPort: {{ service_port | default(application_port) }}
      protocol: TCP
      name: http
{% for p in inbound_ports | default([]) if p != application_port %}
    - port: {{ p }}
      targetPort: {{ p }}
      protocol: TCP
      name: p{{ p }}
{% endfor %}
  type: ClusterIP
