apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{ issuer_name }}
spec:
  acme:
    email: {{ contact_email }}
{% if staging %}
    server: https://acme-staging-v02.api.letsencrypt.org/directory
{% else %}
    server: https://acme-v02.api.letsencrypt.org/directory
{% endif %}
    privateKeySecretRef:
      name: {{ issuer_secret_name }}
    solvers:
{% if gateway %}
    {# Gateway routing: the challenge route hangs on the shared HTTP listener of the
       cluster Gateway, which carries the redirect-to-https route for everything else. #}
    - http01:
        gatewayHTTPRoute:
          parentRefs:
            - group: gateway.networking.k8s.io
              kind: Gateway
              name: {{ gateway.name | yaml_scalar }}
              namespace: {{ gateway.namespace | yaml_scalar }}
              sectionName: {{ gateway.http_listener.name | yaml_scalar }}
{% else %}
    - http01:
        ingress:
          serviceType: ClusterIP
          ingressTemplate:
            metadata:
              annotations:
                haproxy.router.openshift.io/ip_whitelist: "0.0.0.0/0,::/0"
{% endif %}
