apiVersion: v1
kind: Secret
metadata:
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    app.kubernetes.io/name: {{ name | yaml_scalar }}
    app.kubernetes.io/component: {{ (secret_type | default('secret')) | yaml_scalar }}
    created-by: operations-manager
    {% if secret_labels %}
    {% for key, value in secret_labels.items() %}
    {{ key | yaml_scalar }}: {{ value | yaml_scalar }}
    {% endfor %}
    {% endif %}
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
    # Replace ensures ArgoCD does a full kubectl replace instead of 3-way merge,
    # so keys removed/renamed in a later render (e.g. an alias rename) are dropped
    # from the live Secret rather than lingering as stale entries.
    argocd.argoproj.io/sync-options: Replace=true
    {% if secret_annotations %}
    {% for key, value in secret_annotations.items() %}
    {{ key | yaml_scalar }}: {{ value | yaml_scalar }}
    {% endfor %}
    {% endif %}
type: {{ (secret_k8s_type | default('Opaque')) | yaml_scalar }}
{% if secret_pairs %}
stringData:
  {% for key, value in secret_pairs.items() %}
  {# yaml_scalar quotes and escapes exactly what YAML requires; see the filter for
     why naive quoting and tojson both corrupt or reject perfectly legal values. #}
  {{ key | yaml_scalar }}: {{ value | yaml_scalar }}
  {% endfor %}
{% endif %}
