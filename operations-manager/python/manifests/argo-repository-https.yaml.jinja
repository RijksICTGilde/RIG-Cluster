apiVersion: v1
kind: Secret
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  {# Waarden uit het projectbestand, gecodeerd als YAML-scalars. #}
  type: {{ type | yaml_scalar }}
  url: {{ repository_url | yaml_scalar }}
  name: {{ name | yaml_scalar }}
  username: {{ username | yaml_scalar }}
  password: {{ password | yaml_scalar }}
