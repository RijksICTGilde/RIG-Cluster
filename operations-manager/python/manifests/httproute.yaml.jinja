apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ name | yaml_scalar }}
{% if extra_labels %}
  labels:
{% for k, v in extra_labels.items() %}
    {{ k | yaml_scalar }}: {{ v | yaml_scalar }}
{% endfor %}
{% endif %}
{% if external_dns_target %}
  annotations:
    # Overrides the default LB-status hostname, as on the Ingress it replaces.
    external-dns.alpha.kubernetes.io/target: {{ external_dns_target | yaml_scalar }}
{% endif %}
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: {{ parent.kind | yaml_scalar }}
      name: {{ parent.name | yaml_scalar }}
{% if parent.namespace %}
      namespace: {{ parent.namespace | yaml_scalar }}
{% endif %}
      sectionName: {{ parent.section_name | yaml_scalar }}
  hostnames:
    - {{ hostname | yaml_scalar }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: {{ (path | default('/', true)) | yaml_scalar }}
      filters:
{% if rewrite %}
        {# ReplacePrefixMatch replaces the matched prefix, which is what the nginx
           rewrite did; rewrite "/" therefore strips the prefix down to the root. #}
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: {{ rewrite | yaml_scalar }}
{% endif %}
        # The four headers the nginx configuration-snippet set with more_set_headers,
        # for internet.nl compliance. See https://internet.nl/faqs/appsecpriv/
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            set:
              - name: X-Content-Type-Options
                value: "nosniff"
              - name: X-Frame-Options
                value: "DENY"
              - name: Referrer-Policy
                value: "strict-origin-when-cross-origin"
              - name: Permissions-Policy
                value: "geolocation=(), microphone=(), camera=()"
{% if enable_tls %}
              - name: Strict-Transport-Security
                value: "max-age=31536000;includeSubDomains;preload"
{% endif %}
      backendRefs:
        - name: {{ (service_name if service_name is defined and service_name else name) | yaml_scalar }}
          port: {{ service_port | default(80) }}
      # Off: timeouts.request bounds the WHOLE request, and Envoy falls back to a hard 15s
      # without it, which breaks downloads, uploads, SSE and websockets. The idle bound stays
      # with the controller (Envoy: a 5 minute stream idle timeout, as nginx had 300s).
      timeouts:
        request: "0s"
