apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    project: {{ labels.project | yaml_scalar }}
  annotations:
    {# Het projectniveau op wave 0, de deployments op wave 1, zodat wat namespace-breed
       is er staat voor de pods die het nodig hebben. #}
    argocd.argoproj.io/sync-wave: {{ (sync_wave | default(1)) | string | yaml_scalar }}
    # https://argo-cd.readthedocs.io/en/stable/operator-manual/high_availability/#manifest-paths-annotation
    argocd.argoproj.io/manifest-generate-paths: .
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ argo_project | yaml_scalar }}
  source:
    repoURL: {{ repoURL | yaml_scalar }}
    targetRevision: {{ targetRevision | yaml_scalar }}
    path: {{ repoPath | yaml_scalar }}
    plugin:
      name: kustomize-sops-v1.0
      env:
        - name: SOPS_KEY_SECRET
          value: "sops-age-key"
  destination:
    server: "https://kubernetes.default.svc"
    namespace: {{ destination.namespace | yaml_scalar }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: false
    syncOptions:
      - CreateNamespace=false
      - PrunePropagationPolicy=foreground
      - PruneLast=true
      - SkipDryRunOnMissingResource=true
    # The first auto-sync of a new Application can fail once (seen on the sandbox), and OPI waits for it
    # to turn healthy before it rolls out the next level. A fixed 30s backoff made that
    # wait most of a project's creation time; 5, 10, 20, 30 keeps the same window.
    retry:
      limit: 4
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 30s
  revisionHistoryLimit: 3
