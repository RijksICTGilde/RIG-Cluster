apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ object_name | default(name) }}"
  namespace: "{{ namespace }}"
  labels:
    app: "{{ name }}"
    deployment: "{{ deployment_name }}"
    project: "{{ project.name }}"
    component: application
{% for k, v in (extra_selector_labels or {}).items() %}
    {{ k }}: {{ v | tojson }}
{% endfor %}
spec:
  strategy:
    type: {{ pod_replacement_mode }}
  replicas: {{ replicas }}
  revisionHistoryLimit: 3
  # Cap how long Kubernetes reports a stalled rollout as "Progressing" before
  # flipping it to ProgressDeadlineExceeded (default is 600s). ArgoCD's health
  # gate waits out this window, so a broken rollout (e.g. ImagePullBackOff) would
  # otherwise hang the sync for 10 minutes. 300s leaves room for genuinely slow
  # starts while failing visibly faster.
  progressDeadlineSeconds: 300
  selector:
    matchLabels:
      app: "{{ name }}"
      component: application
{% for k, v in (extra_selector_labels or {}).items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
  template:
    metadata:
{% if metrics_config %}
      annotations:
        # Prometheus scraping annotations (metrics-scraper service enabled)
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ metrics_config.port if metrics_config.port else application_port }}"
        prometheus.io/path: "{{ metrics_config.path if metrics_config.path else '/metrics' }}"
{% endif %}
      labels:
        app: "{{ name }}"
        deployment: "{{ deployment_name }}"
        project: "{{ project.name }}"
        component: application
        network-policy: allow-db-access
{% for k, v in (extra_selector_labels or {}).items() %}
        {{ k }}: {{ v | tojson }}
{% endfor %}
    spec:
      {% if imagePullSecretsMap and imageURL in imagePullSecretsMap %}
      imagePullSecrets:
        - name: {{ imagePullSecretsMap[imageURL] }}
      {% endif %}
      # Pod-level security context (OpenShift compatible)
      securityContext:
        {% if assigns_uid_via_scc(cluster) %}
        # Where the platform assigns IDs (OpenShift SCC), let it.
        # Per-component security overrides are intentionally ignored here:
        # SCC admission injects a UID per namespace and would conflict.
        runAsNonRoot: true
        {% else %}
        # Nothing assigns a UID here, so pin one. Without fsGroup a non-root
        # container has no group ownership on its volume and cannot write to it.
        # Per-component overrides via project YAML `components[].security.{run-as-user,run-as-group,fs-group}`;
        # each defaults to 1001 when omitted to preserve historical behaviour.
        runAsNonRoot: true
        runAsUser: {{ security.runAsUser if security and security.runAsUser is not none else 1001 }}
        runAsGroup: {{ security.runAsGroup if security and security.runAsGroup is not none else 1001 }}
        fsGroup: {{ security.fsGroup if security and security.fsGroup is not none else 1001 }}  # Required for PVC write access
        {% endif %}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: {{ (imageURL | default('', true)) | tojson }}
          imagePullPolicy: {{ imagePullPolicy }}
          {% if command %}
          # Override of the image's ENTRYPOINT — set via project YAML
          # `components[].command` or `deployments[].components[].command`.
          command:
          {% for c in command %}
            - {{ c | tojson }}
          {% endfor %}
          {% endif %}
          {% if inbound_ports %}
          ports:
          {% for p in inbound_ports %}
            - containerPort: {{ p }}
              name: {{ 'http' if loop.first else 'p' ~ p }}
          {% endfor %}
          {% endif %}
          # Container-level security context (OpenShift compatible)
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          lifecycle:
            preStop:
              exec:
                command: ["sleep", "5"]
          {% if env_vars or (ca_config and ca_config.enabled and ca_config.env_vars) %}
          env:
          {% if env_vars %}
          {% for env_name, env_value in env_vars.items() %}
            - name: {{ env_name | tojson }}
              value: {{ env_value | tojson }}
          {% endfor %}
          {% endif %}
          {% if ca_config and ca_config.enabled and ca_config.env_vars %}
          {% for env_name, env_value in ca_config.env_vars.items() %}
            - name: {{ env_name | tojson }}
              value: {{ env_value | tojson }}
          {% endfor %}
          {% endif %}
          {% endif %}
          {% if env_from_secrets or env_from_configmaps %}
          envFrom:
          {% for secret_name in env_from_secrets | default([]) %}
            - secretRef:
                name: {{ secret_name }}
          {% endfor %}
          {% for cm_name in env_from_configmaps | default([]) %}
            - configMapRef:
                name: {{ cm_name }}
          {% endfor %}
          {% endif %}
          {% if storage_configs or (ca_config and ca_config.enabled) or (attachment_secret_mounts is defined and attachment_secret_mounts) %}
          volumeMounts:
          {% if storage_configs %}
          {% for storage in storage_configs %}
            - name: {{ storage.name | tojson }}
              mountPath: {{ storage['mount-path'] | tojson }}
          {% endfor %}
          {% endif %}
          {% if ca_config and ca_config.enabled %}
            - name: ca-certificate
              mountPath: {{ ca_config.container_path }}
              readOnly: true
          {% if ca_config.hash %}
            - name: ca-certificate
              mountPath: /etc/ssl/certs/{{ ca_config.hash }}.0
              readOnly: true
          {% endif %}
          {% endif %}
          {% if attachment_secret_mounts is defined and attachment_secret_mounts %}
          {% for m in attachment_secret_mounts %}
            - name: {{ m.name | tojson }}
              mountPath: {{ m.mount_path | tojson }}
              subPath: {{ m.sub_path | tojson }}
              readOnly: true
          {% endfor %}
          {% endif %}
          {% endif %}
          resources:
            requests:
              memory: "{{ resources_requests_memory }}"
              cpu: "{{ resources_requests_cpu }}"
            limits:
              memory: "{{ resources_limits_memory }}"
              cpu: "{{ resources_limits_cpu }}"
          {% if probe_scheme != 'none' %}
          startupProbe:
            {% if probe_scheme in ('http', 'https') %}
            httpGet:
              port: {{ probe_port | default(application_port, true) | tojson }}
              path: {{ probe_liveness_path | default('/') | tojson }}
              scheme: {{ probe_scheme | upper }}
            {% else %}
            tcpSocket:
              port: {{ probe_port | default(application_port, true) | tojson }}
            {% endif %}
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 36  # 5 + (36 × 5) = 185 seconds max startup time
          livenessProbe:
            {% if probe_scheme in ('http', 'https') %}
            httpGet:
              port: {{ probe_port | default(application_port, true) | tojson }}
              path: {{ probe_liveness_path | default('/') | tojson }}
              scheme: {{ probe_scheme | upper }}
            {% else %}
            tcpSocket:
              port: {{ probe_port | default(application_port, true) | tojson }}
            {% endif %}
            initialDelaySeconds: 5
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            {% if probe_scheme in ('http', 'https') %}
            httpGet:
              port: {{ probe_port | default(application_port, true) | tojson }}
              path: {{ probe_readiness_path | default('/') | tojson }}
              scheme: {{ probe_scheme | upper }}
            {% else %}
            tcpSocket:
              port: {{ probe_port | default(application_port, true) | tojson }}
            {% endif %}
            initialDelaySeconds: 0
            {# 2s: de kubelet-sampling bepaalt hoe snel een verse pod als Ready telt, en
               daarmee hoe snel ArgoCD de app Healthy meldt. Op 5s kostte alleen dit rooster
               al gemiddeld 2,5s extra Progressing na een feitelijk geslaagde start. #}
            periodSeconds: 2
            failureThreshold: {{ probe_readiness_failure_threshold | default(3) }}
          {% endif %}
{% if sidecars is defined and sidecars %}
{% for sidecar in sidecars %}
{% set section = 'container' %}
{% include 'sidecar-' + sidecar + '.yaml.jinja' %}
{% endfor %}
{% endif %}
      {% if storage_configs or (ca_config and ca_config.enabled) or (sidecars is defined and sidecars) or (attachment_secret_mounts is defined and attachment_secret_mounts) %}
      volumes:
      {% if storage_configs %}
      {% for storage in storage_configs %}
        {% if storage.type == 'persistent' %}
        - name: {{ storage.name | tojson }}
          persistentVolumeClaim:
            claimName: {{ storage.pvc_name | tojson }}
        {% elif storage.type == 'ephemeral' %}
        - name: {{ storage.name | tojson }}
          emptyDir:
            sizeLimit: {{ storage.size | tojson }}
        {% endif %}
      {% endfor %}
      {% endif %}
      {% if ca_config and ca_config.enabled %}
        - name: ca-certificate
          hostPath:
            path: {{ ca_config.node_path }}
            type: File
      {% endif %}
      {% if attachment_secret_mounts is defined and attachment_secret_mounts %}
      {% for m in attachment_secret_mounts | unique(attribute='name') %}
        - name: {{ m.name | tojson }}
          secret:
            secretName: {{ m.secret_name | tojson }}
      {% endfor %}
      {% endif %}
{% if sidecars is defined and sidecars %}
{% for sidecar in sidecars %}
{% set section = 'volumes' %}
{% include 'sidecar-' + sidecar + '.yaml.jinja' %}
{% endfor %}
{% endif %}
      {% endif %}
