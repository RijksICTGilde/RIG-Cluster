apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app: "{{ name }}"
    project: "{{ project.name }}"
    component: application
spec:
  strategy:
    type: {{ pod_replacement_mode }}
  replicas: {{ replicas }}
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app: "{{ name }}"
      component: application
  template:
    metadata:
      annotations:
        # Prometheus scraping annotations
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ metrics_port if metrics_port else application_port }}"
        prometheus.io/path: "{{ metrics_path if metrics_path else '/metrics' }}"
      labels:
        app: "{{ name }}"
        project: "{{ project.name }}"
        component: application
        network-policy: allow-db-access
    spec:
      {% if imagePullSecretsMap and imageURL in imagePullSecretsMap %}
      imagePullSecrets:
        - name: {{ imagePullSecretsMap[imageURL] }}
      {% endif %}
      # Pod-level security context (OpenShift compatible)
      securityContext:
        {% if cluster in ['local', 'sandboxed-local'] %}
        # For Kind clusters, specify numeric UID since no SCC assignment
        runAsNonRoot: true
        runAsUser: 1001
        runAsGroup: 1001
        fsGroup: 1001  # Required for PVC write access
        {% else %}
        # For OpenShift, let SCCs assign user/group IDs automatically
        runAsNonRoot: true
        {% endif %}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: "{{ imageURL }}"
          imagePullPolicy: {{ imagePullPolicy }}
          ports:
            - containerPort: {{ application_port }}
              name: http
          # Container-level security context (OpenShift compatible)
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          lifecycle:
            preStop:
              exec:
                command: ["sleep", "5"]
          {% if env_vars or (ca_config and ca_config.enabled and ca_config.env_vars) %}
          env:
          {% if env_vars %}
          {% for env_name, env_value in env_vars.items() %}
            - name: {{ env_name }}
              value: "{{ env_value }}"
          {% endfor %}
          {% endif %}
          {% if ca_config and ca_config.enabled and ca_config.env_vars %}
          {% for env_name, env_value in ca_config.env_vars.items() %}
            - name: {{ env_name }}
              value: "{{ env_value }}"
          {% endfor %}
          {% endif %}
          {% endif %}
          {% if env_from_secrets %}
          envFrom:
          {% for secret_name in env_from_secrets %}
            - secretRef:
                name: {{ secret_name }}
          {% endfor %}
          {% endif %}
          {% if storage_configs or (ca_config and ca_config.enabled) %}
          volumeMounts:
          {% if storage_configs %}
          {% for storage in storage_configs %}
            - name: {{ storage.name }}
              mountPath: {{ storage['mount-path'] }}
          {% endfor %}
          {% endif %}
          {% if ca_config and ca_config.enabled %}
            - name: ca-certificate
              mountPath: {{ ca_config.container_path }}
              readOnly: true
          {% if ca_config.hash %}
            - name: ca-certificate
              mountPath: /etc/ssl/certs/{{ ca_config.hash }}.0
              readOnly: true
          {% endif %}
          {% endif %}
          {% endif %}
          resources:
            requests:
              memory: "{{ resources_requests_memory }}"
              cpu: "{{ resources_requests_cpu }}"
            limits:
              memory: "{{ resources_limits_memory }}"
              cpu: "{{ resources_limits_cpu }}"
          startupProbe:
            tcpSocket:
              port: {{ application_port }}
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 36  # 5 + (36 × 5) = 185 seconds max startup time
          livenessProbe:
            tcpSocket:
              port: {{ application_port }}
            initialDelaySeconds: 5
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: {{ application_port }}
            initialDelaySeconds: 0
            periodSeconds: 5
            failureThreshold: 3
{% if sidecars is defined and sidecars %}
{% for sidecar in sidecars %}
{% include 'sidecar-' + sidecar + '.yaml.jinja' %}
{% endfor %}
{% endif %}
      {% if storage_configs or (ca_config and ca_config.enabled) %}
      volumes:
      {% if storage_configs %}
      {% for storage in storage_configs %}
        {% if storage.type == 'persistent' %}
        - name: {{ storage.name }}
          persistentVolumeClaim:
            claimName: {{ storage.pvc_name }}
        {% elif storage.type == 'ephemeral' %}
        - name: {{ storage.name }}
          emptyDir:
            sizeLimit: {{ storage.size }}
        {% endif %}
      {% endfor %}
      {% endif %}
      {% if ca_config and ca_config.enabled %}
        - name: ca-certificate
          hostPath:
            path: {{ ca_config.node_path }}
            type: File
      {% endif %}
      {% endif %}
