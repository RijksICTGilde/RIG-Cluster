apiVersion: v1
kind: Secret
metadata:
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    app.kubernetes.io/name: {{ name | yaml_scalar }}
    app.kubernetes.io/component: {{ (secret_type | default('attachment')) | yaml_scalar }}
    created-by: operations-manager
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
    # Replace ensures ArgoCD drops keys removed in a later render rather than
    # leaving stale entries on the live Secret.
    argocd.argoproj.io/sync-options: Replace=true
type: {{ (secret_k8s_type | default('Opaque')) | yaml_scalar }}
{% if data_pairs %}
data:
  {% for key, value in data_pairs.items() %}
  {{ key | yaml_scalar }}: {{ value | yaml_scalar }}
  {% endfor %}
{% endif %}
