apiVersion: v1
kind: Secret
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: "{{ name }}"
    app.kubernetes.io/component: "{{ secret_type | default('attachment') }}"
    created-by: operations-manager
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
    # Replace ensures ArgoCD drops keys removed in a later render rather than
    # leaving stale entries on the live Secret.
    argocd.argoproj.io/sync-options: Replace=true
type: Opaque
{% if data_pairs %}
data:
  {% for key, value in data_pairs.items() %}
  {{ key }}: "{{ value }}"
  {% endfor %}
{% endif %}
