apiVersion: v1
kind: Pod
metadata:
  name: "{{ pod_name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: database-restore
    app.kubernetes.io/component: restore-job
    app.kubernetes.io/managed-by: opi-backup
    backup.rig.nl/database: "{{ reference_name }}"
    backup.rig.nl/target-database: "{{ target_db_name }}"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: {{ timeout_seconds | default(3600) }}
  containers:
    - name: restore
      image: ghcr.io/minbzk/base-images/rig-backup:latest
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          echo "Starting database restore for: {{ reference_name }}"
          echo "Target Database Host: ${TARGET_DB_HOST}"
          echo "Target Database Port: ${TARGET_DB_PORT}"
          echo "Target Database Name: ${TARGET_DB_NAME}"
          echo "Target Database User: ${TARGET_DB_USER}"
          echo "Namespace: {{ namespace }}"
          echo "S3 Endpoint: ${S3_ENDPOINT}"
          echo "S3 Bucket: ${S3_BUCKET}"
          echo "Backup Prefix: ${BACKUP_PREFIX}"
          echo "S3 Disable TLS: ${S3_DISABLE_TLS}"

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # Connect to repository
          echo "Connecting to Kopia repository..."
          kopia repository connect s3 \
            --bucket="${S3_BUCKET}" \
            --prefix="${BACKUP_PREFIX}/" \
            --endpoint="${S3_ENDPOINT}" \
            --access-key="${S3_ACCESS_KEY}" \
            --secret-access-key="${S3_SECRET_KEY}" \
            --password="${KOPIA_PASSWORD}" \
            ${TLS_FLAG}

          echo "Repository connected successfully"

          # Find the snapshot to restore
          SNAPSHOT_ID="${RESTORE_SNAPSHOT_ID}"

          if [ -z "$SNAPSHOT_ID" ]; then
            echo "No snapshot ID specified, finding latest database snapshot for {{ reference_name }}..."
            # Get latest snapshot with matching database tag
            SNAPSHOT_ID=$(kopia snapshot list --tags="database:{{ reference_name }}" --tags="resource_type:database" --json 2>/dev/null | \
              jq -r 'sort_by(.startTime) | reverse | .[0].id // empty')

            if [ -z "$SNAPSHOT_ID" ]; then
              echo "ERROR: No database snapshots found for {{ reference_name }}"
              exit 1
            fi
            echo "Found latest snapshot: $SNAPSHOT_ID"
          else
            echo "Using specified snapshot: $SNAPSHOT_ID"
          fi

          # Show snapshot info
          echo "Snapshot details:"
          kopia show "$SNAPSHOT_ID" || true

          # Test database connectivity. This is the destination gate: if it fails, the
          # target the caller named is unusable (host, port, database, user or password),
          # and nothing of ours is broken. Exit with the dedicated code so the caller can
          # be told that without anyone parsing this log text.
          echo "Testing target database connectivity..."
          if ! PGPASSWORD="${TARGET_DB_PASSWORD}" psql \
            -h "${TARGET_DB_HOST}" -p "${TARGET_DB_PORT}" -U "${TARGET_DB_USER}" -d "${TARGET_DB_NAME}" \
            -c "SELECT 1" > /dev/null; then
            echo "ERROR: target database is not usable (host, port, database name, user or password rejected)"
            exit {{ target_unusable_exit_code }}
          fi

          echo "Target database connection successful"

          # Restore database
          # First, we need to find the stdin file in the snapshot
          echo "Finding database dump file in snapshot..."
          DUMP_FILE=$(kopia show "$SNAPSHOT_ID" --json 2>/dev/null | \
            jq -r '.rootEntry.name // empty')

          if [ -z "$DUMP_FILE" ]; then
            DUMP_FILE="database-{{ reference_name }}.dump"
          fi
          echo "Dump file: $DUMP_FILE"

          # Stream restore: kopia restore --stdout | pg_restore
          echo "Restoring database from snapshot..."

          # Create temp directory for restore
          mkdir -p /tmp/restore

          # Restore to temp location first
          kopia restore "$SNAPSHOT_ID" /tmp/restore/

          # Find the dump file
          DUMP_PATH=$(find /tmp/restore -name "*.dump" -type f | head -1)

          if [ -z "$DUMP_PATH" ]; then
            echo "ERROR: No .dump file found in snapshot"
            ls -la /tmp/restore/
            exit 1
          fi

          echo "Found dump file: $DUMP_PATH"

          # Which schema in the dump holds the application's own data.
          #
          # The name is supplied by the platform (SOURCE_SCHEMA, from
          # generate_database_name) and is NOT read from the dump. The dump carries
          # every schema of the source database, and pg_restore --list sorts them
          # ALPHABETICALLY, so taking the first one renamed whichever extra schema
          # happened to sort first -- a project with an extra schema restored to a
          # second generation ended up with the reporting schema under the application's
          # schema name and its own data left behind (RC-121).
          echo "Source schema (named by the platform): ${SOURCE_SCHEMA:-<not supplied>}"
          echo "Target schema: ${TARGET_DB_NAME}"

          # When a rename is needed, both names end up in SQL identifiers. Ours are
          # [a-z][a-z0-9_]*; anything else is refused rather than quoted and hoped for.
          # Only checked on the rename path: a restore into an externally named database
          # never puts these names in SQL and has no reason to care.
          LC_ALL=C
          export LC_ALL
          check_identifier() {
            case "$2" in
              [a-z]*) ;;
              *)
                echo "ERROR: $1 '$2' does not start with a lower-case letter"
                exit 1
                ;;
            esac
            case "$2" in
              *[!a-z0-9_]*)
                echo "ERROR: $1 '$2' contains characters outside a-z, 0-9 and _"
                exit 1
                ;;
            esac
          }

          run_sql() {
            PGPASSWORD="${TARGET_DB_PASSWORD}" psql \
              -h "${TARGET_DB_HOST}" -p "${TARGET_DB_PORT}" -U "${TARGET_DB_USER}" -d "${TARGET_DB_NAME}" \
              -v ON_ERROR_STOP=1 -Atc "$1"
          }

          # Restore using pg_restore
          # --no-owner: Don't set ownership
          # --no-privileges: Don't restore privileges
          PGPASSWORD="${TARGET_DB_PASSWORD}" pg_restore \
            -h "${TARGET_DB_HOST}" -p "${TARGET_DB_PORT}" -U "${TARGET_DB_USER}" -d "${TARGET_DB_NAME}" \
            --no-owner --no-privileges \
            --verbose \
            "$DUMP_PATH" || {
              # pg_restore often returns non-zero even on success due to missing objects
              echo "pg_restore completed (some warnings may be expected)"
            }

          # Rename the default schema when the source database had a different name
          # (a new generation, or a restore into a differently named target). Extra
          # schemas ({project}_{deployment}_{postfix}) carry no generation, so their
          # name is already right in the target database and they are left alone.
          if [ -z "${SOURCE_SCHEMA}" ]; then
            # No name was supplied. Only proceed when the dump itself already carries a
            # schema with the target name -- then there is provably nothing to rename.
            # Anything else would be a guess, and a restore that guesses puts the wrong
            # data under the name the application reads.
            if pg_restore --list "$DUMP_PATH" | grep -qF " SCHEMA - ${TARGET_DB_NAME} "; then
              echo "No source schema supplied, and the dump already carries ${TARGET_DB_NAME}: nothing to rename"
            else
              echo "ERROR: the platform did not supply the source schema name and the dump"
              echo "       does not contain a schema named ${TARGET_DB_NAME}, so which schema"
              echo "       belongs to the application cannot be established. Schemas in the dump:"
              pg_restore --list "$DUMP_PATH" | grep " SCHEMA - " || true
              exit 1
            fi
          elif [ "${SOURCE_SCHEMA}" = "${TARGET_DB_NAME}" ]; then
            echo "Source and target schema are both ${TARGET_DB_NAME}: nothing to rename"
          else
            check_identifier "source schema" "${SOURCE_SCHEMA}"
            check_identifier "target schema" "${TARGET_DB_NAME}"

            echo "Renaming schema ${SOURCE_SCHEMA} -> ${TARGET_DB_NAME}..."

            SOURCE_PRESENT=$(run_sql "SELECT count(*) FROM pg_namespace WHERE nspname = '${SOURCE_SCHEMA}'")
            if [ "${SOURCE_PRESENT}" != "1" ]; then
              echo "ERROR: schema ${SOURCE_SCHEMA} is not present after the restore, so there is"
              echo "       nothing to rename. Schemas now in ${TARGET_DB_NAME}:"
              run_sql "SELECT nspname FROM pg_namespace WHERE nspname NOT LIKE 'pg\\_%' AND nspname <> 'information_schema' ORDER BY nspname"
              exit 1
            fi

            # Only the EMPTY target schema created during database setup may be dropped.
            # If it holds anything, that is data the restore just put there, and dropping
            # it with CASCADE is how a successful-looking restore used to destroy exactly
            # what it had restored.
            TARGET_OBJECTS=$(run_sql "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = '${TARGET_DB_NAME}'")
            if [ "${TARGET_OBJECTS}" != "0" ]; then
              echo "ERROR: target schema ${TARGET_DB_NAME} already holds ${TARGET_OBJECTS} object(s);"
              echo "       refusing to drop it. Nothing has been removed."
              exit 1
            fi

            # RESTRICT, not CASCADE: anything the object count above does not cover
            # (functions, types) still stops the restore instead of being dropped.
            run_sql "DROP SCHEMA IF EXISTS \"${TARGET_DB_NAME}\" RESTRICT;"
            run_sql "ALTER SCHEMA \"${SOURCE_SCHEMA}\" RENAME TO \"${TARGET_DB_NAME}\";"

            echo "Renamed ${SOURCE_SCHEMA} to ${TARGET_DB_NAME}"
            UNTOUCHED=$(run_sql "SELECT string_agg(nspname, ', ' ORDER BY nspname) FROM pg_namespace WHERE nspname NOT LIKE 'pg\\_%' AND nspname NOT IN ('information_schema', 'public', '${TARGET_DB_NAME}')")
            echo "Schemas left untouched: ${UNTOUCHED:-none}"
          fi

          # Cleanup
          rm -rf /tmp/restore

          echo "Schemas in ${TARGET_DB_NAME} after restore:"
          run_sql "SELECT nspname FROM pg_namespace WHERE nspname NOT LIKE 'pg\\_%' AND nspname <> 'information_schema' ORDER BY nspname"

          echo "Database restore completed successfully for {{ reference_name }} -> {{ target_db_name }}"
      env:
        - name: TARGET_DB_HOST
          value: "{{ target_db_host }}"
        - name: TARGET_DB_PORT
          value: "{{ target_db_port | default(5432) }}"
        - name: TARGET_DB_NAME
          value: "{{ target_db_name }}"
        - name: TARGET_DB_USER
          value: "{{ target_db_user }}"
        # The default schema of the database the dump was taken from. Validated
        # against the platform naming rule before this manifest is rendered.
        - name: SOURCE_SCHEMA
          value: "{{ source_schema }}"
        - name: TARGET_DB_PASSWORD
          value: "{{ target_db_password }}"
        - name: S3_ENDPOINT
          value: "{{ s3_endpoint }}"
        - name: S3_BUCKET
          value: "{{ s3_bucket }}"
        - name: S3_ACCESS_KEY
          value: "{{ s3_access_key }}"
        - name: S3_SECRET_KEY
          value: "{{ s3_secret_key }}"
        - name: S3_DISABLE_TLS
          value: "{{ s3_disable_tls | lower }}"
        - name: BACKUP_PREFIX
          value: "{{ backup_prefix }}"
        - name: KOPIA_PASSWORD
          value: "{{ kopia_password }}"
        - name: RESTORE_SNAPSHOT_ID
          value: "{{ snapshot_id }}"
        # Use /tmp for Kopia cache (container filesystem is read-only)
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      resources:
        requests:
          memory: "256Mi"
          cpu: "100m"
        limits:
          memory: "2Gi"
          cpu: "1000m"
