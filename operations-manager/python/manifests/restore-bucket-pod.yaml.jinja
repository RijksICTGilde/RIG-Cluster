apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    app.kubernetes.io/name: bucket-restore
    app.kubernetes.io/component: restore-job
    app.kubernetes.io/managed-by: opi-backup
    backup.rig.nl/bucket: {{ reference_name | yaml_scalar }}
    backup.rig.nl/target-bucket: {{ target_bucket_name | yaml_scalar }}
spec:
  serviceAccountName: {{ service_account_name | yaml_scalar }}
  restartPolicy: Never
  activeDeadlineSeconds: {{ timeout_seconds | default(3600) | int }}
  containers:
    - name: restore
      image: ghcr.io/minbzk/base-images/rig-backup:latest
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          echo "Starting bucket restore for: ${REFERENCE_NAME}"
          echo "Target MinIO Endpoint: ${TARGET_MINIO_ENDPOINT}"
          echo "Target Bucket: ${TARGET_BUCKET_NAME}"
          echo "Namespace: ${NAMESPACE}"
          echo "S3 Endpoint: ${S3_ENDPOINT}"
          echo "S3 Bucket: ${S3_BUCKET}"
          echo "Backup Prefix: ${BACKUP_PREFIX}"
          echo "S3 Disable TLS: ${S3_DISABLE_TLS}"

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # mc reads the `target` alias from MC_HOST_target. Destination gate: listing tests the endpoint and keys.
          # CreateBucket may fail (no right to that), but listing the bucket must succeed or the target is broken.
          echo "Ensuring target bucket exists..."
          mc mb target/"${TARGET_BUCKET_NAME}" --ignore-existing || true

          echo "Checking the target bucket..."
          if ! mc ls target/"${TARGET_BUCKET_NAME}" > /dev/null; then
            echo "ERROR: target object storage is not usable (endpoint, bucket, access key or secret key rejected)"
            exit {{ target_unusable_exit_code | int }}
          fi

          # Connect to Kopia repository
          echo "Connecting to Kopia repository..."
          # Kopia takes the repository password from KOPIA_PASSWORD and the S3 keys from
          # AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, so they stay out of argv.
          kopia repository connect s3 \
            --bucket="${S3_BUCKET}" \
            --prefix="${BACKUP_PREFIX}/" \
            --endpoint="${S3_ENDPOINT}" \
            ${TLS_FLAG}

          echo "Repository connected successfully"

          # Find the snapshot to restore
          SNAPSHOT_ID="${RESTORE_SNAPSHOT_ID}"

          if [ -z "$SNAPSHOT_ID" ]; then
            echo "No snapshot ID specified, finding latest bucket snapshot for ${REFERENCE_NAME}..."
            # Get latest snapshot with matching bucket tag
            SNAPSHOT_ID=$(kopia snapshot list --tags="bucket:${REFERENCE_NAME}" --tags="resource_type:bucket" --json 2>/dev/null | \
              jq -r 'sort_by(.startTime) | reverse | .[0].id // empty')

            if [ -z "$SNAPSHOT_ID" ]; then
              echo "ERROR: No bucket snapshots found for ${REFERENCE_NAME}"
              exit 1
            fi
            echo "Found latest snapshot: $SNAPSHOT_ID"
          else
            echo "Using specified snapshot: $SNAPSHOT_ID"
          fi

          # Show snapshot info
          echo "Snapshot details:"
          kopia show "$SNAPSHOT_ID" || true

          # Restore snapshot to temp directory
          echo "Restoring snapshot to temp directory..."
          mkdir -p /tmp/bucket-restore

          kopia restore "$SNAPSHOT_ID" /tmp/bucket-restore/

          # Get restore stats
          OBJECT_COUNT=$(find /tmp/bucket-restore -type f | wc -l)
          TOTAL_SIZE=$(du -sh /tmp/bucket-restore 2>/dev/null | cut -f1 || echo "unknown")
          echo "Restored ${OBJECT_COUNT} objects, total size: ${TOTAL_SIZE}"

          # Clear target bucket if requested
          {% if clear_target %}
          echo "Clearing target bucket before restore..."
          mc rm --recursive --force target/"${TARGET_BUCKET_NAME}"/ || true
          {% endif %}

          # Mirror restored files to target bucket
          echo "Uploading restored files to target bucket..."
          mc mirror --preserve --overwrite \
            /tmp/bucket-restore/ \
            target/"${TARGET_BUCKET_NAME}"/

          # Cleanup
          echo "Cleaning up temp directory..."
          rm -rf /tmp/bucket-restore

          # Verify restore
          echo "Verifying restore..."
          mc ls target/"${TARGET_BUCKET_NAME}"/ | head -20

          echo "Bucket restore completed successfully for ${REFERENCE_NAME} -> ${TARGET_BUCKET_NAME}"
      env:
        # De namen die het script print en als tag meegeeft, komen via env binnen en
        # niet in het script zelf: YAML-quoting is geen shell-quoting.
        - name: NAMESPACE
          value: {{ namespace | yaml_scalar }}
        - name: REFERENCE_NAME
          value: {{ reference_name | yaml_scalar }}
        - name: TARGET_MINIO_ENDPOINT
          value: {{ target_minio_endpoint | yaml_scalar }}
        - name: TARGET_BUCKET_NAME
          value: {{ target_bucket_name | yaml_scalar }}
        - name: MC_HOST_target
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: MC_HOST_target
        - name: S3_ENDPOINT
          value: {{ s3_endpoint | yaml_scalar }}
        - name: S3_BUCKET
          value: {{ s3_bucket | yaml_scalar }}
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: AWS_ACCESS_KEY_ID
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: AWS_SECRET_ACCESS_KEY
        - name: S3_DISABLE_TLS
          value: {{ s3_disable_tls | lower | yaml_scalar }}
        - name: BACKUP_PREFIX
          value: {{ backup_prefix | yaml_scalar }}
        - name: KOPIA_PASSWORD
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: KOPIA_PASSWORD
        - name: RESTORE_SNAPSHOT_ID
          value: {{ snapshot_id | yaml_scalar }}
        # Use /tmp for Kopia cache (container filesystem is read-only)
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      resources:
        requests:
          memory: "512Mi"
          cpu: "100m"
        limits:
          memory: "4Gi"
          cpu: "2000m"
