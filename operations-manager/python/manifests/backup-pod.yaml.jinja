apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
  labels:
    app.kubernetes.io/name: pvc-backup
    app.kubernetes.io/component: backup-job
    app.kubernetes.io/managed-by: opi-backup
    # Match the deployment's tenant NetworkPolicy so this pod is allowed egress to
    # the backup MinIO (the baseline selects deployment=<name>).
    deployment: {{ deployment_name | default('unknown', true) | yaml_scalar }}
    backup.rig.nl/pvc: {{ pvc_name | yaml_scalar }}
    backup.rig.nl/timestamp: {{ timestamp | yaml_scalar }}
    backup.rig.nl/trigger: {{ trigger | default('scheduled') | yaml_scalar }}
spec:
  serviceAccountName: {{ service_account_name | yaml_scalar }}
  restartPolicy: Never
  activeDeadlineSeconds: {{ timeout_seconds | default(3600) | int }}
  containers:
    - name: kopia
      image: {{ backup_image }}
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          echo "Starting backup for PVC: ${PVC_NAME}"
          echo "Namespace: ${NAMESPACE}"
          echo "S3 Endpoint: ${S3_ENDPOINT}"
          echo "S3 Bucket: ${S3_BUCKET}"
          echo "Backup Prefix: ${BACKUP_PREFIX}"
          echo "S3 Disable TLS: ${S3_DISABLE_TLS}"

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # Pin a stable Kopia source identity per (project, deployment, PVC)
          # so retention applies per resource (not per pod). The override
          # flags belong on `repository connect/create` — they set the client
          # identity for the whole session. Manual backups connect with a
          # `-manual` suffix on the hostname, giving them a separate source
          # so scheduled retention never touches them.
          KOPIA_IDENTITY_ARGS="--override-hostname={{ kopia_hostname }} --override-username=opi-backup"
          # Kopia takes the repository password from KOPIA_PASSWORD and the S3 keys from
          # AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, so they stay out of argv.
          KOPIA_S3_ARGS="--bucket=${S3_BUCKET} --prefix=${BACKUP_PREFIX}/ --endpoint=${S3_ENDPOINT} ${TLS_FLAG}"

          echo "Connecting to Kopia repository as {{ kopia_source }}..."
          if kopia repository connect s3 ${KOPIA_S3_ARGS} ${KOPIA_IDENTITY_ARGS} 2>/dev/null; then
            echo "Connected to existing repository"
          elif kopia repository create s3 ${KOPIA_S3_ARGS} ${KOPIA_IDENTITY_ARGS}; then
            echo "Created new repository"
          else
            # Repository exists but cannot be opened. Do not empty the prefix: a pod should never remove backup data.
            echo "ERROR: the Kopia repository at ${S3_BUCKET}/${BACKUP_PREFIX} exists but cannot be opened, and creating one failed. No backup data was removed."
            exit {{ repository_unusable_exit_code | int }}
          fi

          echo "Repository connected successfully"

          echo "Starting snapshot of /data..."
          kopia snapshot create /data \
            --description="PVC backup: ${PVC_NAME}" \
            --tags="resource_type:pvc" \
            --tags="cluster:{{ cluster }}" \
            --tags="namespace:${NAMESPACE}" \
            --tags="project:{{ project_name | default('unknown') }}" \
            --tags="deployment:{{ deployment_name | default('unknown') }}" \
            --tags="component:{{ component_name | default('unknown') }}" \
            --tags="storage:{{ storage_name | default('unknown') }}" \
            --tags="pvc:${PVC_NAME}" \
            --tags="generation:{{ pvc_generation | default('0') }}" \
            --tags="timestamp:{{ timestamp }}" \
            --tags="backup_run:{{ backup_run_id }}" \
            --tags="trigger:{{ trigger | default('scheduled') }}"

          echo "Snapshot created successfully"

{% if trigger | default('scheduled') != 'manual' %}
          # Scheduled backups apply retention scoped to this source only.
          # Manual snapshots (separate source identity) are never affected.
          echo "Setting retention policy for {{ kopia_source }}..."
          kopia policy set "{{ kopia_source }}" \
            --keep-latest={{ retention_keep_latest | default(30) | int }} \
            --keep-daily={{ retention_keep_daily | default(30) | int }} \
            --keep-weekly={{ retention_keep_weekly | default(4) | int }} \
            --keep-monthly={{ retention_keep_monthly | default(12) | int }} \
            --keep-annual={{ retention_keep_annual | default(0) | int }}

          echo "Retention policy set"

          echo "Applying retention policy (expiring old snapshots for this source)..."
          kopia snapshot expire "{{ kopia_source }}" --delete
{% else %}
          echo "Manual backup: skipping retention (protected from automatic deletion)"
{% endif %}

          echo "Current snapshots after retention:"
          kopia snapshot list

          echo "Backup completed successfully for ${PVC_NAME}"
      env:
        # De namen die het script print en als tag meegeeft, komen via env binnen en
        # niet in het script zelf: YAML-quoting is geen shell-quoting.
        - name: NAMESPACE
          value: {{ namespace | yaml_scalar }}
        - name: PVC_NAME
          value: {{ pvc_name | yaml_scalar }}
        - name: S3_ENDPOINT
          value: {{ s3_endpoint | yaml_scalar }}
        - name: S3_BUCKET
          value: {{ s3_bucket | yaml_scalar }}
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: AWS_ACCESS_KEY_ID
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: AWS_SECRET_ACCESS_KEY
        - name: S3_DISABLE_TLS
          value: {{ s3_disable_tls | lower | yaml_scalar }}
        - name: BACKUP_PREFIX
          value: {{ backup_prefix | yaml_scalar }}
        - name: KOPIA_PASSWORD
          valueFrom:
            secretKeyRef:
              name: {{ credentials_secret | yaml_scalar }}
              key: KOPIA_PASSWORD
        # Use /tmp for Kopia paths (HOME is not writable on OpenShift)
        - name: KOPIA_CONFIG_PATH
          value: "/tmp/kopia-repository.config"
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      volumeMounts:
        - name: data
          mountPath: /data
          readOnly: true
      resources:
        requests:
          memory: "256Mi"
          cpu: "100m"
        limits:
          memory: "1Gi"
          cpu: "1000m"
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: {{ clone_pvc_name | yaml_scalar }}
