apiVersion: v1
kind: Pod
metadata:
  name: "{{ pod_name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: kopia-list-snapshots
    app.kubernetes.io/component: snapshot-list
    app.kubernetes.io/managed-by: opi-backup
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 120
  containers:
    - name: kopia
      image: ghcr.io/minbzk/base-images/kopia:latest
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -e

          # Build TLS flag based on configuration
          TLS_FLAG=""
          if [ "${S3_DISABLE_TLS}" = "true" ]; then
            TLS_FLAG="--disable-tls"
          fi

          # Connect to repository
          if ! kopia repository connect s3 \
            --bucket="${S3_BUCKET}" \
            --prefix="${BACKUP_PREFIX}/" \
            --endpoint="${S3_ENDPOINT}" \
            --access-key="${S3_ACCESS_KEY}" \
            --secret-access-key="${S3_SECRET_KEY}" \
            --password="${KOPIA_PASSWORD}" \
            ${TLS_FLAG} 2>/dev/null; then
            echo "No repository found or failed to connect"
            exit 0
          fi

          # List snapshots and output as JSON for parsing
          # Each line outputs a JSON object with snapshot info
          kopia snapshot list --json 2>/dev/null | jq -c '.[] | {
            snapshot_id: .id,
            pvc_name: (.tags.pvc // "unknown"),
            timestamp: .startTime,
            size_bytes: .stats.totalSize
          }' || echo "No snapshots found"

      env:
        - name: S3_ENDPOINT
          value: "{{ s3_endpoint }}"
        - name: S3_BUCKET
          value: "{{ s3_bucket }}"
        - name: S3_ACCESS_KEY
          value: "{{ s3_access_key }}"
        - name: S3_SECRET_KEY
          value: "{{ s3_secret_key }}"
        - name: S3_DISABLE_TLS
          value: "{{ s3_disable_tls | default('false') | lower }}"
        - name: BACKUP_PREFIX
          value: "{{ backup_prefix }}"
        - name: KOPIA_PASSWORD
          value: "{{ kopia_password }}"
        # Use /tmp for Kopia cache (container filesystem is read-only)
        - name: KOPIA_CACHE_DIRECTORY
          value: "/tmp/kopia-cache"
        - name: KOPIA_LOG_DIR
          value: "/tmp/kopia-logs"
      resources:
        requests:
          memory: "128Mi"
          cpu: "50m"
        limits:
          memory: "256Mi"
          cpu: "200m"
