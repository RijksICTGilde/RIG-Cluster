apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}
{% if extra_labels %}
  labels:
{% for k, v in extra_labels.items() %}
    {{ k }}: {{ v | tojson }}
{% endfor %}
{% endif %}
  annotations:
    # ============================================================
    # OpenShift/HAProxy annotations
    # ============================================================
    haproxy.router.openshift.io/ip_whitelist: {{ ip_whitelist | default("0.0.0.0/0,::/0") }}
    haproxy.router.openshift.io/timeout: "300s"
{% if passthrough %}
    # Passthrough TLS: the OpenShift Router forwards the encrypted stream untouched;
    # the pod terminates TLS with its own certificate. No edge certificate is used.
    route.openshift.io/termination: passthrough
{% endif %}
{% if rewrite %}
    haproxy.router.openshift.io/rewrite-target: {{ (rewrite | default('', true)) | tojson }}
{% endif %}
{% if enable_tls %}
    # HSTS for internet.nl compliance (1 year, includeSubDomains, preload)
    # See: https://internet.nl/faqs/https/
    haproxy.router.openshift.io/hsts_header: "max-age=31536000;includeSubDomains;preload"
{% endif %}
    # ============================================================
    # NGINX ingress annotations
    # ============================================================
    nginx.ingress.kubernetes.io/proxy-body-size: "0"
    nginx.ingress.kubernetes.io/proxy-buffer-size: "16k"
    nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "300"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "60"
{% if passthrough %}
    # Passthrough TLS: nginx forwards TLS untouched; the pod terminates it.
    nginx.ingress.kubernetes.io/ssl-passthrough: "true"
{% endif %}
{% if enable_tls %}
    # HSTS for NGINX (enabled by default, but explicit for clarity)
    nginx.ingress.kubernetes.io/hsts: "true"
    nginx.ingress.kubernetes.io/hsts-max-age: "31536000"
    nginx.ingress.kubernetes.io/hsts-include-subdomains: "true"
    nginx.ingress.kubernetes.io/hsts-preload: "true"
{% endif %}
    # ============================================================
    # Security headers for internet.nl compliance
    # See: https://internet.nl/faqs/appsecpriv/
    # ============================================================
    # X-Content-Type-Options: Prevent MIME type sniffing
    nginx.ingress.kubernetes.io/x-content-type-options: "nosniff"
    # X-Frame-Options: Prevent clickjacking (DENY or SAMEORIGIN)
    nginx.ingress.kubernetes.io/x-frame-options: "DENY"
    # Referrer-Policy: Control referrer information
    nginx.ingress.kubernetes.io/referrer-policy: "strict-origin-when-cross-origin"
    # Content-Security-Policy: Baseline CSP (applications should override with stricter policy)
    # Note: This is a permissive default; applications should set their own CSP header
    nginx.ingress.kubernetes.io/configuration-snippet: |
{% if rewrite %}
{% set rewrite_base = '' if rewrite == '/' else rewrite %}
      # path/rewrite_base zijn aan de bron charset-gevalideerd (_SAFE_PATH_PATTERN).
      rewrite "^{{ path }}/?(.*)$" "{{ rewrite_base }}/$1" break;
{% endif %}
      more_set_headers "X-Content-Type-Options: nosniff";
      more_set_headers "X-Frame-Options: DENY";
      more_set_headers "Referrer-Policy: strict-origin-when-cross-origin";
      more_set_headers "Permissions-Policy: geolocation=(), microphone=(), camera=()";
    # ============================================================
    # Certificate manager annotations
    # ============================================================
{% if issuer_name %}
    cert-manager.io/issuer: {{ issuer_name }}
{% elif cluster_issuer %}
    cert-manager.io/cluster-issuer: {{ cluster_issuer }}
{% endif %}
{% if issuer_name or cluster_issuer %}
    # Modern key material: ECDSA P-384, fresh key on every renewal (no RSA-2048 default).
    cert-manager.io/private-key-algorithm: ECDSA
    cert-manager.io/private-key-size: "384"
    cert-manager.io/private-key-rotation-policy: Always
{% endif %}
{% if external_dns_target %}
    # ============================================================
    # External-DNS target - overrides the default LB-status hostname
    # ============================================================
    external-dns.alpha.kubernetes.io/target: {{ (external_dns_target | default('', true)) | tojson }}
{% endif %}
{% set effective_service_name = service_name if service_name is defined and service_name else (name if name is defined else '') %}
spec:
  rules:
    - host: {{ (hostname | default('', true)) | tojson }}
      http:
        paths:
          - path: {{ (path | default('/', true)) | tojson }}
            pathType: Prefix
            backend:
              service:
                name: {{ effective_service_name | tojson }}
                port:
                  number: {{ service_port | default(80) }}
{% if enable_tls %}
  tls:
{% if provided_tls_secret %}
    # Own certificate provided by the customer (tls: provided); no cert-manager issuance.
    - hosts:
        - {{ (hostname | default('', true)) | tojson }}
      secretName: {{ provided_tls_secret | tojson }}
{% elif issuer_name or cluster_issuer %}
    - hosts:
        - {{ (hostname | default('', true)) | tojson }}
      secretName: {{ (tls_secret_name | default('', true)) | tojson }}
{% else %}
    - {}
{% endif %}
{% endif %}
