apiVersion: {{ api_version }}
kind: Organization
metadata:
  name: "{{ name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: "{{ name }}"
    app.kubernetes.io/component: image-registry
    created-by: operations-manager
spec:
  friendlyName: "{{ friendly_name }}"
  suffix: "{{ suffix }}"
  proxyCache:
    # yaml_scalar, want dit is de enige waarde in dit sjabloon die RECHTSTREEKS van de
    # afnemer komt: de andere lopen door sanitize_kubernetes_name. Zonder de filter breekt
    # een aanhalingsteken plus regeleinde uit de scalar en staan er extra DOCUMENTEN in het
    # bestand, die ArgoCD als gewone resources in de namespace aanmaakt.
    upstreamRegistry: {{ upstream | yaml_scalar }}
    {% if credentials_secret %}
    credentialsSecret:
      name: "{{ credentials_secret }}"
    {% endif %}
  robot:
    imagePullSecret:
      # Expliciet gezet: de operator leidt deze naam af ZONDER spec.suffix, en dan
      # botsen twee projecten met dezelfde upstream tenantbreed op een naam.
      name: "{{ pull_secret_name }}"
    rotation:
      # rotation.enabled: false doet niet wat de documentatie belooft -- het token krijgt
      # alsnog retentionDays en verloopt, zonder dat iemand het ververst. Dus altijd aan.
      enabled: true
      retentionDays: {{ rotation_days }}
