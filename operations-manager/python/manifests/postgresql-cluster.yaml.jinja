apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ (project_name ~ "-db") | yaml_scalar }}
  namespace: {{ infrastructure_namespace | yaml_scalar }}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  instances: {{ database_config.instances }}

  # PodDisruptionBudget (PDB) configuration
  # Kyverno policy 'pdb-cnpg-cluster-validation' requires enablePDB to be false
  # when instances < 2, as a PDB requires at least 2 pods to be meaningful.
  # A PDB with a single instance would prevent necessary operations like updates.
  {% if database_config.instances < 2 %}
  enablePDB: false
  {% endif %}

  imageName: {{ database_config.image | yaml_scalar }}
  {% if imagePullSecretsMap and database_config.image in imagePullSecretsMap %}
  # yaml_scalar: dezelfde secretnaam als in deployment.yaml.jinja, hier via de sleutel
  # 'registry' in de config van namespace-postgresql-database. Zie daar.
  imagePullSecrets:
    - name: {{ imagePullSecretsMap[database_config.image] | yaml_scalar }}
  {% endif %}
  primaryUpdateStrategy: unsupervised
  enableSuperuserAccess: true

  # Use custom superuser password
  superuserSecret:
    name: {{ (project_name ~ "-postgres-superuser") | yaml_scalar }}

  # Storage configuration
  storage:
    size: {{ database_config.storage | yaml_scalar }}
    storageClass: {{ storage_class }}

  # Resource limits
  resources:
    requests:
      memory: {{ database_config.resources.requests.memory | yaml_scalar }}
      cpu: {{ database_config.resources.requests.cpu | yaml_scalar }}
    limits:
      memory: {{ database_config.resources.limits.memory | yaml_scalar }}
      cpu: {{ database_config.resources.limits.cpu | yaml_scalar }}

  # Bootstrap initial database
  bootstrap:
    initdb:
      database: postgres
      owner: postgres
      secret:
        name: {{ (project_name ~ "-postgres-superuser") | yaml_scalar }}
      postInitApplicationSQL:
        - CREATE EXTENSION IF NOT EXISTS vector;
{% if database_config.postInitSQL %}
{% for sql in database_config.postInitSQL %}
        - {{ sql | yaml_scalar }}
{% endfor %}
{% endif %}

  # Enable monitoring
  monitoring:
    enablePodMonitor: true
