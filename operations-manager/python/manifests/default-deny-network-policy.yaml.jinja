kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: {{ name | yaml_scalar }}
  namespace: {{ namespace | yaml_scalar }}
{% if prune_disabled %}
  annotations:
    {# Namespace-breed en dus van de project-applicatie: zonder dit verwijdert de
       deployment-applicatie ze zodra ze uit haar eigen map verdwijnen (RC-503). #}
    argocd.argoproj.io/sync-options: Prune=false
{% endif %}
spec:
  # Namespace-breed en zonder regels: elke pod in deze namespace valt onder beleid,
  # ook een helm- of helmfile-pod zonder deployment-label. Wat wel mag staat in de
  # baselines ernaast; policies zijn additief, dus die openen wat hier dichtgaat.
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
