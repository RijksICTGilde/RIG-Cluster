{% if section == 'container' %}
        - name: authorization-wall
          image: quay.io/oauth2-proxy/oauth2-proxy:v7.7.1
          args:
            - --provider=oidc
            - {{ ("--oidc-issuer-url=" ~ authorization_wall.issuer_url) | tojson }}
            - {{ ("--client-id=" ~ authorization_wall.client_id) | tojson }}
            - {{ ("--upstream=http://localhost:" ~ application_port) | tojson }}
            - --http-address=0.0.0.0:4180
            - {{ ("--redirect-url=https://" ~ hostname ~ "/oauth2/callback") | tojson }}
{% if authorization_wall.authenticated_emails_configmap %}
            # Access gate: only emails in this file pass (e.g. the project's members).
            # Keycloak only authenticates; authorization happens here in the wall.
            - --authenticated-emails-file=/etc/oauth2-proxy/authenticated-emails/emails.txt
{% else %}
            - --email-domain=*
{% endif %}
            - --cookie-secure=true
            {# Lax en niet strict: Keycloak komt met een top-level redirect terug op
               /oauth2/callback, en strict houdt het cookie daar tegen. Expliciet, omdat
               de browser anders zelf kiest. #}
            - --cookie-samesite=lax
            {# Het cookie mag niet langer geldig beweren te zijn dan de Keycloak-sessie
               waarop het leunt. Projectrealms krijgen geen ssoSession*-waarden uit een
               blueprint, dus daar geldt Keycloak's eigen 10 uur; oauth2-proxy zou er
               zonder deze vlag 168 uur van maken. #}
            - --cookie-expire=10h
            {# Vernieuwen vóór de grens in plaats van erna. Zonder deze vlag vernieuwt de
               proxy pas als de sessie al verlopen is, en dan komen alle requests van één
               pagina tegelijk op een dode sessie aan en bieden ze allemaal hetzelfde
               refresh token aan. Keycloak roteert dat, dus er wint één en de rest krijgt
               een 403 met de inlogpagina als HTML. #}
            - --cookie-refresh=3m
            {# Een fetch() hoort een 401 te krijgen en geen redirect: een 302 naar Keycloak
               ketst cross-origin af op CORS en komt bij de applicatie aan als netwerkfout
               zonder statuscode. #}
            - --api-route=^/api/
            {# Hetzelfde voor statische bestanden, op extensie omdat de paden per applicatie
               verschillen. Zonder deze regel start elk sessieloos verzoek om een stylesheet
               of een icoon een eigen OAuth-flow bij Keycloak, terwijl de browser met het
               antwoord niets kan: HTML is geen CSS. #}
            - --api-route=\.(css|js|mjs|map|json|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|eot)$
            {# Blijft op false, dus een navigatie zonder sessie krijgt de inlogkaart. Die
               kaart is het enige dat --banner rendert, en vijf projecten gebruiken dat veld.
               Doorsturen naar Keycloak zou de bediener een klik schelen, maar dat is een
               aparte afweging over het tussenscherm: zie
               features/futures/authorization-wall-rolcontrole-in-de-proxy.md. #}
            - --skip-provider-button=false
            {# Parallelle aanvragen mogen elkaars inlogpoging niet slopen. Zonder deze vlag
               deelt oauth2-proxy één CSRF-cookie, dat een tweede gestarte flow overschrijft,
               waarna de callback van de eerste afketst met een 500. Twee tabbladen die
               binnen het kwartier beide op Inloggen drukken is genoeg. #}
            - --cookie-csrf-per-request=true
{% if authorization_wall.banner %}
            - {{ ("--banner=" ~ authorization_wall.banner) | tojson }}
{% endif %}
            - --custom-templates-dir=/etc/oauth2-proxy/templates
            # Require a verified email address: reject any token whose email_verified is not true.
            # Explicit (this is oauth2-proxy's default, but the security intent must be visible).
            - --insecure-oidc-allow-unverified-email=false
            - --scope=openid profile email
          env:
            - name: OAUTH2_PROXY_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ authorization_wall.keycloak_secret_name | tojson }}
                  key: OIDC_CLIENT_SECRET
            - name: OAUTH2_PROXY_COOKIE_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ authorization_wall.cookie_secret_name | tojson }}
                  key: cookie-secret
          ports:
            - containerPort: 4180
              name: oauth2-proxy
          volumeMounts:
            - name: oauth2-signin-templates
              mountPath: /etc/oauth2-proxy/templates
              readOnly: true
{% if authorization_wall.authenticated_emails_configmap %}
            - name: oauth2-authenticated-emails
              mountPath: /etc/oauth2-proxy/authenticated-emails
              readOnly: true
{% endif %}
          resources:
            requests:
              memory: "32Mi"
              cpu: "10m"
            limits:
              memory: "64Mi"
              cpu: "50m"
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          readinessProbe:
            httpGet:
              path: /ping
              port: 4180
            initialDelaySeconds: 3
            {# 2s: de sidecar moet ook Ready zijn voordat de pod meetelt; zelfde afweging
               als de readinessProbe in deployment.yaml.jinja. #}
            periodSeconds: 2
          livenessProbe:
            httpGet:
              path: /ping
              port: 4180
            initialDelaySeconds: 3
            periodSeconds: 30
{% elif section == 'volumes' %}
        - name: oauth2-signin-templates
          configMap:
            name: {{ (name ~ "-oauth2-signin") | tojson }}
{% if authorization_wall is defined and authorization_wall.authenticated_emails_configmap %}
        - name: oauth2-authenticated-emails
          configMap:
            name: {{ authorization_wall.authenticated_emails_configmap | tojson }}
{% endif %}
{% elif section == 'configmap' %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ (name ~ "-oauth2-signin") | tojson }}
  namespace: {{ namespace | tojson }}
  labels:
    app: {{ name | tojson }}
    project: {{ project.name | tojson }}
    component: application
{% for k, v in (extra_labels or {}).items() %}
    {{ k }}: {{ v | tojson }}
{% endfor %}
data:
  sign_in.html: |
    <!DOCTYPE html>
    <html lang="nl">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Inloggen</title>
        <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            body {
                font-family: 'RijksoverheidSansWebText', Verdana, Arial, sans-serif;
                background-color: #F1F5F9;
                color: #1E293B;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                padding: 1rem;
            }
            .card {
                background: #FFFFFF;
                border-radius: 4px;
                border: 1px solid #CBD5E1;
                padding: 2.5rem 2rem;
                max-width: 440px;
                width: 100%;
                text-align: center;
            }
            .card h1 {
                font-size: 1.25rem;
                font-weight: 700;
                color: #1E293B;
                margin-bottom: 0.75rem;
            }
            .card p {
                font-size: 0.95rem;
                color: #475569;
                line-height: 1.5;
                margin-bottom: 1.5rem;
            }
            .btn {
                display: inline-block;
                background-color: #007BC7;
                color: #FFFFFF;
                font-family: inherit;
                font-size: 1.125rem;
                font-weight: 700;
                border: 1px solid #007BC7;
                border-radius: 4px;
                padding: 0.625rem 1.5rem;
                cursor: pointer;
                text-decoration: none;
                transition: background-color 0.15s, border-color 0.15s;
            }
            .btn:hover, .btn:focus {
                background-color: #01689B;
                border-color: #01689B;
                outline: 2px solid #007BC7;
                outline-offset: 2px;
            }
            .subtitle {
                font-size: 0.875rem;
                color: #64748B;
                margin-top: 1.5rem;
            }
        </style>
    </head>
    <body>
        <div class="card">
            <h1>Deze website heeft beperkte toegang</h1>
            {{"{{"}} if .SignInMessage {{"}}"}}
            <p>{{"{{"}} .SignInMessage {{"}}"}}</p>
            {{"{{"}} else {{"}}"}}
            <p>Log in om verder te gaan.</p>
            {{"{{"}} end {{"}}"}}
            <form method="GET" action="{{"{{"}} .ProxyPrefix {{"}}"}}/start">
                <input type="hidden" name="rd" value="{{"{{"}} .Redirect {{"}}"}}">
                <button type="submit" class="btn">Inloggen</button>
            </form>
        </div>
    </body>
    </html>
{% endif %}
