{% include "widgets/service_help_modal.html.j2" %}

{# Generic Edit Section Modal #}
<div id="edit-section-backdrop" class="edit-section-backdrop" onclick="handleEditBackdropClick()"></div>
<div id="edit-section-modal" class="edit-section-modal" role="dialog" aria-modal="true" aria-labelledby="edit-section-title" data-project-name="{{ project.name }}">
    {# .edit-section-header was flex + space-between + align-items + gap: dat is
       <c-cluster justify="between">. De lijn eronder en de marge blijven in
       modal.css - daar heeft het thema niets voor. #}
    <c-cluster justify="between" align="center" class="edit-section-header">
        <c-heading type="h2"><c-icon icon="pencil-on-square" size="lg" color="donkerblauw"/><span id="edit-section-title-text"></span></c-heading>
        {% set lotc_onclick_1 %}closeEditModal(){% endset %}<c-button size="sm" label="Sluiten" show-icon="before" icon="dismiss" class="edit-modal-close-btn"/>
    </c-cluster>
    <div id="edit-section-error" class="edit-section-error is-hidden"></div>
    <div id="edit-section-inner">
        <div id="edit-section-content" class="edit-section-content">
            <div class="edit-section-loading">
                <p>Laden...</p>
            </div>
        </div>
        <div class="edit-section-actions" id="edit-section-actions">
            {% set lotc_onclick_2 %}closeEditModal(){% endset %}<c-button type="button" label="Annuleren"/>
            {% set lotc_onclick_3 %}submitEditModal(){% endset %}<c-button type="button" label="Opslaan"/>
        </div>
    </div>
</div>

