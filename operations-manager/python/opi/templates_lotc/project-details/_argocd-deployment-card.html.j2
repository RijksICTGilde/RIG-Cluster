{#
  ArgoCD status card for a single deployment.
  Expects these variables to be set before include:
    - deployment: the deployment object
    - argocd_status: dict of deployment_name -> status
    - current_cluster: current cluster name
    - project: the project object
    - deployment_states: dict of deployment_name -> DeploymentState (opi.services.deployment_state)
  Optional:
    - _argocd_card_id_prefix: prefix for error toggle IDs (default: deployment.name)
#}
{% set status = argocd_status.get(deployment.name, {}) %}
{% set health = status.get('health', 'Unknown') %}
{% set sync = status.get('sync', 'Unknown') %}
{% set errors = status.get('errors', []) %}
{% set has_errors = errors|length > 0 %}
{% set _id_prefix = _argocd_card_id_prefix | default(deployment.name) %}
{# Components auto-disabled (replicas 0) by the OOM/image-pull watcher or sanitize pass.
   The flag is written inline per deployment-component (comp.disabled + comp.disabled-reason);
   these carry the reason and drive the per-component alerts below. #}
{% set disabled_components = deployment.components | selectattr('disabled') | list if deployment.components else [] %}
{# Whether this card gets to show ArgoCD's badges at all. Computed up front because the
   switched-off chip in the header only has to appear when the badge row does not (RC-31):
   otherwise the same word would stand twice on one card. #}
{% set has_image = deployment.components | selectattr('image', 'defined') | selectattr('image') | list | length > 0 if deployment.components else false %}
{% set shows_argocd_status = has_image and deployment.cluster == current_cluster %}
{# What the services report about this deployment (RC-35). The card names no service: it
   reads the badges the facts carry, so switched off, asleep, and whatever parks a
   deployment next all arrive here the same way. #}
{% set deployment_state = (deployment_states | default({})).get(deployment.name) %}
{% set state_badges = deployment_state.replacing_badges if deployment_state else [] %}
{% set accompanying_badges = deployment_state.accompanying_badges if deployment_state else [] %}
{% set expects_no_pods = deployment_state.expects_no_application_pods if deployment_state else false %}
{# A state badge takes the place of exactly one verdict: the green Healthy that zero
   replicas produce. Every other verdict -- Degraded, Progressing, Unknown -- is something
   ArgoCD really observed and keeps its badge, or switching a component off would hide a
   real failure. #}
{% set state_replaces_health = state_badges and health == 'Healthy' %}

<c-card padding="lg" outline="true" background-color="grijs-050">
    <c-layout-flow gap="md">
        {# Deployment Header #}
        <c-cluster gap="sm">
            <c-icon icon="rectangle-stack" size="md" color="donkerblauw"/>
            <c-heading type="h4" label="{{ deployment.name }}"/>
            <span class="argo-card__cluster">{{ deployment.cluster }}</span>
            {# A badge that does not replace the health verdict belongs here: something is
               still serving traffic, so the health badge stays and this says what else is
               true. A replacing badge only needs a chip here when there is no badge row
               below to carry it, or the same word would stand twice on one card. #}
            {% for badge in accompanying_badges %}
            <span class="argo-card__chip argo-card__chip--accompanying">
                <c-icon icon="moon" size="sm"/>{{ badge }}
            </span>
            {% endfor %}
            {% if not shows_argocd_status %}
            {% for badge in state_badges %}
            <span class="argo-card__chip argo-card__chip--state">
                <c-icon icon="moon" size="sm"/>{{ badge }}
            </span>
            {% endfor %}
            {% endif %}
        </c-cluster>

        {# Auto-disabled components: an error alert per component. The full technical
           reason (a long ImagePullBackOff dump) is tucked into a collapsible details
           so the alert stays readable; the image reference is the actionable bit. #}
        {% if disabled_components %}
        {% for comp in disabled_components %}
        {% set reason = comp['disabled-reason'] | default('') %}
        {% set is_image = 'ImagePull' in reason or 'InvalidImageName' in reason or 'manifest' in reason %}
        <c-alert heading="{{ comp.reference }} is uitgeschakeld{% if is_image %}: image ontbreekt{% endif %}">
            <c-layout-flow gap="sm">
                {% if comp.image %}
                <span class="rvo-text--sm">De container image kon niet worden opgehaald:<br /><code class="argo-card__image-ref">{{ comp.image }}</code></span>
                {% endif %}
                <span class="rvo-text--sm">Push een geldige image of deploy opnieuw met een bestaande tag om automatisch te heractiveren.</span>
                {% if reason %}
                <details>
                    <summary class="rvo-text--xs rvo-text--subtle argo-card__summary">Technische details</summary>
                    <p class="rvo-text--xs rvo-text--subtle argo-card__reason">{{ reason }}</p>
                </details>
                {% endif %}
            </c-layout-flow>
        </c-alert>
        {% endfor %}
        {% endif %}

        {% if not has_image %}
        {# No components have images - deployment has no resources #}
        <c-card padding="md" background-color="grijs-100" outline="true">
            <c-cluster gap="sm">
                <c-icon icon="info" size="md" color="grijs-600"/>
                <c-layout-flow gap="xs">
                    <span class="rvo-text--sm">Geen actieve deployment - geen container image geconfigureerd.</span>
                    <span class="rvo-text--sm rvo-text--subtle">Configureer een container image voor een component om deze deployment te activeren.</span>
                </c-layout-flow>
            </c-cluster>
        </c-card>
        {% elif deployment.cluster != current_cluster %}
        {# Deployment is on a different cluster - show info message #}
        <div class="argo-card__other-cluster">
            <c-icon icon="info" size="md" color="grijs-600"/>
            <div>
                <span class="rvo-text--sm">Deze deployment draait op cluster <strong>{{ deployment.cluster }}</strong>.</span>
                <br />
                <span class="rvo-text--sm rvo-text--subtle">ArgoCD status is alleen beschikbaar vanaf de Operations Manager van dat cluster.</span>
            </div>
        </div>
        {% else %}
        {# Deployment is on current cluster - show ArgoCD status #}
        {# Status Badges Row.

           De badges waren <span class="argo-badge argo-badge--degraded"> met een eigen
           kleurenset in project-details.css: elf selectors voor wat in feite vier verdicten
           zijn. Dat is <c-tag>, waar het TYPE de kleur bepaalt. bg/_argocd-deployment-card
           deed het al zo, met dezelfde afbeelding van verdict op kleur.

           De iconen in de badges zijn vervallen. <c-tag> heeft geen icoonstand, en het icoon
           herhaalde alleen wat de tekst al zei - een schermlezer las de klasse toch al niet.
           De KLEUR blijft het verschil dragen, en die komt nu van het thema.

           .argo-card__badges (flex met een gat) is <c-cluster gap="xs">. #}
        <c-cluster gap="xs" align="center">
            {# State badges (RC-31, generic since RC-35). A deployment that is off or asleep
               has zero replicas and ArgoCD calls that Healthy; the green badge is the
               sentence the user reads to know whether things are going well, and it was
               untrue. So this takes its place -- but only when health has nothing else to
               report: a deployment that is off AND degraded shows both, or switching
               something off would hide a real failure. #}
            {% for badge in state_badges %}
            <c-tag type="info" label="{{ badge }}"/>
            {% endfor %}

            {% if not state_replaces_health %}
            <c-tag type="{{ 'success' if health == 'Healthy' else 'warning' if health == 'Progressing' else 'error' }}"
                   label="{{ health }}"/>
            {% endif %}

            {# Sync Badge. Unknown means ArgoCD cannot compare desired vs live state (often a
               render/CMP error) - show it red, not neutral grey, so it does not read as
               "still working on it". #}
            <c-tag type="{{ 'success' if sync == 'Synced' else 'warning' if sync == 'OutOfSync' else 'error' if sync == 'Unknown' else 'default' }}"
                   label="{{ sync }}"/>

            {% if status.get('revision') %}
            <c-tag type="default" label="{{ status.revision }}"/>
            {% endif %}
        </c-cluster>

        {# Last Sync Time #}
        {% if status.get('last_sync') %}
        <c-cluster gap="xs">
            <c-icon icon="timer" size="sm" color="grijs-600"/>
            <span class="rvo-text--sm rvo-text--subtle">Laatste sync: {{ status.last_sync | dutch_date }}</span>
        </c-cluster>
        {% endif %}

        {# Logs, but only while something runs. A sleeping or switched-off deployment has
           no pods and therefore no logs; offering the button suggests it has. The flag
           comes from the same service facts the badges do, so a second service that parks
           a deployment gets this for free. #}
        {% if deployment.components and not expects_no_pods %}
        {# De knop is een <c-button>. Wat hier stond was een kale <button> met
           .log-viewer-btn erop: een blauw vlak met witte tekst, uit project-details.css,
           dus een met de hand nagebouwde knop. Die klasse bestaat niet meer; de knop in
           bg/_argocd-deployment-card.html.j2 - degene die een gebruiker ziet - liet hem
           al vallen. #}
        <div class="argo-card__logs">
            {% set logs_js = ('openLogViewer('
                ~ (project.name | tojson) ~ ', '
                ~ (deployment.name | tojson) ~ ', '
                ~ (deployment.components[0].reference | tojson) ~ ', '
                ~ (deployment.components | tojson) ~ ')') | forceescape %}
            <c-button type="secondary"
                      size="sm"
                      label="Logs bekijken"
                      icon="file-text"
                      :attrs="{'onclick': logs_js, 'title': 'Bekijk live logs voor deze deployment'}" />
        </div>
        {% endif %}

        {# Operation Status (if running or failed) #}
        {% if status.get('operation_phase') and status.operation_phase not in ['Succeeded', None] %}
        {% set op_modifier = 'running' if status.operation_phase == 'Running' else 'other' %}
        <div class="argo-operation argo-operation--{{ op_modifier }}">
            <c-icon icon="{% if status.operation_phase == 'Running' %}klok{% elif status.operation_phase == 'Failed' %}foutmelding{% else %}info{% endif %}" size="sm"/>
            <span>Operatie: {{ status.operation_phase }}</span>
            {% if status.get('operation_message') %}
            <span class="rvo-text--sm"> - {{ status.operation_message[:100] }}{% if status.operation_message|length > 100 %}...{% endif %}</span>
            {% endif %}
        </div>
        {% endif %}

        {# Errors Section (Expandable) #}
        {% if has_errors %}
        {% set real_errors = errors | rejectattr('orphaned') | list %}
        {% set orphan_errors = errors | selectattr('orphaned') | list %}
        {% if real_errors %}
        <div>
            <button type="button" onclick="toggleArgoErrors('{{ _id_prefix }}')" aria-expanded="false"
                    class="argo-errors__toggle">
                <c-icon icon="exclamation-triangle" size="sm" color="rood"/>
                <span>{{ real_errors|length }} {% if real_errors|length == 1 %}probleem{% else %}problemen{% endif %} gevonden</span>
                <c-icon icon="caret-down" size="sm"/>
            </button>
            <div id="argocd-errors-{{ _id_prefix }}" class="argo-errors__panel">
                {% for error in real_errors %}
                <div class="argo-errors__item{% if not loop.last %} argo-errors__item--divided{% endif %}">
                    <c-cluster gap="xs">
                        {% if error.get('severity') == 'informational' %}
                        <c-icon icon="info" size="sm" color="grijs-600"/>
                        {% else %}
                        <c-icon icon="exclamation-triangle" size="sm" color="rood"/>
                        {% endif %}
                        <strong class="argo-errors__resource">{{ error.resource }}{% if error.get('count') and error.count|int > 1 %} <span class="rvo-text--xs rvo-text--subtle">({{ error.count }}x)</span>{% endif %}</strong>
                    </c-cluster>
                    <p class="argo-errors__message">{{ error.message }}</p>
                    {% if error.get('suggestion') %}
                    <p class="argo-errors__suggestion">{{ error.suggestion }}</p>
                    {% endif %}
                    {% if error.get('original_message') %}
                    <details class="argo-errors__original">
                        <summary class="rvo-text--xs rvo-text--subtle argo-card__summary">Origineel bericht</summary>
                        <p class="rvo-text--xs rvo-text--subtle argo-errors__original-text">{{ error.original_message }}</p>
                    </details>
                    {% endif %}
                    {% if error.get('age') %}
                    <p class="rvo-text--xs rvo-text--subtle argo-errors__age">{{ error.age }}</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% if orphan_errors %}
        <div class="argo-orphans">
            <c-cluster gap="xs">
                <c-icon icon="info" size="sm" color="grijs-600"/>
                <span class="rvo-text--sm rvo-text--subtle">{{ orphan_errors|length }} {% if orphan_errors|length == 1 %}melding{% else %}meldingen{% endif %} van verwijderde componenten &mdash; opruiming nog niet voltooid</span>
            </c-cluster>
            {% for error in orphan_errors %}
            <p class="rvo-text--xs rvo-text--subtle argo-orphans__item">
                <strong>{{ error.resource }}</strong>: {{ error.message }}{% if error.get('age') %} ({{ error.age }}){% endif %}
            </p>
            {% endfor %}
        </div>
        {% endif %}
        {% endif %}
        {% endif %}{# close: not has_image / different cluster / current cluster #}
    </c-layout-flow>
</c-card>
