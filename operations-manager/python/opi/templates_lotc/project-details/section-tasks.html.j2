{# Tasks/runs table fragment (lazy-loaded into the Taken tab).
   Expects: project_name, items (normalized rows: console/job runs + background
   tasks like upserts/refreshes), newest first. #}
{# Self-polling wrapper: refreshes every 5s while present in the DOM. The Taken tab loads this
   fragment when opened and clears its slot when left, so htmx polls only while the tab is open. #}
<div hx-get="/projects/{{ project_name }}/tasks" hx-trigger="every 5s" hx-swap="outerHTML">
<c-card outline="true" padding="lg" background-color="wit">
    <c-layout-flow gap="md">
        <c-heading type="h2" class="section-heading">
            <c-icon icon="timer" size="xl" color="hemelblauw"/>Taken
        </c-heading>
        {% if not items %}
        <c-paragraph>Er zijn nog geen taken uitgevoerd voor dit project.</c-paragraph>
        {% else %}
        {# Was een kale <table class="backup-table tasks-table"> met eigen randen en
           kopregelopmaak. Dat is <c-table>; onder NLDD is dat een CSS-grid, dus de
           kolombreedtes moeten mee - de ruimte gaat naar soort en deployment, waar de
           langste teksten staan. bg/_tasks.html.j2 deed het al zo.

           De status is een <c-tag>: de kleur volgt de betekenis in plaats van gewone
           tekst te zijn. #}
        <c-table columns="2fr 2fr 1fr 2fr 1fr 1fr">
            <c-table-head>
                <c-th>Soort</c-th>
                <c-th>Deployment</c-th>
                <c-th>Status</c-th>
                <c-th>Door</c-th>
                <c-th>Gestart</c-th>
                <c-th>Be&euml;indigd</c-th>
            </c-table-head>
            {% for item in items %}
            <c-table-row>
                <c-td>{{ item.soort }}</c-td>
                <c-td>{{ item.deployment or "-" }}</c-td>
                <c-td>
                    <c-stack gap="xs">
                        <c-tag label="{{ item.status }}"
                               type="{{ 'success' if item.status in ('Succeeded', 'completed') else 'error' if item.status in ('Failed', 'failed') else 'warning' if item.status in ('Running', 'running') else 'default' }}"/>
                        {% if item.active and item.step %}
                        <c-paragraph size="sm">{{ item.step }}{% if item.progress %} ({{ item.progress }}%){% endif %}</c-paragraph>
                        {% endif %}
                    </c-stack>
                </c-td>
                <c-td>{{ item.door or "-" }}</c-td>
                <c-td>{{ (item.gestart or "")[:16] | replace("T", " ") }}</c-td>
                <c-td>{{ ((item.beeindigd or "")[:16] | replace("T", " ")) if item.beeindigd else "-" }}</c-td>
            </c-table-row>
            {% endfor %}
        </c-table>
        {% endif %}
    </c-layout-flow>
</c-card>
</div>
