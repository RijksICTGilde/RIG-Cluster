{# Services & Integraties Section #}
<c-card outline="true" padding="xl" background-color="wit">
    <c-layout-flow gap="lg">
        <c-layout-flow row="true" justify-content="space-between" align-items="center">
            <c-heading type="h2"><c-icon icon="applicatie" size="xl" color="groen"/>Services & Integraties</c-heading>
            {% if user_role in ["admin", "owner"] %}
            {% set lotc_onclick_1 %}openEditModal('modal-edit-services', 'Services beheren'){% endset %}<c-button size="sm" label="Bewerken" show-icon="before" icon="bewerken"/>
            {% endif %}
        </c-layout-flow>
        <p>Geactiveerde services voor dit project</p>

        {% if project.services %}
        <c-grid columns="three" gap="lg">
            {% for service in project.services %}
            <c-card class="service-detail-card" padding="lg" background-color="wit" outline="true">
                <c-layout-flow gap="md">
                    <div class="service-header">
                        {% set service_def = ServiceAdapter.get_service_definition(service.enum) %}
                        <div>
                            <c-heading type="h3"><c-icon icon="{{ service_def.icon }}" size="xl" color="{{ service_def.color }}"/>{{ service_def.name }}</c-heading>
                            <div class="service-scope">{{ service_binding_label(service.enum) }}</div>
                        </div>
                    </div>
                    <p>{{ service_def.description }}</p>
                    {% set config_hint = service_config_hint(service.enum) %}
                    {% if config_hint %}
                    <p>{{ config_hint }}</p>
                    {% endif %}
                    {% if user_role in ["admin", "owner"] and service.value in service_config_sections %}
                    {% set lotc_onclick_2 %}openEditModal('{{ service_config_sections[service.value] }}', '{{ service_def.name }} configuratie'){% endset %}<c-button label="Configureer" size="sm" icon="bewerken"/>
                    {% endif %}
                </c-layout-flow>
            </c-card>
            {% endfor %}
        </c-grid>
        {% else %}
        <c-alert>Geen services geconfigureerd</c-alert>
        {% endif %}
    </c-layout-flow>
</c-card>
