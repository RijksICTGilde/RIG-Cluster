{# Deployments Section - one card per deployment, no outer wrapper.
   Display alphabetically; keep the original YAML index for edit-modal flow_ids. #}
{% if project.deployments %}
    {% for deployment in project.deployments | sort(attribute='name') %}
    {% set original_index = project.deployments.index(deployment) %}
    <div class="deployment-section{% if not loop.first %} is-hidden{% endif %}" id="deployment-{{ deployment.name }}">
    <c-card class="deployment-card" padding="lg" background-color="grijs-050" outline="true">
        <c-layout-flow gap="md">
            <div class="deployment-header">
                <div>
                    <c-heading type="h3">Deployment: {{ deployment.name }}</c-heading>
                </div>
                <div class="deployment-actions">
                    {% if user_role in ['admin', 'owner'] %}
                    {% set lotc_onclick_1 %}openEditModal('modal-edit-deployment-{{ original_index }}', 'Deployment bewerken - {{ deployment.name }}'){% endset %}<c-button size="sm" label="Bewerken" show-icon="before" icon="bewerken"/>
                    {% set lotc_onclick_2 %}openEditModal('modal-edit-domain-{{ original_index }}', 'Webadres bewerken - {{ deployment.name }}'){% endset %}<c-button size="sm" label="Webadres" show-icon="before" icon="wereldbol"/>
                    {% set lotc_onclick_3 %}openServiceModal('/projects/{{ project.name }}/actions/delete-deployment/confirm?target={{ deployment.name | urlencode }}', 'Deployment verwijderen'){% endset %}<c-button size="sm" label="Verwijderen" show-icon="before" icon="verwijderen"/>
                    {% endif %}
                </div>
            </div>

            {# Ungranted approvals, as reported by the owning service #}
            {% for notice in approval_notices.get(deployment.name, []) %}
            <c-alert>
                {{ notice.text }}
                {% if notice.by %}<br />Besluit door {{ notice.by }}{% if notice.date %} op {{ notice.date | dutch_date(include_time=False) }}{% endif %}.{% endif %}
                {% if notice.message %}<br />Toelichting: {{ notice.message }}{% endif %}
            </c-alert>
            {% endfor %}

            {# Components in this deployment #}
            {% if deployment.components %}
            <div class="deployment-components">
                <c-heading type="h4" label="Components"/>
                <div class="component-list">
                    {% for component in deployment.components | sort(attribute='reference') %}
                    <div class="component-item">
                        <c-icon icon="puzzel" size="md" color="donkerblauw"/>
                        <div class="component-details">
                            <div class="component-name">{{ component.reference }}</div>
                            {% if component.image %}
                            <div class="component-image">{{ component.image }}</div>
                            {% else %}
                            <div class="component-image">Geen container image geconfigureerd - dit component wordt niet gedeployd</div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Helm Charts in this deployment #}
            {% if deployment.get('helm-charts') %}
            <div class="deployment-helm-charts section-divider">
                <c-heading type="h4"><c-icon icon="applicatie" size="md" color="groen"/>Helm Charts</c-heading>
                <c-layout-flow gap="md">
                    {% for helm_chart in deployment.get('helm-charts', []) %}
                    <c-card padding="md" background-color="wit" outline="true">
                        <c-layout-flow gap="sm">
                            <c-layout-flow row="true" align-items="center" gap="sm">
                                <c-icon icon="applicatie" size="sm" color="groen"/>
                                <strong>{{ helm_chart.reference }}</strong>
                            </c-layout-flow>
                            {% if helm_chart.get('helm-values') and helm_chart['helm-values'] is mapping %}
                            <div class="helm-values-section">
                                <c-layout-flow row="true" align-items="center" gap="sm" class="section-subheader">
                                    <c-icon icon="sleutel" size="sm" color="hemelblauw"/>
                                    <span class="text-strong">Helm Values</span>
                                    <span class="env-vars-count-badge">{{ helm_chart['helm-values']|length }} waarde{% if helm_chart['helm-values']|length != 1 %}n{% endif %}</span>
                                </c-layout-flow>
                                <c-secret-field value="{{ helm_chart['helm-values'] | tojson(indent=2) }}"/>
                            </div>
                            {% endif %}
                        </c-layout-flow>
                    </c-card>
                    {% endfor %}
                </c-layout-flow>
            </div>
            {% endif %}

            {# Helmfile in this deployment #}
            {% if deployment.get('helmfile') %}
            <div class="deployment-helmfile section-divider">
                <c-heading type="h4"><c-icon icon="applicatie" size="md" color="oranje"/>Helmfile</c-heading>
                <c-layout-flow gap="md">
                    {% for helmfile in deployment.get('helmfile', []) %}
                    <c-card padding="md" background-color="wit" outline="true">
                        <c-layout-flow gap="sm">
                            <c-layout-flow row="true" align-items="center" gap="sm">
                                <c-icon icon="applicatie" size="sm" color="oranje"/>
                                <strong>{{ helmfile.reference }}</strong>
                            </c-layout-flow>
                            {% if helmfile.get('helm-values') and helmfile['helm-values'] is mapping %}
                            <div class="helm-values-section">
                                <c-layout-flow row="true" align-items="center" gap="sm" class="section-subheader">
                                    <c-icon icon="sleutel" size="sm" color="hemelblauw"/>
                                    <span class="text-strong">Helm Values</span>
                                    <span class="env-vars-count-badge">{{ helmfile['helm-values']|length }} waarde{% if helmfile['helm-values']|length != 1 %}n{% endif %}</span>
                                </c-layout-flow>
                                <c-secret-field value="{{ helmfile['helm-values'] | tojson(indent=2) }}" value-type="json" content-width="lg"/>
                            </div>
                            {% endif %}
                        </c-layout-flow>
                    </c-card>
                    {% endfor %}
                </c-layout-flow>
            </div>
            {% endif %}

            {# Public ingress links for this deployment #}
            {% if deployment.ingress_links %}
            <c-layout-flow gap="sm">
                <c-heading type="h4"><c-icon icon="externe-link" size="md" color="hemelblauw"/>Publieke links</c-heading>
                <c-layout-flow gap="sm">
                    {% for link in deployment.ingress_links %}
                    {% set lotc_onclick_4 %}window.open(this.dataset.url, '_blank'){% endset %}<c-button label="{{ link.component_name }}{% if link.path and link.path != '/' %} {{ link.path }}{% endif %}" size="sm" show-icon="after" icon="externe-link"/>
                    {% endfor %}
                </c-layout-flow>
            </c-layout-flow>
            {% endif %}

            {# Deployment Configuration Variables - hidden while determining approach for secret display #}

            {# User Configuration Variables for components in this deployment #}
            {% set deployment_components = deployment.components | sort(attribute='reference') %}
            {% if deployment_components %}
            {% set has_user_vars = false %}
            {% for component in deployment_components %}
                {% for project_component in project.components %}
                    {% if project_component.name == component.reference and project_component.get('user-env-vars') %}
                        {% set has_user_vars = true %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            {% if has_user_vars %}
            <div class="section-divider">
                <c-heading type="h4"><c-icon icon="user" size="md" color="donkerblauw"/>Gebruikers configuratie</c-heading>
                <p>Gebruiker-specifieke omgevingsvariabelen voor deze deployment</p>

                <c-layout-flow gap="md">
                    {% for component in deployment_components %}
                    {% for project_component in project.components %}
                    {% if project_component.name == component.reference and project_component.get('user-env-vars') %}
                    <c-card padding="sm" background-color="grijs-050" outline="true">
                        <c-layout-flow gap="md">
                            <c-cluster gap="sm">
                                <c-icon icon="puzzel" size="sm" color="donkerblauw"/>
                                <c-heading type="h5" label="Component: {{ component.reference }}"/>
                            </c-cluster>

                            <c-layout-flow gap="sm">
                                {% for key, value in project_component['user-env-vars'].items() %}
                                <c-card padding="sm" background-color="wit" outline="true">
                                    <c-layout-flow gap="xs">
                                        <c-layout-flow row="true" align-items="center" gap="sm">
                                            <c-icon icon="sleutel" size="sm" color="grijs-600"/>
                                            <span class="text-strong">{{ key }}</span>
                                        </c-layout-flow>
                                        <div class="indent-lg">
                                            <c-secret-field value="{{ value }}"/>
                                        </div>
                                    </c-layout-flow>
                                </c-card>
                                {% endfor %}
                            </c-layout-flow>
                        </c-layout-flow>
                    </c-card>
                    {% endif %}
                    {% endfor %}
                    {% endfor %}
                </c-layout-flow>
            </div>
            {% endif %}
            {% endif %}
        </c-layout-flow>
    </c-card>
    </div>
    {% endfor %}
{% else %}
<c-alert>Geen deployments geconfigureerd</c-alert>
{% endif %}
