{# Skeleton placeholder shown while an ArgoCD status card lazy-loads.
   Mimics the silhouette of _argocd-deployment-card.html.j2: header row,
   status badges, sync line and logs button. Styles in project-details.html.j2. #}
<div class="argocd-skeleton" role="status" aria-label="ArgoCD status wordt geladen">
    <div class="argocd-skeleton__row">
        <span class="argocd-skeleton__bone argocd-skeleton__bone--avatar"></span>
        <span class="argocd-skeleton__bone argocd-skeleton__bone--title"></span>
        <span class="argocd-skeleton__bone argocd-skeleton__bone--chip"></span>
    </div>
    <div class="argocd-skeleton__row">
        <span class="argocd-skeleton__bone argocd-skeleton__bone--badge"></span>
        <span class="argocd-skeleton__bone argocd-skeleton__bone--badge-short"></span>
    </div>
    <span class="argocd-skeleton__bone argocd-skeleton__bone--meta"></span>
    <span class="argocd-skeleton__bone argocd-skeleton__bone--button"></span>
</div>
