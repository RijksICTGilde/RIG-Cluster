{# Project-wide resource total, the first card on the page. Deployments (and every
   PR environment) share a namespace, so the per-deployment metrics never add up to
   the project's real footprint; this does. Loaded on its own request so a slow or
   absent Prometheus never holds up the page. #}
<c-card outline="true" padding="lg" background-color="wit">
    <c-layout-flow gap="md">
        <c-heading type="h3"><c-icon icon="grafiek" size="lg" color="donkerblauw"/>Resourcegebruik (heel project)</c-heading>
        <div hx-get="/projects/details/{{ project.name }}/resource-usage"
             hx-trigger="intersect once" hx-swap="innerHTML">
            <div class="argocd-skeleton" role="status" aria-label="Resourcegebruik wordt geladen">
                <span class="argocd-skeleton__bone argocd-skeleton__bone--label"></span>
                <span class="argocd-skeleton__bone argocd-skeleton__bone--line"></span>
                <span class="argocd-skeleton__bone argocd-skeleton__bone--line"></span>
            </div>
        </div>
    </c-layout-flow>
</c-card>
