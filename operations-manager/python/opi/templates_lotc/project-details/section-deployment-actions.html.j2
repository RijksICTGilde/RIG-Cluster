{# Deployment Actions Section - quick actions per deployment #}
{% set deployment_service_actions = deployment_service_actions | default({}) %}
{% if user_role in ["admin", "owner"] and project.deployments %}
    {% for deployment in project.deployments | sort(attribute='name') %}
    {% set original_index = project.deployments.index(deployment) %}
    <div class="deployment-section{% if not loop.first %} is-hidden{% endif %}" id="deployment-actions-{{ deployment.name }}">
    <c-card outline="true" padding="lg" background-color="wit">
        <c-layout-flow gap="md">
            <c-heading type="h2" class="section-heading"><c-icon icon="instellingen" size="xl" color="hemelblauw"/>Acties</c-heading>
            <c-cluster gap="sm">
                <c-button label="Images bewerken" size="sm" show-icon="before" icon="bewerken" @/>
                <c-button label="Deployment herverwerken" size="sm" show-icon="before" icon="refresh" @/>
                {# Service-contributed action buttons: the database console and the job
                   runner (both PostgreSQL services), sleep-mode's wake/sleep toggle. A
                   service owns its own button via ServiceDefinition.actions_provider,
                   so this template holds no service name and no condition of its own.
                   An action either opens the shared modal shell on a fragment URL, or
                   POSTs to an endpoint -- and then it asks first, in that same shell:
                   the confirm fragment re-derives the action server-side from its key
                   and renders the POST button, so no endpoint travels through the URL. #}
                {# The two branches repeat the whole button on purpose: a {% if %} INSIDE a
                   ROOS component tag is not valid there -- the component preprocessor
                   reads the tag before Jinja does and the page 500s. #}
                {% for action in deployment_service_actions.get(deployment.name, []) if action.visible %}
                {% if action.modal_endpoint %}
                <c-button label="{{ action.label }}" size="sm" show-icon="before" icon="{{ action.icon }}" @/>
                {% else %}
                <c-button label="{{ action.label }}" size="sm" show-icon="before" icon="{{ action.icon }}" @/>
                {% endif %}
                {% endfor %}
            </c-cluster>
        </c-layout-flow>
    </c-card>
    </div>
    {% endfor %}
{% endif %}
