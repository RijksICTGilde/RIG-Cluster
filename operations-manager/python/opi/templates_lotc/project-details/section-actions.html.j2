    <c-layout-flow gap="md">
        <c-heading type="h2" class="section-heading"><c-icon icon="instellingen" size="xl" color="hemelblauw"/>Acties</c-heading>
        <c-cluster gap="sm">
            <c-button label="Deployment toevoegen" size="sm" show-icon="before" icon="plus" @/>
