{# Components Section #}
{% from "widgets/_macros.html.j2" import service_block %}
<c-card outline="true" padding="xl" background-color="wit">
    <c-layout-flow gap="lg">
        <c-layout-flow row="true" justify-content="space-between" align-items="center">
            <c-heading type="h2"><c-icon icon="puzzle-piece" size="xl" color="donkerblauw"/>Components</c-heading>
            {% if user_role in ["admin", "owner"] %}
            {% set lotc_onclick_1 %}openEditModal('modal-edit-component-{{ project.components|length if project.components else 0 }}', 'Component toevoegen'){% endset %}<c-button size="sm" label="Toevoegen" show-icon="before" icon="plus"/>
            {% endif %}
        </c-layout-flow>
        <p>Applicatie componenten en hun configuratie</p>

        {% if project.components %}
        <c-layout-flow gap="lg">
            {# Display alphabetically; keep the original YAML index for edit-modal flow_ids. #}
            {% for component in project.components | sort(attribute='name') %}
            {% set original_index = project.components.index(component) %}
            <c-card class="component-card" padding="lg" background-color="wit" outline="true">
                <c-layout-flow gap="md">
                    <div class="component-header">
                        <c-icon icon="puzzle-piece" size="lg" color="donkerblauw"/>
                        <div class="flex-1">
                            <c-heading type="h3" label="{{ component.name }}"/>
                            <div class="component-type">{{ component.type|title }}</div>
                        </div>
                        {% if user_role in ["admin", "owner"] %}
                        <c-layout-flow row="true" gap="xs">
                            {% set lotc_onclick_2 %}openEditModal('modal-edit-component-{{ original_index }}', 'Component bewerken - {{ component.name }}'){% endset %}<c-button size="sm" label="Bewerken" show-icon="before" icon="pencil-on-square"/>
                            {% set lotc_onclick_3 %}openServiceModal('/projects/{{ project.name }}/actions/delete-component/confirm?target={{ component.name | urlencode }}', 'Component verwijderen'){% endset %}<c-button size="sm" label="Verwijderen" show-icon="before" icon="trash"/>
                        </c-layout-flow>
                        {% endif %}
                    </div>

                    <div class="component-specs">
                        {% if component.ports %}
                        <div class="spec-item">
                            <strong>Poorten:</strong>
                            {% if component.ports.inbound %}Inbound: {{ component.ports.inbound|join(", ") }}{% endif %}
                            {% if component.ports.outbound %}{% if component.ports.inbound %} | {% endif %}Outbound: {{ component.ports.outbound|join(", ") }}{% endif %}
                        </div>
                        {% endif %}

                        {% if component.resources %}
                        <div class="spec-item">
                            <strong>Resources:</strong>
                            {% set req = component.resources.get('requests', {}) or {} %}
                            {% set lim = component.resources.get('limits', {}) or {} %}
                            {% if req.get('memory') or lim.get('memory') %}
                                Memory: {{ req.get('memory', '?') }} / {{ lim.get('memory', '?') }}
                            {% elif component.resources.memory is string %}
                                Memory: {{ component.resources.memory }}
                            {% endif %}
                            {% if req.get('cpu') or lim.get('cpu') %}
                                | CPU: {{ req.get('cpu', '?') }} / {{ lim.get('cpu', '?') }}
                            {% elif component.resources.cpu is string %}
                                | CPU: {{ component.resources.cpu }}
                            {% endif %}
                        </div>
                        {% endif %}

                        {% if component.services %}
                        <div class="spec-item">
                            <strong>Services:</strong>
                            {# The same block as the wizard's service picker and the service
                               overview page: icon, name, description and the question mark with
                               the explanation. This used to be a line of raw names, so the same
                               service looked like something else here than where it was chosen.
                               Both filters are format-agnostic: an entry is a string,
                               ``{naam: {...}}`` or ``{"reference": ..., "config": ...}``. #}
                            {# Zelfde raster als bij de dienstkaarten: <c-auto-grid min="300px">. #}
                            <c-auto-grid min="300px" gap="md" class="service-cards-grid">
                                {% for svc in component.services %}
                                {% set definition = svc|service_definition %}
                                <div class="service-card service-card--static">
                                    <div class="service-card__content">
                                        {% if definition %}
                                        {{ service_block(definition.name, definition.description, definition.icon, definition.color, definition.help_template) }}
                                        {% else %}
                                        {{ svc|service_name }}
                                        {% endif %}
                                    </div>
                                </div>
                                {% endfor %}
                            </c-auto-grid>
                        </div>
                        {% endif %}
                    </div>

                    {# Public ingress links for this component #}
                    {% if component.ingress_links %}
                    <c-layout-flow gap="sm">
                        <c-heading type="h5"><c-icon icon="link" size="sm" color="hemelblauw"/>Publieke links</c-heading>
                        <c-layout-flow gap="sm">
                            {% for link in component.ingress_links %}
                            {% set lotc_onclick_4 %}window.open(this.dataset.url, '_blank'){% endset %}<c-button label="{{ link.deployment_name }} ({{ link.cluster }}){% if link.path and link.path != '/' %} {{ link.path }}{% endif %}" size="sm" show-icon="after" icon="link"/>
                            {% endfor %}
                        </c-layout-flow>
                    </c-layout-flow>
                    {% endif %}

                    {# User Environment Variables indicator for this component #}
                    {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
                    <div class="env-vars-indicator">
                        <c-icon icon="lock-closed" size="sm" color="hemelblauw"/>
                        <span>{{ component['user-env-vars']|length }} omgevingsvariabele{% if component['user-env-vars']|length != 1 %}n{% endif %}</span>
                        <span>(zie Omgevingsvariabelen sectie)</span>
                    </div>
                    {% endif %}
                </c-layout-flow>
            </c-card>
            {% endfor %}
        </c-layout-flow>
        {% else %}
        <c-alert>Geen componenten geconfigureerd</c-alert>
        {% endif %}
    </c-layout-flow>
</c-card>
