{# Danger Zone Section #}
{% if user_role in ["admin", "owner"] %}
<c-card outline="true" padding="xl" background-color="wit">
    <c-layout-flow gap="lg">
        <c-heading type="h2" class="section-heading section-heading--danger"><c-icon icon="exclamation-triangle" size="xl" color="rood"/>Danger zone</c-heading>

        <c-card padding="md" background-color="grijs-050" outline="true">
            <c-cluster justify="between" align="center" class="danger-action-row">
                <div>
                    <strong>Project herverwerken</strong>
                    <p class="text-flush">Herverwerkt het projectbestand vanuit Git. Detecteert wijzigingen en synchroniseert deployments, services en manifesten. Verwijderde deployments worden opgeruimd, nieuwe worden aangemaakt.</p>
                </div>
                {% set lotc_onclick_1 %}openServiceModal('/projects/{{ project.name }}/actions/refresh-project/confirm', 'Project herverwerken'){% endset %}<c-button size="sm" label="Project herverwerken" show-icon="before" icon="refresh"/>
            </c-cluster>
        </c-card>

        <c-card padding="md" background-color="grijs-050" outline="true">
            <c-cluster justify="between" align="center" class="danger-action-row">
                <div>
                    <strong class="danger-action-title">Project "{{ project.display_name or project.name }}" verwijderen</strong>
                    <p class="text-flush">Verwijdert het volledige project inclusief alle deployments, services en configuratie. Dit kan niet ongedaan worden gemaakt.</p>
                </div>
                {% set lotc_onclick_2 %}openServiceModal('/projects/{{ project.name }}/actions/delete-project/confirm', 'Project verwijderen'){% endset %}<c-button size="sm" label="Project verwijderen" show-icon="before" icon="trash"/>
            </c-cluster>
        </c-card>
    </c-layout-flow>
</c-card>
{% endif %}
