{# Helmfile Section (Base level) #}
{% if project.helmfile %}
<c-card outline="true" padding="xl" background-color="wit">
    <c-layout-flow gap="lg">
        <c-heading type="h2" class="section-heading"><c-icon icon="rectangle-stack" size="xl" color="oranje"/>Helmfile</c-heading>
        <p>Helmfile definities op project niveau</p>

        <div class="helmfile-section">
            {% for helmfile in project.helmfile %}
            <c-card class="helmfile-card" padding="lg" background-color="grijs-050" outline="true">
                <c-layout-flow gap="md">
                    <div class="helmfile-header">
                        <c-icon icon="rectangle-stack" size="lg" color="oranje"/>
                        <div>
                            <c-heading type="h3" label="{{ helmfile.name }}"/>
                            {% if helmfile.get('repository') %}
                            <div>{{ helmfile.repository }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="helmfile-specs">
                        {% if helmfile.get('path') %}
                        <div class="spec-item"><strong>Path:</strong> {{ helmfile.path }}</div>
                        {% endif %}
                        {% if helmfile.get('branch') %}
                        <div class="spec-item"><strong>Branch:</strong> {{ helmfile.branch }}</div>
                        {% endif %}
                    </div>

                    {% if helmfile.get('helm-values') and helmfile['helm-values'] is mapping and helmfile['helm-values']|length > 0 %}
                    <div class="helm-values-section section-divider">
                        <div class="helm-values-header">
                            <c-icon icon="lock-closed" size="sm" color="hemelblauw"/>
                            <span class="text-strong">Helm Values (Base)</span>
                            <span class="env-vars-count-badge">{{ helmfile['helm-values']|length }} waarde{% if helmfile['helm-values']|length != 1 %}n{% endif %}</span>
                        </div>
                        <c-secret-field value="{{ helmfile['helm-values'] | tojson(indent=2) }}" value-type="json" content-width="lg"/>
                    </div>
                    {% endif %}
                </c-layout-flow>
            </c-card>
            {% endfor %}
        </div>
    </c-layout-flow>
</c-card>
{% endif %}
