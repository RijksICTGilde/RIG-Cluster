{# Configuration & Secrets Section #}
{% if user_role in ["admin", "owner"] %}
<c-card outline="true" padding="xl" background-color="wit">
    <c-layout-flow gap="lg">
        <c-heading type="h2" class="section-heading"><c-icon icon="gear" size="xl" color="donkerblauw"/>Configuratie & Secrets</c-heading>
        <p>Project configuratie en gevoelige informatie</p>

        <div class="config-section">
            {# Project Name - always show #}
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="file-text" size="md" color="hemelblauw"/>
                    <strong>Project Naam</strong>
                </div>
                <div class="config-value">
                    {# Niet geheim, dus `revealed` toont de waarde en laat het oogje weg;
                       `show-copy` zet het klembord IN het veld. Hier stond een losse knop
                       met een inline copyToClipboard() erop, maar die aanroep stond in een
                       {% set %} dat nergens werd uitgelezen - de knop deed dus niets. #}
                    <c-secret-field value="{{ project.name }}" revealed show-copy/>
                </div>
            </div>

            {% if project.config %}

            {# API Key Section #}
            {% if project.config.get('api-key') %}
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="lock-closed" size="md" color="rood"/>
                    <strong>API Key</strong>
                </div>
                <div class="config-value">
                    <c-secret-field value="{{ project.config['api-key'] }}"/>
                </div>
            </div>
            {% endif %}

            {# Age Public Key #}
            {% if project.config.get('age-public-key') %}
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="shield-check-mark" size="md" color="groen"/>
                    <strong>Age Public Key</strong>
                </div>
                <div class="config-value">
                    {# Zelfde als de projectnaam hierboven: zichtbaar en kopieerbaar. #}
                    <c-secret-field value="{{ project.config['age-public-key'] }}" revealed show-copy/>
                </div>
            </div>
            {% endif %}

            {# Age Private Key #}
            {% if project.config.get('age-private-key') %}
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="shield-check-mark" size="md" color="rood"/>
                    <strong>Age Private Key</strong>
                </div>
                <div class="config-value">
                    <c-secret-field value="{{ project.config['age-private-key'] }}"/>
                </div>
            </div>
            {% endif %}

            {% else %}
            <div class="empty-state">
                <c-icon icon="info" size="lg" color="grijs-050"/>
                <p>Geen configuratie beschikbaar</p>
            </div>
            {% endif %}
        </div>
    </c-layout-flow>
</c-card>
{% endif %}
