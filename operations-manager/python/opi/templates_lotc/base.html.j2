{#
  Base Template - Self Service Portal

  Gemeenschappelijke layout voor alle pagina's in het Self Service Portal
  inclusief header, navigatie en footer.
#}

{% set page_title_value %}{% block page_title %}Self Service Portal{% endblock %}{% endset %}
{# additionalJs is a single-quoted ROOS attribute holding raw HTML, so a static_url('...')
   call cannot be written inline there - its quotes would end the attribute value. Resolve
   the URLs first and reference them by name. #}
{% set json_enc_js = static_url("js/json-enc.js") %}
{% set edit_modal_js = static_url("js/edit_modal.js") %}
<c-page title="{{ page_title_value }}" lang="nl" body-class="rvo-theme rvo-responsive">

    <div class="rvo-demo-page">
        {# Header #}
        <c-header text="Zelfservice voor Applicatie Deployment" subtitle="Rijksorganisatie voor Ontwikkeling, Digitalisering en Innovatie" link="/"/>

        <c-layout-flow gap="xl" size="lg">
            {# MenuBar #}
            <c-menu type="bar" size="md"/>

            {# Main Content Area #}
            <main>
                {% block content %}
                {# Default content - override in child templates #}
                <c-layout-flow gap="lg">
                    <c-heading type="h1" label="Welkom bij het Self Service Portal"/>
                    <p>Gebruik de navigatie om door de verschillende secties te bladeren.</p>
                </c-layout-flow>
                {% endblock %}
            </main>

            {# Footer - version info (reads live from opi/version.json via version_info()) #}
            {% set vi = version_info() %}
            {% set version_label = 'ZAD ' + vi.version
                + (' @ ' + vi.branch if vi.branch else '')
                + (' *' if vi.dirty else '')
                + (' (' + vi.build_date + ')' if vi.build_date else '') %}
            {% set commit_ref = vi.commit if vi.commit else (vi.version if vi.version != '0.1.0' else '') %}
            {% if commit_ref %}
                {% set version_menu = [{'content': version_label, 'link': 'https://github.com/RijksICTGilde/RIG-Cluster/commit/' + commit_ref}] %}
            {% else %}
                {% set version_menu = [{'content': version_label}] %}
            {% endif %}
            <c-footer max-width="lg"/>
        </c-layout-flow>


        {% block additional_styles %}
        {# Additional CSS can be added here by child templates #}
        {% endblock %}

        {% block additional_scripts %}
        {# Additional JavaScript can be added here by child templates #}
        {% endblock %}
    </div>
</c-page>
