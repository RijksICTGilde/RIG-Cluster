{#
  Invite Registration Form Template

  Displays the local account registration form for invite users.
#}

{% set title_nl = "Account Aanmaken - " ~ display_name %}
{% set title_en = "Create Account - " ~ display_name %}
{% set page_title = title_nl if language == 'nl' else title_en %}

<c-page title="{{ page_title }}" lang="{{ language }}" body-class="rvo-theme rvo-responsive">
    {# Header #}
    <c-header text="RIG Cluster" subtitle="Rijksorganisatie voor Ontwikkeling, Digitalisering en Innovatie" link="/"/>

    <c-layout-flow gap="xl" size="lg">
        <main>
            <c-layout-flow gap="xl">
                    {# Registration Form Card #}
                    <c-card outline="true" padding="lg">
                        <form method="POST" action="/invite/{{ invite_key }}/register" autocomplete="off">
                            <input type="hidden" name="csrf_token" value="{{ request.state.csrf_token }}">
                            <c-layout-flow gap="lg">
                                <c-heading type="h1" label="{{ display_name }}"/>
                                <c-heading type="h2" :label="('Nieuw Account') if (language == 'nl') else ('New Account')"/>

                                {% if general_error %}
                                <c-alert :heading="('Fout') if (language == 'nl') else ('Error')"/>
                                {% endif %}

                                {% if domain_restriction %}
                                <c-alert :heading="('E-mail beperking') if (language == 'nl') else ('Email restriction')"/>
                                {% endif %}

                                {# Email Field #}
                                <c-text-input-field id="email" name="email" type="email" :label="('E-mailadres') if (language == 'nl') else ('Email address')" :placeholder="('naam@organisatie.nl') if (language == 'nl') else ('name@organization.com')" :value="((form_data.email)) if (form_data and form_data.email) else none" required="true"/>

                                {# First Name Field #}
                                <c-text-input-field id="first_name" name="first_name" type="text" :label="('Voornaam') if (language == 'nl') else ('First name')" :placeholder="('Voornaam') if (language == 'nl') else ('First name')" :value="((form_data.first_name)) if (form_data and form_data.first_name) else none" required="true"/>

                                {# Last Name Field #}
                                <c-text-input-field id="last_name" name="last_name" type="text" :label="('Achternaam') if (language == 'nl') else ('Last name')" :placeholder="('Achternaam') if (language == 'nl') else ('Last name')" :value="((form_data.last_name)) if (form_data and form_data.last_name) else none" required="true"/>

                                {# Password Field #}
                                <c-text-input-field id="password" name="password" type="password" :label="('Wachtwoord') if (language == 'nl') else ('Password')" :placeholder="('Minimaal 12 tekens') if (language == 'nl') else ('At least 12 characters')" required="true"/>

                                {# Confirm Password Field #}
                                <c-text-input-field id="password_confirm" name="password_confirm" type="password" :label="('Bevestig wachtwoord') if (language == 'nl') else ('Confirm password')" :placeholder="('Herhaal wachtwoord') if (language == 'nl') else ('Repeat password')" required="true"/>

                                {# Form Actions #}
                                <c-layout-flow gap="md" row="true">
                                    <c-button type="submit" :label="('Account Aanmaken') if (language == 'nl') else ('Create Account')"/>
                                    {% set lotc_onclick_1 %}window.location.href='/invite/{{ invite_key }}'{% endset %}<c-button type="secondary" :label="('Annuleren') if (language == 'nl') else ('Cancel')"/>
                                </c-layout-flow>
                            </c-layout-flow>
                        </form>
                    </c-card>
            </c-layout-flow>
        </main>
    </c-layout-flow>
</c-page>
