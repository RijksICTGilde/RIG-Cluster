{# De uitleg en de startknop voor wie nog geen factor heeft. #}
{% from "bg/_patterns.html.j2" import panel %}
{% call panel("Nog niet ingericht", "lock-open") %}
    <c-paragraph>
        Je hebt nog geen tweede factor. Met een authenticator-app lees je een QR in en
        krijg je elke dertig seconden een code.
    </c-paragraph>
    <form autocomplete="off" method="post" action="/account/otp/start">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
        <c-action-group align="start">
            <c-button type="primary" label="Tweede factor inrichten" html-type="submit" />
            <c-button type="secondary" label="Terug naar account" href="/account" />
        </c-action-group>
    </form>
{% endcall %}
