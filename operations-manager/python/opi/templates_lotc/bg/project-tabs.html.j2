{#
  De projectpagina in tabs. Dit is de gekozen richting; het alternatief (de zijkolom laten
  meewisselen met het project) staat geparkeerd in project-context.html.j2.

  DE INDELING VOLGT DE BESTAANDE PAGINA

  Niet zelf bedacht. De huidige projectdetailpagina heeft al tabs - Project, Deployments,
  Taken - en die verdeling is er niet zomaar: hij scheidt "wat is dit project", "waar
  draait het" en "wat is er aan de hand". Die drie blijven dus staan, met dezelfde secties
  eronder.

  Er komt er een bij: METRICS. Het resourcegebruik zat op de projecttab tussen de
  tekstblokken, terwijl het het enige is dat je periodiek komt bekijken. Als eigen tab is
  het te vinden, en er is ruimte om er meer te tonen dan twee balkjes.

  Repositories is eruit. Die stond op de oude pagina omdat hij in het projectbestand
  staat, niet omdat iemand hem nodig heeft.

  WAT ER ANDERS IS DAN DE OUDE PAGINA

  De tabs zijn ECHTE LINKS met een eigen URL (?tab=deployments), waar de oude versie ze in
  de browser wisselt met switchTab(). Daardoor is een tab deelbaar, werkt de terugknop, en
  doet de pagina het zonder JavaScript.

  De balken voor CPU en geheugen waren eigen div's met een breedte in een style-attribuut
  (usage-bar__fill). Dat is nu c-progress-bar: hetzelfde beeld, met de toegankelijkheid die
  het thema meelevert, en het volgt een themawissel.
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head, info, explainer %}

{% block page_title %}{{ project.display_name }} - {{ tabs[active_tab].label }}{% endblock %}

{% block content %}
    {# Het kruimelpad zegt waar je bent; de tabbalk zegt alleen welk aanzicht je hebt. #}
    <c-breadcrumbs aria-label="Kruimelpad">
        <c-breadcrumbs-item label="Projecten" href="/projects" />
        <c-breadcrumbs-item label="{{ project.display_name }}" href="?tab=project" />
        <c-breadcrumbs-item label="{{ tabs[active_tab].label }}" />
    </c-breadcrumbs>

    {{ page_head(project.display_name, project.description) }}

    <c-tabs aria-label="Aanzichten van dit project">
        {% for key, tab in tabs.items() %}
            <c-tab label="{{ tab.label }}" href="?tab={{ key }}" :active="key == active_tab" />
        {% endfor %}
    </c-tabs>

    {% if active_tab == 'project' %}
        <c-auto-grid min="200px" gap="md">
            <c-metric icon="rectangle-stack" value="{{ project.components | length }}" label="Componenten" />
            <c-metric icon="arrow-up-arrow-down" value="{{ project.deployments | length }}" label="Deployments" href="?tab=deployments" />
            <c-metric icon="cylinder-split" value="{{ project.services | length }}" label="Diensten" />
            <c-metric icon="person-2" value="{{ project.users | length }}" label="Teamleden" />
        </c-auto-grid>

        {% call panel("Diensten", "cylinder-split", info_text="Diensten worden door het platform geleverd en beheerd. Je hoeft ze niet zelf te installeren of bij te werken.") %}
            <c-cluster gap="sm">
                {% for service in project.services %}
                    <c-chip>{{ service.value }}</c-chip>
                {% else %}
                    <c-paragraph>Dit project neemt geen diensten af.</c-paragraph>
                {% endfor %}
            </c-cluster>
        {% endcall %}

        {% call panel("Componenten", "rectangle-stack", info_text="Een component is een draaiend onderdeel van je applicatie. Waar het draait bepaal je bij Deployments.") %}
            <c-stack gap="sm">
                {% for component in project.components %}
                    <c-layer
                        icon="rectangle-stack"
                        title="{{ component.name }}"
                        count="{{ component.type }}"
                        sub="poorten: {{ component.ports.inbound | join(', ') if component.ports else 'geen' }}">
                        {% for service in component.services or [] %}
                            <c-chip>{{ service }}</c-chip>
                        {% endfor %}
                    </c-layer>
                {% else %}
                    <c-paragraph>Dit project heeft nog geen componenten.</c-paragraph>
                {% endfor %}
            </c-stack>
        {% endcall %}

        {% call panel("Team", "person-2", info_text="Een beheerder mag alles, inclusief het project verwijderen. Een ontwikkelaar mag wijzigen en uitrollen, maar het project niet opheffen.") %}
            <c-table columns="2fr 1fr">
                <c-table-head>
                    <c-th>E-mailadres</c-th>
                    <c-th>Rol</c-th>
                </c-table-head>
                {% for member in project.users %}
                    <c-table-row>
                        <c-td>{{ member.email }}</c-td>
                        <c-td><c-tag type="default" label="{{ member.role }}" /></c-td>
                    </c-table-row>
                {% endfor %}
            </c-table>
        {% endcall %}

        {% call panel("Sleutels", "lock-closed", info_text="De API-sleutel geeft toegang tot dit project via de API. Deel hem niet, en vernieuw hem als je vermoedt dat hij is uitgelekt.") %}
            <c-detail-list>
                <c-detail-item label="Cluster" value="{{ project.clusters | join(', ') }}" />
            </c-detail-list>
            <c-secret-field value="{{ project.config['api-key'] | default('', true) }}" />
        {% endcall %}

        {% call panel("Gevarenzone", "exclamation-triangle", info_text="Verwijderen kan niet ongedaan worden gemaakt: deployments, database en opslag gaan mee.") %}
            <c-action-group align="start">
                <c-button type="warning" label="Project verwijderen" />
            </c-action-group>
        {% endcall %}

    {% elif active_tab == 'deployments' %}
        {% call panel("Deployments", "arrow-up-arrow-down", info_text="Een deployment brengt je componenten naar een cluster, met een eigen namespace en een eigen image per component.") %}
            <c-stack gap="sm">
                {% for deployment in project.deployments %}
                    <c-layer
                        icon="arrow-up-arrow-down"
                        title="{{ deployment.name }}"
                        count="{{ deployment.components | length }} componenten"
                        sub="{{ deployment.cluster }} / {{ deployment.namespace }}">
                        {% for entry in deployment.components %}
                            <c-chip>{{ entry.reference }}</c-chip>
                        {% endfor %}
                    </c-layer>
                {% else %}
                    <c-paragraph>Dit project heeft nog geen deployments.</c-paragraph>
                {% endfor %}
            </c-stack>
        {% endcall %}

    {% elif active_tab == 'metrics' %}
        {% if project.name is defined and usage is not defined %}
            {# Zelfde aanpak als de bestaande pagina: apart laden, zodat een trage of
               afwezige Prometheus deze pagina niet ophoudt. Het fragment kent zijn eigen
               LOTC-weergave, dus ?ui=lotc gaat mee. #}
            {% call panel("Resourcegebruik", "chart-x-y-axis-line", info_text="Wat dit project op dit moment gebruikt, tegen de limiet die ervoor is ingesteld.") %}
                <div hx-get="/projects/details/{{ project.name }}/resource-usage?ui=lotc"
                     hx-trigger="load"
                     hx-swap="innerHTML">
                    <c-paragraph>Metingen worden opgehaald...</c-paragraph>
                </div>
            {% endcall %}
        {% elif usage_error %}
            <c-alert type="info" heading="Resourcegebruik niet beschikbaar">{{ usage_error }}</c-alert>
        {% elif usage %}
            {% call panel("Resourcegebruik", "chart-x-y-axis-line", info_text="Wat dit project op dit moment gebruikt, tegen de limiet die ervoor is ingesteld.") %}
                <c-paragraph size="sm">
                    {{ usage.deployments }} deployment(s), {{ usage.pods }} pod(s) op dit cluster.
                </c-paragraph>
                <c-progress-bar
                    text="CPU"
                    :value="usage.cpu_pct"
                    max="100"
                    value-display="true"
                    color="info"
                    accessible-label="CPU-gebruik ten opzichte van de limiet" />
                <c-progress-bar
                    text="Geheugen"
                    :value="usage.mem_pct"
                    max="100"
                    value-display="true"
                    color="success"
                    accessible-label="Geheugengebruik ten opzichte van de limiet" />
            {% endcall %}
        {% else %}
            <c-alert type="info" heading="Nog geen meetgegevens">
                Er zijn nog geen metingen voor dit project.
            </c-alert>
        {% endif %}

    {% elif active_tab == 'taken' %}
        {% call panel("Taken", "timer", info_text="Werk dat op de achtergrond loopt: uitrollen, back-ups en herstelacties. Hier zie je of het gelukt is.") %}
            <c-paragraph>
                Taken worden tijdens het gebruik bijgewerkt en zijn nog niet aangesloten op
                deze weergave.
            </c-paragraph>
        {% endcall %}
    {% endif %}
{% endblock %}
