{#
  Het overzicht van de omgevingsvariabelen.

  Dit blok wordt sinds de tabbladenverhuizing nergens meer ingevoegd; tests renderen het
  rechtstreeks om de leesvorm vast te leggen. Sinds RC-388 toont het alleen de NAMEN en
  de tellers, nooit een waarde: waarden horen achter een verse step-up, in het venster
  dat de componentkaart en de deploymentkaart openen (router_env_vars).

  De context draagt daarom `user-env-var-namen` (een gesorteerde lijst van namen, of
  None als het opgeslagen blok niet te lezen was) en geen `user-env-vars` meer.
#}
{% from "bg/_patterns.html.j2" import panel %}

{% set ns = namespace(has_any_env_vars=false, has_component_env_vars=false, has_deployment_env_vars=false) %}
{% for component in project.components %}
    {% if component.get('user-env-var-namen') %}
        {% set ns.has_any_env_vars = true %}
        {% set ns.has_component_env_vars = true %}
    {% endif %}
{% endfor %}
{% for deployment in project.deployments %}
    {% for dep_component in deployment.components %}
        {% if dep_component.get('user-env-var-namen') %}
            {% set ns.has_any_env_vars = true %}
            {% set ns.has_deployment_env_vars = true %}
        {% endif %}
    {% endfor %}
{% endfor %}

{% set env_niveau = env_niveau | default('') %}
{% set toon_component = env_niveau in ('', 'component') %}
{% set toon_deployment = env_niveau in ('', 'deployment') %}
{% set env_kop = "Omgevingsvariabelen" %}
{% set env_uitleg = "Namen van de gebruiker-gedefinieerde omgevingsvariabelen per scope. De waarden zijn te zien en te wijzigen via een verse bevestiging, niet op deze pagina." %}
{% if env_niveau == 'component' %}
    {% set env_uitleg = "Standaardvariabelen per component; ze gelden voor alle deployments." %}
{% elif env_niveau == 'deployment' %}
    {% set env_kop = "Omgevingsvariabelen (overschrijvingen)" %}
    {% set env_uitleg = "Wat deze deployments anders instellen dan het component. De standaardwaarden staan bij Componenten." %}
{% endif %}
{% call panel(env_kop, "key", info_text=env_uitleg) %}
    {% if ns.has_any_env_vars %}

        {# Componentniveau #}
        {% if ns.has_component_env_vars and toon_component %}
        <c-cluster gap="sm" align="center">
            <c-icon icon="puzzle-piece" size="lg" />
            <c-stack gap="xs">
                <c-heading type="h3" size="5" label="Component niveau" />
                <c-span>Standaard variabelen per component (gelden voor alle deployments)</c-span>
            </c-stack>
        </c-cluster>

        {% for component in project.components | sort(attribute='name') %}
        {% if component.get('user-env-var-namen') %}
        <c-card outline padding="md">
            <c-stack gap="sm">
                <c-cluster gap="sm" align="center">
                    <c-icon icon="puzzle-piece" size="md" />
                    <strong>{{ component.name }}</strong>
                    <c-tag type="default" label="{{ component['user-env-var-namen']|length }} variabele{{ 'n' if component['user-env-var-namen']|length != 1 else '' }}" />
                </c-cluster>
                {% for naam in component['user-env-var-namen'] %}
                <c-cluster gap="sm" align="center">
                    <c-icon icon="lock-closed" size="sm" />
                    <c-code>{{ naam }}</c-code>
                </c-cluster>
                {% endfor %}
            </c-stack>
        </c-card>
        {% endif %}
        {% endfor %}
        {% endif %}

        {# Deploymentniveau #}
        {% if ns.has_deployment_env_vars and toon_deployment %}
        <c-cluster gap="sm" align="center">
            <c-icon icon="cylinder-split" size="lg" />
            <c-stack gap="xs">
                <c-heading type="h3" size="5" label="Deployment niveau" />
                <c-span>Deployment-specifieke variabelen (overschrijven component niveau)</c-span>
            </c-stack>
        </c-cluster>

        {% for deployment in project.deployments | sort(attribute='name') %}
        {% set dep_ns = namespace(has_env_vars=false) %}
        {% for dep_component in deployment.components %}
            {% if dep_component.get('user-env-var-namen') %}
                {% set dep_ns.has_env_vars = true %}
            {% endif %}
        {% endfor %}

        {% if dep_ns.has_env_vars %}
        <c-card outline padding="md">
            <c-stack gap="md">
                <c-cluster gap="sm" align="center">
                    <c-icon icon="cylinder-split" size="md" />
                    <strong>{{ deployment.name }}</strong>
                    <c-tag type="default" label="{{ deployment.cluster|title }}" />
                </c-cluster>

                {% for dep_component in deployment.components | sort(attribute='reference') %}
                {% if dep_component.get('user-env-var-namen') %}
                <c-card outline padding="sm">
                    <c-stack gap="sm">
                        <c-cluster gap="sm" align="center">
                            <c-icon icon="puzzle-piece" size="sm" />
                            <c-span>{{ dep_component.reference }}</c-span>
                            <c-tag type="default" label="{{ dep_component['user-env-var-namen']|length }} variabele{{ 'n' if dep_component['user-env-var-namen']|length != 1 else '' }}" />
                        </c-cluster>
                        {% for naam in dep_component['user-env-var-namen'] %}
                        <c-cluster gap="sm" align="center">
                            <c-icon icon="lock-closed" size="sm" />
                            <c-code>{{ naam }}</c-code>
                        </c-cluster>
                        {% endfor %}
                    </c-stack>
                </c-card>
                {% endif %}
                {% endfor %}
            </c-stack>
        </c-card>
        {% endif %}
        {% endfor %}
        {% endif %}

    {% else %}
        <c-alert type="info" heading="Geen omgevingsvariabelen geconfigureerd" />
    {% endif %}
{% endcall %}
