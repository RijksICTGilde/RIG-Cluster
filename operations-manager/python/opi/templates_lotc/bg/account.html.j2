{#
  Profielpagina: sessie-info plus tweede factor (uit de database, RC-329).
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head %}

{% block page_title %}Account - Self Service Portal{% endblock %}

{% block content %}
    {{ page_head("Account", "De gegevens waarmee je bent ingelogd.") }}

    {% call panel("Wie je bent", "person") %}
        <c-detail-list>
            <c-detail-item label="Naam" value="{{ account.name }}" />
            {% if account.email %}
                <c-detail-item label="E-mailadres" value="{{ account.email }}" />
            {% endif %}
            {% if account.organisatie %}
                <c-detail-item label="Organisatie" value="{{ account.organisatie }}" />
            {% endif %}
        </c-detail-list>

        <c-paragraph size="sm" color="grijs-500">
            Deze gegevens komen uit je inlogsessie en worden door ZAD niet zelf bijgehouden.
            Kloppen ze niet, dan zijn ze bij de inlogdienst aan te passen.
        </c-paragraph>
    {% endcall %}

    {% call panel("Tweede factor", "lock-closed") %}
        {% if otp_status.registered %}
            <c-paragraph>
                Je hebt een tweede factor ingericht op {{ otp_status.confirmed_at | dutch_date }}.
            </c-paragraph>
        {% else %}
            <c-paragraph>
                Je hebt nog geen tweede factor: een eenmalige code uit een app op je telefoon,
                naast je inlog.
            </c-paragraph>
        {% endif %}
        {% set otp_knop = "Tweede factor beheren" if otp_status.registered else "Tweede factor inrichten" %}
        <c-cluster gap="sm">
            <c-button type="secondary" label="{{ otp_knop }}" href="/account/otp" />
        </c-cluster>
    {% endcall %}

    <c-cluster gap="sm">
        <c-button type="secondary" label="Uitloggen" href="/auth/logout" />
    </c-cluster>
{% endblock %}
