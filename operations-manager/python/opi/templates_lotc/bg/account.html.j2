{#
  Profielpagina: sessie-info plus 2-factor (uit de database, RC-329).
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head %}

{% block page_title %}Account - Self Service Portal{% endblock %}

{% block content %}
    {{ page_head("Account", "De gegevens waarmee je bent ingelogd.") }}

    {% call panel("Wie je bent", "person") %}
        <nldd-rich-text><dl>
            <dt>Naam</dt><dd>{{ account.name }}</dd>
            {% if account.email %}
                <dt>E-mailadres</dt><dd>{{ account.email }}</dd>
            {% endif %}
            {% if account.organisatie %}
                <dt>Organisatie</dt><dd>{{ account.organisatie }}</dd>
            {% endif %}
        </dl></nldd-rich-text>

        <c-paragraph size="sm" color="grijs-500">
            Deze gegevens komen uit je inlogsessie en worden door ZAD niet zelf bijgehouden.
            Kloppen ze niet, dan zijn ze bij de inlogdienst aan te passen.
        </c-paragraph>
    {% endcall %}

    {% call panel("2-factor", "lock-closed") %}
        {% if otp_status.registered %}
            <c-paragraph>
                Je hebt een 2-factor ingericht op {{ otp_status.confirmed_at | dutch_date }}.
            </c-paragraph>
        {% else %}
            <c-paragraph>
                Je hebt nog geen 2-factor: een eenmalige code uit een app op je telefoon,
                naast je inlog.
            </c-paragraph>
        {% endif %}
        {% set otp_knop = "2-factor beheren" if otp_status.registered else "2-factor inrichten" %}
        <c-cluster gap="sm">
            <c-button type="secondary" label="{{ otp_knop }}" href="/account/otp" />
        </c-cluster>
    {% endcall %}

    <c-cluster gap="sm">
        <c-button type="secondary" label="Uitloggen" href="/auth/logout" />
    </c-cluster>
{% endblock %}
