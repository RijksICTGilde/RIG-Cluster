{#
  De acties per deployment.

  Overname van project-details/section-deployment-actions.html.j2: dezelfde poort
  (alleen admin/owner), dezelfde twee vaste knoppen in dezelfde volgorde, en daarna de
  knoppen die de diensten leveren (databaseconsole, job uitvoeren, slapen/wekken,
  cross-domain). Dezelfde flow-id's en dezelfde bevestigings-URL's.

  De index in het projectbestand telt door en wordt NIET meegesorteerd: die index IS de
  flow-id van de bewerk-dialoog, dus sorteren zonder dat zou "Images bewerken" stilletjes
  op een andere deployment richten.

  ER IS ER EEN, en dat is die uit het PAD (``deployment_geopend``, zie de route). Dit
  bestand liep eerst over alle deployments en verborg alle acties behalve die van een; nu
  rendert het de acties van de deployment die de pagina toont. De wikkel houdt zijn
  ``id="deployment-actions-<naam>"``: die zegt bij welke deployment deze knoppen horen.

  De aanroep wordt met {% set %} BOVEN de tag opgebouwd: <c-button> laat geen onclick toe,
  :attrs zet het attribuut wel door, en een genest aanhalingsteken binnen :attrs leest de
  voorbewerker als het einde van het attribuut.

  De twee takken van een dienstknop (een eigen modal-URL of de gedeelde
  bevestigingsroute) staan hier als een expressie in de {% set %} in plaats van als twee
  hele knoppen: een {% if %} BINNEN een componenttag kan niet, maar in een {% set %} wel.
  Het icoon en de soort komen ongewijzigd van de dienst.
#}
{% set deployment_service_actions = deployment_service_actions | default({}) %}
{% if user_role in ["admin", "owner"] and deployment_geopend %}
    {% set deployment = deployment_geopend %}
    {% set original_index = project.deployments.index(deployment) %}
    <div id="deployment-actions-{{ deployment.name }}">
        {# Twee kaarten onder elkaar in EEN wikkel: de stack geeft ze hun
           tussenruimte, want de c-stack van de tab omvat deze div als geheel. #}
        <c-stack gap="md">
        <c-card outline padding="lg">
            <c-stack gap="md">
                <c-section-head title="Acties" icon="gear" />
                <c-cluster gap="sm">
                    {% set images_bewerken = "openEditModal('modal-edit-deployment-" ~ original_index ~ "', 'Images bewerken - " ~ deployment.name ~ "')" %}
                    {% set herverwerken = "openServiceModal('/projects/" ~ project.name ~ "/actions/refresh-deployment/confirm?target=" ~ (deployment.name | urlencode) ~ "', 'Deployment herverwerken')" %}
                    <c-button type="secondary" size="sm" show-icon="before" icon="pencil"
                              label="Images bewerken" :attrs="{'onclick': images_bewerken}" />
                    <c-button type="secondary" size="sm" show-icon="before" icon="refresh"
                              label="Deployment herverwerken" :attrs="{'onclick': herverwerken}" />
                    {# Hoort bij het PROJECT en niet bij deze deployment, maar staat hier omdat
                       dit de plek is waar je naar acties kijkt. De pagina toont er een, dus
                       hij verschijnt niet dubbel. #}
                    <c-button type="secondary" size="sm" show-icon="before" icon="plus"
                              label="Deployment toevoegen" :attrs="{'onclick': deployment_toevoegen}" />

                    {# Deze drie stonden los in het deploymentpaneel, tussen de statusregel
                       en de componentenlijst, en zweefden daar tussen blokken die er niets
                       mee te maken hebben. Het zijn acties, dus ze horen bij de acties. De
                       labels zeggen nu WAAROP ze slaan: "Bewerken" naast "Images bewerken"
                       is een raadsel, "Deployment bewerken" niet. #}
                    {% set deployment_bewerken = "openEditModal('modal-edit-deployment-" ~ original_index ~ "', 'Deployment bewerken - " ~ deployment.name ~ "')" %}
                    {% set webadres = "openEditModal('modal-edit-domain-" ~ original_index ~ "', 'Webadres bewerken - " ~ deployment.name ~ "')" %}
                    {% set verwijderen = "openServiceModal('/projects/" ~ project.name ~ "/actions/delete-deployment/confirm?target=" ~ (deployment.name | urlencode) ~ "', 'Deployment verwijderen')" %}
                    <c-button type="secondary" size="sm" show-icon="before" icon="pencil"
                              label="Deployment bewerken" :attrs="{'onclick': deployment_bewerken}" />
                    <c-button type="secondary" size="sm" show-icon="before" icon="globe"
                              label="Webadres wijzigen" :attrs="{'onclick': webadres}" />
                    <c-button type="warning" size="sm" show-icon="before" icon="trash"
                              label="Deployment verwijderen" :attrs="{'onclick': verwijderen}" />

                    {% for action in deployment_service_actions.get(deployment.name, []) if action.visible %}
                    {% set doel = action.modal_endpoint if action.modal_endpoint else "/projects/" ~ project.name ~ "/deployments/" ~ deployment.name ~ "/actions/" ~ (action | deployment_action_key) ~ "/confirm" %}
                    {% set titel = action.modal_title if action.modal_endpoint else action.label %}
                    {% set dienstactie = "openServiceModal('" ~ doel ~ "', '" ~ titel ~ "')" %}
                    <c-button type="{{ action.kind }}" size="sm" show-icon="before" icon="{{ action.icon | nldd_icon }}"
                              label="{{ action.label }}" :attrs="{'onclick': dienstactie}" />
                    {% endfor %}
                </c-cluster>
            </c-stack>
        </c-card>

        {# Publieke links stonden onderaan het deploymentpaneel, na de componenten. Dat is
           waar je juist NAARTOE wilt: het adres waarop je deployment draait. Een eigen
           kaart direct onder de acties, zodat het als bestemming leest en niet als bijzin. #}
        {% if deployment.ingress_links %}
            <c-card outline padding="lg">
                <c-stack gap="md">
                    <c-section-head title="Publieke links" icon="link" />
                    <c-cluster gap="sm">
                        {% for link in deployment.ingress_links %}
                            {% set link_label = link.component_name ~ (' ' ~ link.path if link.path and link.path != '/' else '') %}
                            <c-button type="secondary" size="sm" show-icon="after" icon="link"
                                      label="{{ link_label }}" href="{{ link.url }}" target="_blank" />
                        {% endfor %}
                    </c-cluster>
                </c-stack>
            </c-card>
        {% endif %}
        </c-stack>
    </div>
{% endif %}
