{#
  De QR en de sleutel van een lopende registratie, plus het veld dat hem bevestigt.

  De QR is een inline SVG die de server maakt (opi/utils/qr.py). Geen script van een CDN:
  deze pagina draagt een geheim.

  Deze pagina is het ANTWOORD op POST /account/otp/start en heeft geen eigen GET: de
  seed staat in een verborgen veld en zou na een omleiding weg zijn.
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head %}

{% block page_title %}2-factor inrichten - Self Service Portal{% endblock %}

{% block content %}
    {{ page_head("2-factor inrichten", "Scan de QR, vul daarna de code in die je app geeft.") }}

    {% if fout %}
        <c-alert type="error" heading="{{ fout }}" />
    {% endif %}

    {% call panel("Stap 1: zet het geheim in je app", "shield") %}
        <div class="otp-qr">{{ qr_svg | safe }}</div>

        <c-paragraph size="sm">
            Lukt scannen niet of gebruik je een passwordmanager, dan kun je onderstaande sleutel gebruiken.
        </c-paragraph>
        <c-code>{{ base32_secret }}</c-code>
    {% endcall %}

    {% call panel("Stap 2: bevestig met een code", "key") %}
        {# novalidate: de server valideert dit veld. Zie FORMULIEREN_MET_SERVERVALIDATIE
           in tests/test_template_structure.py. #}
        <form autocomplete="off" method="post" action="/account/otp/bevestigen" novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            {# De versleutelde seed reist hier mee; dat hij loopt staat server-side
               (tabel otp_pending_registrations), niet in de sessiecookie. Zie router_otp.py. #}
            <input type="hidden" name="{{ pending_field }}" value="{{ pending }}" />
            <c-stack gap="md">
                <c-text-input-field
                    id="code"
                    name="otp"
                    label="Code uit je app"
                    type="text"
                    autocomplete="one-time-code" :error="code_fout or none"
                    placeholder="123456"
                    required="true" />
                <c-action-group align="start">
                    <c-button type="primary" label="Bevestigen" html-type="submit" />
                </c-action-group>
            </c-stack>
        </form>
    {% endcall %}

    <form autocomplete="off" method="post" action="/account/otp/afbreken">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
        <c-button type="tertiary" label="Afbreken" html-type="submit" />
    </form>
{% endblock %}
