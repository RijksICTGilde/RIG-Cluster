{#
  De deploymentlijst van een project.

  Overname van project-details/section-deployments.html.j2. Dezelfde blokken in dezelfde
  volgorde: goedkeuringsmeldingen, componenten, Helm Charts, Helmfile, publieke links en de
  gebruikersconfiguratie per component.

  WAAROM DIT EEN MACRO IS EN NIET ALLEEN EEN LOOP

  De Deployments-tab zet onder elke deployment de ArgoCD-statuskaart, die apart wordt
  ingeladen. Dat interleaven kan niet met een {% include %} van een template dat zelf de
  hele lus draait. Vandaar deployment_panel(): de tab loopt over de deployments en zet per
  deployment het paneel en daaronder de lazy statuskaart. Wie dit bestand rechtstreeks
  rendert (als los fragment) krijgt gewoon de hele lijst - dat is de body onderaan.

  WAT ER ANDERS IS DAN DE BESTAANDE PAGINA, en waarom

  - De knoppen "Bewerken", "Webadres" en "Verwijderen" openen de gedeelde dialoog, net als
    op de bestaande pagina, met dezelfde flow-id en dezelfde bevestigings-URL. <c-button>
    laat geen onclick toe, maar :attrs zet het attribuut wel door; de aanroep wordt boven
    de tag opgebouwd omdat een genest aanhalingsteken binnen :attrs als het einde van het
    attribuut gelezen wordt. De volgorde is alfabetisch en de index in het projectbestand
    telt door, want die index IS de flow-id - sorteren zonder dat zou de knop "Bewerken"
    stilletjes op een andere deployment richten.
  - De publieke links waren knoppen met @click="window.open(this.dataset.url)". Nu gewoon
    <c-button href=... target="_blank">: zelfde bestemming, zelfde nieuw venster, zonder
    tekst als JavaScript uit te voeren.
  - De wikkel <div class="deployment-section is-hidden"> is weg. Die verbergt alle
    deployments behalve de eerste, waarna de JavaScript van de oude pagina er een zichtbaar
    maakt. Deze tab toont ze onder elkaar, dus er is niets te verbergen.
#}
{% from "bg/_patterns.html.j2" import panel %}

{% macro deployment_panel(deployment, project, approval_notices={}, user_role='') %}
{% call panel("Deployment: " ~ deployment.name, "arrow-up-arrow-down") %}
    {# ---- De stand van deze deployment ------------------------------------------

       Hier stonden twee blokken boven dit paneel: een statuskaart (naam, cluster, de rode
       melding over uitgeschakelde componenten, Uitgeschakeld/Synced, laatste sync) en dan
       pas "Deployment: <naam>" met de acties en de inhoud. Dezelfde deployment, twee keer
       onder elkaar, met de naam er twee keer boven. Ze zijn samengevoegd, met DIT paneel
       als uitgangspunt omdat het de acties en de inhoud draagt; de statusgegevens staan er
       nu bovenin.

       De ArgoCD-kant laadt zichzelf, net als voorheen: de volledige diagnose kost een
       bevraging bij ArgoCD plus een bij kubectl, en die hoort de pagina niet op te houden.
       Er staat er precies EEN open (switchDeployment toont een deployment tegelijk), dus
       dit is geen bevraging per rij - de tabel op Overzicht heeft zijn eigen, gebundelde
       bron. hx-trigger="intersect once" en niet "load", en dat is precies waarom: de
       verborgen panelen staan op display:none, komen dus nooit in beeld, en halen niets
       op. Met "load" zou elk paneel op de pagina alsnog zijn eigen bevraging doen.

       De prefix is de KALE deploymentnaam; die houdt de id's van de foutenlijst in de
       kaart uniek.

       Het cluster stond in de kop van de weggevallen kaart en hoort bij de stand: het
       zegt WAAR dit draait, en de kaart hieronder meldt alleen iets als dat het cluster
       van deze instantie is. #}
    <c-cluster gap="sm" align="center">
        <c-tag type="default" label="{{ deployment.cluster }}" />
    </c-cluster>

    {# Wat de DIENSTEN over deze deployment melden (RC-28): slaapstand, uitgeschakeld. Uit
       het projectbestand en niet uit het cluster, dus dit staat er ook als ArgoCD niets
       zegt. Stond in een eigen kaart boven het paneel; die kaart is deze regels. #}
    {% for fact in (deployment_state_facts | default({})).get(deployment.name, []) %}
        <c-cluster gap="md" align="center">
            <c-icon icon="info-circle" size="lg" />
            <c-stack gap="xs">
                <strong>{{ ServiceAdapter.get_service_definition(ServiceAdapter.get_service_by_value(fact.service)).name }}</strong>
                <c-paragraph size="sm">{{ fact.summary }}</c-paragraph>
            </c-stack>
        </c-cluster>
    {% endfor %}

    {% if argocd_available | default(false) %}
        <div id="argocd-{{ deployment.name }}"
             hx-get="/projects/details/{{ project.name }}/argocd-status/{{ deployment.name }}?prefix={{ deployment.name }}"
             hx-trigger="intersect once"
             hx-swap="innerHTML">
            {% include "bg/_argocd-status-skeleton.html.j2" %}
        </div>
    {% endif %}

    {% if user_role in ['admin', 'owner'] %}
        {% set original_index = project.deployments.index(deployment) %}
        {% set bewerken = "openEditModal('modal-edit-deployment-" ~ original_index ~ "', 'Deployment bewerken - " ~ deployment.name ~ "')" %}
        {% set webadres = "openEditModal('modal-edit-domain-" ~ original_index ~ "', 'Webadres bewerken - " ~ deployment.name ~ "')" %}
        {% set verwijderen = "openServiceModal('/projects/" ~ project.name ~ "/actions/delete-deployment/confirm?target=" ~ (deployment.name | urlencode) ~ "', 'Deployment verwijderen')" %}
        <c-action-group align="start">
            <c-button type="secondary" size="sm" label="Bewerken" icon="pencil" :attrs="{'onclick': bewerken}" />
            <c-button type="secondary" size="sm" label="Webadres" icon="globe" :attrs="{'onclick': webadres}" />
            <c-button type="warning" size="sm" label="Verwijderen" icon="trash" :attrs="{'onclick': verwijderen}" />
        </c-action-group>
    {% endif %}
    {# Goedkeuringen die nog niet verleend zijn, zoals de eigenaardienst ze meldt. #}
    {% for notice in approval_notices.get(deployment.name, []) %}
        <c-alert type="{{ 'error' if notice.status == 'denied' else 'warning' }}" heading="{{ notice.text }}">
            <c-stack gap="xs">
                {% if notice.by %}
                    <c-paragraph size="sm">Besluit door {{ notice.by }}{% if notice.date %} op {{ notice.date | dutch_date(include_time=False) }}{% endif %}.</c-paragraph>
                {% endif %}
                {% if notice.message %}
                    <c-paragraph size="sm">Toelichting: {{ notice.message }}</c-paragraph>
                {% endif %}
            </c-stack>
        </c-alert>
    {% endfor %}

    {% if deployment.components %}
        <c-heading type="h4" size="5" label="Componenten" />
        <c-stack gap="sm">
            {% for component in deployment.components | sort(attribute='reference') %}
                <c-layer
                    icon="puzzle-piece"
                    title="{{ component.reference }}"
                    sub="{{ component.image or 'Geen container image geconfigureerd - dit component wordt niet gedeployd' }}" />
            {% endfor %}
        </c-stack>
    {% endif %}

    {% if deployment.get('helm-charts') %}
        <c-heading type="h4" size="5" label="Helm Charts" />
        <c-stack gap="md">
            {% for helm_chart in deployment.get('helm-charts', []) %}
                <c-card outline padding="md">
                    <c-stack gap="sm">
                        <c-cluster gap="sm" align="center">
                            <c-icon icon="rectangle-stack" size="sm" />
                            <c-code>{{ helm_chart.reference }}</c-code>
                        </c-cluster>
                        {% if helm_chart.get('helm-values') and helm_chart['helm-values'] is mapping %}
                            {% set waarden = helm_chart['helm-values'] | length %}
                            <c-cluster gap="sm" align="center">
                                <c-icon icon="lock-closed" size="sm" />
                                <c-paragraph size="sm">Helm Values</c-paragraph>
                                <c-tag type="default" label="{{ waarden }} waarde{{ 'n' if waarden != 1 else '' }}" />
                            </c-cluster>
                            <c-secret-field value="{{ helm_chart['helm-values'] | tojson(indent=2) | forceescape }}" value-type="json" />
                        {% endif %}
                    </c-stack>
                </c-card>
            {% endfor %}
        </c-stack>
    {% endif %}

    {% if deployment.get('helmfile') %}
        <c-heading type="h4" size="5" label="Helmfile" />
        <c-stack gap="md">
            {% for helmfile in deployment.get('helmfile', []) %}
                <c-card outline padding="md">
                    <c-stack gap="sm">
                        <c-cluster gap="sm" align="center">
                            <c-icon icon="rectangle-stack" size="sm" />
                            <c-code>{{ helmfile.reference }}</c-code>
                        </c-cluster>
                        {% if helmfile.get('helm-values') and helmfile['helm-values'] is mapping %}
                            {% set waarden = helmfile['helm-values'] | length %}
                            <c-cluster gap="sm" align="center">
                                <c-icon icon="lock-closed" size="sm" />
                                <c-paragraph size="sm">Helm Values</c-paragraph>
                                <c-tag type="default" label="{{ waarden }} waarde{{ 'n' if waarden != 1 else '' }}" />
                            </c-cluster>
                            <c-secret-field
                                value="{{ helmfile['helm-values'] | tojson(indent=2) | forceescape }}"
                                value-type="json"
                                content-width="lg" />
                        {% endif %}
                    </c-stack>
                </c-card>
            {% endfor %}
        </c-stack>
    {% endif %}

    {% if deployment.ingress_links %}
        <c-heading type="h4" size="5" label="Publieke links" />
        <c-cluster gap="sm">
            {% for link in deployment.ingress_links %}
                {% set link_label = link.component_name ~ (' ' ~ link.path if link.path and link.path != '/' else '') %}
                <c-button
                    type="secondary"
                    size="sm"
                    show-icon="after"
                    icon="link"
                    label="{{ link_label }}"
                    href="{{ link.url }}"
                    target="_blank" />
            {% endfor %}
        </c-cluster>
    {% endif %}

    {# De configuratievariabelen van de deployment zelf staan hier bewust niet; dat besluit
       (hoe geheimen getoond worden) staat nog open, net als op de bestaande pagina. #}

    {# De gebruikersvariabelen van de componenten in deze deployment. #}
    {% set deployment_components = deployment.components | sort(attribute='reference') if deployment.components else [] %}
    {% set eigen_vars = [] %}
    {% for component in deployment_components %}
        {% for project_component in project.components %}
            {% if project_component.name == component.reference and project_component.get('user-env-vars') %}
                {% set _ = eigen_vars.append((component.reference, project_component['user-env-vars'])) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% if eigen_vars %}
        <c-heading type="h4" size="5" label="Gebruikers configuratie" />
        <c-paragraph size="sm">Gebruiker-specifieke omgevingsvariabelen voor deze deployment</c-paragraph>
        <c-stack gap="md">
            {% for reference, variabelen in eigen_vars %}
                <c-card outline padding="md">
                    <c-stack gap="sm">
                        <c-cluster gap="sm" align="center">
                            <c-icon icon="puzzle-piece" size="sm" />
                            <c-heading type="h5" size="6" label="Component: {{ reference }}" />
                        </c-cluster>
                        {% for key, value in variabelen.items() %}
                            <c-cluster gap="sm" align="center">
                                <c-icon icon="lock-closed" size="sm" />
                                <c-paragraph size="sm">{{ key }}</c-paragraph>
                            </c-cluster>
                            <c-secret-field value="{{ value }}" />
                        {% endfor %}
                    </c-stack>
                </c-card>
            {% endfor %}
        </c-stack>
    {% endif %}
{% endcall %}
{% endmacro %}


{# De hele lijst, voor wie dit bestand rechtstreeks rendert. Alfabetisch, net als de
   bestaande pagina. #}
{% if project is defined %}
    {% if project.deployments %}
        <c-stack gap="md">
            {% for deployment in project.deployments | sort(attribute='name') %}
                {{ deployment_panel(deployment, project, approval_notices | default({}), user_role | default('')) }}
            {% endfor %}
        </c-stack>
    {% else %}
        <c-alert type="info" heading="Geen deployments geconfigureerd" />
    {% endif %}
{% endif %}
