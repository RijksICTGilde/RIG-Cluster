{#
  De rollen zelf: wat elke rol is, en of een service account hem kan dragen.
#}
{% from "bg/_patterns.html.j2" import panel %}
{% call panel("De rollen", "user") %}
    <nldd-table columns="1fr 3fr 1.4fr" accessible-label="De rollen">
        <nldd-table-row slot="header">
            <nldd-text-cell text="**Rol**"></nldd-text-cell>
            <nldd-text-cell text="**Waarvoor**"></nldd-text-cell>
            <nldd-text-cell text="**Service account**"></nldd-text-cell>
        </nldd-table-row>
        {% for kolom in kolommen %}
            <nldd-table-row>
                <nldd-text-cell text="{{ kolom.label }}"></nldd-text-cell>
                <nldd-text-cell text="{{ kolom.description }}"></nldd-text-cell>
                <nldd-text-cell text="{{ "ja" if kolom.service_account_reachable else "nee, vraagt een mens" }}"></nldd-text-cell>
            </nldd-table-row>
        {% endfor %}
    </nldd-table>
{% endcall %}
