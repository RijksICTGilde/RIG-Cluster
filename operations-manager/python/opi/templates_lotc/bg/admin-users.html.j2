{#
  Gebruikersbeheer.

  Een OVERNAME van admin/users.html.j2 met de nieuwe componenten, geen herontwerp.
  Dezelfde vier blokken in dezelfde volgorde, dezelfde gegevens, hetzelfde gedrag:

    _kop         -> page_head()
    _actiebalk   -> de knop in de kopregel van het paneel, met de telling erbij
    _tabel       -> c-table in plaats van een eigen <table> met admin-users.css
    _meldingen   -> c-alert in plaats van een kaart met een vinkje en een eigen klasse

  De melding staat onderaan, net als in het origineel. Dat leest niet best - je komt hier
  na een omleiding met ?success=... en die bevestiging vind je dan pas na de hele lijst -
  maar het verplaatsen is een besluit over de pagina en niet over de componenten, en dus
  niet iets om ongemerkt in een omzetting mee te nemen.

  De drie handelingen posten met htmx naast hun action: de step-up zet een dialoog in de
  plaats van het formulier, en die komt alleen terug op een htmx-verzoek. De route
  antwoordt dan met HX-Redirect, want een 303 zou htmx de hele pagina in die dialoog laten
  hangen. Wat ze vragen voordat ze doen gaat door de dialoog uit bg/_bevestiging.html.j2:
  de vraag, de uitleg en het label van de knop staan in data-attributen op het formulier,
  en bevestiging.js kent de combinatie met hx-post.
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head %}

{% block page_title %}Gebruikersbeheer - Self Service Portal{% endblock %}

{% block content %}
    {{ page_head("Gebruikersbeheer", "Beheer de platformgebruikers: e-mailadressen en namen.") }}

    {% set toevoegen %}<c-button type="primary" size="sm" label="Gebruiker toevoegen" icon="plus" show-icon="before" href="/admin/users/create" />{% endset %}
    {% call panel("Platformgebruikers", "person-2", aside=toevoegen) %}
        <c-paragraph size="sm">Totaal: {{ users | length }} gebruiker{{ 's' if users | length != 1 else '' }}</c-paragraph>

        {% if users %}
{# NLDD maakt van een tabel een CSS-grid: zonder columns valt alles in een
               kolom en stapelen de cellen. En c-table-head IS de kopregel, daar hoort
               geen c-table-row in. #}
            {# De laatste kolom draagt vier knoppen naast elkaar en heeft daarom meer
               ruimte nodig dan de datum ervoor; met gelijke breedtes vallen ze onder
               elkaar. #}
            <c-table columns="2fr 3fr 1.5fr 8fr">
                <c-table-head>
                    <c-th>Naam</c-th>
                    <c-th>E-mailadres</c-th>
                    <c-th>Aangemaakt</c-th>
                    <c-th>Acties</c-th>
                </c-table-head>
                {% for user in users %}
                    <c-table-row>
                        <c-td><c-b>{{ user.full_name }}</c-b></c-td>
                        <c-td>{{ user.email }}</c-td>
                        <c-td>{{ user.created_at | dutch_date(include_time=False) }}</c-td>
                        <c-td>
                            <c-cluster gap="sm" align="center">
                                <c-button
                                    type="tertiary"
                                    size="sm"
                                    label="Bewerken"
                                    icon="pencil-on-square"
                                    show-icon="before"
                                    href="/admin/users/{{ user.id }}/edit" />
                                {# De naam gaat in een attribuutwaarde: autoescape beschermt tegen XSS. #}
                                <form autocomplete="off" method="post" action="/admin/users/{{ user.id }}/revoke-sessions"
                                      hx-post="/admin/users/{{ user.id }}/revoke-sessions"
                                      hx-target="#edit-section-inner" hx-swap="innerHTML"
                                      data-bevestig="De sessies van {{ user.full_name }} beëindigen?"
                                      data-bevestig-uitleg="Daarna moet {{ user.full_name }} opnieuw inloggen."
                                      data-bevestig-knop="Sessies beëindigen">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                                    <c-button
                                        type="tertiary"
                                        size="sm"
                                        label="Sessies beëindigen"
                                        icon="logout"
                                        show-icon="before"
                                        html-type="submit" />
                                </form>
                                <form autocomplete="off" method="post" action="/admin/users/{{ user.id }}/delete"
                                      hx-post="/admin/users/{{ user.id }}/delete"
                                      hx-target="#edit-section-inner" hx-swap="innerHTML"
                                      data-bevestig="{{ user.full_name }} verwijderen?"
                                      data-bevestig-uitleg="Daarna kan {{ user.full_name }} niet meer inloggen op het portaal."
                                      data-bevestig-knop="Gebruiker verwijderen">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                                    <c-button
                                        type="warning"
                                        size="sm"
                                        label="Verwijderen"
                                        icon="trash"
                                        show-icon="before"
                                        html-type="submit" />
                                </form>
                                {# Je eigen factor hoort niet hier maar op /account/otp, en de
                                   route weigert hem ook. #}
                                {% if user.email | lower != eigen_email %}
                                    <form autocomplete="off" method="post" action="/admin/users/{{ user.id }}/otp-reset"
                                          hx-post="/admin/users/{{ user.id }}/otp-reset"
                                          hx-target="#edit-section-inner" hx-swap="innerHTML"
                                          data-bevestig="De 2-factor van {{ user.full_name }} leegmaken?"
                                          data-bevestig-uitleg="Daarna richt {{ user.full_name }} hem zelf opnieuw in."
                                          data-bevestig-knop="2-factor leegmaken">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                                        <c-button
                                            type="tertiary"
                                            size="sm"
                                            label="OTP resetten"
                                            icon="lock-open"
                                            show-icon="before"
                                            html-type="submit" />
                                    </form>
                                {% endif %}
                            </c-cluster>
                        </c-td>
                    </c-table-row>
                {% endfor %}
            </c-table>
        {% else %}
            <c-paragraph>Geen gebruikers gevonden. Voeg een gebruiker toe om te beginnen.</c-paragraph>
        {% endif %}
    {% endcall %}

    {% if success_message %}
        <c-alert type="success" heading="{{ success_message }}" />
    {% endif %}

    {% include "bg/_bevestiging.html.j2" %}
    {% include "bg/_step-up-venster.html.j2" %}
{% endblock %}
