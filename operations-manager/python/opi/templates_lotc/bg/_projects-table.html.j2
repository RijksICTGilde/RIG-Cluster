{#
  De projectentabel, plus de telling erboven.

  Een APART bestand omdat dit het stuk is dat htmx vervangt als je zoekt of sorteert:
  de pagina eromheen (kop, knoppen, de toolbar met het zoekveld) blijft staan, alleen dit
  blok komt opnieuw van de server. Vandaar ook de id: #projects-lijst is het doel.

  MAATSTAF: projects-overview/_tabel.html.j2 en _actiebalk.html.j2. Dezelfde vijf
  kolommen in dezelfde volgorde (Project, Omgeving, Team, Services, Acties), dezelfde
  inhoud per cel:

    - Project: de weergavenaam als link, daaronder de projectnaam en de omschrijving,
      met dezelfde terugvaltekst als er geen omschrijving is.
    - Omgeving: het EERSTE cluster, met "Unknown" als er geen is. De semantische kleur
      volgt de omgeving: productie is de zwaarste.
    - Team: het aantal leden, en de initialen van de eerste drie op e-mailadres
      gesorteerd, met een "+n" als er meer zijn.
    - Services: de eerste vier, met een "+n" als er meer zijn.
    - Acties: de link naar de projectpagina.

  Hier stond in plaats van dit alles een lijst met alleen naam, omschrijving en het
  aantal deployments. Dat was geen omzetting maar een herontwerp ("bewust sober"), en
  daarmee verdwenen drie kolommen en de vier totalen zonder dat iemand dat besloten had.
#}

<c-cluster gap="sm" align="center" justify="between">
    <c-paragraph size="sm" color="grijs-500">
        Totaal: {{ projects | length }} project{{ 'en' if projects | length != 1 else '' }}
        {%- if project_query %} van {{ projects_all | length }}{% endif %}
    </c-paragraph>
</c-cluster>

<c-card outline padding="none">
    {# De kolombreedtes staan hier omdat NLDD van een tabel een CSS-grid maakt: zonder
       columns valt alles in een kolom en stapelen de cellen. Dat is geen bug maar de
       manier waarop nldd-table werkt. #}
    <c-table columns="3fr 1fr 1fr 2fr 1fr">
        <c-table-head>
            <c-th>Project</c-th>
            <c-th>Omgeving</c-th>
            <c-th>Team</c-th>
            <c-th>Services</c-th>
            <c-th>Acties</c-th>
        </c-table-head>
        {% for project in projects %}
            <c-table-row>
                <c-td>
                    <c-stack gap="xs">
                        <c-link href="/projects/details/{{ project.name }}" label="{{ project.display_name or project.name }}" weight="bold" />
                        <c-code>{{ project.name }}</c-code>
                        <c-paragraph size="sm" color="grijs-500">{{ project.description or "Geen beschrijving beschikbaar" }}</c-paragraph>
                    </c-stack>
                </c-td>
                <c-td>
                    {% set cluster = project.clusters[0] if project.clusters else "" %}
                    {% if cluster == "production" %}
                        <c-tag type="error" label="Production" />
                    {% elif cluster == "staging" %}
                        <c-tag type="warning" label="Staging" />
                    {% elif cluster %}
                        <c-tag type="info" label="{{ cluster | title }}" />
                    {% else %}
                        <c-tag type="default" label="Unknown" />
                    {% endif %}
                </c-td>
                <c-td>
                    <c-stack gap="xs">
                        <c-paragraph size="sm">{{ project.users | length }} {{ 'lid' if project.users | length == 1 else 'leden' }}</c-paragraph>
                        <c-cluster gap="xs">
                            {% for member in (project.users | sort(attribute='email'))[:3] %}
                                <c-avatar initials="{{ member.email[:2] | upper }}" size="24" decorative />
                            {% endfor %}
                            {% if project.users | length > 3 %}
                                <c-avatar initials="+{{ project.users | length - 3 }}" size="24" decorative />
                            {% endif %}
                        </c-cluster>
                    </c-stack>
                </c-td>
                <c-td>
                    <c-cluster gap="xs">
                        {% for service in project.services[:4] %}
                            <c-tag type="default" label="{{ service | service_name | replace('-', ' ') | title }}" />
                        {% endfor %}
                        {% if project.services | length > 4 %}
                            <c-tag type="default" label="+{{ project.services | length - 4 }}" />
                        {% endif %}
                    </c-cluster>
                </c-td>
                <c-td>
                    <c-link href="/projects/details/{{ project.name }}" label="Details" />
                </c-td>
            </c-table-row>
        {% endfor %}
    </c-table>

    {% if not projects %}
        <c-cluster gap="sm" align="center">
            <c-icon icon="info" size="lg" />
            <c-paragraph>
                {%- if project_query -%}
                    Geen projecten gevonden voor "{{ project_query }}".
                {%- else -%}
                    Geen projecten gevonden waar je toegang toe hebt.
                {%- endif -%}
            </c-paragraph>
        </c-cluster>
    {% endif %}
</c-card>
