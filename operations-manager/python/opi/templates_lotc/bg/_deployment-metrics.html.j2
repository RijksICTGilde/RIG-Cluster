{#
  De metingen van een deployment, als los fragment.

  Overname van partials/deployment_metrics.html.j2. Dezelfde drie gevallen in dezelfde
  volgorde - componenten, ontdekte workloads (Helm), en anders "geen componenten" - plus
  de PVC-opslag eronder, en dezelfde tijdvakknoppen erboven met hetzelfde htmx-gedrag.

  DE GRAFIEKEN ZIJN GRAFIEKEN

  Hier stonden een tijd voortgangsbalken met alleen de huidige waarde. Dat is
  teruggedraaid: het VERLOOP over de tijd is waarvoor je deze pagina opent, en een piek van
  tien minuten geleden is op een balkje niet te zien. Dezelfde canvassen met dezelfde id's
  (cpu-chart-, mem-chart-, net-in-chart-, net-out-chart-, disk-read-chart-,
  disk-write-chart-, pvc-chart-), dezelfde data-attributen en dezelfde klasse
  ``metrics-chart``, want daar zoekt de tekencode op.

  Diezelfde keuze is eerder op het dashboard gemaakt, met dezelfde reden en dezelfde
  oplossing: de tekenfunctie staat in static/js/metrics_charts.js en wordt door BEIDE
  vormgevingen gebruikt, zodat er geen tweede kopie is die uit de pas gaat lopen.

  WAAROM DIT FRAGMENT ZIJN EIGEN STIJL EN SCRIPTS MEEBRENGT

  Op de bestaande pagina laadt project-details.html.j2 Chart.js, de annotatie-plugin, de
  tekencode en de maten (project-details.css) zelf. De hertekende projectpagina doet dat
  niet: dit blok komt daar als dienstblok binnen en de pagina weet niet dat het bestaat.
  Dus haalt het fragment onderaan zelf op wat het nodig heeft, precies een keer per
  document, en tekent het daarna. Een canvas zonder tekencode of zonder hoogte staat er
  namelijk gewoon - leeg, en zonder foutmelding.
#}
{% from "bg/_patterns.html.j2" import panel %}

{% set active_duration = duration | default(60) %}
{% set durations = [(60, "1 uur"), (120, "2 uur"), (360, "6 uur"), (720, "12 uur"), (1440, "24 uur")] %}

{#
  Een meting als grafiek: het canvas met zijn reeks in data-attributen, precies zoals de
  bestaande pagina hem neerzet. De tekencode leest ze daar uit.
#}
{% macro grafiek(canvas_id, label, timestamps, waarden, limiet, kleur, extra_class='', request=none, warning=none, critical=none) %}
<div class="chart-wrapper">
    <canvas id="{{ canvas_id }}"
            class="metrics-chart{% if extra_class %} {{ extra_class }}{% endif %}"
            data-timestamps='{{ timestamps | default([]) | tojson }}'
            data-values='{{ waarden | default([]) | map(attribute="value") | list | tojson }}'
            data-limit='{{ limiet | default("null") }}'
            {%- if request is not none %}
            data-request='{{ request | default("null") }}'
            {%- endif %}
            {%- if warning is not none %}
            data-warning='{{ warning | default("null") }}'
            {%- endif %}
            {%- if critical is not none %}
            data-critical='{{ critical | default("null") }}'
            {%- endif %}
            data-color="{{ kleur }}"
            aria-label="{{ label }}"></canvas>
</div>
{% endmacro %}

<div class="metrics-toolbar">
    {% for value, label in durations %}
    {# Het doel is het blok van DEZE deployment: metrics-content-<naam>, zoals
       metrics_scraper/section-deployment.html.j2 het neerzet. Hier stond #metrics-content, en dat
       id bestaat nergens - de tijdvakknoppen deden dus niets. Dezelfde fout stond in het
       roos-origineel en is daar op dezelfde manier gerepareerd. #}
    <c-button size="xs"
              type="{{ 'primary' if value == active_duration else 'secondary' }}"
              label="{{ label }}"
              hx-get="/projects/details/{{ project_name }}/metrics/{{ deployment.name }}?duration={{ value }}"
              hx-target="#metrics-content-{{ deployment.name }}"
              hx-swap="innerHTML" />
    {% endfor %}
</div>

{% if deployment.components %}
<div class="metrics-grid">
    {% for component in deployment.components | sort(attribute='reference') %}
    {% set component_name = component.reference %}
    {% set m = metrics.get(component_name, {}) %}
    {% call panel(component_name, "puzzle-piece") %}
        <div class="charts-container">
            {# CPU Chart #}
            <div class="chart-item">
                <div class="chart-label">CPU (millicores){% if m.cpu_limit %} - Limit: {{ m.cpu_limit|int }}m{% endif %}</div>
                {{ grafiek("cpu-chart-" ~ deployment.name ~ "-" ~ component_name, "CPU", m.cpu_timestamps, m.cpu, m.cpu_limit, "#39870c") }}
                {% if m.cpu %}
                <div class="chart-current">Current: {{ "%.1f"|format(m.cpu[-1].value) }}m{% if m.cpu_limit %} / {{ m.cpu_limit|int }}m ({{ "%.0f"|format(m.cpu[-1].value / m.cpu_limit * 100) }}%){% endif %}</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Memory Chart #}
            <div class="chart-item">
                <div class="chart-label">Memory (MB){% if m.memory_limit %} - Limit: {{ m.memory_limit|int }} MB{% endif %}</div>
                {{ grafiek("mem-chart-" ~ deployment.name ~ "-" ~ component_name, "Memory", m.memory_timestamps, m.memory, m.memory_limit, "#007bc7", request=m.memory_request | default("null")) }}
                {% if m.memory %}
                <div class="chart-current">Current: {{ "%.0f"|format(m.memory[-1].value) }} MB{% if m.memory_limit %} / {{ m.memory_limit|int }} MB ({{ "%.0f"|format(m.memory[-1].value / m.memory_limit * 100) }}%){% endif %}{% if m.memory_request and m.memory_request != m.memory_limit %} - Request: {{ m.memory_request|int }} MB{% endif %}</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Network In Chart #}
            <div class="chart-item">
                <div class="chart-label">Network In (KB/s)</div>
                {{ grafiek("net-in-chart-" ~ deployment.name ~ "-" ~ component_name, "Network In", m.network_timestamps, m.network_in, "null", "#154273") }}
                {% if m.network_in %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.network_in[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Network Out Chart #}
            <div class="chart-item">
                <div class="chart-label">Network Out (KB/s)</div>
                {{ grafiek("net-out-chart-" ~ deployment.name ~ "-" ~ component_name, "Network Out", m.network_timestamps, m.network_out, "null", "#8fcae7") }}
                {% if m.network_out %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.network_out[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Disk Read Chart #}
            <div class="chart-item">
                <div class="chart-label">Disk Read (KB/s)</div>
                {{ grafiek("disk-read-chart-" ~ deployment.name ~ "-" ~ component_name, "Disk Read", m.disk_timestamps, m.disk_read, "null", "#673327") }}
                {% if m.disk_read %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.disk_read[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Disk Write Chart #}
            <div class="chart-item">
                <div class="chart-label">Disk Write (KB/s)</div>
                {{ grafiek("disk-write-chart-" ~ deployment.name ~ "-" ~ component_name, "Disk Write", m.disk_timestamps, m.disk_write, "null", "#c9742f") }}
                {% if m.disk_write %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.disk_write[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>
        </div>
    {% endcall %}
    {% endfor %}
</div>
{% elif discovered_workloads %}
{# Een Helm-deployment: dan zijn de workloads niet uit het projectbestand bekend maar uit
   het cluster ontdekt. Zonder schijfmetingen, net als de bestaande pagina. #}
<div class="metrics-grid">
    {% for workload in discovered_workloads %}
    {% set workload_name = workload.name %}
    {% set workload_id = workload_name | replace('.', '-') | replace(':', '-') %}
    {% set m = metrics.get(workload_name, {}) %}
    {% set pods %}<span class="pod-count-chip">{{ workload.pod_count }} pod{% if workload.pod_count != 1 %}s{% endif %}</span>{% endset %}
    {% call panel(workload_name, "rectangle-stack", aside=pods) %}
        <div class="charts-container">
            {# CPU Chart #}
            <div class="chart-item">
                <div class="chart-label">CPU (millicores){% if m.cpu_limit %} - Limit: {{ m.cpu_limit|int }}m{% endif %}</div>
                {{ grafiek("cpu-chart-" ~ deployment.name ~ "-" ~ workload_id, "CPU", m.cpu_timestamps, m.cpu, m.cpu_limit, "#39870c") }}
                {% if m.cpu %}
                <div class="chart-current">Current: {{ "%.1f"|format(m.cpu[-1].value) }}m{% if m.cpu_limit %} / {{ m.cpu_limit|int }}m ({{ "%.0f"|format(m.cpu[-1].value / m.cpu_limit * 100) }}%){% endif %}</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Memory Chart #}
            <div class="chart-item">
                <div class="chart-label">Memory (MB){% if m.memory_limit %} - Limit: {{ m.memory_limit|int }} MB{% endif %}</div>
                {{ grafiek("mem-chart-" ~ deployment.name ~ "-" ~ workload_id, "Memory", m.memory_timestamps, m.memory, m.memory_limit, "#007bc7") }}
                {% if m.memory %}
                <div class="chart-current">Current: {{ "%.0f"|format(m.memory[-1].value) }} MB{% if m.memory_limit %} / {{ m.memory_limit|int }} MB ({{ "%.0f"|format(m.memory[-1].value / m.memory_limit * 100) }}%){% endif %}</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Network In Chart #}
            <div class="chart-item">
                <div class="chart-label">Network In (KB/s)</div>
                {{ grafiek("net-in-chart-" ~ deployment.name ~ "-" ~ workload_id, "Network In", m.network_timestamps, m.network_in, "null", "#154273") }}
                {% if m.network_in %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.network_in[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>

            {# Network Out Chart #}
            <div class="chart-item">
                <div class="chart-label">Network Out (KB/s)</div>
                {{ grafiek("net-out-chart-" ~ deployment.name ~ "-" ~ workload_id, "Network Out", m.network_timestamps, m.network_out, "null", "#01689b") }}
                {% if m.network_out %}
                <div class="chart-current">Current: {{ "%.2f"|format(m.network_out[-1].value) }} KB/s</div>
                {% else %}
                <div class="chart-current no-data">No data</div>
                {% endif %}
            </div>
        </div>
    {% endcall %}
    {% endfor %}
</div>
{% else %}
<c-alert type="info" heading="Geen components in deze deployment" />
{% endif %}

{# PVC Storage Section #}
{% if pvc_storage %}
<div class="pvc-storage-section">
    <div class="pvc-storage-header">
        <c-heading type="h4" size="5" label="Persistent Storage" />
        <c-paragraph size="sm">PVC disk usage</c-paragraph>
    </div>
    <div class="metrics-grid">
        {% for pvc_name, pvc_data in pvc_storage.items() %}
        {% call panel(pvc_name, "database") %}
            <div class="chart-item">
                <div class="chart-label">Storage Usage (GB) - Capacity: {{ "%.1f"|format(pvc_data.capacity_gb) }} GB</div>
                {{ grafiek("pvc-chart-" ~ deployment.name ~ "-" ~ (pvc_name | replace('.', '-') | replace(':', '-')),
                           "Storage Usage",
                           pvc_data["timestamps"],
                           pvc_data["values"],
                           pvc_data.capacity_gb,
                           "#6a1b9a",
                           extra_class="pvc-storage-chart",
                           warning=pvc_data.warning_threshold_gb | default("null"),
                           critical=pvc_data.critical_threshold_gb | default("null")) }}
                {% if pvc_data["values"] %}
                {% set current_used = pvc_data["values"][-1].value %}
                {% set usage_percent = (current_used / pvc_data.capacity_gb * 100) if pvc_data.capacity_gb else 0 %}
                <div class="chart-current {% if usage_percent >= 90 %}critical{% elif usage_percent >= 80 %}warning{% endif %}">
                    Current: {{ "%.2f"|format(current_used) }} GB / {{ "%.1f"|format(pvc_data.capacity_gb) }} GB ({{ "%.0f"|format(usage_percent) }}%)
                </div>
                {% else %}
                <div class="chart-current no-data">No PVC data</div>
                {% endif %}
            </div>
        {% endcall %}
        {% endfor %}
    </div>
</div>
{% endif %}

{# Wat de bestaande pagina in haar <head> laadt, haalt dit fragment zelf op: de maten van
   de grafieken, Chart.js met zijn annotatie-plugin, en de tekencode. Een keer per
   document - een tweede deployment die zijn blok opent vindt ze al staan - en op volgorde,
   want de plugin heeft Chart nodig en de tekencode heeft beide nodig. Pas als alles er is
   wordt er getekend; dat is dezelfde aanroep die het roos-fragment doet, alleen wacht deze
   op zijn scripts in plaats van aan te nemen dat de pagina ze al had. #}
<script>
(function () {
    var stijl = "{{ static_url('css/metrics-charts.css') }}";
    var scripts = [
        "https://cdn.jsdelivr.net/npm/chart.js",
        "https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation",
        "{{ static_url('js/metrics_charts.js') }}"
    ];

    if (!document.querySelector('link[data-metrics-asset]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = stijl;
        link.setAttribute('data-metrics-asset', stijl);
        document.head.appendChild(link);
    }

    function teken() {
        if (typeof initMetricsCharts === 'function') initMetricsCharts();
    }

    function laad(i) {
        if (i >= scripts.length) { teken(); return; }
        var src = scripts[i];
        var volgende = function () { laad(i + 1); };
        var bestaand = document.querySelector('script[data-metrics-asset="' + src + '"]');
        if (bestaand) {
            if (bestaand.getAttribute('data-geladen') === 'ja') { volgende(); }
            else { bestaand.addEventListener('load', volgende); bestaand.addEventListener('error', volgende); }
            return;
        }
        var el = document.createElement('script');
        el.setAttribute('data-metrics-asset', src);
        el.addEventListener('load', function () { el.setAttribute('data-geladen', 'ja'); volgende(); });
        /* Een script dat niet komt (de CDN is onbereikbaar) mag de rij niet ophouden: dan
           faalt het tekenen zichtbaar, net als op de bestaande pagina, in plaats van dat
           er stil niets gebeurt. */
        el.addEventListener('error', volgende);
        el.src = src;
        document.head.appendChild(el);
    }

    laad(0);
})();
</script>
