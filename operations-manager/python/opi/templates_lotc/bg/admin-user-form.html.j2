{#
  Het formulier waarmee een platformgebruiker wordt toegevoegd of bewerkt.

  Een OVERNAME van admin/user-form.html.j2. Dezelfde route, dezelfde velden, dezelfde
  twee knoppen; alleen de omlijsting komt nu uit het thema.

    <c-heading>            -> page_head(), zonder ondertitel want de bestaande pagina
                              heeft er geen en er is er hier niets bij te verzinnen
    <c-card> met <form>    -> panel() zonder kop, zodat de kaart een kaart blijft en de
                              afstanden erbinnen uit de stack komen
    div.user-form-actions  -> c-action-group, de plek die het thema voor formulier-
                              knoppen heeft

  Het formulier zelf staat in bg/_admin-user-form.html.j2: de route rendert dat fragment
  ook los, en het vervangt dan zichzelf, hier op de pagina of in de dialoog van de step-up.
#}
{% extends "base_lotc.html.j2" %}
{% from "bg/_patterns.html.j2" import panel, page_head %}

{% block page_title %}{{ page_heading }} - Self Service Portal{% endblock %}

{% block content %}
    {{ page_head(page_heading) }}

    {% call panel("") %}
        {% include "bg/_admin-user-form.html.j2" %}
    {% endcall %}

    {% include "bg/_step-up-venster.html.j2" %}
{% endblock %}
