{# De balk die het resourcegebruik over de projecten verdeelt.

   De kop staat IN de kaart: dit is een kop van EEN blok, en die hoort in dat blok. Hij
   stond ernaast, als losse <c-heading> boven de kaart, waardoor hij bij het wegvallen
   van de eigen afstanden tegen de kaartrand plakte. panel() uit bg/_patterns.html.j2 is
   wat het thema daarvoor levert (c-card + c-section-head), dezelfde als op de andere
   dashboardblokken. #}
{% from "bg/_patterns.html.j2" import panel %}
{% if prometheus_available and total_cpu_usage is defined and total_cpu_usage > 0 %}
    {% call panel("Resource Verdeling", "chart-x-y-axis-line") %}
        <c-layout-flow gap="md">
            <p>CPU gebruik per project</p>
            <div class="resource-bar">
                {% for project in projects %}
                    {% if project.cpu_cores is defined and project.cpu_cores > 0 %}
                    <div class="resource-segment resource-color-{{ loop.index0 % 6 }}"
                         data-width="{{ (project.cpu_cores / total_cpu_usage * 100) | round(1) }}"
                         title="{{ project.display_name }}: {{ '%.3f' | format(project.cpu_cores) }} cores">
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
            {# .resource-legend was flex + wrap + gap: <c-cluster>. De items zelf blijven
               een eigen <a> met eigen flex - een cluster rendert een <div>, en daar mag
               geen link omheen die zelf weer een klikbaar geheel is. #}
            <c-cluster gap="md">
                {% for project in projects %}
                    {% if project.cpu_cores is defined and project.cpu_cores > 0 %}
                    <a href="/projects/details/{{ project.name }}" class="resource-legend-item">
                        <span class="resource-dot resource-color-{{ loop.index0 % 6 }}"></span>
                        <span>{{ project.display_name }}</span>
                        <span>{{ '%.3f' | format(project.cpu_cores) }} cores ({{ (project.cpu_cores / total_cpu_usage * 100) | round(1) }}%)</span>
                    </a>
                    {% endif %}
                {% endfor %}
            </c-cluster>
        </c-layout-flow>
    {% endcall %}
{% endif %}
