{# Swagger-UI, in plaats van FastAPI's get_swagger_ui_html.

   Die functie bouwt de HTML in Python en kent geen nonce, dus zijn twee scripts vielen
   buiten de nonce-dekking (features/security-headers.md). Dezelfde bestanden uit static/,
   dezelfde parameters als swagger_ui_default_parameters. #}
<!DOCTYPE html>
<html lang="nl">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link type="text/css" rel="stylesheet" href="{{ static_url('swagger-ui/swagger-ui.css') }}">
<link rel="shortcut icon" href="/favicon.ico">
<title>{{ titel }}</title>
</head>
<body>
<div id="swagger-ui"></div>
<script nonce="{{ csp_nonce }}" src="{{ static_url('swagger-ui/swagger-ui-bundle.js') }}"></script>
<script nonce="{{ csp_nonce }}">
const ui = SwaggerUIBundle({
    url: {{ openapi_url | tojson }},
    dom_id: "#swagger-ui",
    layout: "BaseLayout",
    deepLinking: true,
    showExtensions: true,
    showCommonExtensions: true,
    presets: [SwaggerUIBundle.presets.apis, SwaggerUIBundle.SwaggerUIStandalonePreset]
})
</script>
</body>
</html>
