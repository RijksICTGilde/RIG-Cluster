{# De keuzes voor dienst, metriek en filter, met de knop. #}
<div class="metrics-controls">
    <div class="metrics-controls__row">
        {# Service selector #}
        <div class="metrics-controls__field">
            <label for="service-select"><strong>Service</strong></label>
            <select id="service-select" class="lotc-select">
                <option value="">-- Selecteer een service --</option>
                {% for service in services %}
                    <option value="{{ service.id }}">{{ service.name }}</option>
                {% endfor %}
            </select>
            <span id="service-description"></span>
        </div>

        {# Metric selector #}
        <div class="metrics-controls__field">
            <label for="metric-select"><strong>Metric</strong></label>
            <select id="metric-select" class="lotc-select" disabled>
                <option value="">-- Selecteer eerst een service --</option>
            </select>
            <span id="metric-count"></span>
        </div>

        {# Show button #}
        <div class="metrics-controls__field metrics-controls__field--button">
            {% set lotc_onclick_1 %}showMetric(){% endset %}<c-button label="Tonen in Prometheus" disabled/>
        </div>
    </div>

    {# Metric filter #}
    <div class="metrics-controls__filter is-hidden" id="filter-container">
        <label for="metric-filter"><strong>Filter metrics:</strong></label>
        <input type="text" id="metric-filter" class="lotc-input" placeholder="Type om te filteren..." oninput="filterMetrics()" />
    </div>
</div>
