{% extends "base_lotc.html.j2" %}

{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<c-layout-flow gap="lg" size="lg">
    <c-heading type="h1" label="Dynamic Form Demo"/>

    <c-span>
        Dit is een demonstratie van het dynamische formulier systeem.
        Het formulier wordt gegenereerd vanuit een Pydantic model met FormMeta annotaties.
    </c-span>

    {# Form Container #}
    <div class="project-form-container">
        <form method="POST" action="/projects/form-demo" autocomplete="off">
            {{ form_html | process_components }}
        </form>
    </div>

    {# Debug: Show extracted fields #}
    <c-fieldset legend="Debug: Extracted Fields">
        <div class="debug-fields">
            <table class="rvo-table">
                <thead>
                    <tr>
                        <th>Field Name</th>
                        <th>Widget Type</th>
                        <th>Required</th>
                        <th>Label</th>
                    </tr>
                </thead>
                <tbody>
                    {% for field in fields %}
                    <tr>
                        <td><code>{{ field.name }}</code></td>
                        <td>{{ field.widget_type }}</td>
                        <td>{{ "Ja" if field.required else "Nee" }}</td>
                        <td>{{ field.label }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </c-fieldset>

    {# Debug: Show project data #}
    <c-fieldset legend="Debug: Project Data (JSON)">
        <pre class="debug-json">{{ project_data | tojson(indent=2) }}</pre>
    </c-fieldset>
</c-layout-flow>

    <link rel="stylesheet" href="{{ static_url('css/project-form-demo.css') }}">
{% endblock %}
