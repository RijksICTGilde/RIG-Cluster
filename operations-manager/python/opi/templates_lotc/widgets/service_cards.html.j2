{#
  Dienstkaarten voor de LOTC-bouwlijn.

  Zelfde afweging als bij preset_cards: de eigen kaartklassen blijven, de componenttags
  gaan om. aria-disabled blijft bewust naast disabled bestaan - een vergrendelde dienst
  moet mee de POST in, alleen aanpassen mag niet.

  Omgezet uit de roos-versie: bool_attr/optional_attr zijn :prop="expr" geworden en de
  attribuutbundels een enkele :attrs-spread. De roos-macro's schreven attribuut-TEKST
  middenin de tag, en dat leest de LOTC-voorbewerker als een attribuutnaam.
#}
{% from "widgets/_macros.html.j2" import helper_text, render_errors, service_block %}
<div class="rvo-form-group">
    <span class="utrecht-form-label rvo-form-field__label-text">{{ field.label|e }}</span>
    {{ helper_text(field) }}
    <div class="service-cards-grid" id="{{ field.path|e }}-grid">
        {% for card in cards %}
        <div class="service-card{% if card.checked %} service-card--selected{% endif %}{% if card.is_locked %} service-card--locked-checked{% endif %}" data-service="{{ card.value|e }}"{% if card.data_requires %} data-requires='{{ card.data_requires }}'{% endif %}{% if card.server_locked %} data-locked="true"{% endif %}>
            {# Vergrendeld is aria-disabled, niet disabled: de waarde moet mee de POST in,
                   alleen aanpassen mag niet. Server-side gezet zodat het klopt vanaf het
                   eerste beeld; wizard.js houdt het bij zodra een keuze het slot verplaatst. #}
            <c-checkbox
                id="{{ field.path|e }}-{{ card.value|e }}"
                name="{{ field.path|e }}[]"
                value="{{ card.value|e }}"
                :checked="card.checked"
                :disabled="card.disabled"
                aria-disabled="{{ 'true' if card.is_locked else 'false' }}"
            />
            <div class="service-card__content">
                {{ service_block(card.label, card.description, card.icon, card.color, card.help_template) }}
                {% if card.is_locked and card.dependents_labels %}
                <p class="service-card__hint service-card__hint--depends">Vereist door: {{ card.dependents_labels|join(', ')|e }}</p>
                {% endif %}
                {% if card.config_hint %}
                {# Shown only while the card is selected (see .service-card__hint--config
                   in wizard.css): before ticking there is nothing to explain. #}
                <p class="service-card__hint service-card__hint--config">{{ card.config_hint|e }}</p>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {{ render_errors(field.errors) }}
</div>
