{#
  Keuzerondjes voor de LOTC-bouwlijn.

  De roos-versie schreef het label, de hulptekst en de foutmelding zelf uit met eigen
  rvo-klassen eromheen. Dat is precies de omlijsting die bij een themawissel achterblijft,
  dus die gaat hier naar c-fieldset: die levert de groepskop en houdt de rondjes bij
  elkaar, in de vormgeving van het thema.
#}
{% from "widgets/_macros.html.j2" import combined_helper, render_examples, render_errors %}
<c-fieldset
    id="{{ field.path|e }}"
    legend="{{ field.label|e }}"
>
    {% if combined_helper(field)|trim %}
        <c-paragraph>{{ combined_helper(field)|trim }}</c-paragraph>
    {% endif %}
    {{ render_examples(field) }}
    <c-layout-flow gap="md">
        {% for option in options %}
            <c-radio
                name="{{ field.path|e }}"
                value="{{ option.value|e }}"
                label="{{ option.label|e }}"
                :checked="option.checked"
                :disabled="field.readonly" />
            {% if option.description %}
                <c-paragraph size="sm">{{ option.description|e }}</c-paragraph>
            {% endif %}
        {% endfor %}
    </c-layout-flow>
</c-fieldset>
{{ render_errors(field.errors) }}
