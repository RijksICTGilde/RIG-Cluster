{#
  Een item in een herhaalbare reeks, als kaart. Zie sequence.html.j2 voor waarom de
  eigen klassen blijven staan.

  Omgezet uit de roos-versie: bool_attr/optional_attr zijn :prop="expr" geworden en de
  attribuutbundels een enkele :attrs-spread. De roos-macro's schreven attribuut-TEKST
  middenin de tag, en dat leest de LOTC-voorbewerker als een attribuutnaam.
#}
{% set min_items = (field.min_items or field.attributes.get('min_items', 0))|int %}
{% set max_items = field.max_items or field.attributes.get('max_items') %}
{% set fixed_size = max_items is not none and min_items == max_items|int %}
{% set remove_disabled = (field.children|length if field.children else 0) <= min_items %}
{% set remove_label = field.attributes.get('remove_label', 'Verwijderen') %}
<div class="rvo-sequence__item rvo-card rvo-card--outline rvo-card--padding-md" data-index="{{ index }}">
    {% if not fixed_size and field.add_remove %}
    <div class="rvo-sequence__item-header">
        <span></span>
        {# @click met Jinja erin werkt niet: de voorbewerker leest de waarde van een
       @-attribuut als kale tekst, dus {{ ... }} komt er letterlijk uit en de knop doet
       stilletjes niets. Via de :attrs-spread wordt het wel een expressie, en geescapet. #}
        {% set verwijder_js = "sequenceRemove('" ~ field.path ~ "', " ~ index|string ~ ")" %}
        <c-button type="warning-subtle" size="sm"
                  show-icon="before" icon="verwijderen"
                  :attrs="{'onclick': verwijder_js}"
                  :disabled="remove_disabled">
            {{ remove_label|e }}
        </c-button>
    </div>
    {% endif %}
    <div class="rvo-sequence__item-content">
        <c-layout-flow gap="md">
            {{ item_html }}
        </c-layout-flow>
    </div>
</div>
