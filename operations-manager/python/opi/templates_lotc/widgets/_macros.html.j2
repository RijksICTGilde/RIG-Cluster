{#
  Shared macros for widget templates.

  Usage: {% from "widgets/_macros.html.j2" import helper_text, render_examples, bool_attr, optional_attr, render_errors, htmx_attrs, extra_attrs, format_value, combined_helper, description_text %}
#}

{# --- Attribute helpers --- #}

{% macro bool_attr(name, value) %}{% if value %}:{{ name }}="true"{% endif %}{% endmacro %}

{% macro optional_attr(name, value) %}{% if value is not none and value != '' %}{{ name }}="{{ value|attr_escape }}"{% endif %}{% endmacro %}

{% macro htmx_attrs(field) %}{% if field.htmx_attrs %}{% for k, v in field.htmx_attrs.items() %}{{ k|e }}="{{ v|e }}" {% endfor %}{% endif %}{% endmacro %}

{% macro extra_attrs(field, handled) %}
{%- set skip = handled|default(['rows','min','max','step','accept','multiple','min_items','max_items','add_label','remove_label','options_provider','converter','validator','kv_format','icon','icon_color']) -%}
{%- for k, v in field.attributes.items() if k not in skip %}{{ k|e }}="{{ v|e }}" {% endfor -%}
{% endmacro %}

{% macro html_attributes(attrs) %}{% for k, v in attrs.items() %}{{ k|e }}="{{ v|e }}" {% endfor %}{% endmacro %}

{# --- Text helpers --- #}

{% macro combined_helper(field) %}
{%- if field.help_text -%}{{ field.help_text }}
{%- elif field.description -%}{{ field.description }}
{%- endif -%}
{% endmacro %}

{% macro description_text(field) %}
{%- if field.description and field.help_text -%}
<span>{{ field.description }}<br><br></span>
{%- endif -%}
{% endmacro %}

{% macro helper_text(field) %}
{% if field.description and field.help_text %}
<div class="lotc-form-field__helper-group">
<span>{{ field.description }}</span>
<span>{{ field.help_text }}</span>
</div>
{% elif field.description %}
<span>{{ field.description }}</span>
{% elif field.help_text %}
<span>{{ field.help_text }}</span>
{% endif %}
{% endmacro %}

{% macro render_examples(field) %}
{% if field.examples %}
<div>
Voorbeelden: {% for ex in field.examples %}<code>{{ ex|e }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
</div>
{% endif %}
{% endmacro %}

{# --- Service block --- #}

{#
  One service, rendered the same everywhere: icon, name, help button, description.
  Used by the service picker (widgets/service_cards.html.j2) and the service
  overview page (services-overview.html.j2). Both used to build this themselves
  and drifted apart -- the overview lost the help button. Keep it here.

  The help button only appears when the service has a help_template, and needs
  openServiceHelp() (static/js/wizard.js) plus the help modal
  (widgets/service_help_modal.html.j2) on the page.
#}
{#
  DE KEUZEKAART: de schil van een kaart die je aan kunt vinken.

  Op EEN plek, want hij wordt op twee plaatsen gebruikt - de dienstenkiezer
  (widgets/service_cards.html.j2) en de voorinstellingen (widgets/preset_cards.html.j2) -
  en de vorige keer dat zoiets op twee plaatsen stond liepen ze uit de pas.

  Wat er in deze schil zit is precies het stuk dat NIET mag afwijken, want het is met
  meten tot stand gekomen:

  - Rechtstreeks <nldd-card> en geen <c-card>. Die laatste zet altijd een
    <nldd-container> om zijn inhoud, en de schaduw-div daarbinnen groeit niet mee met zijn
    eigen host. Gemeten op een korte kaart in een hoge rij: kaart 426px, container 426px,
    de div erin 214px. Alles eronder volgde die 214, dus het aanvinkvakje bleef halverwege
    hangen in plaats van onderaan.
  - De padding komt van <c-box> en de inhoud van <c-stack>. Dat zijn gewone divs uit de
    layoutlaag zonder schaduwboom, dus `flex-grow` werkt er gewoon op
    (static/css/wizard.css, .service-card__vak en .service-card__body).
  - De klasse service-card is een HAAK, geen opmaak: static/js/wizard.js zoekt de kaarten
    ermee op, en zo ook drie e2e-tests.

  ``attrs`` is een dict die letterlijk op de kaart komt. Daar hangt het gedrag aan: de
  dienstenkiezer zet er data-service en background in, de voorinstellingen hun hx-post.
#}
{% macro keuzekaart(gekozen=False, vergrendeld=False, attrs=None) %}
<nldd-card class="service-card{% if gekozen %} service-card--selected{% endif %}{% if vergrendeld %} service-card--locked-checked{% endif %}"
           outline
           {% for naam, waarde in (attrs or {}).items() %}{{ naam }}="{{ waarde|e }}" {% endfor %}>
    <c-box pad="lg" class="service-card__vak">
    <c-stack gap="sm" class="service-card__body">
        {{ caller() }}
    </c-stack>
    </c-box>
</nldd-card>
{% endmacro %}

{#
  Het aanvinkvakje van een keuzekaart: onderaan, rechts, zonder tekst ernaast.

  Een kale <nldd-checkbox> en geen <c-checkbox>: die laatste wordt een
  <nldd-checkbox-field> en tekent naast het vakje altijd een <span> met zijn label. Hier
  hoort geen tekst bij, want de naam staat al als kop in de kaart. Het kale component
  draagt zijn toegankelijke naam in accessible-label en is net zo goed form-associated.

  ``naam`` leeg laten maakt het vakje pure bediening: de voorinstellingen sturen hun eigen
  verzoek en zouden met een name een tweede waarde meesturen.

  ``vergrendeld`` zet ``aria-disabled`` op het VAKJE en niet alleen op de kaart. Dat is waar
  het hoort: een kaart is geen bediening, en een <nldd-card> heeft geen rol, dus een
  aria-disabled daarop kondigt niets aan. Bij de omzetting naar componenten is die markering
  van het vakje afgevallen en alleen op de kaart blijven staan.

  Let op wat dit vandaag WEL en NIET doet. <nldd-checkbox> zet zijn echte <input> in een
  schaduwboom en geeft daar alleen ``aria-label`` (uit accessible-label) en ``disabled`` aan
  door. Dit attribuut blijft dus op de host staan en bereikt de bediening nog niet; dat is
  gevraagd in request_for_components.md ("een vergrendeld aanvinkvakje dat zijn waarde wel
  meestuurt"). Disabled is hier GEEN alternatief: dat onderdrukt de waarde in de POST, en
  precies zo verdween een vergrendelde dienst ooit stil uit het projectbestand.

  Op een vakje dat WEL ``uit`` is komt het attribuut niet: ``aria-disabled="false"`` naast
  een ``disabled`` is een tegenspraak in de markup. De voorinstellingen gebruiken die vorm.
#}
{% macro kaart_vakje(id, label, gekozen=False, uit=False, naam='', waarde='', vergrendeld=False) %}
<c-cluster justify="end" class="service-card__kies">
    <nldd-checkbox
        id="{{ id|e }}"
        {% if naam %}name="{{ naam|e }}"{% endif %}
        {% if waarde %}value="{{ waarde|e }}"{% endif %}
        accessible-label="{{ label|e }}"
        {% if not uit %}aria-disabled="{{ 'true' if vergrendeld else 'false' }}"{% endif %}
        {% if gekozen %}checked{% endif %}
        {% if uit %}disabled{% endif %}></nldd-checkbox>
</c-cluster>
{% endmacro %}

{% macro service_block(name, description, icon, color, help_template=None, icon_size="lg") %}
{# HET BLOK DAT EEN DIENST VOORSTELT: icoon, naam, vraagteken op een regel, met de
   omschrijving eronder. Op EEN plek, want de dienstenkiezer in de wizard en het
   dienstenoverzicht bouwden dit allebei zelf en liepen uit de pas - het overzicht was
   toen zijn vraagtekenknop kwijt. tests/test_service_help.py bewaakt dat ze het blijven
   delen.

   Omgezet naar componenten: de naam was een <span class="service-card__title"> die zijn
   vetheid uit static/css/wizard.css haalde, en de omschrijving een <p> met een eigen
   lettergrootte. Beide regels zijn daar weg; <c-heading> en <c-paragraph> leveren dat uit
   het thema. De KLASSEN blijven staan, want ze zijn haken: wizard.js en de e2e-tests
   zoeken de hulpknop ermee op. #}
<c-cluster gap="sm" align="center" justify="between" class="service-card__header">
    <c-cluster gap="sm" align="center">
        {# Door het nldd_icon-filter: de kaartgegevens dragen de ROOS-naam, want dezelfde
           gegevens voeden ook de oude weergave. Zonder vertaling rendert het icoon leeg -
           zo misten de dienstkaarten in de wizard hun iconen, op PostgreSQL na. #}
        <c-icon icon="{{ icon|nldd_icon|e }}" color="{{ color|e }}" size="{{ icon_size|e }}"/>
        <c-heading type="h3" size="6" label="{{ name|e }}" class="service-card__title" />
    </c-cluster>
    {% if help_template %}
    {# De vraagtekenknop opent de hulpdialoog van deze dienst. stopPropagation staat er
       omdat de kaart eronder zelf ook een klik afhandelt. #}
    {% set hulp_js %}event.stopPropagation(); openServiceHelp('{{ help_template|e }}'){% endset %}
    {# question-MARK-circle: zo heet hij in de NLDD-woordenschat. Hier stond
       "question-circle", en die naam bestaat daar niet - dan rendert de knop wel maar
       blijft hij leeg. Precies het stille gat waar de servicekaarten op het overzicht
       eerder ook in vielen. #}
    <c-icon-button
        icon="question-mark-circle"
        accessible-label="Uitleg over {{ name|e }}"
        appearance="neutral-transparent"
        size="sm"
        @click="{{ hulp_js }}" :attrs="{'class': 'service-card__help-btn'}" />
    {% endif %}
</c-cluster>
<c-paragraph size="sm" class="service-card__description">{{ description|e }}</c-paragraph>
{% endmacro %}

{# --- Task progress --- #}

{#
  De voortgang van een taak, gedeeld door de twee fragmenten die hem tonen:
  partials/task_progress_fragment.html.j2 (inline en in de bewerkmodal) en
  wizard/modal_wizard_progress_fragment.html.j2 (de wizardmodal). Die twee hadden
  zeventien identieke blokken van zes regels of meer; wat hieronder staat is precies
  dat gedeelte.

  progress_bar is de enige plek in de templates waar nog een style= staat: de breedte
  is de waarde zelf en kan niet in een CSS-bestand. De vormgeving eromheen zit in
  static/css/modal.css (.edit-progress-*).
#}
{% macro progress_bar(progress) %}
<div class="edit-progress-bar-wrapper">
    <div class="edit-progress-bar" style="width: {{ progress }}%"></div>
</div>
{% endmacro %}

{#
  De takenlijst: een ``nldd-list`` met per regel een ``nldd-step-cell`` (het spoor met een
  stip per stap) en een ``nldd-text-cell``. Een taak op het hoogste niveau, bij een uitrol
  een fase, krijgt een grote stip met een vinkje of een kruis; een subtaak een kleine
  (``level="minor"``). De step-cell kent alleen past, current en future: een mislukte stap
  is ``current`` met een kruis en rode tekst, want daar is de taak gebleven.

  Hiervoor stond er een ``c-list`` met icoon- en spacercellen. Die las als een kale lijst
  vinkjes, niet als een verloop; de step-cell is de NLDD-component hiervoor.

  ``show_errors`` staat uit voor de wizardmodal, die de foutregels van een taak bewust
  niet toont.
#}
{#
  De tweede regel van een stap: waarvoor hij loopt, en zijn fout.

  Een stap die per deployment draait (de database, de opslag, de cache) staat anders
  net zo vaak identiek in de lijst als er deployments zijn, en dan zegt de lijst niet
  meer waar de verwerking is. Het onderwerp staat daarom NAAST de naam in de gegevens
  (``subject``) en niet erin, zodat de weergave kan kiezen; hier is dat de regel onder
  de naam. Loopt een stap een keer per project, dan heeft hij geen onderwerp en blijft
  de regel weg.

  Fout en onderwerp delen die tweede regel. Ze sluiten elkaar niet uit -- een mislukte
  stap hoort nog steeds te zeggen voor welke deployment hij mislukte -- dus staan ze
  achter elkaar in plaats van dat de een de ander verdringt.
#}
{% macro progress_step_detail(step, show_errors=True) %}
{%- set parts = [] -%}
{%- if step.subject %}{% set _ = parts.append(step.subject) %}{% endif -%}
{%- if show_errors and step.error %}{% set _ = parts.append(step.error) %}{% endif -%}
{{- parts | join(' - ') -}}
{% endmacro %}

{% macro progress_step_row(step, minor, position, show_errors) %}
{%- set step_status = {"completed": "past", "running": "current", "failed": "current"}.get(step.status, "future") -%}
{#- In the dot, so the bare glyph: the circled variants that ``nldd_icon`` gives draw a ring inside the ring. -#}
{%- set icon = "check-mark" if step.status == "completed" else ("close" if step.status == "failed" else "") -%}
{%- set detail = progress_step_detail(step, show_errors) | trim -%}
<nldd-list-item size="sm">
    <nldd-step-cell size="md" status="{{ step_status }}" position="{{ position }}"{% if minor %} level="minor"{% elif icon %} icon="{{ icon | nldd_icon | trim }}"{% endif %}></nldd-step-cell>
    <nldd-text-cell size="sm"{% if step.status == "failed" %} color="critical"{% elif minor %} color="secondary"{% endif %}{% if detail %} supporting-text="{{ detail }}"{% endif %}>{{ step.name }}</nldd-text-cell>
</nldd-list-item>
{%- endmacro %}

{% macro progress_task_list(tasks, show_errors=True) %}
{% if tasks %}
{%- set rows = [] -%}
{%- for task in tasks -%}
{%- set _ = rows.append((task, False)) -%}
{%- for subtask in task.subtasks or [] %}{% set _ = rows.append((subtask, True)) %}{% endfor -%}
{%- endfor -%}
<nldd-list appearance="simple" dividers="never" accessible-label="Voortgang per taak">
    {% for step, minor in rows %}
    {{ progress_step_row(step, minor, "only" if rows | length == 1 else ("first" if loop.first else ("last" if loop.last else "between")), show_errors) }}
    {% endfor %}
</nldd-list>
{% endif %}
{% endmacro %}

{# --- Error helpers --- #}

{% macro render_errors(errors) %}
{% if errors %}
<div>
{% for error in errors %}
<span class="lotc-form-field__error-text">{{ error }}</span>
{% endfor %}
</div>
{% endif %}
{% endmacro %}

{# --- Warning helpers --- #}

{% macro render_warnings(warnings) %}
{% if warnings %}
{% for warning in warnings %}
<c-alert>{{ warning }}</c-alert>
{% endfor %}
{% endif %}
{% endmacro %}

{# --- Value formatting --- #}

{% macro format_value(value) %}
{%- if value is none -%}
{%- elif value is iterable and value is not string -%}
{{ value|join(', ') }}
{%- else -%}
{{ value }}
{%- endif -%}
{% endmacro %}
