{# De melding na een geslaagde goed- of afkeuring. #}
{% if success_message %}
<c-card padding="md" background-color="wit" outline="true">
    <div class="flash-success">
        <c-icon icon="check-mark-circle" size="md"/>
        <span>{{ success_message }}</span>
    </div>
</c-card>
{% endif %}
