{# Het venster waarin een aanvraag wordt beoordeeld. #}
{# De achtergrond gaat langs de gedeelde afhandeling, niet rechtstreeks langs sluiten:
   die negeert de klik zolang er een taak loopt en waarschuwt bij niet-opgeslagen werk. #}
<div id="approval-backdrop" class="edit-section-backdrop" onclick="handleEditBackdropClick()"></div>
<div id="approval-modal" class="edit-section-modal" role="dialog" aria-modal="true">
    {# .edit-section-header was flex + space-between + align-items + gap: dat is
       <c-cluster justify="between">. De lijn eronder en de marge blijven in
       modal.css - daar heeft het thema niets voor. #}
    <c-cluster justify="between" align="center" class="edit-section-header">
        {# Het icoon staat NAAST de kop: binnen <c-heading> lijnt het op de tekstbasislijn
           uit en zakt het uit de lijn. De span met de id blijft ongemoeid - JavaScript
           schrijft daarin de projectnaam. #}
        <c-cluster gap="sm" align="center">
            <c-icon icon="check-mark-circle" size="lg" color="donkerblauw"/>
            <c-heading type="h2">
                <span id="approval-title-text">Goedkeuring</span>
            </c-heading>
        </c-cluster>
        {% set lotc_onclick_1 %}closeApprovalModal(){% endset %}<c-button size="sm" label="Sluiten" show-icon="before" icon="dismiss" class="edit-modal-close-btn"/>
    </c-cluster>
    <div id="approval-error" class="edit-section-error is-hidden"></div>
    <div id="edit-section-inner">
        <div class="edit-section-content">
            <div class="edit-section-loading"><p>Laden...</p></div>
        </div>
    </div>
</div>
