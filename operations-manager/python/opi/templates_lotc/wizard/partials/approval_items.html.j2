{#
  Admin domain/subdomain approval step.

  Expected context (via yaml_data / wizard state):
    - _approval_items: list of dicts with keys:
        type, label, domain, name, current_status, status, history
#}
{% set items = _approval_items | default([]) %}

{% if items %}
<c-layout-flow gap="lg">
    {% for item in items %}
    <c-card outline="true" padding="md" background-color="wit">
        <c-layout-flow gap="md">
            {# Summary row #}
            <div class="approval-item-summary">
                <div class="approval-item-info">
                    {# Het opschrift komt van de spec zelf (item.label), zodat een derde
                       soort aanvraag niet als "Domein" wordt aangekondigd. De terugval is
                       er voor een lopende modalsessie van voor dat veld bestond. #}
                    {% set soort_klasse = 'approval-type-subdomain' if item.type == 'subdomain' else 'approval-type-domain' %}
                    <span class="approval-type-badge {{ soort_klasse }}">{{ item.label | default('Domein', true) }}</span>
                    <strong>{{ item.name }}</strong>
                    {% if item.type == 'subdomain' %}
                        <span class="rvo-text--subtle">.{{ item.domain }}</span>
                    {% endif %}
                </div>
                {# De statuspil is <c-tag>: het type bepaalt de kleur. De eigen klassen
                   verwezen naar --rvo-color-geel-300/-750, namen die in lotc-app.css niet
                   staan en dus nergens meer bestaan - de pil kwam zonder achtergrond EN
                   zonder tekstkleur op het scherm. Dezelfde afbeelding als in
                   admin/approvals: aangevraagd warning, goedgekeurd success, afgewezen
                   error. #}
                <div>
                    {% if item.current_status == 'requested' %}
                        <c-tag type="warning" label="Aangevraagd"/>
                    {% elif item.current_status == 'approved' %}
                        <c-tag type="success" label="Goedgekeurd"/>
                    {% elif item.current_status == 'denied' %}
                        <c-tag type="error" label="Afgewezen"/>
                    {% endif %}
                </div>
            </div>

            {# History #}
            {% if item.history %}
            <details class="approval-history">
                <summary class="rvo-text--sm rvo-text--subtle">Geschiedenis ({{ item.history | length }})</summary>
                <div class="approval-history-entries">
                    {% for entry in item.history | reverse %}
                    <div class="approval-history-entry">
                        <span class="approval-history-date">{{ entry.date | dutch_date(include_time=False) }}</span>
                        {% set soort = {'requested': 'warning', 'approved': 'success', 'denied': 'error'}.get(entry.status, 'default') %}
                        {% set opschrift = {'requested': 'Aangevraagd', 'approved': 'Goedgekeurd', 'denied': 'Afgewezen'}.get(entry.status, entry.status) %}
                        <c-tag type="{{ soort }}" label="{{ opschrift }}"/>
                        {% if entry.by %}<span class="rvo-text--sm rvo-text--subtle">door {{ entry.by }}</span>{% endif %}
                        {% if entry.message %}<span class="rvo-text--sm">, {{ entry.message }}</span>{% endif %}
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {# Action fields #}
            <div class="approval-item-actions">
                {# Hidden context fields #}
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][service]" value="{{ item.service }}" />
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][type]" value="{{ item.type }}" />
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][label]" value="{{ item.label }}" />
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][domain]" value="{{ item.domain }}" />
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][name]" value="{{ item.name }}" />
                <input type="hidden" name="_approval_items[{{ loop.index0 }}][current_status]" value="{{ item.current_status }}" />

                <div class="approval-action-fields">
                    <div class="rvo-form-field approval-action-field">
                        <label class="rvo-form-field__label" for="status-{{ loop.index0 }}">Actie</label>
                        <select id="status-{{ loop.index0 }}"
                                name="_approval_items[{{ loop.index0 }}][status]"
                                class="rvo-select approval-select">
                            <option value="skip" {% if item.status == 'skip' %}selected{% endif %}>Niet wijzigen</option>
                            <option value="approved" {% if item.status == 'approved' %}selected{% endif %}>Goedkeuren</option>
                            <option value="denied" {% if item.status == 'denied' %}selected{% endif %}>Afwijzen</option>
                        </select>
                    </div>
                    <div class="rvo-form-field approval-message-field">
                        <label class="rvo-form-field__label" for="message-{{ loop.index0 }}">Opmerking</label>
                        <input type="text"
                               id="message-{{ loop.index0 }}"
                               name="_approval_items[{{ loop.index0 }}][message]"
                               class="rvo-text-input"
                               placeholder="Optioneel: reden"
                               value="{{ item.message | default('', true) }}" />
                    </div>
                </div>
            </div>
        </c-layout-flow>
    </c-card>
    {% endfor %}
</c-layout-flow>

{% else %}
<p class="rvo-text--subtle">Geen openstaande aanvragen voor dit project.</p>
{% endif %}
