{#
  Wizard Step Indicator - shows progress through wizard steps.

  Dit was een eigen <nav> met een <ol class="wizard-steps__list">, een genummerde bol per
  stap, een streep ertussen via ::after en een handgetekende voortgangsbalk eronder - bij
  elkaar vijftien selectors in wizard.css. Daar bestaat een component voor:
  <nldd-step-bar> met <nldd-step-bar-item>-kinderen. bg/_wizard-steps.html.j2 deed
  het al zo; dit is dezelfde omzetting voor de bestaande wizard.

  De stand per stap staat hieronder bij de balk zelf.

  DE ID IS VAN DE WIKKEL. Hier stond id="wizard-steps" op de <nav>, terwijl de sjablonen
  die deze balk buiten het doel om verwisselen (wizard_step, wizard_review) hem al in een
  <div id="wizard-steps" hx-swap-oob="outerHTML"> zetten. Dat waren dus TWEE elementen met
  hetzelfde id op een pagina. De wikkel houdt het id, deze partial niet meer - zelfde
  verdeling als aan de bg-kant.

  Required context:
    - steps: WizardSteps object

  Optional context (for reuse outside wizard):
    - step_base_url: URL prefix for step links (default: /forms/wizard/<flow_id>/step/)
    - step_target: HTMX target selector (default: #wizard-step-content)
    - step_query_params: Query string to append to step URLs (default: "")
    - flow_id: FormFlow ID (required when step_base_url is not set)

  step_push_url wordt niet meer gelezen. Het stond in de contextlijst maar werd nergens
  gebruikt: de oude markup zette geen hx-push-url, en deze doet dat ook niet.
#}
{% set base_url = step_base_url | default('/forms/wizard/' ~ flow_id ~ '/step/') %}
{% set target = step_target | default('#wizard-step-content') %}
{% set query_params = step_query_params | default('') %}
{# Plain nldd markup instead of <c-step-bar>: the LOTC wrapper still passes a `current`
   index that nldd-step-bar 0.13 no longer reads. The status follows the POSITION: before
   the current step `past` (check mark), after it `future` (number). A completed step after
   the current one stays a link, but no longer gets a check mark: that put check marks and
   numbers in mixed order after jumping back. On the review step (not in steps.all) every
   step is past. #}
{% set current_position = steps.index if steps.current in steps.all else steps.count %}

<nldd-step-bar accessible-label="Wizard voortgang">
    {% for section_id in steps.all %}
        {% set is_current = section_id == steps.current %}
        {% set is_completed = section_id in steps.completed %}
        {% set status = 'current' if is_current else ('past' if loop.index0 < current_position else 'future') %}
        {% if is_completed and not is_current %}
            {# A completed step stays a real link, so it works without JavaScript; htmx
               intercepts it and posts the current step first, so what you just typed is
               not lost by jumping. The JSON values are plain strings, so autoescape
               escapes their quotes inside the attribute. #}
            <nldd-step-bar-item
                text="{{ steps.titles[section_id] }}"
                status="{{ status }}"
                href="{{ base_url }}{{ section_id }}{{ query_params }}"
                hx-post="{{ base_url }}{{ steps.current }}{{ query_params }}"
                hx-target="{{ target }}"
                hx-swap="innerHTML"
                hx-include="#wizard-step-form"
                hx-vals="{{ '{"_goto": "' ~ section_id ~ '"}' }}"
                hx-ext="json-enc"
                hx-headers="{{ '{"X-CSRF-Token": "' ~ request.state.csrf_token ~ '"}' }}"></nldd-step-bar-item>
        {% else %}
            <nldd-step-bar-item text="{{ steps.titles[section_id] }}" status="{{ status }}"></nldd-step-bar-item>
        {% endif %}
    {% endfor %}
</nldd-step-bar>
