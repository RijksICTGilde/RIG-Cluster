{#
  Modal Wizard Review Fragment - confirmation screen before final submit.

  Required context:
    - steps: WizardSteps object
    - flow_id: FormFlow ID
    - project_name: str
    - section_summaries: list of dicts with section_id, title, icon, fields
    - action_label: str (button text)
    - warnings: list of warning strings (optional)

  Each field in section.fields is a dict:
    - {label, value, is_list: false}  — key-value pair
    - {label, value, is_list: true}   — value is a list, render as <c-list>
    - {html}                          — pre-rendered HTML (sequences, custom)
#}

{# Step indicator (only for multi-step flows) #}
{% if steps.count > 1 %}
<div class="edit-step-indicator" id="modal-wizard-steps">
    {% include "wizard/wizard_steps_indicator.html.j2" %}
</div>
{% endif %}

<div class="wizard-review" id="modal-wizard-step-inner">
    <c-layout-flow gap="lg">
        <div class="wizard-step__header">
            <c-heading type="h2">
                <c-icon icon="vinkje" size="md"/>
                Controleer uw wijzigingen
            </c-heading>
            <p class="wizard-step__description">
                Controleer de wijzigingen hieronder voordat u verdergaat.
            </p>
        </div>

        {% if warnings %}
        <c-layout-flow gap="sm">
            {% for warning in warnings %}
            <c-alert heading="Let op">
                {{ warning }}
            </c-alert>
            {% endfor %}
        </c-layout-flow>
        {% endif %}

        {% if global_errors %}
        <c-alert heading="Fouten">
            <ul>
                {% for err in global_errors %}
                <li>{{ err }}</li>
                {% endfor %}
            </ul>
        </c-alert>
        {% endif %}

        {% set _token_qs = "?_wizard_token=" ~ wizard_token if wizard_token else "" %}
        {% for section in section_summaries %}
        <c-card outline="true" padding="md">
            <div class="wizard-review__section">
                <div class="wizard-review__section-header">
                    <c-heading type="h3">
                        {% if section.icon %}<c-icon icon="{{ section.icon }}" size="lg"/>{% endif %}
                        {{ section.title }}
                    </c-heading>
                    <c-button size="sm" label="Bewerken" show-icon="before" icon="bewerken"/>
                </div>
                <div class="wizard-review__section-content">
                    {% for field in section.fields %}
                        {% if field.html is defined %}
                            {{ field.html | safe }}
                        {% elif field.is_list %}
                            <dl>
                                <dt>{{ field.label }}</dt>
                                <dd>
                                    <c-list>
                                        {% for item in field.value %}
                                        <c-list-item>{{ item }}</c-list-item>
                                        {% endfor %}
                                    </c-list>
                                </dd>
                            </dl>
                        {% else %}
                            <dl><dt>{{ field.label }}</dt><dd>{{ field.value }}</dd></dl>
                        {% endif %}
                    {% else %}
                        <p><em>Geen gegevens ingevuld</em></p>
                    {% endfor %}
                </div>
            </div>
        </c-card>
        {% endfor %}
    </c-layout-flow>

    <div class="wizard-step__actions rvo-layout-margin-vertical--xl">
        <c-button label="Annuleren" @/>

        <div class="wizard-step__actions-right">
            <c-button label="Vorige" show-icon="before" icon="delta-naar-links"/>
            {% if wizard_token %}<input type="hidden" id="modal-wizard-confirm-token" name="_wizard_token" value="{{ wizard_token }}" />{% endif %}
            <span id="modal-wizard-confirm-saving" aria-hidden="true">
                <c-icon icon="refresh" size="sm"/>Bezig&hellip;
            </span>
            <c-button label="{{ action_label }}" show-icon="before" icon="publicatie"/>
        </div>
    </div>
</div>
