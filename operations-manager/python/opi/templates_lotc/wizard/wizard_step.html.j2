{#
  Wizard Step Fragment - loaded via HTMX for each step.

  Required context:
    - steps: WizardSteps object
    - flow_id: FormFlow ID
    - section: FormSection for the current step
    - step_html: Pre-rendered form field HTML from FormRenderer
    - errors: dict of field errors (optional)
    - global_errors: list of global validation errors (optional)
#}

{# Step indicator OOB swap - only for HTMX responses, not initial page load #}
{% if not embedded %}
<div id="wizard-steps" hx-swap-oob="outerHTML">
    {% include "wizard/wizard_steps_indicator.html.j2" %}
</div>
{% endif %}

{# Step content #}
<div class="wizard-step" id="wizard-step-inner">
    <div class="wizard-step__header">
        <c-heading type="h2">
            {% if section.icon %}<c-icon icon="{{ section.icon }}" size="xl"/>{% endif %}
            {{ section.title }}
        </c-heading>
        {% if section.description %}
        <p class="wizard-step__description">{{ section.description }}</p>
        {% endif %}
    </div>

    {% if global_errors %}
    <c-alert heading="Fouten">
        <ul>
            {% for message in global_errors %}
            <li>{{ message }}</li>
            {% endfor %}
        </ul>
    </c-alert>
    {% endif %}

    {% if preset_html %}
    <div class="wizard-step__presets rvo-layout-margin-vertical--xl">
        <p class="rvo-text--subtle rvo-text--sm">Snelstart: kies een scenario</p>
        {{ preset_html | process_components }}
    </div>
    {% endif %}

    <form id="wizard-step-form"
          autocomplete="off"
          hx-ext="json-enc"
          hx-headers='{"X-CSRF-Token": "{{ request.state.csrf_token }}"}'
          hx-post="/forms/wizard/{{ flow_id }}/step/{{ section.section_id }}"
          hx-target="#wizard-step-content"
          hx-swap="innerHTML"
          hx-disabled-elt="#wizard-step-form button[type='submit']">

        <div class="wizard-step__fields">
            {{ step_html | process_components }}
        </div>

        <div class="wizard-step__actions">
            {% if not steps.is_first %}
            <c-button label="Vorige" show-icon="before" icon="delta-naar-links"/>
            {% else %}
            <span></span>
            {% endif %}

            <div class="wizard-step__actions-right">
                {% if all_steps_completed and show_review and not steps.is_last %}
                <c-button label="Naar samenvatting" show-icon="after" icon="delta-naar-rechts"/>
                {% endif %}

                <span class="wizard-step__saving" aria-hidden="true">
                    <c-icon icon="refresh" size="sm"/>Bezig&hellip;
                </span>

                {% if steps.is_last %}
                    {% if show_review %}
                    <c-button type="submit" label="Controleren" show-icon="after" icon="delta-naar-rechts"/>
                    {% else %}
                    <c-button type="submit" label="Opslaan" show-icon="before" icon="publicatie"/>
                    {% endif %}
                {% else %}
                <c-button type="submit" label="Volgende" show-icon="after" icon="delta-naar-rechts"/>
                {% endif %}
            </div>
        </div>
    </form>
</div>
