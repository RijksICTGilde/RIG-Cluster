{#
  Modal Wizard Progress Fragment - server-rendered progress with HTMX polling.

  Replaces itself every 2s until the task completes or fails.

  Required context:
    - task_id: str
    - project_name: str
    - progress: int (0-100)
    - current_step: str
    - tasks: list of task dicts (name, status, subtasks)
    - status: str ("running", "completed", "failed")
    - error: str | None
#}
{% from "widgets/_macros.html.j2" import progress_bar, progress_task_list %}
<div id="modal-progress-container"
     {% if status not in ("completed", "failed") %}
     hx-get="/projects/{{ project_name }}/modal-wizard/progress/{{ task_id }}"
     hx-trigger="every 2s"
     hx-target="#modal-progress-container"
     hx-swap="outerHTML"
     hx-target-404="#modal-progress-container"
     {% endif %}>

    {{ progress_bar(progress) }}

    {% if status == "completed" %}
    <p class="edit-progress-step">Wijzigingen succesvol verwerkt!</p>
    {% elif status == "failed" %}
    {% include "partials/_component_failures.html.j2" %}
    {% else %}
    <p class="edit-progress-step">{{ current_step }}</p>
    {% endif %}

    {{ progress_task_list(tasks, show_errors=False) }}

    {% if status == "completed" %}
    <div class="edit-progress-actions">
        <c-button label="Bekijk volledige voortgang" @/>
        <c-button label="Ok" @/>
    </div>
    {% elif status == "failed" %}
    <div class="edit-progress-actions">
        <c-button label="Bekijk details" @/>
        <c-button label="Sluiten" @/>
    </div>
    {% endif %}
</div>
