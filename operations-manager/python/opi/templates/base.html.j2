{#
  Base Template - Self Service Portal

  Gemeenschappelijke layout voor alle pagina's in het Self Service Portal
  inclusief header, navigatie en footer.
#}

{% set page_title_value %}{% block page_title %}Self Service Portal{% endblock %}{% endset %}
<c-page title="{{ page_title_value }}" lang="nl" bodyClass="rvo-theme rvo-responsive" additionalJs='<script src="/static/js/json-enc.js"></script><script src="/static/js/edit_modal.js"></script>'>

    <div class="rvo-demo-page">
        {# ===================================================================
           TODO: DELETE ME  -- TODO: DELETE ME  -- TODO: DELETE ME
           HACK: our ROOS c-alert renders without the flex container styling,
           so the icon and text stack/misalign. This restores the intended
           layout globally. Remove this <style> block once the jinja-roos-components
           c-alert is fixed upstream.
           TODO: DELETE ME  -- TODO: DELETE ME  -- TODO: DELETE ME
           =================================================================== #}
        <style>
            .rvo-alert__container {
                align-items: flex-start;
                display: flex;
                gap: var(--rvo-alert-gap);
            }
        </style>

        {# Header #}
        <c-header
            text="Zelfservice voor Applicatie Deployment"
            subtitle="Rijksorganisatie voor Ontwikkeling, Digitalisering en Innovatie"
            link="/" />

        <c-layout-flow gap="xl" size="lg">
            {# MenuBar #}
            <c-menubar
                size="md"
                :useIcons="true"
                iconPlacement="before"
                maxWidth="lg"
                :items="menu_items" />

            {# Vakantie-melding: subtiel, boven de paginatitel, op elke pagina. #}
            <c-alert
                kind="info"
                maxWidth="lg"
                padding="xs"
                content="Van vrijdag 3 juli t/m vrijdag 17 juli is er in verband met vakantie uitsluitend ondersteuning bij urgente vragen of bedrijfskritische verstoringen." />

            {# Main Content Area #}
            <main>
                {% block content %}
                {# Default content - override in child templates #}
                <c-layout-flow gap="lg">
                    <c-heading type="h1" textContent="Welkom bij het Self Service Portal" />
                    <p>Gebruik de navigatie om door de verschillende secties te bladeren.</p>
                </c-layout-flow>
                {% endblock %}
            </main>

            {# Footer - version info (reads live from opi/version.json via version_info()) #}
            {% set vi = version_info() %}
            {% set version_label = 'ZAD ' + vi.version
                + (' @ ' + vi.branch if vi.branch else '')
                + (' *' if vi.dirty else '')
                + (' (' + vi.build_date + ')' if vi.build_date else '') %}
            {% set commit_ref = vi.commit if vi.commit else (vi.version if vi.version != '0.1.0' else '') %}
            {% if commit_ref %}
                {% set version_menu = [{'content': version_label, 'link': 'https://github.com/RijksICTGilde/RIG-Cluster/commit/' + commit_ref}] %}
            {% else %}
                {% set version_menu = [{'content': version_label}] %}
            {% endif %}
            <c-footer
                maxWidth="lg"
                :primaryMenu="[
                    {
                        'label': 'Platform',
                        'items': [
                            {'content': 'Over het platform', 'link': '/about'},
                            {'content': 'Architectuur', 'link': '/architecture'},
                            {'content': 'API Referentie', 'link': '/api'}
                        ]
                    }
                ]"
                :secondaryMenu="version_menu" />
        </c-layout-flow>

        <style>
            .rvo-footer__column-title {
                color: white !important;
            }

            /* Icon alignment for headings */
            h1 .utrecht-icon,
            h2 .utrecht-icon,
            h3 .utrecht-icon,
            h4 .utrecht-icon,
            h5 .utrecht-icon,
            h6 .utrecht-icon {
                vertical-align: sub;
                margin-right: 0.1em;
            }
        </style>

        {% block additional_styles %}
        {# Additional CSS can be added here by child templates #}
        <style>
        .rvo-footer__column-title {
            color: white !important;
        }
        </style>
        {% endblock %}

        {% block additional_scripts %}
        {# Additional JavaScript can be added here by child templates #}
        {% endblock %}
    </div>
</c-page>
