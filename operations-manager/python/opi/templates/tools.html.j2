<c-page title="ZAD Tools" lang="nl">
    <c-header
        text="AGE Encryption Tools"
        subtitle="Encrypt and decrypt text using AGE public and private keys"
        link="/"/>
    <c-menubar
        size="md"
        :useIcons="true"
        iconPlacement="before"
        maxWidth="lg"
        :items="menu_items"/>

    <c-layout-flow gap="md" size="lg">
        <c-card padding="md">
            <c-heading type="h2">Configuration</c-heading>

            <form id="age-tool-form" autocomplete="off">
                <c-layout-flow gap="md">
                    <c-text-input-field
                        id="public_key"
                        name="public_key"
                        label="AGE Public Key"
                        placeholder="age1..."
                        helperText="Required for encryption. Format: age1..." />

                    <c-text-input-field
                        id="private_key"
                        name="private_key"
                        label="AGE Private Key"
                        placeholder="AGE-SECRET-KEY-1..."
                        helperText="Required for decryption. Format: AGE-SECRET-KEY-1..." />

                    <div class="rvo-form-field">
                        <label class="rvo-label" for="operation">Operation</label>
                        <select id="operation" name="operation" class="rvo-select">
                            <option value="encrypt">Encrypt</option>
                            <option value="decrypt">Decrypt</option>
                        </select>
                        <p class="rvo-text--sm rvo-text--subtle">Select whether to encrypt or decrypt</p>
                    </div>

                    <c-textarea-field
                        id="input_text"
                        name="input_text"
                        label="Input Text"
                        rows="8"
                        placeholder="Enter text here..."
                        helperText="Enter the text to encrypt or decrypt" />

                    <c-button kind="primary" label="Process" id="submit-btn" @click="handleSubmit(event)" />
                </c-layout-flow>
            </form>
        </c-card>

        <c-card padding="md" id="output-card" style="display: none;">
            <c-heading type="h2">Output</c-heading>
            <div id="error-message" class="rvo-alert rvo-alert--error" style="display: none; margin-bottom: 1rem;">
                <span id="error-text"></span>
            </div>
            <div id="success-message" style="display: block;">
                <p class="rvo-text--sm" style="margin-bottom: 0.5rem;">Result (click to copy):</p>
                <pre id="output-text" class="output-code-block"></pre>
            </div>
        </c-card>
    </c-layout-flow>

    <style>
        .output-code-block {
            background-color: #f5f5f5;
            padding: 1rem;
            border-radius: 4px;
            cursor: pointer;
            overflow-x: auto;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('age-tool-form');
            const submitBtn = document.getElementById('submit-btn');
            const outputCard = document.getElementById('output-card');
            const outputText = document.getElementById('output-text');
            const errorMessage = document.getElementById('error-message');
            const errorText = document.getElementById('error-text');
            const successMessage = document.getElementById('success-message');
            const operationSelect = document.querySelector('[name="operation"]');

            function cleanupText(text) {
                let lines = text.split('\n').map(line => line.trim());
                while (lines.length > 0 && lines[0] === '') { lines.shift(); }
                while (lines.length > 0 && lines[lines.length - 1] === '') { lines.pop(); }
                return lines.join('\n');
            }

            const publicKeyInput = document.querySelector('[name="public_key"]');
            const privateKeyInput = document.querySelector('[name="private_key"]');
            const inputTextArea = document.querySelector('[name="input_text"]');

            publicKeyInput.addEventListener('paste', function(e) {
                e.preventDefault();
                const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                publicKeyInput.value = cleanupText(pastedText);
            });

            privateKeyInput.addEventListener('paste', function(e) {
                e.preventDefault();
                const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                privateKeyInput.value = cleanupText(pastedText);
            });

            inputTextArea.addEventListener('paste', function(e) {
                e.preventDefault();
                const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                inputTextArea.value = cleanupText(pastedText);
            });

            publicKeyInput.addEventListener('blur', function() {
                if (publicKeyInput.value) { publicKeyInput.value = cleanupText(publicKeyInput.value); }
            });

            privateKeyInput.addEventListener('blur', function() {
                if (privateKeyInput.value) { privateKeyInput.value = cleanupText(privateKeyInput.value); }
            });

            inputTextArea.addEventListener('blur', function() {
                if (inputTextArea.value) { inputTextArea.value = cleanupText(inputTextArea.value); }
            });

            window.handleSubmit = async function(e) {
                e.preventDefault();

                const operation = operationSelect.value;
                const publicKey = publicKeyInput.value.trim();
                const privateKey = privateKeyInput.value.trim();
                const inputText = inputTextArea.value.trim();

                if (!inputText) { showError('Input text is required'); return; }
                if (operation === 'encrypt' && !publicKey) { showError('Public key is required for encryption'); return; }
                if (operation === 'decrypt' && !privateKey) { showError('Private key is required for decryption'); return; }

                const formData = new FormData();
                formData.append('input_text', inputText);
                if (operation === 'encrypt') { formData.append('public_key', publicKey); }
                else { formData.append('private_key', privateKey); }

                const btnLabel = submitBtn.querySelector('.rvo-button__label') || submitBtn;
                btnLabel.textContent = 'Processing...';
                submitBtn.disabled = true;

                try {
                    const endpoint = operation === 'encrypt' ? '/tools/encrypt' : '/tools/decrypt';
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-CSRF-Token': "{{ request.state.csrf_token }}" },
                    });
                    const data = await response.json();
                    if (data.success) { showSuccess(data.result); }
                    else { showError(data.error || 'Operation failed'); }
                } catch (error) {
                    showError('Network error: ' + error.message);
                } finally {
                    btnLabel.textContent = 'Process';
                    submitBtn.disabled = false;
                }
            };

            outputText.addEventListener('click', function() {
                const text = outputText.textContent;
                navigator.clipboard.writeText(text).then(function() {
                    const originalText = outputText.textContent;
                    outputText.textContent = 'Copied to clipboard!';
                    setTimeout(function() { outputText.textContent = originalText; }, 1000);
                });
            });

            function showSuccess(result) {
                outputCard.style.display = 'block';
                errorMessage.style.display = 'none';
                successMessage.style.display = 'block';
                outputText.textContent = result;
            }

            function showError(message) {
                outputCard.style.display = 'block';
                successMessage.style.display = 'none';
                errorMessage.style.display = 'block';
                errorText.textContent = message;
            }
        });
    </script>
</c-page>
