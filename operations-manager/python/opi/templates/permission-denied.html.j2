{% extends "base.html.j2" %}

{#
  Dashboard - Self Service Portal

  Overzicht van alle projecten, deployments en resource metrics
  met real-time monitoring en status updates.
#}

{% block page_title %}Dashboard - Self Service Portal{% endblock %}

{% block content %}

<c-layout-flow gap="sm">

    {% if reason == 'email-not-verified' %}
    <c-heading type="h1"
               textContent="Geen Toegang: e-mailadres niet geverifieerd"/>

    <c-heading type="h2" textContent="Wat betekent dit?"/>

    <p>Je bent ingelogd, maar je e-mailadres is niet geverifieerd. Om
        veiligheidsredenen krijg je alleen toegang met een geverifieerd
        e-mailadres.</p>

    <c-heading type="h3" textContent="Hoe krijg ik toegang?"/>

    <c-ul bulletType="icon" bulletIcon="option-1">
        <c-li>Zorg dat je e-mailadres geverifieerd is</c-li>
        <c-li>Denk je dat dit onterecht is? Neem contact op met de <c-link
            href="mailto:robbert.uittenbroek@rijksoverheid.nl"
            content="platformbeheerder"/></c-li>
    </c-ul>
    {% else %}
    <c-heading type="h1"
               textContent="Geen Toegang tot ZAD"/>

    <c-heading type="h2" textContent="Wat betekent dit?"/>

    <p>Je bent succesvol ingelogd, maar je e-mailadres staat niet op de lijst van
        geautoriseerde gebruikers voor dit platform.</p>

    <c-heading type="h3" textContent="Hoe krijg ik toegang?"/>

    <c-ul bulletType="icon" bulletIcon="option-1">
        <c-li>Neem contact op met een collega die al een project in ZAD heeft of de <c-link
            href="mailto:robbert.uittenbroek@rijksoverheid.nl"
            showIcon="before"
            icon="info"
            content="platformbeheerder"/></c-li>
    </c-ul>
    {% endif %}

    {% if user and user.organization %}
        <c-heading type="h3" textContent="Je Organisatie Informatie"/>
        <c-ul>
            <c-li><strong>Organisatie:</strong> {{ user.organization.name }}</c-li>
            {% if user.organization.number %}
                <c-li><strong>Organisatie Nummer:</strong> {{ user.organization.number }}</c-li>
            {% endif %}
            {% if user.organization.role %}
                <c-li><strong>Rol:</strong> {{ user.organization.role }}</c-li>
            {% endif %}
        </c-ul>
    {% endif %}

    {# Action Buttons #}
    <c-layout-row gap="md">
        <c-action-group>
            <c-link
                href="mailto:robbert.uittenbroek@rijksoverheid.nl"
                showIcon="before"
                icon="info"
                content="Contact Opnemen"/>
        </c-action-group>
    </c-layout-row>
</c-layout-flow>
{% endblock %}
