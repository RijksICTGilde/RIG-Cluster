{% extends "base.html.j2" %}

{#
  Project Details Page - Self Service Portal

  Comprehensive project details page showing all project information
  including services, components, deployments, and configuration.

  Sections are split into separate include files under project-details/.
#}

{% block page_title %}{{ project.display_name }} - Project Details{% endblock %}

{% block content %}
<c-layout-flow gap="xl">

    {% include "project-details/section-header.html.j2" %}

    {# Above the tabs on purpose: drift is about the whole project, and it must be
       visible without first picking the right tab. #}
    {% include "project-details/section-pending-rollout.html.j2" %}

    {# Tab Navigation #}
    <c-tabs>
        <c-tab-item label="Project" href="#" selected="true" @click="switchTab('project', event)" />
        <c-tab-item label="Deployments" href="#" @click="switchTab('deployments', event)" />
        <c-tab-item label="Taken" href="#" @click="switchTab('taken', event)" />
    </c-tabs>

    {# De drie tabbladen. switchTab() in dit bestand wisselt ze via .is-hidden. #}
    {% include "project-details/tab-project.html.j2" %}

    {% include "project-details/tab-deployments.html.j2" %}

    {% include "project-details/tab-taken.html.j2" %}

</c-layout-flow>

{% include "project-details/modals.html.j2" %}
{% endblock %}

{% block additional_styles %}
<link rel="stylesheet" href="{{ static_url('css/wizard.css') }}">
<link rel="stylesheet" href="{{ static_url('css/modal.css') }}">
<link rel="stylesheet" href="{{ static_url('css/project-details.css') }}">

<script src="{{ static_url('js/codemirror-bundle.js') }}"></script>
<script src="{{ static_url('js/codemirror-kv.js') }}"></script>
<script src="{{ static_url('js/wizard.js') }}"></script>
{# copyToClipboard() stond hieronder inline, maar wordt ook aangeroepen door de
   dienstblokken (keycloak, invite, de OTP-code) en door de nieuwe vormgeving. Een
   tweede kopie loopt uit de pas, dus hij staat nu in static/js/, net als de
   modal-openers. #}
<script src="{{ static_url('js/copy_to_clipboard.js') }}"></script>
{# switchDeployment() en het herstellen van de keuze uit de URL-hash stonden hieronder
   inline. De hertekende Deployments-tab heeft ze ook nodig, en twee kopieen lopen uit de
   pas, dus ze staan nu in static/js/ - net als de modal-openers. #}
<script src="{{ static_url('js/deployment_switch.js') }}"></script>
<script>
    /**
     * Switch between tabs (Project / Deployments)
     */
    function switchTab(tabName, event) {
        if (event) event.preventDefault();

        // Hide all tab content
        document.getElementById('tab-project').classList.add('is-hidden');
        document.getElementById('tab-deployments').classList.add('is-hidden');
        document.getElementById('tab-taken').classList.add('is-hidden');

        // Show selected tab
        document.getElementById('tab-' + tabName).classList.remove('is-hidden');

        // Load the Taken list (it then polls itself via htmx) only while its tab is open;
        // clearing it on any other tab removes the poller so htmx stops polling.
        var t = document.getElementById('tasks-content');
        if (t) {
            if (tabName === 'taken') htmx.ajax('GET', t.dataset.tasksUrl, { target: '#tasks-content', swap: 'innerHTML' });
            else t.innerHTML = '';
        }

        // Update URL hash to preserve tab state across reloads
        if (tabName === 'deployments') {
            var gs = document.getElementById('global-deployment-selector');
            var depName = gs ? gs.value : '';
            location.hash = depName ? 'deployments/' + depName : 'deployments';
        } else {
            location.hash = tabName;
        }

        // Update rendered tab active state (c-tab-item renders as <li> with <a> inside)
        var tabsList = document.querySelector('[data-roos-component="tabs"]') ||
                       document.querySelector('.rvo-tabs');
        if (tabsList) {
            tabsList.querySelectorAll('.rvo-tabs__item-link').forEach(function(link) {
                link.classList.remove('rvo-tabs__item-link--active');
                link.setAttribute('aria-selected', 'false');
            });
        }
        // Activate the clicked tab link - find by tab name when restoring from hash
        if (event && event.target) {
            var link = event.target.closest('.rvo-tabs__item-link') || event.target;
            link.classList.add('rvo-tabs__item-link--active');
            link.setAttribute('aria-selected', 'true');
        } else if (tabsList) {
            var links = tabsList.querySelectorAll('.rvo-tabs__item-link');
            var tabIndex = tabName === 'deployments' ? 1 : 0;
            if (links[tabIndex]) {
                links[tabIndex].classList.add('rvo-tabs__item-link--active');
                links[tabIndex].setAttribute('aria-selected', 'true');
            }
        }
    }

    /* switchDeployment() staat sinds de omzetting in static/js/deployment_switch.js,
       samen met het herstellen van de keuze uit de URL-hash: de hertekende pagina
       (templates_lotc/bg/project-tabs.html.j2) heeft hem ook nodig en er hoort er maar
       een te zijn. Het script staat hierboven bij de andere. */

    /**
     * Toggle ArgoCD error details visibility
     */
    function toggleArgoErrors(deploymentName) {
        const content = document.getElementById('argocd-errors-' + deploymentName);
        const button = content.previousElementSibling;

        // Gaat via een klasse en niet via element.style, zodat de dichtgeklapte
        // begintoestand in project-details.css kan staan in plaats van in de markup.
        const opened = content.classList.toggle('argo-errors__panel--open');
        button.setAttribute('aria-expanded', opened ? 'true' : 'false');
    }

    /* De logviewer (openLogViewer en alles wat het paneel bedient) staat in
       /static/js/log_viewer.js. Ze hoort bij het paneel en niet bij deze pagina: de
       nieuwe vormgeving zet hetzelfde paneel neer en heeft dezelfde code nodig, en twee
       kopieen van vijfhonderd regels met een WebSocket erin lopen uit de pas. */


    /* De modal-openers (openEditModal, openServiceModal) en de foutafhandeling van een
       bevestigde actie staan in /static/js/edit_modal.js, bij de sluiters waar ze bij
       horen. Ze zijn niet van deze pagina: de nieuwe vormgeving opent dezelfde dialoog,
       en een tweede kopie van honderd regels loopt gegarandeerd uit de pas. De projectnaam
       die de opener nodig heeft komt uit data-project-name op de dialoog zelf. */

    /* closeEditModal / closeEditModalAndReload / handleEditBackdropClick, the global
       ``isEditSubmitting`` flag, the htmx hook that raises it while a progress view is
       in the modal, and the Escape handler that respects it all live in
       /static/js/edit_modal.js. They belong to the shared modal, not to this page:
       every page that opens it gets the same rule, without wiring it up again. */

    // Initialize KV editors after settle (DOM fully ready, attributes processed)
    document.addEventListener('htmx:afterSettle', function(evt) {
        if (typeof initKvEditors === 'function') initKvEditors(evt.detail.target);
    });

    /* copyToClipboard() staat in /static/js/copy_to_clipboard.js, hierboven ingeladen.
       Hij is niet van deze pagina: de dienstblokken en de nieuwe vormgeving roepen hem
       net zo goed aan. */

    /* Het herstellen van tab en deployment uit de URL-hash is meeverhuisd naar
       static/js/deployment_switch.js; daar wacht het op DOMContentLoaded en roept het
       switchTab() alleen aan als die bestaat (op deze pagina dus wel). */
</script>
{% endblock %}

{% block additional_scripts %}
{# De logviewer staat nu in een eigen bestand. Hij hoort HIER, na de markup van het
   paneel: het script pakt zijn elementen bij het laden op, dus in de <head> zou elke
   verwijzing null zijn en zou de viewer stilzwijgend niets doen. #}
<script src="{{ static_url('js/log_viewer.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation"></script>
{# De tekencode van de grafieken stond hier inline. Sinds de omzetting staat hij in
   static/js/metrics_charts.js, want de hertekende pagina zet dezelfde canvassen neer en
   laat ze door dezelfde functie tekenen; twee kopieen lopen uit de pas. Ongewijzigd
   verhuisd, inclusief de DOMContentLoaded-binding. #}
<script src="{{ static_url('js/metrics_charts.js') }}"></script>
{% endblock %}
