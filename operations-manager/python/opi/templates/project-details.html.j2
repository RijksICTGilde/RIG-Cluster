{% extends "base.html.j2" %}

{#
  Project Details Page - Self Service Portal

  Comprehensive project details page showing all project information
  including services, components, deployments, and configuration.

  Sections are split into separate include files under project-details/.
#}

{% block page_title %}{{ project.display_name }} - Project Details{% endblock %}

{% block content %}
<c-layout-flow gap="xl">

    {% include "project-details/section-header.html.j2" %}

    {# Tab Navigation #}
    <c-tabs>
        <c-tab-item label="Project" href="#" selected="true" @click="switchTab('project', event)" />
        <c-tab-item label="Deployments" href="#" @click="switchTab('deployments', event)" />
        <c-tab-item label="Taken" href="#" @click="switchTab('taken', event)" />
    </c-tabs>

    {# ==================== PROJECT TAB ==================== #}
    <c-layout-flow id="tab-project" gap="lg">
        {% include "project-details/section-actions.html.j2" %}
        {% include "project-details/section-deployment-status.html.j2" %}
        {% include "project-details/section-team.html.j2" %}
        {% include "project-details/section-config.html.j2" %}
        {% include "project-details/section-keycloak.html.j2" %}
        {% include "project-details/section-services.html.j2" %}
        {% include "project-details/section-components.html.j2" %}
        {% include "project-details/section-helm-charts.html.j2" %}
        {% include "project-details/section-helmfile.html.j2" %}
        {% include "project-details/section-repositories.html.j2" %}
        {% if "attachments" in (project.services | default([]) | map(attribute="value") | list) %}
        {% include "project-details/section-attachments.html.j2" %}
        {% endif %}
        {% include "project-details/section-danger-zone.html.j2" %}
    </c-layout-flow>

    {# ==================== DEPLOYMENTS TAB ==================== #}
    <c-layout-flow id="tab-deployments" gap="lg" style="display: none;">
        {# Deployment Selector #}
        {% if project.deployments|length > 1 %}
        <div class="deployment-global-selector">
            <label for="global-deployment-selector"><strong>Deployment:</strong></label>
            <select id="global-deployment-selector" class="deployment-select" onchange="switchDeployment(this.value)">
                {% for deployment in project.deployments | sort(attribute='name') %}
                <option value="{{ deployment.name }}">{{ deployment.name }} ({{ deployment.cluster }})</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}

        {% include "project-details/section-deployment-actions.html.j2" %}
        {% include "project-details/section-deployment-argocd.html.j2" %}
        {% include "project-details/section-metrics.html.j2" %}
        {% include "project-details/section-deployments.html.j2" %}
        {% include "project-details/section-backups.html.j2" %}
        {% include "project-details/section-env-vars.html.j2" %}
    </c-layout-flow>

    <c-layout-flow id="tab-taken" gap="lg" style="display: none;">
        {# Loaded + polled only while the Taken tab is open (startTasksPoll/stopTasksPoll),
           so we don't poll every 5s from page load on tabs the user is not viewing. #}
        <div id="tasks-content" data-tasks-url="/projects/{{ project.name }}/tasks">
            <c-p>Taken worden geladen...</c-p>
        </div>
    </c-layout-flow>

</c-layout-flow>

{% include "project-details/modals.html.j2" %}
{% endblock %}

{% block additional_styles %}
<link rel="stylesheet" href="/static/css/wizard.css">
<link rel="stylesheet" href="/static/css/modal.css">
<style>
    /* Project Badge */
    .project-badge {
        background: var(--rvo-color-grijs-100);
        color: var(--rvo-color-grijs-700);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.875rem;
        font-family: monospace;
    }

    /* Overview Grid */
    .overview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--rvo-space-lg);
    }

    .overview-icon {
        text-align: center;
        margin-bottom: var(--rvo-space-xs);
    }

    .overview-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--rvo-color-hemelblauw);
        text-align: center;
    }

    .overview-label {
        font-weight: 600;
        text-align: center;
        color: var(--rvo-color-grijs-700);
    }

    .overview-detail {
        font-size: 0.875rem;
        text-align: center;
        color: var(--rvo-color-grijs-600);
    }


    /* Team Grid - Replaced with c-grid component */

    /* Metrics Section */
    .deployment-select {
        padding: var(--rvo-space-sm) var(--rvo-space-md);
        border: 1px solid var(--rvo-color-grijs-300);
        border-radius: 4px;
        background: white;
        font-size: 0.875rem;
        cursor: pointer;
        min-width: 200px;
    }

    .deployment-select:focus {
        outline: 2px solid var(--rvo-color-hemelblauw);
        outline-offset: 2px;
    }

    .deployment-global-selector {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .metrics-grid {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-lg);
    }

    .metrics-component-card {
        border-left: 4px solid var(--rvo-color-groen);
    }

    .metrics-component-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-sm);
    }

    .charts-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--rvo-space-md);
    }

    @media (max-width: 1024px) {
        .charts-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .charts-container {
            grid-template-columns: 1fr;
        }
    }

    .chart-item {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-xs);
        min-width: 0;
    }

    .chart-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--rvo-color-grijs-600);
        text-transform: uppercase;
    }

    .chart-wrapper {
        width: 100%;
        height: 100px;
        position: relative;
    }

    .metrics-chart {
        width: 100%;
        height: 100%;
    }

    .chart-current {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--rvo-color-grijs-800);
        text-align: right;
    }

    .chart-current.no-data {
        color: var(--rvo-color-grijs-400);
        font-style: italic;
    }

    .chart-current.warning {
        color: #e17000;
        background-color: #fff3e0;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .chart-current.critical {
        color: #d52b1e;
        background-color: #ffebee;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .service-detail-card {
        min-height: 150px;
    }

    .service-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .service-scope {
        font-size: 0.875rem;
        color: var(--rvo-color-grijs-600);
        font-style: italic;
    }

    /* Deployments Section */
    .deployments-section {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-lg);
    }

    .deployment-card {
        border-left: 4px solid var(--rvo-color-oranje);
    }

    .deployment-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .deployment-meta {
        display: flex;
        gap: var(--rvo-space-sm);
        margin-top: var(--rvo-space-xs);
        flex-wrap: wrap;
    }

    .cluster-badge {
        background: var(--rvo-color-hemelblauw-50);
        color: var(--rvo-color-hemelblauw);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .namespace-badge {
        background: var(--rvo-color-groen-50);
        color: var(--rvo-color-groen);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .clone-badge {
        background: var(--rvo-color-paars-50);
        color: var(--rvo-color-paars);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .deployment-components {
        margin-top: var(--rvo-space-md);
        padding-top: var(--rvo-space-md);
        border-top: 1px solid var(--rvo-color-grijs-200);
    }

    .component-list {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-sm);
        margin-top: var(--rvo-space-sm);
    }

    .component-item {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
        padding: var(--rvo-space-sm);
        background: white;
        border-radius: 4px;
    }

    .component-name {
        font-weight: 600;
        color: var(--rvo-color-grijs-900);
    }

    .component-image {
        font-size: 0.875rem;
        color: var(--rvo-color-grijs-600);
        font-family: monospace;
    }


    .component-card {
        border-left: 4px solid var(--rvo-color-paars);
    }

    .component-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .component-type {
        font-size: 0.875rem;
        color: var(--rvo-color-grijs-600);
        text-transform: capitalize;
    }

    .env-vars-indicator {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-sm);
        padding: var(--rvo-space-sm) var(--rvo-space-md);
        background: var(--rvo-color-hemelblauw-50);
        border-radius: 4px;
        font-size: 0.875rem;
        color: var(--rvo-color-hemelblauw);
        margin-top: var(--rvo-space-sm);
    }

    .component-specs {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-xs);
    }

    .spec-item {
        font-size: 0.875rem;
        line-height: 1.5;
    }

    /* Helm Charts Section */
    .helm-charts-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--rvo-space-lg);
    }

    .helm-chart-card {
        border-left: 4px solid var(--rvo-color-groen);
    }

    .helm-chart-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .helm-chart-specs {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-xs);
    }

    /* Helmfile Section */
    .helmfile-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--rvo-space-lg);
    }

    .helmfile-card {
        border-left: 4px solid var(--rvo-color-oranje);
    }

    .helmfile-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .helmfile-specs {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-xs);
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--rvo-space-sm);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-running {
        background: var(--rvo-color-groen-50);
        color: var(--rvo-color-groen);
    }

    /* Configuration Section */
    .config-section {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-lg);
    }

    .config-item {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-sm);
        padding: var(--rvo-space-md);
        border: 1px solid var(--rvo-color-grijs-200);
        border-radius: 4px;
        background: var(--rvo-color-grijs-25);
    }

    .config-label {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-sm);
        font-weight: 600;
        color: var(--rvo-color-grijs-900);
    }

    .config-value {
        margin-left: var(--rvo-space-xl);
    }

    .config-code {
        background: var(--rvo-color-grijs-100);
        padding: var(--rvo-space-sm);
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.875rem;
        word-break: break-all;
    }

    .config-value--inline {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
        flex-wrap: wrap;
    }

    .config-value--inline .config-code {
        display: inline-block;
    }

    /* Copy button copied state */
    .copy-btn.is-copied {
        color: var(--rvo-color-groen) !important;
    }

    .copy-btn.is-copied .rvo-icon {
        color: var(--rvo-color-groen) !important;
    }

    /* Environment Variables Section */
    .env-vars-scope-section {
        padding: var(--rvo-space-md);
        background: var(--rvo-color-grijs-025);
        border-radius: 8px;
        border: 1px solid var(--rvo-color-grijs-100);
    }

    .env-vars-scope-header {
        display: flex;
        align-items: flex-start;
        gap: var(--rvo-space-md);
        margin-bottom: var(--rvo-space-md);
    }

    .env-vars-deployment-header,
    .env-vars-component-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-sm);
        flex-wrap: wrap;
    }

    .env-vars-count-badge {
        background: var(--rvo-color-hemelblauw-50);
        color: var(--rvo-color-hemelblauw);
        padding: var(--rvo-space-xs) var(--rvo-space-sm);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .env-vars-list {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-xs);
    }

    .env-var-item {
        display: grid;
        grid-template-columns: minmax(150px, auto) 1fr;
        gap: var(--rvo-space-md);
        padding: var(--rvo-space-sm);
        background: var(--rvo-color-wit);
        border-radius: 4px;
        border: 1px solid var(--rvo-color-grijs-100);
        align-items: center;
    }

    .env-var-key {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-xs);
    }

    .env-var-key code {
        font-family: monospace;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--rvo-color-grijs-800);
    }

    .env-var-value {
        min-width: 0;
    }

    /* Repositories Section */
    .repositories-section {
        display: flex;
        flex-direction: column;
        gap: var(--rvo-space-lg);
    }

    .repository-card {
        border-left: 4px solid var(--rvo-color-oranje);
    }

    .repo-header {
        display: flex;
        align-items: center;
        gap: var(--rvo-space-md);
    }

    .repo-url {
        font-family: monospace;
        font-size: 0.875rem;
        color: var(--rvo-color-grijs-600);
        word-break: break-all;
    }

    .repo-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--rvo-space-sm);
        margin-top: var(--rvo-space-md);
        padding-top: var(--rvo-space-md);
        border-top: 1px solid var(--rvo-color-grijs-200);
    }

    .repo-item {
        font-size: 0.875rem;
    }

    /* Empty States */
    .empty-state {
        text-align: center;
        padding: var(--rvo-space-xl);
        color: var(--rvo-color-grijs-600);
    }

    /* Backup Table */
    .backup-table th,
    .backup-table td {
        padding: 8px 12px;
        text-align: left;
    }
    .backup-table th {
        font-weight: 600;
        color: var(--rvo-color-grijs-700);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .overview-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        /* .team-grid responsive styles handled by c-grid component */

        .deployment-header {
            flex-direction: column;
            gap: var(--rvo-space-md);
        }

        .deployment-meta {
            flex-direction: column;
            align-items: flex-start;
        }

        .repo-details {
            grid-template-columns: 1fr;
        }

        .env-var-item {
            grid-template-columns: 1fr;
        }

        .env-vars-scope-header {
            flex-direction: column;
        }
    }

    /* Log Viewer Button */
    .log-viewer-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: var(--rvo-color-hemelblauw);
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
    }

    .log-viewer-btn:hover {
        background: var(--rvo-color-donkerblauw);
    }

    .log-viewer-btn:active {
        transform: scale(0.98);
    }

    /* Log Viewer Backdrop */
    .log-viewer-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s, visibility 0.3s;
    }

    .log-viewer-backdrop.is-open {
        opacity: 1;
        visibility: visible;
    }

    /* Log Viewer Panel */
    .log-viewer-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 60%;
        max-width: 1000px;
        min-width: 400px;
        height: 100vh;
        background: #1a1a2e;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.3s ease-out;
    }

    .log-viewer-panel.is-open {
        transform: translateX(0);
    }

    @media (max-width: 768px) {
        .log-viewer-panel {
            width: 100%;
            min-width: unset;
        }
    }

    /* Log Viewer Header */
    .log-viewer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: #16213e;
        border-bottom: 1px solid #0f3460;
    }

    .log-viewer-title {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
    }

    .log-viewer-title h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .log-viewer-subtitle {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-top: 2px;
    }

    .log-component-select {
        background: #0f3460;
        color: #e2e8f0;
        border: 1px solid #1e3a5f;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.8rem;
        cursor: pointer;
    }

    .log-component-select:focus {
        outline: 2px solid var(--rvo-color-hemelblauw);
        outline-offset: 1px;
    }

    /* Log Viewer Controls */
    .log-viewer-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .log-control-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #0f3460;
        color: #e2e8f0;
        border: 1px solid #1e3a5f;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .log-control-btn:hover {
        background: #1e3a5f;
    }

    .log-control-btn.is-active {
        background: var(--rvo-color-oranje);
        border-color: var(--rvo-color-oranje);
    }

    .log-close-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: transparent;
        color: #94a3b8;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        margin-left: 8px;
        transition: color 0.2s, background-color 0.2s;
    }

    .log-close-btn:hover {
        color: white;
        background: rgba(255, 255, 255, 0.1);
    }

    /* Log Viewer Status Bar */
    .log-viewer-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        background: #0f3460;
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .log-status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #6b7280;
    }

    .log-status-indicator.is-streaming {
        background: #22c55e;
        animation: pulse 2s infinite;
    }

    .log-status-indicator.is-paused {
        background: #f59e0b;
    }

    .log-status-indicator.is-error {
        background: #ef4444;
    }

    .log-status-indicator.is-connecting {
        background: #3b82f6;
        animation: pulse 1s infinite;
    }

    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .log-line-count {
        margin-left: auto;
        color: #64748b;
    }

    /* Log Viewer Toolbar */
    .log-viewer-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 20px;
        background: #16213e;
        border-bottom: 1px solid #0f3460;
        flex-wrap: wrap;
    }

    .log-search-container {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 200px;
        max-width: 400px;
        background: #0f3460;
        border: 1px solid #1e3a5f;
        border-radius: 4px;
        padding: 4px 10px;
    }

    .log-search-container:focus-within {
        border-color: var(--rvo-color-hemelblauw);
        box-shadow: 0 0 0 2px rgba(0, 119, 200, 0.2);
    }

    .log-search-input {
        flex: 1;
        background: transparent;
        border: none;
        color: #e2e8f0;
        font-size: 0.85rem;
        outline: none;
    }

    .log-search-input::placeholder {
