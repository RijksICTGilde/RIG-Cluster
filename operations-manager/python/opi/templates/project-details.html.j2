<script>
    /**
     * Toggle visibility of sensitive information
     */
    function toggleSensitive(fieldId) {
        const field = document.getElementById(fieldId);
        const dots = field.querySelector('.sensitive-dots');
        const value = field.querySelector('.sensitive-value');
        const button = field.querySelector('.toggle-sensitive');

        if (dots.style.display === 'none') {
            // Hide sensitive value
            dots.style.display = 'inline';
            value.style.display = 'none';
            button.textContent = 'Tonen';
            button.querySelector('c-icon').setAttribute('icon', 'oog');
        } else {
            // Show sensitive value
            dots.style.display = 'none';
            value.style.display = 'block';
            button.textContent = 'Verbergen';
            button.querySelector('c-icon').setAttribute('icon', 'oog-dicht');
        }
    }

    /**
     * Switch between deployment metrics sections
     */
    function showDeploymentMetrics(deploymentName) {
        // Hide all deployment metrics sections
        document.querySelectorAll('.deployment-metrics-section').forEach(section => {
            section.style.display = 'none';
        });
        // Show the selected deployment's metrics
        const selectedSection = document.getElementById('metrics-' + deploymentName);
        if (selectedSection) {
            selectedSection.style.display = 'block';
        }
    }

    /**
     * Draw a semi-circular gauge on a canvas
     */
    function drawGauge(canvas, value, max, color) {
        const ctx = canvas.getContext('2d');
        const width = canvas.width;
        const height = canvas.height;
        const centerX = width / 2;
        const centerY = height - 5;
        const radius = Math.min(centerX, centerY) - 5;

        // Clear canvas
        ctx.clearRect(0, 0, width, height);

        // Draw background arc (gray)
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius, Math.PI, 0, false);
        ctx.lineWidth = 8;
        ctx.strokeStyle = '#e5e5e5';
        ctx.stroke();

        // Calculate percentage and angle
        const percentage = Math.min(value / max, 1);
        const endAngle = Math.PI + (percentage * Math.PI);

        // Draw value arc
        if (percentage > 0) {
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, Math.PI, endAngle, false);
            ctx.lineWidth = 8;
            ctx.lineCap = 'round';
            ctx.strokeStyle = color;
            ctx.stroke();
        }
    }

    /**
     * Get color based on percentage (green -> yellow -> red)
     */
    function getGaugeColor(percentage) {
        if (percentage < 0.5) {
            return '#39870c'; // Green
        } else if (percentage < 0.75) {
            return '#e17000'; // Orange
        } else {
            return '#d52b1e'; // Red
        }
    }

    /**
     * Initialize all gauge canvases
     */
    function initGauges() {
        document.querySelectorAll('.gauge-canvas').forEach(canvas => {
            const value = parseFloat(canvas.dataset.value) || 0;
            const max = parseFloat(canvas.dataset.max) || 100;
            const percentage = value / max;
            const color = getGaugeColor(percentage);

            // Set canvas size for retina displays
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * 2;
            canvas.height = rect.height * 2;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            canvas.getContext('2d').scale(2, 2);

            drawGauge(canvas, value, max, color);
        });
    }

    // Initialize gauges when DOM is loaded
    document.addEventListener('DOMContentLoaded', initGauges);

</script>
{% endblock %}