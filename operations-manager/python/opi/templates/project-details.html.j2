{% extends "base.html.j2" %}

{#
  Project Details Page - Self Service Portal
  
  Comprehensive project details page showing all project information
  including services, components, deployments, and configuration.
#}

{% block page_title %}{{ project.display_name }} - Project Details{% endblock %}

{% block content %}
<c-layout-flow gap="xl">
    
    {# Page Header #}
    <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rvo-space-md);">
            <div>
                <c-heading type="h1" textContent="{{ project.display_name }}" />
                <p class="rvo-text--lg">{{ project.description }}</p>
                <div style="margin-top: var(--rvo-space-sm);">
                    <span class="project-badge">{{ project.name }}</span>
                </div>
            </div>
            <div style="display: flex; gap: var(--rvo-space-md);">
                <c-button 
                    label="Terug naar overzicht"
                    kind="secondary"
                    size="md"
                    showIcon="before"
                    icon="terug"
                    @click="window.location.href='/projects'" />
                {% if user_role in ["admin", "owner"] %}
                    <c-button 
                        label="Project beheren"
                        kind="primary"
                        size="md"
                        showIcon="before"
                        icon="instellingen" />
                {% endif %}
            </div>
        </div>
    </div>

    {# Metrics Section #}
    {% if prometheus_available and project.deployments %}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="grafiek" size="xl" color="groen" />Resource Metrics</c-heading>
                    <p class="rvo-text--subtle">Resource usage per component (laatste uur, 5 min intervallen)</p>
                </div>
                {% if project.deployments|length > 1 %}
                <div>
                    <select id="deployment-selector" class="deployment-select" onchange="showDeploymentMetrics(this.value)">
                        {% for deployment in project.deployments %}
                        <option value="{{ deployment.name }}">{{ deployment.name }} ({{ deployment.cluster }})</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
            </div>

            {% for deployment in project.deployments %}
            <div id="metrics-{{ deployment.name }}" class="deployment-metrics-section" {% if not loop.first %}style="display: none;"{% endif %}>
                {% if deployment.components %}
                <div class="metrics-grid">
                    {% for component in deployment.components %}
                    {% set component_name = component.reference %}
                    {% set metrics = deployment_metrics_timeseries.get(deployment.name, {}).get(component_name, {}) %}
                    <c-card class="metrics-component-card" padding="lg" backgroundColor="grijs-050" outline="true">
                        <c-layout-flow gap="md">
                            <div class="metrics-component-header">
                                <c-icon icon="puzzel" size="md" color="donkerblauw" />
                                <c-heading type="h4" textContent="{{ component_name }}" />
                            </div>

                            <div class="charts-container">
                                {# CPU Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">CPU (millicores){% if metrics.cpu_limit %} - Limit: {{ metrics.cpu_limit|int }}m{% endif %}</div>
                                    <div class="chart-wrapper">
                                        <canvas id="cpu-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.cpu_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.cpu | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='{{ metrics.cpu_limit | default("null") }}'
                                                data-color="#39870c"></canvas>
                                    </div>
                                    {% if metrics.cpu %}
                                    <div class="chart-current">Current: {{ "%.1f"|format(metrics.cpu[-1].value) }}m{% if metrics.cpu_limit %} / {{ metrics.cpu_limit|int }}m ({{ "%.0f"|format(metrics.cpu[-1].value / metrics.cpu_limit * 100) }}%){% endif %}</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Memory Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Memory (MB){% if metrics.memory_limit %} - Limit: {{ metrics.memory_limit|int }} MB{% endif %}</div>
                                    <div class="chart-wrapper">
                                        <canvas id="mem-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.memory_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.memory | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='{{ metrics.memory_limit | default("null") }}'
                                                data-color="#007bc7"></canvas>
                                    </div>
                                    {% if metrics.memory %}
                                    <div class="chart-current">Current: {{ "%.0f"|format(metrics.memory[-1].value) }} MB{% if metrics.memory_limit %} / {{ metrics.memory_limit|int }} MB ({{ "%.0f"|format(metrics.memory[-1].value / metrics.memory_limit * 100) }}%){% endif %}</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Requests Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">HTTP Requests (req/min)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="req-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.requests_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.requests | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#e17000"></canvas>
                                    </div>
                                    {% if metrics.requests %}
                                    <div class="chart-current">Current: {{ "%.1f"|format(metrics.requests[-1].value) }} req/min</div>
                                    {% else %}
                                    <div class="chart-current no-data">No HTTP metrics</div>
                                    {% endif %}
                                </div>

                                {# Network In Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Network In (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="net-in-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.network_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.network_in | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#154273"></canvas>
                                    </div>
                                    {% if metrics.network_in %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.network_in[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Network Out Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Network Out (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="net-out-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.network_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.network_out | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#8fcae7"></canvas>
                                    </div>
                                    {% if metrics.network_out %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.network_out[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Disk Read Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Disk Read (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="disk-read-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.disk_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.disk_read | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#673327"></canvas>
                                    </div>
                                    {% if metrics.disk_read %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.disk_read[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Disk Write Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Disk Write (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="disk-write-chart-{{ deployment.name }}-{{ component_name }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.disk_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.disk_write | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#c9742f"></canvas>
                                    </div>
                                    {% if metrics.disk_write %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.disk_write[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>
                            </div>
                        </c-layout-flow>
                    </c-card>
                    {% endfor %}
                </div>
                {% elif discovered_workloads.get(deployment.name) %}
                {# Helm-based deployment: show discovered workloads #}
                <div class="metrics-grid">
                    {% for workload in discovered_workloads.get(deployment.name, []) %}
                    {% set workload_name = workload.name %}
                    {% set metrics = deployment_metrics_timeseries.get(deployment.name, {}).get(workload_name, {}) %}
                    <c-card class="metrics-component-card" padding="lg" backgroundColor="grijs-050" outline="true">
                        <c-layout-flow gap="md">
                            <div class="metrics-component-header">
                                <c-icon icon="applicatie" size="md" color="donkerblauw" />
                                <c-heading type="h4" textContent="{{ workload_name }}" />
                                <span style="background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; margin-left: 8px;">{{ workload.pod_count }} pod{% if workload.pod_count != 1 %}s{% endif %}</span>
                            </div>

                            <div class="charts-container">
                                {# CPU Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">CPU (millicores){% if metrics.cpu_limit %} - Limit: {{ metrics.cpu_limit|int }}m{% endif %}</div>
                                    <div class="chart-wrapper">
                                        <canvas id="cpu-chart-{{ deployment.name }}-{{ workload_name | replace('.', '-') | replace(':', '-') }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.cpu_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.cpu | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='{{ metrics.cpu_limit | default("null") }}'
                                                data-color="#39870c"></canvas>
                                    </div>
                                    {% if metrics.cpu %}
                                    <div class="chart-current">Current: {{ "%.1f"|format(metrics.cpu[-1].value) }}m{% if metrics.cpu_limit %} / {{ metrics.cpu_limit|int }}m ({{ "%.0f"|format(metrics.cpu[-1].value / metrics.cpu_limit * 100) }}%){% endif %}</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Memory Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Memory (MB){% if metrics.memory_limit %} - Limit: {{ metrics.memory_limit|int }} MB{% endif %}</div>
                                    <div class="chart-wrapper">
                                        <canvas id="mem-chart-{{ deployment.name }}-{{ workload_name | replace('.', '-') | replace(':', '-') }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.memory_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.memory | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='{{ metrics.memory_limit | default("null") }}'
                                                data-color="#007bc7"></canvas>
                                    </div>
                                    {% if metrics.memory %}
                                    <div class="chart-current">Current: {{ "%.0f"|format(metrics.memory[-1].value) }} MB{% if metrics.memory_limit %} / {{ metrics.memory_limit|int }} MB ({{ "%.0f"|format(metrics.memory[-1].value / metrics.memory_limit * 100) }}%){% endif %}</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Network In Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Network In (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="net-in-chart-{{ deployment.name }}-{{ workload_name | replace('.', '-') | replace(':', '-') }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.network_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.network_in | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#154273"></canvas>
                                    </div>
                                    {% if metrics.network_in %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.network_in[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>

                                {# Network Out Chart #}
                                <div class="chart-item">
                                    <div class="chart-label">Network Out (KB/s)</div>
                                    <div class="chart-wrapper">
                                        <canvas id="net-out-chart-{{ deployment.name }}-{{ workload_name | replace('.', '-') | replace(':', '-') }}"
                                                class="metrics-chart"
                                                data-timestamps='{{ metrics.network_timestamps | default([]) | tojson }}'
                                                data-values='{{ metrics.network_out | default([]) | map(attribute="value") | list | tojson }}'
                                                data-limit='null'
                                                data-color="#01689b"></canvas>
                                    </div>
                                    {% if metrics.network_out %}
                                    <div class="chart-current">Current: {{ "%.2f"|format(metrics.network_out[-1].value) }} KB/s</div>
                                    {% else %}
                                    <div class="chart-current no-data">No data</div>
                                    {% endif %}
                                </div>
                            </div>
                        </c-layout-flow>
                    </c-card>
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state">
                    <c-icon icon="info" size="lg" color="grijs-050" />
                    <p class="rvo-text--md">Geen components in deze deployment</p>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </c-layout-flow>
    </c-card>
    {% elif not prometheus_available %}
    <c-card outline="true" padding="lg" backgroundColor="grijs-050">
        <c-layout-row gap="md" verticalSpacing="center">
            <c-icon icon="info" size="lg" color="grijs-500" />
            <div>
                <strong>Metrics niet beschikbaar</strong>
                <p class="rvo-text--sm rvo-text--subtle">Prometheus is niet verbonden. Resource metrics worden getoond wanneer Prometheus beschikbaar is.</p>
            </div>
        </c-layout-row>
    </c-card>
    {% endif %}

    {# ArgoCD Deployment Status Section #}
    {% if argocd_available and project.deployments %}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <div>
                <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="server" size="xl" color="hemelblauw" />Deployment Status</c-heading>
                <p class="rvo-text--subtle">ArgoCD synchronisatie en health status per deployment</p>
            </div>

            <c-grid columns="two" gap="lg">
                {% for deployment in project.deployments %}
                {% set status = argocd_status.get(deployment.name, {}) %}
                {% set health = status.get('health', 'Unknown') %}
                {% set sync = status.get('sync', 'Unknown') %}
                {% set errors = status.get('errors', []) %}
                {% set has_errors = errors|length > 0 %}

                <c-card padding="lg" outline="true" backgroundColor="grijs-050" style="border-left: 4px solid var(--rvo-color-hemelblauw);">
                    <c-layout-flow gap="md">
                        {# Deployment Header #}
                        <c-layout-row gap="sm" verticalSpacing="center">
                            <c-icon icon="applicatie" size="md" color="donkerblauw" />
                            <c-heading type="h4" textContent="{{ deployment.name }}" />
                            <span style="background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">{{ deployment.cluster }}</span>
                        </c-layout-row>

                        {# Status Badges Row #}
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            {# Health Badge #}
                            {% set health_bg = '#c8e6c9' if health == 'Healthy' else ('#bbdefb' if health == 'Progressing' else ('#ffe0b2' if health == 'Degraded' else '#ffcdd2')) %}
                            {% set health_color = '#1b5e20' if health == 'Healthy' else ('#0d47a1' if health == 'Progressing' else ('#e65100' if health == 'Degraded' else '#b71c1c')) %}
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500; background: {{ health_bg }}; color: {{ health_color }};">
                                {% if health == 'Healthy' %}
                                <c-icon icon="vinkje" size="sm" />
                                {% elif health == 'Progressing' %}
                                <c-icon icon="klok" size="sm" />
                                {% elif health == 'Degraded' %}
                                <c-icon icon="waarschuwing" size="sm" />
                                {% else %}
                                <c-icon icon="foutmelding" size="sm" />
                                {% endif %}
                                {{ health }}
                            </span>

                            {# Sync Badge #}
                            {% set sync_bg = '#c8e6c9' if sync == 'Synced' else ('#ffe0b2' if sync == 'OutOfSync' else 'var(--rvo-color-grijs-200)') %}
                            {% set sync_color = '#1b5e20' if sync == 'Synced' else ('#e65100' if sync == 'OutOfSync' else 'var(--rvo-color-grijs-700)') %}
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500; background: {{ sync_bg }}; color: {{ sync_color }};">
                                {% if sync == 'Synced' %}
                                <c-icon icon="vinkje" size="sm" />
                                {% elif sync == 'OutOfSync' %}
                                <c-icon icon="waarschuwing" size="sm" />
                                {% else %}
                                <c-icon icon="info" size="sm" />
                                {% endif %}
                                {{ sync }}
                            </span>

                            {# Revision Badge (if available) #}
                            {% if status.get('revision') %}
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700);">
                                <c-icon icon="document-blanco" size="sm" />
                                {{ status.revision }}
                            </span>
                            {% endif %}
                        </div>

                        {# Last Sync Time #}
                        {% if status.get('last_sync') %}
                        <c-layout-row gap="xs" verticalSpacing="center">
                            <c-icon icon="klok" size="sm" color="grijs-600" />
                            <span class="rvo-text--sm rvo-text--subtle">Laatste sync: {{ status.last_sync[:19]|replace('T', ' ') }} UTC</span>
                        </c-layout-row>
                        {% endif %}

                        {# Operation Status (if running or failed) #}
                        {% if status.get('operation_phase') and status.operation_phase not in ['Succeeded', None] %}
                        {% set op_bg = '#e3f2fd' if status.operation_phase == 'Running' else '#ffebee' %}
                        {% set op_color = '#1565c0' if status.operation_phase == 'Running' else '#c62828' %}
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 4px; font-size: 0.875rem; background: {{ op_bg }}; color: {{ op_color }};">
                            <c-icon icon="{% if status.operation_phase == 'Running' %}klok{% elif status.operation_phase == 'Failed' %}foutmelding{% else %}info{% endif %}" size="sm" />
                            <span>Operatie: {{ status.operation_phase }}</span>
                            {% if status.get('operation_message') %}
                            <span class="rvo-text--sm"> - {{ status.operation_message[:100] }}{% if status.operation_message|length > 100 %}...{% endif %}</span>
                            {% endif %}
                        </div>
                        {% endif %}

                        {# Errors Section (Expandable) #}
                        {% if has_errors %}
                        <div>
                            <button type="button" onclick="toggleArgoErrors('{{ deployment.name }}')" aria-expanded="false"
                                    style="display: flex; align-items: center; gap: 8px; width: 100%; padding: 8px 12px; background: #ffebee; border: 1px solid #ef9a9a; border-radius: 4px; cursor: pointer; font-size: 0.875rem; color: #c62828; text-align: left;">
                                <c-icon icon="waarschuwing" size="sm" color="rood" />
                                <span>{{ errors|length }} {% if errors|length == 1 %}probleem{% else %}problemen{% endif %} gevonden</span>
                                <c-icon icon="delta-omlaag" size="sm" style="margin-left: auto;" />
                            </button>
                            <div id="argocd-errors-{{ deployment.name }}" style="display: none; margin-top: 8px; padding: 8px; background: #fff5f5; border: 1px solid #ffcdd2; border-radius: 4px;">
                                {% for error in errors %}
                                <div style="padding: 8px; {% if not loop.last %}border-bottom: 1px solid #ffcdd2;{% endif %}">
                                    <c-layout-row gap="xs" verticalSpacing="center">
                                        <c-icon icon="foutmelding" size="sm" color="rood" />
                                        <strong style="font-size: 0.875rem;">{{ error.resource }}</strong>
                                    </c-layout-row>
                                    <p style="font-size: 0.8rem; color: var(--rvo-color-grijs-700); margin: 4px 0 0 24px; word-break: break-word;">{{ error.message }}</p>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                    </c-layout-flow>
                </c-card>
                {% endfor %}
            </c-grid>
        </c-layout-flow>
    </c-card>
    {% elif not argocd_available and project.deployments %}
    <c-card outline="true" padding="lg" backgroundColor="grijs-050">
        <c-layout-row gap="md" verticalSpacing="center">
            <c-icon icon="info" size="lg" color="grijs-500" />
            <div>
                <strong>Deployment status niet beschikbaar</strong>
                <p class="rvo-text--sm rvo-text--subtle">ArgoCD is niet verbonden. Deployment status wordt getoond wanneer ArgoCD beschikbaar is.</p>
            </div>
        </c-layout-row>
    </c-card>
    {% endif %}

    {# Team Section #}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="groep-3-personen" size="xl" color="hemelblauw" />Team & Toegang</c-heading>
            <p class="rvo-text--subtle">Teamleden met toegang tot dit project</p>
            
            <c-grid columns="three" gap="md">
                {% for user in project.users %}
                <c-card padding="md" outline="true" backgroundColor="grijs-050">
                    <c-layout-row gap="md" verticalSpacing="center">
                        <div style="display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: var(--rvo-color-hemelblauw); color: white; font-weight: 600; font-size: 1.125rem;">
                            {{ user.email[:2]|upper }}
                        </div>
                        <c-layout-flow gap="xs">
                            <div style="font-weight: 500; color: var(--rvo-color-grijs-900);">{{ user.email }}</div>
                            <div style="font-size: 0.875rem; color: var(--rvo-color-grijs-700); text-transform: capitalize;">{{ user.role|title }}</div>
                        </c-layout-flow>
                    </c-layout-row>
                </c-card>
                {% endfor %}
            </c-grid>
        </c-layout-flow>
    </c-card>

    {# Configuration Section #}
    {% if user_role in ["admin", "owner"] %}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="instellingen" size="xl" color="donkerblauw" />Configuratie & Secrets</c-heading>
            <p class="rvo-text--subtle">Project configuratie en gevoelige informatie</p>
            
            <div class="config-section">
                {% if project.config %}
                
                {# API Key Section #}
                {% if project.config.get('api-key') %}
                <div class="config-item">
                    <div class="config-label">
                        <c-icon icon="sleutel" size="md" color="rood" />
                        <strong>API Key</strong>
                    </div>
                    <div class="config-value">
                        <div class="sensitive-field" id="api-key-field">
                            <span class="sensitive-dots">••••••••••••••••••••••••••••••••</span>
                            <span class="sensitive-value" style="display: none;">{{ project.config['api-key'] }}</span>
                            <c-button 
                                label="Tonen"
                                kind="tertiary" 
                                size="sm"
                                showIcon="before"
                                icon="oog"
                                class="toggle-sensitive"
                                @click="toggleSensitive('api-key-field')" />
                        </div>
                    </div>
                </div>
                {% endif %}
                
                {# Age Public Key #}
                {% if project.config.get('age-public-key') %}
                <div class="config-item">
                    <div class="config-label">
                        <c-icon icon="beveiligingsscan" size="md" color="groen" />
                        <strong>Age Public Key</strong>
                    </div>
                    <div class="config-value">
                        <code class="config-code">{{ project.config['age-public-key'] }}</code>
                    </div>
                </div>
                {% endif %}
                
                {# Age Private Key #}
                {% if project.config.get('age-private-key') %}
                <div class="config-item">
                    <div class="config-label">
                        <c-icon icon="beveiligingsscan" size="md" color="rood" />
                        <strong>Age Private Key</strong>
                    </div>
                    <div class="config-value">
                        <div class="sensitive-field" id="private-key-field">
                            <span class="sensitive-dots">••••••••••••••••••••••••••••••••</span>
                            <span class="sensitive-value" style="display: none;"><pre class="config-code">{{ project.config['age-private-key'] }}</pre></span>
                            <c-button 
                                label="Tonen"
                                kind="tertiary" 
                                size="sm"
                                showIcon="before"
                                icon="oog"
                                class="toggle-sensitive"
                                @click="toggleSensitive('private-key-field')" />
                        </div>
                    </div>
                </div>
                {% endif %}
                
                {% else %}
                <div class="empty-state">
                    <c-icon icon="info" size="lg" color="grijs-050" />
                    <p class="rvo-text--md">Geen configuratie beschikbaar</p>
                </div>
                {% endif %}
            </div>
        </c-layout-flow>
    </c-card>
    {% endif %}

    {# Services Section #}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="applicatie" size="xl" color="groen" />Services & Integraties</c-heading>
            <p class="rvo-text--subtle">Geactiveerde services voor dit project</p>
            
            {% if project.services %}
            <div class="services-grid">
                {% for service in project.services %}
                <c-card class="service-detail-card" padding="lg" background="color" backgroundColor="wit" outline="true">
                    <c-layout-flow gap="md">
                        <div class="service-header">
                            {% set service_def = ServiceAdapter.get_service_definition(service.enum) %}
                            <c-icon icon="{{ service_def.icon }}" size="xl" color="{{ service_def.color }}"></c-icon>
                            <div>
                                <c-heading type="h3" textContent="{{ service_def.name }}" />
                                <div class="service-scope">{{ service_def.scope|title }} scope</div>
                            </div>
                        </div>
                        <p class="rvo-text--sm">{{ service_def.description }}</p>
                    </c-layout-flow>
                </c-card>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <c-icon icon="info" size="lg" color="grijs-050" />
                <p class="rvo-text--md">Geen services geconfigureerd</p>
            </div>
            {% endif %}
        </c-layout-flow>
    </c-card>

    {# Deployments Section #}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="server" size="xl" color="oranje" />Deployments</c-heading>
            <p class="rvo-text--subtle">Applicatie deployments per omgeving</p>
            
            {% if project.deployments %}
            <div class="deployments-section">
                {% for deployment in project.deployments %}
                <c-card class="deployment-card" padding="lg" background="color" backgroundColor="grijs-050" outline="true">
                    <c-layout-flow gap="md">
                        <div class="deployment-header">
                            <div>
                                <c-heading type="h3" textContent="{{ deployment.name }}" />
                                <div class="deployment-meta">
                                    <span class="cluster-badge">{{ deployment.cluster|title }}</span>
                                    <span class="namespace-badge">{{ deployment.namespace }}</span>
                                    {% if deployment.get('clone-from') %}
                                        <span class="clone-badge">Cloned from {{ deployment['clone-from'] }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="deployment-status">
                                <div class="status-badge status-running">
                                    <c-icon icon="applicatie" size="sm" />
                                    <span>Running</span>
                                </div>
                            </div>
                        </div>
                        
                        {# Components in this deployment #}
                        {% if deployment.components %}
                        <div class="deployment-components">
                            <c-heading type="h4" textContent="Components" />
                            <div class="component-list">
                                {% for component in deployment.components %}
                                <div class="component-item">
                                    <c-icon icon="puzzel" size="md" color="donkerblauw" />
                                    <div class="component-details">
                                        <div class="component-name">{{ component.reference }}</div>
                                        <div class="component-image">{{ component.image }}</div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        
                        {# Public ingress links for this deployment #}
                        {% if deployment.ingress_links %}
                        <c-layout-flow gap="sm">
                            <c-heading type="h4"><c-icon icon="externe-link" size="md" color="hemelblauw" />Publieke links</c-heading>
                            <c-layout-row gap="sm">
                                {% for link in deployment.ingress_links %}
                                <c-button 
                                    label="{{ link.component_name }}"
                                    kind="secondary"
                                    size="sm"
                                    showIcon="after"
                                    icon="externe-link"
                                    @click="window.open('{{ link.url }}', '_blank')" />
                                {% endfor %}
                            </c-layout-row>
                        </c-layout-flow>
                        {% endif %}
                        
                        {# Deployment Configuration Variables #}
                        {% if deployment.configuration %}
                        <div style="margin-top: var(--rvo-space-md); padding-top: var(--rvo-space-md); border-top: 1px solid var(--rvo-color-grijs-200);">
                            <c-heading type="h4" textContent="Configuratie Variabelen" />
                            <c-layout-flow gap="md">
                                {% set variables = deployment.configuration.get('variables', {}) %}
                                {% if variables %}
                                    {% for key, value in variables.items() %}
                                    <c-card padding="sm" backgroundColor="wit" outline="true">
                                        <c-layout-flow gap="xs">
                                            <div style="display: flex; align-items: center; gap: var(--rvo-space-sm);">
                                                <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                                <span class="rvo-text--sm" style="font-weight: 600;">{{ key }}</span>
                                            </div>
                                            <div style="margin-left: var(--rvo-space-lg);">
                                                <div class="sensitive-field" id="config-{{ deployment.name }}-{{ key|replace('_', '-')|lower }}">
                                                    <span class="sensitive-dots">••••••••••••••••••••</span>
                                                    <span class="sensitive-value" style="display: none;">{{ value }}</span>
                                                    <c-button
                                                        label="Tonen"
                                                        kind="tertiary"
                                                        size="sm"
                                                        showIcon="before"
                                                        icon="oog"
                                                        class="toggle-sensitive"
                                                        @click="toggleSensitive('config-{{ deployment.name }}-{{ key|replace('_', '-')|lower }}')" />
                                                </div>
                                            </div>
                                        </c-layout-flow>
                                    </c-card>
                                    {% endfor %}

                                    {% set metadata = deployment.configuration.get('metadata', {}) %}
                                    {% if metadata.get('updated_on') %}
                                    <div style="margin-top: var(--rvo-space-md); padding-top: var(--rvo-space-sm); border-top: 1px solid var(--rvo-color-grijs-100);">
                                        <small class="rvo-text--xs" style="display: flex; align-items: center; gap: var(--rvo-space-xs); color: var(--rvo-color-grijs-500);">
                                            <c-icon icon="info" size="sm" color="grijs-500" />
                                            Laatste update: {{ metadata.updated_on }}
                                        </small>
                                    </div>
                                    {% endif %}
                                {% else %}
                                <div class="empty-state">
                                    <c-icon icon="info" size="lg" color="grijs-050" />
                                    <p class="rvo-text--md">Geen configuratie variabelen beschikbaar</p>
                                </div>
                                {% endif %}
                            </c-layout-flow>
                        </div>
                        {% endif %}

                        {# User Configuration Variables for components in this deployment #}
                        {% set deployment_components = deployment.components %}
                        {% if deployment_components %}
                        {% set has_user_vars = false %}
                        {% for component in deployment_components %}
                            {% for project_component in project.components %}
                                {% if project_component.name == component.reference and project_component.get('user-env-vars') %}
                                    {% set has_user_vars = true %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}

                        {% if has_user_vars %}
                        <div style="margin-top: var(--rvo-space-md); padding-top: var(--rvo-space-md); border-top: 1px solid var(--rvo-color-grijs-200);">
                            <c-heading type="h4" style="margin-bottom: 0;"><c-icon icon="user" size="md" color="donkerblauw" />Gebruikers configuratie</c-heading>
                            <p class="rvo-text--subtle">Gebruiker-specifieke omgevingsvariabelen voor deze deployment</p>

                            <c-layout-flow gap="md">
                                {% for component in deployment_components %}
                                {% for project_component in project.components %}
                                {% if project_component.name == component.reference and project_component.get('user-env-vars') %}
                                <c-card padding="sm" backgroundColor="grijs-050" outline="true">
                                    <c-layout-flow gap="md">
                                        <c-layout-row gap="sm">
                                            <c-icon icon="puzzel" size="sm" color="donkerblauw" />
                                            <c-heading type="h5" textContent="Component: {{ component.reference }}" />
                                        </c-layout-row>

                                        <c-layout-flow gap="sm">
                                            {% for key, value in project_component['user-env-vars'].items() %}
                                            <c-card padding="sm" backgroundColor="wit" outline="true">
                                                <c-layout-flow gap="xs">
                                                    <div style="display: flex; align-items: center; gap: var(--rvo-space-sm);">
                                                        <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                                        <span class="rvo-text--sm" style="font-weight: 600;">{{ key }}</span>
                                                    </div>
                                                    <div style="margin-left: var(--rvo-space-lg);">
                                                        <div class="sensitive-field" id="user-{{ deployment.name }}-{{ component.reference }}-{{ key|replace('_', '-')|lower }}">
                                                            <span class="sensitive-dots">••••••••••••••••••••</span>
                                                            <span class="sensitive-value" style="display: none;">{{ value }}</span>
                                                            <c-button
                                                                label="Tonen"
                                                                kind="tertiary"
                                                                size="sm"
                                                                showIcon="before"
                                                                icon="oog"
                                                                class="toggle-sensitive"
                                                                @click="toggleSensitive('user-{{ deployment.name }}-{{ component.reference }}-{{ key|replace('_', '-')|lower }}')" />
                                                        </div>
                                                    </div>
                                                </c-layout-flow>
                                            </c-card>
                                            {% endfor %}
                                        </c-layout-flow>
                                    </c-layout-flow>
                                </c-card>
                                {% endif %}
                                {% endfor %}
                                {% endfor %}
                            </c-layout-flow>
                        </div>
                        {% endif %}
                        {% endif %}
                    </c-layout-flow>
                </c-card>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <c-icon icon="info" size="lg" color="grijs-050" />
                <p class="rvo-text--md">Geen deployments geconfigureerd</p>
            </div>
            {% endif %}
        </c-layout-flow>
    </c-card>


    {# Components Section #}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="puzzel" size="xl" color="donkerblauw" />Components</c-heading>
            <p class="rvo-text--subtle">Applicatie componenten en hun configuratie</p>

            {% if project.components %}
            <div class="components-section">
                {% for component in project.components %}
                <c-card class="component-card" padding="lg" background="color" backgroundColor="wit" outline="true">
                    <c-layout-flow gap="md">
                        <div class="component-header">
                            <c-icon icon="puzzel" size="lg" color="donkerblauw" />
                            <div>
                                <c-heading type="h3" textContent="{{ component.name }}" />
                                <div class="component-type">{{ component.type|title }}</div>
                            </div>
                        </div>

                        <div class="component-specs">
                            {% if component.ports %}
                            <div class="spec-item">
                                <strong>Poorten:</strong>
                                {% if component.ports.inbound %}Inbound: {{ component.ports.inbound|join(", ") }}{% endif %}
                                {% if component.ports.outbound %}{% if component.ports.inbound %} | {% endif %}Outbound: {{ component.ports.outbound|join(", ") }}{% endif %}
                            </div>
                            {% endif %}

                            {% if component.resources %}
                            <div class="spec-item">
                                <strong>Resources:</strong>
                                {% if component.resources.cpu %}CPU: {{ component.resources.cpu }}{% endif %}
                                {% if component.resources.memory %}{% if component.resources.cpu %} | {% endif %}Memory: {{ component.resources.memory }}{% endif %}
                            </div>
                            {% endif %}

                            {% if component['uses-services'] %}
                            <div class="spec-item">
                                <strong>Services:</strong> {{ component['uses-services']|join(", ")|replace("-", " ")|title }}
                            </div>
                            {% endif %}
                        </div>

                        {# Public ingress links for this component #}
                        {% if component.ingress_links %}
                        <c-layout-flow gap="sm">
                            <c-heading type="h5"><c-icon icon="externe-link" size="sm" color="hemelblauw" />Publieke links</c-heading>
                            <c-layout-row gap="sm">
                                {% for link in component.ingress_links %}
                                <c-button
                                    label="{{ link.deployment_name }} ({{ link.cluster }})"
                                    kind="secondary"
                                    size="sm"
                                    showIcon="after"
                                    icon="externe-link"
                                    @click="window.open('{{ link.url }}', '_blank')" />
                                {% endfor %}
                            </c-layout-row>
                        </c-layout-flow>
                        {% endif %}

                        {# User Environment Variables indicator for this component #}
                        {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
                        <div class="env-vars-indicator">
                            <c-icon icon="sleutel" size="sm" color="hemelblauw" />
                            <span>{{ component['user-env-vars']|length }} omgevingsvariabele{% if component['user-env-vars']|length != 1 %}n{% endif %}</span>
                            <span class="rvo-text--subtle">(zie Omgevingsvariabelen sectie)</span>
                        </div>
                        {% endif %}
                    </c-layout-flow>
                </c-card>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <c-icon icon="info" size="lg" color="grijs-050" />
                <p class="rvo-text--md">Geen componenten geconfigureerd</p>
            </div>
            {% endif %}
        </c-layout-flow>
    </c-card>


    {# Environment Variables Overview Section #}
    {% set ns = namespace(has_any_env_vars=false, has_component_env_vars=false, has_deployment_env_vars=false) %}
    {% for component in project.components %}
        {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
            {% set ns.has_any_env_vars = true %}
            {% set ns.has_component_env_vars = true %}
        {% endif %}
    {% endfor %}
    {% for deployment in project.deployments %}
        {% for dep_component in deployment.components %}
            {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
                {% set ns.has_any_env_vars = true %}
                {% set ns.has_deployment_env_vars = true %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="sleutel" size="xl" color="hemelblauw" />Omgevingsvariabelen</c-heading>
            <p class="rvo-text--subtle">Overzicht van alle gebruiker-gedefinieerde omgevingsvariabelen per scope</p>

            {% if ns.has_any_env_vars %}
            <c-layout-flow gap="xl">

                {# Component-level Environment Variables #}
                {% if ns.has_component_env_vars %}
                <div class="env-vars-scope-section">
                    <c-layout-flow gap="md">
                        <div class="env-vars-scope-header">
                            <c-icon icon="puzzel" size="lg" color="donkerblauw" />
                            <div>
                                <c-heading type="h3" textContent="Component niveau" />
                                <p class="rvo-text--sm rvo-text--subtle">Standaard variabelen per component (gelden voor alle deployments)</p>
                            </div>
                        </div>

                        {% for component in project.components %}
                        {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
                        <c-card padding="md" backgroundColor="grijs-050" outline="true">
                            <c-layout-flow gap="sm">
                                <div class="env-vars-component-header">
                                    <c-icon icon="puzzel" size="md" color="donkerblauw" />
                                    <strong>{{ component.name }}</strong>
                                    <span class="env-vars-count-badge">{{ component['user-env-vars']|length }} variabele{% if component['user-env-vars']|length != 1 %}n{% endif %}</span>
                                </div>

                                <div class="env-vars-list">
                                    {% for key, value in component['user-env-vars'].items() %}
                                    <div class="env-var-item">
                                        <div class="env-var-key">
                                            <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                            <code>{{ key }}</code>
                                        </div>
                                        <div class="env-var-value">
                                            <div class="sensitive-field" id="env-overview-comp-{{ component.name }}-{{ key|replace('_', '-')|lower }}">
                                                <span class="sensitive-dots">••••••••••••••••</span>
                                                <span class="sensitive-value" style="display: none;">{{ value }}</span>
                                                <c-button
                                                    label="Tonen"
                                                    kind="tertiary"
                                                    size="sm"
                                                    showIcon="before"
                                                    icon="oog"
                                                    class="toggle-sensitive"
                                                    @click="toggleSensitive('env-overview-comp-{{ component.name }}-{{ key|replace('_', '-')|lower }}')" />
                                            </div>
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                            </c-layout-flow>
                        </c-card>
                        {% endif %}
                        {% endfor %}
                    </c-layout-flow>
                </div>
                {% endif %}

                {# Deployment-specific Environment Variables #}
                {% if ns.has_deployment_env_vars %}
                <div class="env-vars-scope-section">
                    <c-layout-flow gap="md">
                        <div class="env-vars-scope-header">
                            <c-icon icon="server" size="lg" color="oranje" />
                            <div>
                                <c-heading type="h3" textContent="Deployment niveau" />
                                <p class="rvo-text--sm rvo-text--subtle">Deployment-specifieke variabelen (overschrijven component niveau)</p>
                            </div>
                        </div>

                        {% for deployment in project.deployments %}
                        {% set dep_ns = namespace(has_env_vars=false) %}
                        {% for dep_component in deployment.components %}
                            {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
                                {% set dep_ns.has_env_vars = true %}
                            {% endif %}
                        {% endfor %}

                        {% if dep_ns.has_env_vars %}
                        <c-card padding="md" backgroundColor="grijs-050" outline="true">
                            <c-layout-flow gap="md">
                                <div class="env-vars-deployment-header">
                                    <c-icon icon="server" size="md" color="oranje" />
                                    <strong>{{ deployment.name }}</strong>
                                    <span class="cluster-badge">{{ deployment.cluster|title }}</span>
                                </div>

                                {% for dep_component in deployment.components %}
                                {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
                                <c-card padding="sm" backgroundColor="wit" outline="true">
                                    <c-layout-flow gap="sm">
                                        <div class="env-vars-component-header">
                                            <c-icon icon="puzzel" size="sm" color="donkerblauw" />
                                            <span>{{ dep_component.reference }}</span>
                                            <span class="env-vars-count-badge">{{ dep_component['user-env-vars']|length }} variabele{% if dep_component['user-env-vars']|length != 1 %}n{% endif %}</span>
                                        </div>

                                        <div class="env-vars-list">
                                            {% for key, value in dep_component['user-env-vars'].items() %}
                                            <div class="env-var-item">
                                                <div class="env-var-key">
                                                    <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                                    <code>{{ key }}</code>
                                                </div>
                                                <div class="env-var-value">
                                                    <div class="sensitive-field" id="env-overview-dep-{{ deployment.name }}-{{ dep_component.reference }}-{{ key|replace('_', '-')|lower }}">
                                                        <span class="sensitive-dots">••••••••••••••••</span>
                                                        <span class="sensitive-value" style="display: none;">{{ value }}</span>
                                                        <c-button
                                                            label="Tonen"
                                                            kind="tertiary"
                                                            size="sm"
                                                            showIcon="before"
                                                            icon="oog"
                                                            class="toggle-sensitive"
                                                            @click="toggleSensitive('env-overview-dep-{{ deployment.name }}-{{ dep_component.reference }}-{{ key|replace('_', '-')|lower }}')" />
                                                    </div>
                                                </div>
                                            </div>
                                            {% endfor %}
                                        </div>
                                    </c-layout-flow>
                                </c-card>
                                {% endif %}
                                {% endfor %}
                            </c-layout-flow>
                        </c-card>
                        {% endif %}
                        {% endfor %}
                    </c-layout-flow>
                </div>
                {% endif %}

            </c-layout-flow>
            {% else %}
            <div class="empty-state">
                <c-icon icon="info" size="lg" color="grijs-050" />
                <p class="rvo-text--md">Geen omgevingsvariabelen geconfigureerd</p>
            </div>
            {% endif %}
        </c-layout-flow>
    </c-card>

    {# Repositories Section #}
    {% if project.repositories %}
    <c-card outline="true" padding="xl" backgroundColor="wit">
        <c-layout-flow gap="lg">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="computercode" size="xl" color="oranje" />Git Repositories</c-heading>
            <p class="rvo-text--subtle">Gekoppelde code repositories</p>

            <div class="repositories-section">
                {% for repo in project.repositories %}
                <c-card class="repository-card" padding="lg" background="color" backgroundColor="grijs-050" outline="true">
                    <c-layout-flow gap="md">
                        <div class="repo-header">
                            <c-icon icon="computercode" size="lg" color="oranje" />
                            <div>
                                <c-heading type="h3" textContent="{{ repo.name }}" />
                                <div class="repo-url">{{ repo.url }}</div>
                            </div>
                        </div>

                        <div class="repo-details">
                            <div class="repo-item"><strong>Branch:</strong> {{ repo.branch }}</div>
                            <div class="repo-item"><strong>Path:</strong> {{ repo.path }}</div>
                            <div class="repo-item"><strong>Username:</strong> {{ repo.username }}</div>
                        </div>
                    </c-layout-flow>
                </c-card>
                {% endfor %}
            </div>
        </c-layout-flow>
    </c-card>
    {% endif %}

</c-layout-flow>
{% endblock %}

