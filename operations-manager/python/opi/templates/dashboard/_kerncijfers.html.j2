{# De vier kerncijfers: projecten, deployments, gebruikers en pods. #}
<div class="stats-grid">
    <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <div class="stat-header">
                <c-icon icon="applicatie" size="lg" />
                <span class="stat-number" data-count="{{ active_projects }}">0</span>
            </div>
            <c-heading type="h3" textContent="Actieve Projecten" />
            <p class="rvo-text--sm rvo-text--subtle">{{ total_deployments }} deployments</p>
        </c-layout-flow>
    </c-card>

    <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <div class="stat-header">
                <c-icon icon="server" size="lg" />
                <span class="stat-number" data-count="{{ total_deployments }}">0</span>
            </div>
            <c-heading type="h3" textContent="Deployments" />
        </c-layout-flow>
    </c-card>

    <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <div class="stat-header">
                <c-icon icon="user" size="lg" />
                <span class="stat-number" data-count="{{ total_users }}">0</span>
            </div>
            <c-heading type="h3" textContent="Gebruikers" />
        </c-layout-flow>
    </c-card>

    <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <div class="stat-header">
                <c-icon icon="vinkje" size="lg" />
                <span class="stat-number" data-count="{{ pod_count }}">0</span>
            </div>
            <c-heading type="h3" textContent="Pods" />
        </c-layout-flow>
    </c-card>
</div>
