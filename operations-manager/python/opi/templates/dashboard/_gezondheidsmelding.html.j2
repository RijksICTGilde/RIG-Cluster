{# De banner die meldt hoeveel projecten problemen hebben. #}
{% if health_counts is defined %}
    {% if health_counts.Degraded > 0 %}
    <c-alert kind="error" heading="{{ health_counts.Degraded }} project{{ 'en' if health_counts.Degraded != 1 }} {{ 'hebben' if health_counts.Degraded != 1 else 'heeft' }} problemen" maxWidth="lg">
        <c-layout-flow gap="xs">
            {% for project in projects if project.health == 'Degraded' %}
            <c-link content="{{ project.display_name }} - Bekijk deployment status" href="/projects/details/{{ project.name }}#deployment-status" weight="bold" />
            {% endfor %}
        </c-layout-flow>
    </c-alert>
    {% elif health_counts.Progressing > 0 %}
    <c-alert kind="warning" heading="{{ health_counts.Progressing }} project{{ 'en' if health_counts.Progressing != 1 }} {{ 'worden' if health_counts.Progressing != 1 else 'wordt' }} bijgewerkt" maxWidth="lg">
        <c-layout-flow gap="xs">
            {% for project in projects if project.health == 'Progressing' %}
            <c-link content="{{ project.display_name }} - Bekijk deployment status" href="/projects/details/{{ project.name }}#deployment-status" weight="bold" />
            {% endfor %}
        </c-layout-flow>
    </c-alert>
    {% elif health_banner %}
    {# The wording is decided in _dashboard_health_banner, not here: "Alle N projecten
       zijn gezond" stopped being true the moment one of them ran nothing on purpose,
       and what stands there instead is a text choice (RC-31). #}
    <c-alert kind="{{ health_banner.kind }}" heading="{{ health_banner.heading }}" maxWidth="lg">
        {% if health_banner.lines %}
        <c-layout-flow gap="xs">
            {% for line in health_banner.lines %}
            <span class="rvo-text--sm">{{ line }}</span>
            {% endfor %}
        </c-layout-flow>
        {% endif %}
    </c-alert>
    {% elif not argocd_available %}
    <c-alert kind="info" heading="Status informatie niet beschikbaar" content="ArgoCD is niet verbonden." maxWidth="lg" />
    {% endif %}
{% endif %}
