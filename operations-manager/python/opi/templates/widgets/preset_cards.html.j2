{% from "widgets/_macros.html.j2" import bool_attr %}
{% if preset_states %}
<div class="service-cards-grid">
    {% for state in preset_states %}
    {% set preset = state.preset %}
    {% set applied = state.applied %}
    {% set locked = state.locked %}
    <div class="service-card{% if applied %} service-card--selected{% endif %}{% if locked %} service-card--locked-checked{% endif %}"
         {% if not locked %}
         hx-post="/forms/wizard/{{ flow_id|e }}/preset/{{ section_id|e }}/{{ preset.id|e }}"
         hx-target="#wizard-step-content"
         hx-swap="innerHTML"
         {% endif %}>
        <c-checkbox
            id="preset-{{ preset.id|e }}"
            name="_preset_{{ preset.id|e }}"
            {{ bool_attr("checked", applied) }}
            {{ bool_attr("disabled", locked) }}
        />
        <div class="service-card__content">
            <div class="service-card__header">
                <c-icon icon="{{ preset.icon|e }}" color="{{ preset.color|e }}" size="lg" />
                <span class="service-card__title">{{ preset.label|e }}</span>
            </div>
            <p class="service-card__description">{{ preset.description|e }}</p>
            {% if locked and state.locked_hint %}
            <p class="service-card__hint">{{ state.locked_hint|e }}</p>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
