{% from "widgets/_macros.html.j2" import helper_text, render_errors, bool_attr %}
<div class="rvo-form-group">
    <span class="utrecht-form-label">{{ field.label|e }}</span>
    {{ helper_text(field) }}
    <div class="service-cards-grid" id="{{ field.path|e }}-grid">
        {% for card in cards %}
        <div class="service-card{% if card.checked %} service-card--selected{% endif %}{% if card.is_locked %} service-card--locked-checked{% endif %}" data-service="{{ card.value|e }}"{% if card.data_requires %} data-requires='{{ card.data_requires }}'{% endif %}{% if card.server_locked %} data-locked="true"{% endif %}>
            <c-checkbox
                id="{{ field.path|e }}-{{ card.value|e }}"
                name="{{ field.path|e }}[]"
                value="{{ card.value|e }}"
                {{ bool_attr("checked", card.checked) }}
                {{ bool_attr("disabled", card.disabled) }}
            />
            {% if card.checked and card.disabled %}
            <input type="hidden" name="{{ field.path|e }}[]" value="{{ card.value|e }}" />
            {% endif %}
            <div class="service-card__content">
                <div class="service-card__header">
                    <c-icon icon="{{ card.icon|e }}" color="{{ card.color|e }}" size="lg" />
                    <span class="service-card__title">{{ card.label|e }}</span>
                    {% if card.help_template %}
                    <c-icon icon="vraagteken" size="xl" color="hemelblauw"
                            class="service-card__help-btn"
                            @click="event.stopPropagation(); openServiceHelp('{{ card.help_template|e }}')" />
                    {% endif %}
                </div>
                <p class="service-card__description">{{ card.description|e }}</p>
                {% if card.is_locked and card.dependents_labels %}
                <p class="service-card__hint">Vereist door: {{ card.dependents_labels|join(', ')|e }}</p>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {{ render_errors(field.errors) }}
</div>
