{# Skeleton placeholder shown while an ArgoCD status card lazy-loads.
   Mimics the silhouette of _argocd-deployment-card.html.j2: header row,
   status badges, sync line and logs button. Styles in project-details.html.j2. #}
<div class="argocd-skeleton" role="status" aria-label="ArgoCD status wordt geladen">
    <div class="argocd-skeleton__row">
        <span class="argocd-skeleton__bone" style="width: 24px; height: 24px; border-radius: 50%;"></span>
        <span class="argocd-skeleton__bone" style="width: 38%; height: 18px;"></span>
        <span class="argocd-skeleton__bone" style="width: 64px; height: 20px;"></span>
    </div>
    <div class="argocd-skeleton__row">
        <span class="argocd-skeleton__bone" style="width: 100px; height: 26px; border-radius: 16px;"></span>
        <span class="argocd-skeleton__bone" style="width: 88px; height: 26px; border-radius: 16px;"></span>
    </div>
    <span class="argocd-skeleton__bone" style="width: 55%; height: 14px;"></span>
    <span class="argocd-skeleton__bone" style="width: 112px; height: 30px;"></span>
</div>
