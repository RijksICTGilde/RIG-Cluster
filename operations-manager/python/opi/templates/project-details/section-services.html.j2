{# Services & Integraties Section #}
<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <c-layout-flow row="true" justifyContent="space-between" alignItems="center">
            <c-heading type="h2"><c-icon icon="applicatie" size="xl" color="groen" />Services & Integraties</c-heading>
            {% if user_role in ["admin", "owner"] %}
            <c-button kind="secondary" size="sm" label="Bewerken" showIcon="before" icon="bewerken"
                      @click="openEditModal('modal-edit-services', 'Services beheren')" />
            {% endif %}
        </c-layout-flow>
        <p class="rvo-text--subtle">Geactiveerde services voor dit project</p>

        {% if project.services %}
        <c-grid columns="three" gap="lg">
            {% for service in project.services %}
            <c-card class="service-detail-card" padding="lg" background="color" backgroundColor="wit" outline="true">
                <c-layout-flow gap="md">
                    <div class="service-header">
                        {% set service_def = ServiceAdapter.get_service_definition(service.enum) %}
                        <div>
                            <c-heading type="h3"><c-icon icon="{{ service_def.icon }}" size="xl" color="{{ service_def.color }}" />{{ service_def.name }}</c-heading>
                            <div class="service-scope">{{ service_def.scope|title }} scope</div>
                        </div>
                    </div>
                    <p class="rvo-text--sm">{{ service_def.description }}</p>
                    {% if user_role in ["admin", "owner"] and service.value in service_config_sections %}
                    <c-button
                        label="Configureer"
                        kind="tertiary"
                        size="sm"
                        icon="bewerken"
                        @click="openEditModal('{{ service_config_sections[service.value] }}', '{{ service_def.name }} configuratie')" />
                    {% endif %}
                </c-layout-flow>
            </c-card>
            {% endfor %}
        </c-grid>
        {% else %}
        <c-alert kind="info">Geen services geconfigureerd</c-alert>
        {% endif %}
    </c-layout-flow>
</c-card>
