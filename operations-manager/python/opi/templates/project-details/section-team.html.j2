{# Team & Toegang Section #}
<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <c-layout-flow row="true" justifyContent="space-between" alignItems="center">
            <c-heading type="h2"><c-icon icon="groep-3-personen" size="xl" color="hemelblauw" />Team & Toegang</c-heading>
            {% if user_role in ["admin", "owner"] %}
            <c-button kind="secondary" size="sm" label="Bewerken" showIcon="before" icon="bewerken"
                      @click="openEditModal('modal-edit-team', 'Projectleden beheren')" />
            {% endif %}
        </c-layout-flow>
        <p class="rvo-text--subtle">Teamleden met toegang tot dit project</p>

        <c-grid columns="three" gap="md">
            {% for user in project.users | sort(attribute='email') %}
            <c-card padding="md" outline="true" backgroundColor="grijs-050">
                <c-layout-row gap="md" verticalSpacing="center">
                    <div class="team-avatar">
                        {{ user.email[:2]|upper }}
                    </div>
                    <c-layout-flow gap="xs">
                        <div class="team-email">{{ user.email }}</div>
                        <div class="team-role">{{ user.role|title }}</div>
                    </c-layout-flow>
                </c-layout-row>
            </c-card>
            {% endfor %}
        </c-grid>
    </c-layout-flow>
</c-card>
