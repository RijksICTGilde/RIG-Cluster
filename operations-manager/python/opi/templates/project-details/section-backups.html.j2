{# Backups Section - Show backups per deployment for current cluster #}
{% if backups_available and project.deployments %}
{% set ns = namespace(has_backups=false) %}
{% for deployment in project.deployments %}
    {% if deployment.cluster == current_cluster and deployment_backups.get(deployment.name) %}
        {% set ns.has_backups = true %}
    {% endif %}
{% endfor %}
<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="database" size="xl" color="groen" />Backups</c-heading>
                <p class="rvo-text--subtle">Beschikbare backups per deployment (alleen voor cluster: {{ current_cluster }})</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="edit-section-btn" onclick="openEditModal('modal-backup', 'Backup aanmaken')" title="Backup aanmaken">
                    <c-icon icon="iconen-toevoegen" size="sm" color="groen" />
                    <span>Backup aanmaken</span>
                </button>
                {% if ns.has_backups %}
                <button type="button" class="edit-section-btn" onclick="openEditModal('modal-restore', 'Backup herstellen')" title="Backup herstellen">
                    <c-icon icon="terug" size="sm" color="hemelblauw" />
                    <span>Herstellen</span>
                </button>
                {% endif %}
            </div>
        </div>

        {% if ns.has_backups %}
        <div>
            {% for deployment in project.deployments %}
            {% if deployment.cluster == current_cluster %}
            <div class="deployment-section" id="backups-{{ deployment.name }}"
                 {% if not loop.first and project.deployments|length > 1 %}style="display: none;"{% endif %}>
            {% set backups = deployment_backups.get(deployment.name, []) %}

            <c-card padding="lg" outline="true" backgroundColor="grijs-050" style="border-left: 4px solid var(--rvo-color-groen);">
                <c-layout-flow gap="md">
                    {# Deployment Header #}
                    <c-layout-row gap="sm" verticalSpacing="center">
                        <c-icon icon="applicatie" size="md" color="donkerblauw" />
                        <c-heading type="h4" textContent="{{ deployment.name }}" />
                        <span style="background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">{{ deployment.namespace }}</span>
                    </c-layout-row>

                    {% if backups %}
                    {# Group backups by backup_run_id for visual distinction #}
                    {% set backup_runs = {} %}
                    {% for backup in backups %}
                        {% set run_id = backup.backup_run_id or 'unknown' %}
                        {% if run_id not in backup_runs %}
                            {% set _ = backup_runs.update({run_id: []}) %}
                        {% endif %}
                        {% set _ = backup_runs[run_id].append(backup) %}
                    {% endfor %}
                    {% set run_colors = ['var(--rvo-color-wit)', 'var(--rvo-color-grijs-100)'] %}
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--rvo-color-grijs-300);">
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Backup Run</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Type</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Component</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Storage</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Gen</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Timestamp</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Grootte</th>
                                    <th style="text-align: left; padding: 8px 12px; font-weight: 600; color: var(--rvo-color-grijs-700);">Snapshot ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set color_idx = namespace(val=0) %}
                                {% for run_id, run_backups in backup_runs.items() | sort(reverse=true) %}
                                {% set row_bg = run_colors[color_idx.val % 2] %}
                                {% for backup in run_backups %}
                                <tr style="border-bottom: 1px solid var(--rvo-color-grijs-200); background: {{ row_bg }};">
                                    <td style="padding: 8px 12px;">
                                        {% if run_id != 'unknown' %}
                                            <code style="font-family: monospace; font-size: 0.75rem; background: var(--rvo-color-hemelblauw-200); color: var(--rvo-color-donkerblauw); padding: 2px 6px; border-radius: 4px; cursor: help;" title="{{ run_backups | length }} item(s) in deze backup run">{{ run_id }}</code>
                                        {% else %}
                                            <span style="color: var(--rvo-color-grijs-500); font-size: 0.75rem;">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        {% if backup.resource_type == 'pvc' %}
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: var(--rvo-color-hemelblauw-200); color: var(--rvo-color-donkerblauw);">
                                                PVC
                                            </span>
                                        {% elif backup.resource_type == 'database' %}
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: var(--rvo-color-grasgroen-200); color: var(--rvo-color-grasgroen-800);">
                                                DB
                                            </span>
                                        {% elif backup.resource_type == 'bucket' %}
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: var(--rvo-color-oranje-200); color: var(--rvo-color-oranje-800);">
                                                Bucket
                                            </span>
                                        {% else %}
                                            <span style="color: var(--rvo-color-grijs-500); font-size: 0.75rem;">{{ backup.resource_type or '-' }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        <span style="display: inline-flex; align-items: center; gap: 4px;">
                                            <c-icon icon="document-blanco" size="sm" color="grijs-600" />
                                            {{ backup.component_name or '-' }}
                                        </span>
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        {{ backup.storage_name or '-' }}
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        {% if backup.generation is not none %}
                                            <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 24px; background: var(--rvo-color-grijs-200); border-radius: 4px; font-weight: 500;">v{{ backup.generation }}</span>
                                        {% else %}
                                            <span style="color: var(--rvo-color-grijs-500);">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        <span style="color: var(--rvo-color-grijs-700);">{{ backup.timestamp | dutch_date }}</span>
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        {% if backup.size_bytes is not none %}
                                            {% if backup.size_bytes == 0 %}
                                                <span style="color: var(--rvo-color-grijs-500);">0 B (leeg)</span>
                                            {% else %}
                                                {% set size_mb = (backup.size_bytes / 1048576) | round(2) %}
                                                {% if size_mb >= 1024 %}
                                                    {{ (size_mb / 1024) | round(2) }} GB
                                                {% elif size_mb >= 1 %}
                                                    {{ size_mb }} MB
                                                {% else %}
                                                    {{ (backup.size_bytes / 1024) | round(2) }} KB
                                                {% endif %}
                                            {% endif %}
                                        {% else %}
                                            <span style="color: var(--rvo-color-grijs-500);">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        {% set tags_display = [] %}
                                        {% if backup.tags %}
                                            {% for key, value in backup.tags.items() %}
                                                {% set _ = tags_display.append(key ~ ': ' ~ value) %}
                                            {% endfor %}
                                        {% endif %}
                                        <code style="font-family: monospace; font-size: 0.7rem; background: var(--rvo-color-grijs-100); padding: 2px 6px; border-radius: 4px; cursor: pointer; user-select: all;" title="Click to select, PVC: {{ backup.pvc_name }}&#10;{% if backup.tags %}Tags:&#10;{{ tags_display | join('&#10;') }}{% endif %}">{{ backup.snapshot_id }}</code>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% set color_idx.val = color_idx.val + 1 %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="rvo-text--sm rvo-text--subtle" style="margin-top: 8px;">
                        {% set known_runs = backup_runs.keys() | reject('equalto', 'unknown') | list %}
                        {% if known_runs | length > 0 %}
                            {{ known_runs | length }} backup run(s), {{ backups|length }} snapshot(s) totaal
                        {% else %}
                            {{ backups|length }} backup(s) gevonden
                        {% endif %}
                    </p>
                    {% else %}
                    <p class="rvo-text--md rvo-text--subtle">
                        <c-icon icon="info" size="sm" color="grijs-500" />
                        Geen backups gevonden voor deze deployment
                    </p>
                    {% endif %}
                </c-layout-flow>
            </c-card>
            </div>
            {% endif %}
            {% endfor %}
        </div>
        {% else %}
        <c-card padding="md" outline="true" backgroundColor="grijs-050">
            <c-layout-row gap="md" verticalSpacing="center">
                <c-icon icon="info" size="md" color="grijs-500" />
                <p class="rvo-text--md">Geen backups beschikbaar voor deployments op cluster {{ current_cluster }}</p>
            </c-layout-row>
        </c-card>
        {% endif %}
    </c-layout-flow>
</c-card>
{% elif not backups_available and project.deployments %}
<c-card outline="true" padding="lg" backgroundColor="grijs-050">
    <c-layout-row gap="md" verticalSpacing="center">
        <c-icon icon="info" size="lg" color="grijs-500" />
        <div>
            <strong>Backups niet beschikbaar</strong>
            <p class="rvo-text--sm rvo-text--subtle">De backup service is niet verbonden. Backup informatie wordt getoond wanneer de service beschikbaar is.</p>
        </div>
    </c-layout-row>
</c-card>
{% endif %}
