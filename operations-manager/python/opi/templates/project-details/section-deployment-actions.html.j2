{# Deployment Actions Section - quick actions per deployment #}
{% set deployment_service_actions = deployment_service_actions | default({}) %}
{% if user_role in ["admin", "owner"] and project.deployments %}
    {# Database console only makes sense when the project has a PostgreSQL service. #}
    {% set service_values = project.services | default([]) | map(attribute='value') | list %}
    {% set has_database = 'postgresql-database' in service_values or 'namespace-postgresql-database' in service_values %}
    {% for deployment in project.deployments | sort(attribute='name') %}
    {% set original_index = project.deployments.index(deployment) %}
    <div class="deployment-section" id="deployment-actions-{{ deployment.name }}"
         {% if not loop.first and project.deployments|length > 1 %}style="display: none;"{% endif %}>
    <c-card outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="md">
            <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="instellingen" size="xl" color="hemelblauw" />Acties</c-heading>
            <c-layout-row gap="sm">
                <c-button
                    label="Images bewerken"
                    kind="secondary"
                    size="sm"
                    showIcon="before"
                    icon="bewerken"
                    @click="openEditModal('modal-edit-deployment-{{ original_index }}', 'Images bewerken - {{ deployment.name }}')" />
                <c-button
                    label="Deployment herverwerken"
                    kind="secondary"
                    size="sm"
                    showIcon="before"
                    icon="refresh"
                    @click="showDangerConfirmation('deployment-refresh', '{{ deployment.name }}', 'Weet u zeker dat u deployment &quot;{{ deployment.name }}&quot; wilt herverwerken? Dit synchroniseert de manifesten voor deze deployment.')" />
                {% if has_database %}
                <c-button
                    label="Databaseconsole"
                    kind="secondary"
                    size="sm"
                    showIcon="before"
                    icon="database"
                    @click="openDbConsoleModal('{{ deployment.name }}')" />
                {% endif %}
                <c-button
                    label="Job uitvoeren"
                    kind="secondary"
                    size="sm"
                    showIcon="before"
                    icon="uitvoering"
                    @click="openJobModal('{{ deployment.name }}')" />
                {# Service-contributed action buttons (e.g. sleep-mode "wake"). A service
                   owns its own button via ServiceDefinition.actions_provider instead of
                   this template hardcoding the condition. #}
                {% for action in deployment_service_actions.get(deployment.name, []) if action.visible %}
                <c-button
                    label="{{ action.label }}"
                    kind="{{ action.kind }}"
                    size="sm"
                    showIcon="before"
                    icon="{{ action.icon }}"
                    @click="runDeploymentAction('{{ action.endpoint }}', '{{ action.confirm_message }}')" />
                {% endfor %}
            </c-layout-row>
        </c-layout-flow>
    </c-card>
    </div>
    {% endfor %}
{% endif %}
