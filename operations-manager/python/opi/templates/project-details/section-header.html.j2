{# Page Header - project name, description, badge #}
<div>
    <c-layout-flow row="true" justifyContent="space-between" alignItems="center" class="section-header-row">
        <div>
            <c-layout-flow row="true" alignItems="center" gap="sm">
                <c-heading type="h1" textContent="{{ project.display_name }}" />
                {% if user_role in ["admin", "owner"] %}
                <c-button kind="secondary" size="sm" label="Bewerken" showIcon="before" icon="bewerken"
                          @click="openEditModal('modal-edit-identity', 'Projectgegevens bewerken')" />
                {% endif %}
            </c-layout-flow>
            {% if project.description %}
            <p class="rvo-text--lg text-flush">{{ project.description }}</p>
            {% endif %}
        </div>
    </c-layout-flow>
</div>
