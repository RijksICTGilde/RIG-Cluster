{# Page Header — project name, description, badge #}
<div>
    <c-layout-flow row="true" justifyContent="space-between" alignItems="center" style="margin-bottom: var(--rvo-space-md);">
        <div>
            <c-heading type="h1" textContent="{{ project.display_name }}" />
            <c-layout-flow row="true" alignItems="center" gap="sm">
                <p class="rvo-text--lg" style="margin: 0;">{{ project.description }}</p>
                {% if user_role in ["admin", "owner"] %}
                <c-button kind="secondary" size="sm" showIcon="before" icon="bewerken"
                          @click="openEditModal('modal-edit-identity', 'Projectgegevens bewerken')" />
                {% endif %}
            </c-layout-flow>
        </div>
    </c-layout-flow>
</div>
