{#
  ArgoCD status card for a single deployment.
  Expects these variables to be set before include:
    - deployment: the deployment object
    - argocd_status: dict of deployment_name -> status
    - current_cluster: current cluster name
    - project: the project object
    - disabled_state: DeploymentDisabledState for this deployment (opi.services.disabled_state)
  Optional:
    - _argocd_card_id_prefix: prefix for error toggle IDs (default: deployment.name)
#}
{% set status = argocd_status.get(deployment.name, {}) %}
{% set health = status.get('health', 'Unknown') %}
{% set sync = status.get('sync', 'Unknown') %}
{% set errors = status.get('errors', []) %}
{% set has_errors = errors|length > 0 %}
{% set _id_prefix = _argocd_card_id_prefix | default(deployment.name) %}
{# Components auto-disabled (replicas 0) by the OOM/image-pull watcher or sanitize pass.
   The flag is written inline per deployment-component (comp.disabled + comp.disabled-reason);
   these carry the reason and drive the per-component alerts below. #}
{% set disabled_components = deployment.components | selectattr('disabled') | list if deployment.components else [] %}
{# Whether this card gets to show ArgoCD's badges at all. Computed up front because the
   switched-off chip in the header only has to appear when the badge row does not (RC-31):
   otherwise the same word would stand twice on one card. #}
{% set has_image = deployment.components | selectattr('image', 'defined') | selectattr('image') | list | length > 0 if deployment.components else false %}
{% set shows_argocd_status = has_image and deployment.cluster == current_cluster %}
{# "Uitgeschakeld" takes the place of exactly one verdict: the green Healthy that zero
   replicas produce. Every other verdict -- Degraded, Progressing, Unknown -- is something
   ArgoCD really observed and keeps its badge, or switching a component off would hide a
   real failure. #}
{% set disabled_replaces_health = disabled_state.is_disabled and health == 'Healthy' %}

<c-card padding="lg" outline="true" backgroundColor="grijs-050" style="border-left: 4px solid var(--rvo-color-hemelblauw);">
    <c-layout-flow gap="md">
        {# Deployment Header #}
        <c-layout-row gap="sm" verticalSpacing="center">
            <c-icon icon="applicatie" size="md" color="donkerblauw" />
            <c-heading type="h4" textContent="{{ deployment.name }}" />
            <span style="background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">{{ deployment.cluster }}</span>
            {# Partly off is its own situation: something is still serving traffic, so the
               health badge stays and this chip says how much is not. Fully off only needs
               a chip here when there is no badge row to carry it. #}
            {% if disabled_state.is_partially_disabled %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #ffe0b2; color: #e65100;">
                <c-icon icon="uit-aanknop" size="sm" />{{ disabled_state.disabled_count }} van {{ disabled_state.total_count }} componenten uitgeschakeld
            </span>
            {% elif disabled_state.is_disabled and not shows_argocd_status %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700);">
                <c-icon icon="uit-aanknop" size="sm" />Uitgeschakeld
            </span>
            {% endif %}
        </c-layout-row>

        {# Auto-disabled components: an error alert per component. The full technical
           reason (a long ImagePullBackOff dump) is tucked into a collapsible details
           so the alert stays readable; the image reference is the actionable bit. #}
        {% if disabled_components %}
        {% for comp in disabled_components %}
        {% set reason = comp['disabled-reason'] | default('') %}
        {% set is_image = 'ImagePull' in reason or 'InvalidImageName' in reason or 'manifest' in reason %}
        <c-alert kind="error" heading="{{ comp.reference }} is uitgeschakeld{% if is_image %}: image ontbreekt{% endif %}">
            <c-layout-flow gap="sm">
                {% if comp.image %}
                <span class="rvo-text--sm">De container image kon niet worden opgehaald:<br /><code style="word-break: break-all;">{{ comp.image }}</code></span>
                {% endif %}
                <span class="rvo-text--sm">Push een geldige image of deploy opnieuw met een bestaande tag om automatisch te heractiveren.</span>
                {% if reason %}
                <details>
                    <summary class="rvo-text--xs rvo-text--subtle" style="cursor: pointer;">Technische details</summary>
                    <p class="rvo-text--xs rvo-text--subtle" style="margin-top: 4px; word-break: break-word;">{{ reason }}</p>
                </details>
                {% endif %}
            </c-layout-flow>
        </c-alert>
        {% endfor %}
        {% endif %}

        {% if not has_image %}
        {# No components have images - deployment has no resources #}
        <c-card padding="md" backgroundColor="grijs-100" outline="true">
            <c-layout-row gap="sm" verticalSpacing="center">
                <c-icon icon="info" size="md" color="grijs-600" />
                <c-layout-flow gap="xs">
                    <span class="rvo-text--sm">Geen actieve deployment - geen container image geconfigureerd.</span>
                    <span class="rvo-text--sm rvo-text--subtle">Configureer een container image voor een component om deze deployment te activeren.</span>
                </c-layout-flow>
            </c-layout-row>
        </c-card>
        {% elif deployment.cluster != current_cluster %}
        {# Deployment is on a different cluster - show info message #}
        <div style="display: flex; align-items: center; gap: 8px; padding: 12px; background: var(--rvo-color-grijs-100); border: 1px solid var(--rvo-color-grijs-300); border-radius: 4px;">
            <c-icon icon="info" size="md" color="grijs-600" />
            <div>
                <span class="rvo-text--sm">Deze deployment draait op cluster <strong>{{ deployment.cluster }}</strong>.</span>
                <br />
                <span class="rvo-text--sm rvo-text--subtle">ArgoCD status is alleen beschikbaar vanaf de Operations Manager van dat cluster.</span>
            </div>
        </div>
        {% else %}
        {# Deployment is on current cluster - show ArgoCD status #}
        {# Status Badges Row #}
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {# Switched-off badge (RC-31). A deployment that is off has zero replicas and
               ArgoCD calls that Healthy; showing the green badge here is the sentence the
               user reads to know whether things are going well, and it was untrue. So it
               takes the health badge's place -- but only when health has nothing to report:
               a deployment that is off AND degraded shows both, or switching something off
               would hide a real failure. #}
            {% if disabled_state.is_disabled %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500; background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700);">
                <c-icon icon="uit-aanknop" size="sm" />
                Uitgeschakeld
            </span>
            {% endif %}

            {# Health Badge #}
            {% if not disabled_replaces_health %}
            {% set health_bg = '#c8e6c9' if health == 'Healthy' else ('#bbdefb' if health == 'Progressing' else ('#ffe0b2' if health == 'Degraded' else '#ffcdd2')) %}
            {% set health_color = '#1b5e20' if health == 'Healthy' else ('#0d47a1' if health == 'Progressing' else ('#e65100' if health == 'Degraded' else '#b71c1c')) %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500; background: {{ health_bg }}; color: {{ health_color }};">
                {% if health == 'Healthy' %}
                <c-icon icon="vinkje" size="sm" />
                {% elif health == 'Progressing' %}
                <c-icon icon="klok" size="sm" />
                {% elif health == 'Degraded' %}
                <c-icon icon="waarschuwing" size="sm" />
                {% else %}
                <c-icon icon="foutmelding" size="sm" />
                {% endif %}
                {{ health }}
            </span>
            {% endif %}

            {# Sync Badge. Unknown means ArgoCD cannot compare desired vs live state (often a
               render/CMP error) - show it red, not neutral grey, so it does not read as
               "still working on it". #}
            {% set sync_bg = '#c8e6c9' if sync == 'Synced' else ('#ffe0b2' if sync == 'OutOfSync' else ('#ffebee' if sync == 'Unknown' else 'var(--rvo-color-grijs-200)')) %}
            {% set sync_color = '#1b5e20' if sync == 'Synced' else ('#e65100' if sync == 'OutOfSync' else ('#c62828' if sync == 'Unknown' else 'var(--rvo-color-grijs-700)')) %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500; background: {{ sync_bg }}; color: {{ sync_color }};">
                {% if sync == 'Synced' %}
                <c-icon icon="vinkje" size="sm" />
                {% elif sync == 'OutOfSync' %}
                <c-icon icon="waarschuwing" size="sm" />
                {% elif sync == 'Unknown' %}
                <c-icon icon="foutmelding" size="sm" />
                {% else %}
                <c-icon icon="info" size="sm" />
                {% endif %}
                {{ sync }}
            </span>

            {# Revision Badge (if available) #}
            {% if status.get('revision') %}
            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; background: var(--rvo-color-grijs-200); color: var(--rvo-color-grijs-700);">
                <c-icon icon="document-blanco" size="sm" />
                {{ status.revision }}
            </span>
            {% endif %}
        </div>

        {# Last Sync Time #}
        {% if status.get('last_sync') %}
        <c-layout-row gap="xs" verticalSpacing="center">
            <c-icon icon="klok" size="sm" color="grijs-600" />
            <span class="rvo-text--sm rvo-text--subtle">Laatste sync: {{ status.last_sync | dutch_date }}</span>
        </c-layout-row>
        {% endif %}

        {# Logs, but only while something runs. A sleeping or switched-off deployment has
           no pods and therefore no logs; offering the button suggests it has. The flag
           comes from the same service facts the state block renders, so a second service
           that parks a deployment gets this for free. #}
        {% set expects_no_pods = (deployment_expects_no_pods | default({})).get(deployment.name, false) %}
        {% if deployment.components and not expects_no_pods %}
        <div style="margin-top: var(--rvo-space-sm);">
            <button type="button" class="log-viewer-btn"
                    onclick='openLogViewer({{ project.name | tojson }}, {{ deployment.name | tojson }}, {{ deployment.components[0].reference | tojson }}, {{ deployment.components | tojson }})'
                    title="Bekijk live logs voor deze deployment">
                <c-icon icon="document-blanco" size="sm" />
                <span>View Logs</span>
            </button>
        </div>
        {% endif %}

        {# Operation Status (if running or failed) #}
        {% if status.get('operation_phase') and status.operation_phase not in ['Succeeded', None] %}
        {% set op_bg = '#e3f2fd' if status.operation_phase == 'Running' else '#ffebee' %}
        {% set op_color = '#1565c0' if status.operation_phase == 'Running' else '#c62828' %}
        <div style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 4px; font-size: 0.875rem; background: {{ op_bg }}; color: {{ op_color }};">
            <c-icon icon="{% if status.operation_phase == 'Running' %}klok{% elif status.operation_phase == 'Failed' %}foutmelding{% else %}info{% endif %}" size="sm" />
            <span>Operatie: {{ status.operation_phase }}</span>
            {% if status.get('operation_message') %}
            <span class="rvo-text--sm"> - {{ status.operation_message[:100] }}{% if status.operation_message|length > 100 %}...{% endif %}</span>
            {% endif %}
        </div>
        {% endif %}

        {# Errors Section (Expandable) #}
        {% if has_errors %}
        {% set real_errors = errors | rejectattr('orphaned') | list %}
        {% set orphan_errors = errors | selectattr('orphaned') | list %}
        {% if real_errors %}
        <div>
            <button type="button" onclick="toggleArgoErrors('{{ _id_prefix }}')" aria-expanded="false"
                    style="display: flex; align-items: center; gap: 8px; width: 100%; padding: 8px 12px; background: #ffebee; border: 1px solid #ef9a9a; border-radius: 4px; cursor: pointer; font-size: 0.875rem; color: #c62828; text-align: left;">
                <c-icon icon="waarschuwing" size="sm" color="rood" />
                <span>{{ real_errors|length }} {% if real_errors|length == 1 %}probleem{% else %}problemen{% endif %} gevonden</span>
                <c-icon icon="delta-omlaag" size="sm" style="margin-left: auto;" />
            </button>
            <div id="argocd-errors-{{ _id_prefix }}" style="display: none; margin-top: 8px; padding: 8px; background: #fff5f5; border: 1px solid #ffcdd2; border-radius: 4px;">
                {% for error in real_errors %}
                <div style="padding: 8px; {% if not loop.last %}border-bottom: 1px solid #ffcdd2;{% endif %}">
                    <c-layout-row gap="xs" verticalSpacing="center">
                        {% if error.get('severity') == 'informational' %}
                        <c-icon icon="info" size="sm" color="grijs-600" />
                        {% else %}
                        <c-icon icon="foutmelding" size="sm" color="rood" />
                        {% endif %}
                        <strong style="font-size: 0.875rem;">{{ error.resource }}{% if error.get('count') and error.count|int > 1 %} <span class="rvo-text--xs rvo-text--subtle">({{ error.count }}x)</span>{% endif %}</strong>
                    </c-layout-row>
                    <p style="font-size: 0.8rem; color: var(--rvo-color-grijs-700); margin: 4px 0 0 24px; word-break: break-word;">{{ error.message }}</p>
                    {% if error.get('suggestion') %}
                    <p style="font-size: 0.8rem; color: var(--rvo-color-hemelblauw-750); margin: 2px 0 0 24px; word-break: break-word;">{{ error.suggestion }}</p>
                    {% endif %}
                    {% if error.get('original_message') %}
                    <details style="margin: 4px 0 0 24px;">
                        <summary class="rvo-text--xs rvo-text--subtle" style="cursor: pointer;">Origineel bericht</summary>
                        <p class="rvo-text--xs rvo-text--subtle" style="margin-top: 2px; word-break: break-word;">{{ error.original_message }}</p>
                    </details>
                    {% endif %}
                    {% if error.get('age') %}
                    <p class="rvo-text--xs rvo-text--subtle" style="margin: 2px 0 0 24px;">{{ error.age }}</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% if orphan_errors %}
        <div style="margin-top: 8px; padding: 8px 12px; background: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 4px;">
            <c-layout-row gap="xs" verticalSpacing="center">
                <c-icon icon="info" size="sm" color="grijs-600" />
                <span class="rvo-text--sm rvo-text--subtle">{{ orphan_errors|length }} {% if orphan_errors|length == 1 %}melding{% else %}meldingen{% endif %} van verwijderde componenten &mdash; opruiming nog niet voltooid</span>
            </c-layout-row>
            {% for error in orphan_errors %}
            <p class="rvo-text--xs rvo-text--subtle" style="margin: 6px 0 0 24px; word-break: break-word;">
                <strong>{{ error.resource }}</strong>: {{ error.message }}{% if error.get('age') %} ({{ error.age }}){% endif %}
            </p>
            {% endfor %}
        </div>
        {% endif %}
        {% endif %}
        {% endif %}{# close: not has_image / different cluster / current cluster #}
    </c-layout-flow>
</c-card>
