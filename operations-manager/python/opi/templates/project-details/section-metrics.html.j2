{# Metrics Section #}
{% set deployments_on_current_cluster = project.deployments | selectattr('cluster', 'equalto', current_cluster) | list %}
{% if prometheus_available and deployments_on_current_cluster %}
<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <div>
            <c-heading type="h2" style="margin-bottom: 0;">
                <c-icon icon="grafiek" size="xl" color="groen" />Resource Metrics
            </c-heading>
            <p class="rvo-text--subtle">Resource usage per component</p>
        </div>

        <div id="metrics-content"
             data-project-name="{{ project.name }}"
             hx-get="/projects/details/{{ project.name }}/metrics/{{ deployments_on_current_cluster[0].name }}"
             hx-trigger="intersect once"
             hx-swap="innerHTML">
            <div class="metrics-loading">
                <p class="rvo-text--subtle">Metrics laden...</p>
            </div>
        </div>
    </c-layout-flow>
</c-card>
{% elif prometheus_available and project.deployments and not deployments_on_current_cluster %}
<c-card outline="true" padding="lg" backgroundColor="grijs-050">
    <c-layout-row gap="md" verticalSpacing="center">
        <c-icon icon="info" size="lg" color="grijs-500" />
        <div>
            <strong>Metrics niet beschikbaar</strong>
            <p class="rvo-text--sm rvo-text--subtle">Geen deployments op cluster {{ current_cluster }}. Resource metrics zijn alleen beschikbaar voor deployments op het huidige cluster.</p>
        </div>
    </c-layout-row>
</c-card>
{% elif not prometheus_available %}
<c-card outline="true" padding="lg" backgroundColor="grijs-050">
    <c-layout-row gap="md" verticalSpacing="center">
        <c-icon icon="info" size="lg" color="grijs-500" />
        <div>
            <strong>Metrics niet beschikbaar</strong>
            <p class="rvo-text--sm rvo-text--subtle">Prometheus is niet verbonden. Resource metrics worden getoond wanneer Prometheus beschikbaar is.</p>
        </div>
    </c-layout-row>
</c-card>
{% endif %}
