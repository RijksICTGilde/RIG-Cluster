{# ArgoCD Status for the currently selected deployment (Deployments tab) #}
{% if argocd_available and project.deployments %}
{% for deployment in project.deployments %}
<div class="deployment-section" id="argocd-{{ deployment.name }}"
     {% if not loop.first and project.deployments|length > 1 %}style="display: none;"{% endif %}>

    {% set _argocd_card_id_prefix = "dep-" ~ deployment.name %}
    {% include "project-details/_argocd-deployment-card.html.j2" %}
</div>
{% endfor %}
{% endif %}
