{#
  Job Runner Form - step 1: configure the job.

  Required context:
    - project_name: str
    - deployment_name: str
    - available_services: list of dicts with "name" (display) and "secret_name" (K8s secret)
#}
<div class="edit-section-content">
    <form id="job-runner-form"
          hx-post="/projects/{{ project_name }}/run-job/{{ deployment_name }}"
          hx-headers='{"X-CSRF-Token": "{{ request.state.csrf_token }}"}'
          hx-target="#edit-section-inner"
          hx-swap="innerHTML">

        <c-layout-flow gap="md">

            <c-text-input-field
                name="image"
                label="Container image"
                helperText="Volledig image path, bijv. alpine:latest of registry.example.com/my-tool:v1"
                placeholder="alpine:latest"
                required="true" />

            <c-textarea-field
                name="command"
                label="Command"
                helperText="Shell command om uit te voeren (optioneel). Wordt uitgevoerd als /bin/sh -c"
                rows="3"
                placeholder="echo hello && sleep 5" />

            <c-textarea-field
                name="env_vars_text"
                label="Omgevingsvariabelen"
                helperText="Extra omgevingsvariabelen in KEY=VALUE formaat, een per regel (optioneel)"
                rows="4"
                placeholder="MY_VAR=value" />

            {% if available_services %}
            <c-layout-flow gap="sm">
                <c-heading type="h3">Services</c-heading>
                <c-paragraph size="sm">Selecteer welke deployment-services beschikbaar moeten zijn in de job</c-paragraph>
                {% for svc in available_services %}
                <c-checkbox
                    name="selected_services"
                    value="{{ svc.secret_name }}"
                    label="{{ svc.name }}"
                    checked />
                {% endfor %}
            </c-layout-flow>
            {% endif %}

        </c-layout-flow>
    </form>
</div>
<div class="edit-section-actions">
    <c-button kind="tertiary" label="Annuleren" @click="closeEditModal()" />
    <c-button kind="primary" label="Volgende" @click="htmx.trigger('#job-runner-form', 'submit')" />
</div>
