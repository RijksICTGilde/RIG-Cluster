{# Modal content: add a project attachment. Uses the framework field component so the
   identifier only shows an error state (red + errorText) when the server reports one,
   never on a fresh/empty field. Posts to the direct /attachments/upload endpoint, which
   swaps this same modal content with a success fragment or this form + the error. #}
<div class="edit-section-content">
    <c-layout-flow gap="md">
        <p class="rvo-text--subtle">
            Upload een bestand (bijvoorbeeld een certificaat: cert + key in één PEM). Max 256 KB.
            Koppelen aan een component doe je daarna per component.
        </p>

        {% if error %}
        <c-text-input-field id="add-att-id" name="attachment_id" label="Identifier"
            helperText="Kleine letters, cijfers en streepjes, maximaal 40 tekens."
            value="{{ attachment_id | default('', true) }}"
            invalid="true" errorText="{{ error }}" />
        {% else %}
        <c-text-input-field id="add-att-id" name="attachment_id" label="Identifier"
            helperText="Kleine letters, cijfers en streepjes, maximaal 40 tekens." />
        {% endif %}

        <div class="rvo-form-group">
            <label class="utrecht-form-label" for="add-att-file">Bestand</label>
            <input type="file" id="add-att-file" name="file" class="rvo-file-input">
        </div>

        <c-layout-flow row="true" gap="sm">
            <c-button kind="primary" label="Uploaden"
                      hx-post="/projects/{{ project_name }}/attachments/upload"
                      hx-ext="ignore:json-enc"
                      hx-encoding="multipart/form-data"
                      hx-include="#add-att-id, #add-att-file"
                      hx-headers='{"X-CSRF-Token": "{{ request.state.csrf_token }}"}'
                      hx-target="#edit-section-inner"
                      hx-swap="innerHTML"
                      hx-disabled-elt="this" />
            <c-button kind="secondary" label="Annuleren" @click="closeEditModal()" />
        </c-layout-flow>
    </c-layout-flow>
</div>
