{# Actions Section - quick actions for the project #}
{% if user_role in ["admin", "owner"] %}
<c-card outline="true" padding="lg" backgroundColor="wit">
    <c-layout-flow gap="md">
        <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="instellingen" size="xl" color="hemelblauw" />Acties</c-heading>
        <c-layout-row gap="sm">
            <c-button
                label="Deployment toevoegen"
                kind="secondary"
                size="sm"
                showIcon="before"
                icon="plus"
                @click="openEditModal('modal-add-deployment-{{ project.deployments|length if project.deployments else 0 }}', 'Deployment toevoegen')" />
        </c-layout-row>
    </c-layout-flow>
</c-card>
{% endif %}
