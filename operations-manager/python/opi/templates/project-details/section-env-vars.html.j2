{# Environment Variables Overview Section #}
{% set ns = namespace(has_any_env_vars=false, has_component_env_vars=false, has_deployment_env_vars=false) %}
{% for component in project.components %}
    {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
        {% set ns.has_any_env_vars = true %}
        {% set ns.has_component_env_vars = true %}
    {% endif %}
{% endfor %}
{% for deployment in project.deployments %}
    {% for dep_component in deployment.components %}
        {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
            {% set ns.has_any_env_vars = true %}
            {% set ns.has_deployment_env_vars = true %}
        {% endif %}
    {% endfor %}
{% endfor %}

<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="sleutel" size="xl" color="hemelblauw" />Omgevingsvariabelen</c-heading>
        <p class="rvo-text--subtle">Overzicht van alle gebruiker-gedefinieerde omgevingsvariabelen per scope</p>

        {% if ns.has_any_env_vars %}
        <c-layout-flow gap="xl">

            {# Component-level Environment Variables #}
            {% if ns.has_component_env_vars %}
            <div class="env-vars-scope-section">
                <c-layout-flow gap="md">
                    <div class="env-vars-scope-header">
                        <c-icon icon="puzzel" size="lg" color="donkerblauw" />
                        <div>
                            <c-heading type="h3" textContent="Component niveau" />
                            <p class="rvo-text--sm rvo-text--subtle">Standaard variabelen per component (gelden voor alle deployments)</p>
                        </div>
                    </div>

                    {% for component in project.components | sort(attribute='name') %}
                    {% if component.get('user-env-vars') and component['user-env-vars'] is mapping and component['user-env-vars']|length > 0 %}
                    <c-card padding="md" backgroundColor="grijs-050" outline="true">
                        <c-layout-flow gap="sm">
                            <div class="env-vars-component-header">
                                <c-icon icon="puzzel" size="md" color="donkerblauw" />
                                <strong>{{ component.name }}</strong>
                                <span class="env-vars-count-badge">{{ component['user-env-vars']|length }} variabele{% if component['user-env-vars']|length != 1 %}n{% endif %}</span>
                            </div>

                            <div class="env-vars-list">
                                {% for key, value in component['user-env-vars'].items() %}
                                <div class="env-var-item">
                                    <div class="env-var-key">
                                        <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                        <code>{{ key }}</code>
                                    </div>
                                    <div class="env-var-value">
                                        <c-secret-field value="{{ value }}" />
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </c-layout-flow>
                    </c-card>
                    {% endif %}
                    {% endfor %}
                </c-layout-flow>
            </div>
            {% endif %}

            {# Deployment-specific Environment Variables #}
            {% if ns.has_deployment_env_vars %}
            <div class="env-vars-scope-section">
                <c-layout-flow gap="md">
                    <div class="env-vars-scope-header">
                        <c-icon icon="server" size="lg" color="oranje" />
                        <div>
                            <c-heading type="h3" textContent="Deployment niveau" />
                            <p class="rvo-text--sm rvo-text--subtle">Deployment-specifieke variabelen (overschrijven component niveau)</p>
                        </div>
                    </div>

                    {% for deployment in project.deployments | sort(attribute='name') %}
                    {% set dep_ns = namespace(has_env_vars=false) %}
                    {% for dep_component in deployment.components %}
                        {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
                            {% set dep_ns.has_env_vars = true %}
                        {% endif %}
                    {% endfor %}

                    {% if dep_ns.has_env_vars %}
                    <c-card padding="md" backgroundColor="grijs-050" outline="true">
                        <c-layout-flow gap="md">
                            <div class="env-vars-deployment-header">
                                <c-icon icon="server" size="md" color="oranje" />
                                <strong>{{ deployment.name }}</strong>
                                <span class="cluster-badge">{{ deployment.cluster|title }}</span>
                            </div>

                            {% for dep_component in deployment.components | sort(attribute='reference') %}
                            {% if dep_component.get('user-env-vars') and dep_component['user-env-vars'] is mapping and dep_component['user-env-vars']|length > 0 %}
                            <c-card padding="sm" backgroundColor="wit" outline="true">
                                <c-layout-flow gap="sm">
                                    <div class="env-vars-component-header">
                                        <c-icon icon="puzzel" size="sm" color="donkerblauw" />
                                        <span>{{ dep_component.reference }}</span>
                                        <span class="env-vars-count-badge">{{ dep_component['user-env-vars']|length }} variabele{% if dep_component['user-env-vars']|length != 1 %}n{% endif %}</span>
                                    </div>

                                    <div class="env-vars-list">
                                        {% for key, value in dep_component['user-env-vars'].items() %}
                                        <div class="env-var-item">
                                            <div class="env-var-key">
                                                <c-icon icon="sleutel" size="sm" color="grijs-600" />
                                                <code>{{ key }}</code>
                                            </div>
                                            <div class="env-var-value">
                                                <c-secret-field value="{{ value }}" />
                                            </div>
                                        </div>
                                        {% endfor %}
                                    </div>
                                </c-layout-flow>
                            </c-card>
                            {% endif %}
                            {% endfor %}
                        </c-layout-flow>
                    </c-card>
                    {% endif %}
                    {% endfor %}
                </c-layout-flow>
            </div>
            {% endif %}

        </c-layout-flow>
        {% else %}
        <div class="empty-state">
            <c-icon icon="info" size="lg" color="grijs-050" />
            <p class="rvo-text--md">Geen omgevingsvariabelen geconfigureerd</p>
        </div>
        {% endif %}
    </c-layout-flow>
</c-card>
