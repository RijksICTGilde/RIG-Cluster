{#
  Job Runner Confirmation - step 2: review and confirm.

  Required context:
    - project_name: str
    - deployment_name: str
    - image: str
    - command: str | None
    - env_vars_text: str | None
    - selected_services: list[str] (secret names)
    - selected_service_labels: list[str] (display names)
    - namespace: str
    - error: str | None (validation error)
#}
<div class="edit-section-content">
    {% if error %}
    <c-alert kind="error" heading="Validatiefout" content="{{ error }}" />
    {% else %}
    <c-layout-flow gap="md">

        <c-alert kind="info" heading="Bevestiging" content="Dit voert een eenmalige job uit in namespace {{ namespace }}. De job wordt automatisch opgeruimd na voltooiing." />

        <c-data-list items='[
            {"term": "Image", "value": "{{ image }}"}
            {% if command %},{"term": "Command", "value": "{{ command }}"}{% endif %}
            {% if env_vars_text %},{"term": "Omgevingsvariabelen", "value": "{{ env_vars_text | replace("\n", ", ") }}"}{% endif %}
            {% if selected_service_labels %},{"term": "Services", "value": "{{ selected_service_labels | join(", ") }}"}{% endif %}
            {% if not command %},{"term": "Command", "value": "Standaard entrypoint"}{% endif %}
        ]' />

    </c-layout-flow>

    <form id="job-runner-confirm-form"
          hx-post="/projects/{{ project_name }}/run-job/{{ deployment_name }}/confirm"
          hx-target="#edit-section-inner"
          hx-swap="innerHTML">
        <input type="hidden" name="image" value="{{ image }}" />
        <input type="hidden" name="command" value="{{ command or '' }}" />
        <input type="hidden" name="env_vars_text" value="{{ env_vars_text or '' }}" />
        {% for secret_name in selected_services %}
        <input type="hidden" name="selected_services" value="{{ secret_name }}" />
        {% endfor %}
    </form>
    {% endif %}
</div>
<div class="edit-section-actions">
    <c-button kind="tertiary" label="Annuleren" @click="closeEditModal()" />
    {% if not error %}
    <c-button kind="primary" label="Job starten" @click="isEditSubmitting = true; htmx.trigger('#job-runner-confirm-form', 'submit')" />
    {% endif %}
</div>
