{#
  Job Runner Confirmation - step 2: review and confirm.

  Required context:
    - project_name: str
    - deployment_name: str
    - image: str
    - command: str | None
    - env_vars_text: str | None
    - selected_services: list[str] (secret names)
    - selected_service_labels: list[str] (display names)
    - namespace: str
    - error: str | None (validation error)
#}
<div class="edit-section-content">
    {% if error %}
    <c-notification type="error" heading="Validatiefout">
        {{ error }}
    </c-notification>
    {% else %}
    <c-layout-flow gap="md">

        <c-notification type="info" heading="Bevestiging">
            Dit voert een eenmalige job uit in namespace <strong>{{ namespace }}</strong>.
            De job wordt automatisch opgeruimd na voltooiing.
        </c-notification>

        <c-description-list>
            <c-description-list-item label="Image">{{ image }}</c-description-list-item>
            {% if command %}
            <c-description-list-item label="Command"><code>{{ command }}</code></c-description-list-item>
            {% else %}
            <c-description-list-item label="Command"><em>Standaard entrypoint</em></c-description-list-item>
            {% endif %}
            {% if env_vars_text %}
            <c-description-list-item label="Omgevingsvariabelen"><pre style="margin:0; white-space:pre-wrap;">{{ env_vars_text }}</pre></c-description-list-item>
            {% endif %}
            {% if selected_service_labels %}
            <c-description-list-item label="Services">{{ selected_service_labels | join(', ') }}</c-description-list-item>
            {% endif %}
        </c-description-list>

    </c-layout-flow>

    <form id="job-runner-confirm-form"
          hx-post="/projects/{{ project_name }}/run-job/{{ deployment_name }}/confirm"
          hx-target="#edit-section-inner"
          hx-swap="innerHTML">
        <input type="hidden" name="image" value="{{ image }}" />
        <input type="hidden" name="command" value="{{ command or '' }}" />
        <input type="hidden" name="env_vars_text" value="{{ env_vars_text or '' }}" />
        {% for secret_name in selected_services %}
        <input type="hidden" name="selected_services" value="{{ secret_name }}" />
        {% endfor %}
    </form>
    {% endif %}
</div>
<div class="edit-section-actions">
    <c-button kind="tertiary" label="Annuleren" @click="closeEditModal()" />
    {% if not error %}
    <c-button kind="primary" label="Job starten" @click="isEditSubmitting = true; htmx.trigger('#job-runner-confirm-form', 'submit')" />
    {% endif %}
</div>
