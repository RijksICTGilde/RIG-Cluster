{#
  Job modal body (HTMX-driven).
  Expects: project_name, deployment_name, job (JobRun|None),
           state ('none'|'starting'|'running'|'succeeded'|'failed'), error, ttl_seconds, enabled.
  All swaps replace #job-modal-body. While starting/running it self-polls status.
#}
{% if state in ['starting', 'running'] %}
<div id="job-modal-body"
     hx-get="/projects/{{ project_name }}/jobs/{{ deployment_name }}/status"
     hx-trigger="load delay:2s"
     hx-swap="outerHTML">
{% else %}
<div id="job-modal-body">
{% endif %}

{% if error %}
    <c-alert kind="error" heading="Job" content="{{ error }}" closable="true" />
{% endif %}

{% if not enabled %}
    <c-card outline="true" padding="lg" backgroundColor="wit">
        <c-p>Jobs zijn uitgeschakeld op dit cluster.</c-p>
    </c-card>

{% elif state in ['starting', 'running', 'succeeded', 'failed'] and job %}
    {% set bg = "groen-150" if state == "succeeded" else ("rood-150" if state == "failed" else "wit") %}
    <c-card outline="true" padding="lg" background="color" backgroundColor="{{ bg }}">
        <c-layout-flow gap="md">
            <c-heading type="h5" textContent="{{ {'starting': 'Job wordt gestart...', 'running': 'Job draait...', 'succeeded': 'Job voltooid', 'failed': 'Job mislukt'}[state] }}" />
            <c-p>Image: {{ job.image }}</c-p>
            <c-p>Commando: {{ job.command }}</c-p>
            <c-p>Gestart door: {{ job.opened_by }} &middot; verloopt om {{ job.expires_at.strftime("%H:%M") }} UTC</c-p>
            <c-layout-row gap="md">
                <c-button
                    kind="primary"
                    size="sm"
                    label="Logs bekijken"
                    @click="openLogViewer('{{ project_name }}', '{{ job.name }}', '{{ job.name }}', [{reference: '{{ job.name }}'}])" />
                <c-button
                    kind="warning"
                    size="sm"
                    label="{{ 'Opruimen' if state in ['succeeded', 'failed'] else 'Nu stoppen' }}"
                    hx-post="/projects/{{ project_name }}/jobs/{{ job.session_id }}/stop"
                    hx-headers="{&quot;X-CSRF-Token&quot;: &quot;{{ request.state.csrf_token }}&quot;}"
                    hx-vals="{&quot;deployment&quot;: &quot;{{ deployment_name }}&quot;}"
                    hx-target="#job-modal-body"
                    hx-swap="outerHTML" />
            </c-layout-row>
        </c-layout-flow>
    </c-card>

{% elif state == 'starting' %}
    {# Background provisioning: the run is registered but the pod is not visible
       yet (job is None), so show a spinner card; the wrapper above keeps polling. #}
    <c-card outline="true" padding="md" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <c-heading type="h5" textContent="Job wordt gestart..." />
            <c-p>Even geduld, de job wordt opgestart.</c-p>
        </c-layout-flow>
    </c-card>

{% else %}
    <c-card outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="md">
            <c-heading type="h5" textContent="Nieuwe job" />
            <c-p>Voer eenmalig een image + commando uit voor deze deployment (bijv. een migratie). De job krijgt de databaseverbinding van de deployment.</c-p>
            <form id="job-form-{{ deployment_name }}"
                  hx-post="/projects/{{ project_name }}/jobs"
                  hx-headers="{&quot;X-CSRF-Token&quot;: &quot;{{ request.state.csrf_token }}&quot;}"
                  hx-vals="{&quot;deployment&quot;: &quot;{{ deployment_name }}&quot;}"
                  hx-target="#job-modal-body"
                  hx-swap="outerHTML"
                  hx-disabled-elt="find button">
                <c-layout-flow gap="md">
                    <c-text-input-field
                        id="job-image-{{ deployment_name }}"
                        name="image"
                        label="Image"
                        value="{{ form_image | default('', true) }}"
                        required="true"
                        invalid="{{ 'true' if (errors and errors.image) else '' }}"
                        errorText="{{ errors.image if (errors and errors.image) else '' }}" />
                    <c-text-input-field
                        id="job-command-{{ deployment_name }}"
                        name="command"
                        label="Commando"
                        value="{{ form_command | default('', true) }}"
                        helperText="Optioneel. Leeg laten = het standaardcommando van de image." />
                    <c-button
                        type="submit"
                        kind="primary"
                        size="sm"
                        label="Job uitvoeren" />
                </c-layout-flow>
            </form>
        </c-layout-flow>
    </c-card>
{% endif %}
</div>
