{#
  Invite Error Page Template

  Displays error messages for invite-related errors.
#}

{% set page_title_nl = "Fout - Uitnodiging" %}
{% set page_title_en = "Error - Invitation" %}
{% set page_title = page_title_nl if language == 'nl' else page_title_en %}

<c-page title="{{ page_title }}" lang="{{ language }}" bodyClass="rvo-theme rvo-responsive">
    {# Header #}
    <c-header
        text="RIG Cluster"
        subtitle="Rijksorganisatie voor Ontwikkeling, Digitalisering en Innovatie"
        link="/"/>

    <c-layout-flow gap="xl" size="lg">
        <main>
            <c-layout-flow gap="xl">
                    {# Error Alert #}
                    <c-alert
                        kind="error"
                        heading="{{ error_title }}"
                        content="{{ error_message if error_message else '' }}"/>

                    {# Error Details Card #}
                    <c-card outline="true" padding="lg">
                        <c-layout-flow gap="lg">
                            <c-heading type="h2" textContent="{{ error_title }}" />

                            {% if error_message %}
                            <p class="rvo-paragraph">{{ error_message }}</p>
                            {% endif %}

                            <c-layout-flow gap="md">
                                <p class="rvo-paragraph">
                                    {% if language == 'nl' %}
                                    Er is een probleem opgetreden met deze uitnodiging. Dit kan verschillende oorzaken hebben:
                                    {% else %}
                                    There was a problem with this invitation. This can have various causes:
                                    {% endif %}
                                </p>
                                <ul class="utrecht-unordered-list">
                                    <li class="utrecht-unordered-list__item">
                                        {% if language == 'nl' %}De uitnodiging is verlopen{% else %}The invitation has expired{% endif %}
                                    </li>
                                    <li class="utrecht-unordered-list__item">
                                        {% if language == 'nl' %}De uitnodigingslink is niet correct{% else %}The invitation link is incorrect{% endif %}
                                    </li>
                                    <li class="utrecht-unordered-list__item">
                                        {% if language == 'nl' %}Uw e-mailadres voldoet niet aan de vereisten{% else %}Your email address does not meet the requirements{% endif %}
                                    </li>
                                </ul>
                            </c-layout-flow>

                            {% if invite_key %}
                            <c-layout-flow gap="md">
                                <c-action-group
                                    :actions="[
                                        {
                                            'type': 'link',
                                            'kind': 'primary',
                                            'size': 'md',
                                            'label': '{% if language == \"nl\" %}Probeer opnieuw{% else %}Try again{% endif %}',
                                            'showIcon': 'after',
                                            'icon': 'pijl-naar-rechts',
                                            'url': '/invite/{{ invite_key }}'
                                        }
                                    ]"/>
                            </c-layout-flow>
                            {% endif %}
                        </c-layout-flow>
                    </c-card>

                    {# Help Section #}
                    <c-card outline="true" padding="md">
                        <c-layout-flow gap="sm">
                            <c-heading type="h3" textContent="{% if language == 'nl' %}Hulp nodig?{% else %}Need help?{% endif %}" />
                            <p class="rvo-paragraph">
                                {% if language == 'nl' %}
                                Neem contact op met de persoon die u de uitnodiging heeft gestuurd voor assistentie.
                                {% else %}
                                Contact the person who sent you the invitation for assistance.
                                {% endif %}
                            </p>
                        </c-layout-flow>
                    </c-card>
            </c-layout-flow>
        </main>
    </c-layout-flow>
</c-page>
