{% extends "base.html.j2" %}

{#
  Dashboard - Self Service Portal

  Overzicht van alle projecten, deployments en resource metrics
  met real-time monitoring en status updates.
#}

{% block page_title %}Dashboard - Self Service Portal{% endblock %}


{% block content %}
<c-layout-flow gap="xl">

    {# Page Header #}
    <div>
        <c-heading type="h1" textContent="Dashboard" />
        <p class="rvo-text--lg">
            Hier vindt u een overzicht van al uw projecten, deployments en resource usage.
        </p>
    </div>

    {# Health Summary Banner #}
    {% if health_counts is defined %}
        {% if health_counts.Degraded > 0 %}
        <c-alert kind="error" heading="{{ health_counts.Degraded }} project{{ 'en' if health_counts.Degraded != 1 }} {{ 'hebben' if health_counts.Degraded != 1 else 'heeft' }} problemen" maxWidth="lg">
            <c-layout-flow gap="xs">
                {% for project in projects if project.health == 'Degraded' %}
                <c-link content="{{ project.display_name }} - Bekijk deployment status" href="/projects/details/{{ project.name }}#deployment-status" weight="bold" />
                {% endfor %}
            </c-layout-flow>
        </c-alert>
        {% elif health_counts.Progressing > 0 %}
        <c-alert kind="warning" heading="{{ health_counts.Progressing }} project{{ 'en' if health_counts.Progressing != 1 }} {{ 'worden' if health_counts.Progressing != 1 else 'wordt' }} bijgewerkt" maxWidth="lg">
            <c-layout-flow gap="xs">
                {% for project in projects if project.health == 'Progressing' %}
                <c-link content="{{ project.display_name }} - Bekijk deployment status" href="/projects/details/{{ project.name }}#deployment-status" weight="bold" />
                {% endfor %}
            </c-layout-flow>
        </c-alert>
        {% elif health_banner %}
        {# The wording is decided in _dashboard_health_banner, not here: "Alle N projecten
           zijn gezond" stopped being true the moment one of them ran nothing on purpose,
           and what stands there instead is a text choice (RC-31). #}
        <c-alert kind="{{ health_banner.kind }}" heading="{{ health_banner.heading }}" maxWidth="lg">
            {% if health_banner.lines %}
            <c-layout-flow gap="xs">
                {% for line in health_banner.lines %}
                <span class="rvo-text--sm">{{ line }}</span>
                {% endfor %}
            </c-layout-flow>
            {% endif %}
        </c-alert>
        {% elif not argocd_available %}
        <c-alert kind="info" heading="Status informatie niet beschikbaar" content="ArgoCD is niet verbonden." maxWidth="lg" />
        {% endif %}
    {% endif %}

    {# Quick Stats Cards #}
    <div class="stats-grid">
        <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
            <c-layout-flow gap="sm">
                <div class="stat-header">
                    <c-icon icon="applicatie" size="lg" />
                    <span class="stat-number" data-count="{{ active_projects }}">0</span>
                </div>
                <c-heading type="h3" textContent="Actieve Projecten" />
                <p class="rvo-text--sm rvo-text--subtle">{{ total_deployments }} deployments</p>
            </c-layout-flow>
        </c-card>

        <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
            <c-layout-flow gap="sm">
                <div class="stat-header">
                    <c-icon icon="server" size="lg" />
                    <span class="stat-number" data-count="{{ total_deployments }}">0</span>
                </div>
                <c-heading type="h3" textContent="Deployments" />
            </c-layout-flow>
        </c-card>

        <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
            <c-layout-flow gap="sm">
                <div class="stat-header">
                    <c-icon icon="user" size="lg" />
                    <span class="stat-number" data-count="{{ total_users }}">0</span>
                </div>
                <c-heading type="h3" textContent="Gebruikers" />
            </c-layout-flow>
        </c-card>

        <c-card class="stat-card" outline="true" padding="lg" backgroundColor="wit">
            <c-layout-flow gap="sm">
                <div class="stat-header">
                    <c-icon icon="vinkje" size="lg" />
                    <span class="stat-number" data-count="{{ pod_count }}">0</span>
                </div>
                <c-heading type="h3" textContent="Pods" />
            </c-layout-flow>
        </c-card>
    </div>

    {# Resource Usage Section #}
    <c-layout-flow gap="lg">
        <c-heading type="h2" textContent="Resource Usage" />

        {% if prometheus_available and metrics %}
        <div class="metrics-grid">
            {# CPU Usage Gauge #}
            <c-card class="metric-card" outline="true" padding="lg" backgroundColor="wit">
                <c-layout-flow gap="md">
                    <c-heading type="h3" textContent="CPU Usage" />
                    <div class="gauge-container">
                        <canvas id="cpu-gauge" class="gauge"></canvas>
                        <div class="gauge-value">
                            <span class="gauge-percentage">{{ metrics.cpu_percentage }}{{ '%' }}</span>
                            <span class="gauge-label">{{ metrics.cpu_usage_display }} / {{ metrics.cpu_limit_display }} cores</span>
                        </div>
                    </div>
                </c-layout-flow>
            </c-card>

            {# Memory Usage Gauge #}
            <c-card class="metric-card" outline="true" padding="lg" backgroundColor="wit">
                <c-layout-flow gap="md">
                    <c-heading type="h3" textContent="Memory Usage" />
                    <div class="gauge-container">
                        <canvas id="memory-gauge" class="gauge"></canvas>
                        <div class="gauge-value">
                            <span class="gauge-percentage">{{ metrics.memory_percentage }}{{ '%' }}</span>
                            <span class="gauge-label">{{ metrics.memory_usage_display }} / {{ metrics.memory_limit_display }}</span>
                        </div>
                    </div>
                </c-layout-flow>
            </c-card>

            {# Storage Usage Gauge #}
            <c-card class="metric-card" outline="true" padding="lg" backgroundColor="wit">
                <c-layout-flow gap="md">
                    <c-heading type="h3" textContent="Storage Usage" />
                    <div class="gauge-container">
                        <canvas id="storage-gauge" class="gauge"></canvas>
                        <div class="gauge-value">
                            <span class="gauge-percentage">{{ metrics.storage_percentage }}{{ '%' }}</span>
                            <span class="gauge-label">{{ metrics.storage_usage_display }} / {{ metrics.storage_capacity_display }}</span>
                        </div>
                    </div>
                </c-layout-flow>
            </c-card>

            {# Network Traffic #}
            <c-card class="metric-card" outline="true" padding="lg" backgroundColor="wit">
                <c-layout-flow gap="md">
                    <c-heading type="h3" textContent="Network Traffic" />
                    <div class="chart-container">
                        <canvas id="network-chart" class="chart"></canvas>
                    </div>
                    <p class="rvo-text--sm rvo-text--subtle">Inbound/Outbound (KB/s, laatste 30 min)</p>
                </c-layout-flow>
            </c-card>
        </div>
        {% else %}
        <c-card outline="true" padding="lg" backgroundColor="wit">
            <p class="rvo-text--md rvo-text--subtle">Metrics niet beschikbaar. Prometheus is niet verbonden of er zijn geen namespaces gevonden.</p>
        </c-card>
        {% endif %}
    </c-layout-flow>

    {# Resource Comparison Bar #}
    {% if prometheus_available and total_cpu_usage is defined and total_cpu_usage > 0 %}
    <c-layout-flow gap="lg">
        <c-heading type="h2" textContent="Resource Verdeling" />
        <c-card outline="true" padding="lg" backgroundColor="wit">
            <c-layout-flow gap="md">
                <p class="rvo-text--sm rvo-text--subtle">CPU gebruik per project</p>
                <div class="resource-bar">
                    {% for project in projects %}
                        {% if project.cpu_cores is defined and project.cpu_cores > 0 %}
                        <div class="resource-segment resource-color-{{ loop.index0 % 6 }}"
                             data-width="{{ (project.cpu_cores / total_cpu_usage * 100) | round(1) }}"
                             style="width: 0%"
                             title="{{ project.display_name }}: {{ '%.3f' | format(project.cpu_cores) }} cores">
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="resource-legend">
                    {% for project in projects %}
                        {% if project.cpu_cores is defined and project.cpu_cores > 0 %}
                        <a href="/projects/details/{{ project.name }}" class="resource-legend-item">
                            <span class="resource-dot resource-color-{{ loop.index0 % 6 }}"></span>
                            <span class="rvo-text--sm">{{ project.display_name }}</span>
                            <span class="rvo-text--sm rvo-text--subtle">{{ '%.3f' | format(project.cpu_cores) }} cores ({{ (project.cpu_cores / total_cpu_usage * 100) | round(1) }}%)</span>
                        </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </c-layout-flow>
        </c-card>
    </c-layout-flow>
    {% endif %}

    {# Projects Overview #}
    <c-layout-flow gap="lg">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <c-heading type="h2" textContent="Mijn Projecten" />
            <c-button
                label="Nieuw Project"
                kind="primary"
                size="md"
                showIcon="before"
                icon="plus"
                @click="window.location.href='/projects/new'" />
        </div>

        {% if projects %}
        <div class="projects-grid">
            {% for project in projects %}
            <a href="/projects/details/{{ project.name }}" class="project-card-link">
                <c-card class="project-card project-card-{{ project.health | default('Unknown') | lower }}" outline="true" padding="lg" backgroundColor="wit">
                    <c-layout-flow gap="md">
                        <div class="project-header">
                            <c-heading type="h3" textContent="{{ project.display_name }}" />
                            {% set health = project.health | default('Unknown') %}
                            {% if health == 'Healthy' %}
                            <div class="project-status status-healthy">
                                <span class="status-dot status-dot-healthy"></span>
                                Healthy
                            </div>
                            {% elif health == 'Progressing' %}
                            <div class="project-status status-progressing">
                                <span class="status-dot status-dot-progressing"></span>
                                Progressing
                            </div>
                            {% elif health == 'Degraded' %}
                            <div class="project-status status-degraded">
                                <span class="status-dot status-dot-degraded"></span>
                                Degraded
                            </div>
                            {# Switched off and parked get their own label, not a shared grey
                               "niet actief" (RC-31): the first stays off until someone turns
                               it back on, the second returns by itself. Without the labels
                               both fell through to "Unknown", which is a different untruth. #}
                            {% elif health == 'Disabled' %}
                            <div class="project-status status-disabled">
                                <span class="status-dot status-dot-disabled"></span>
                                Uitgeschakeld
                            </div>
                            {% elif health == 'Inactive' %}
                            <div class="project-status status-inactive">
                                <span class="status-dot status-dot-inactive"></span>
                                Niet actief
                            </div>
                            {% else %}
                            <div class="project-status status-unknown">
                                <span class="status-dot status-dot-unknown"></span>
                                Unknown
                            </div>
                            {% endif %}
                        </div>
                        {% if project.description %}
                        <p class="rvo-text--sm">{{ project.description }}</p>
                        {% endif %}
                        <div class="project-metrics">
                            <div class="metric">
                                <c-icon icon="server" size="sm" />
                                <span>{{ project.deployment_count }} deployment{{ 's' if project.deployment_count != 1 }}</span>
                            </div>
                            <div class="metric">
                                <c-icon icon="user" size="sm" />
                                <span>{{ project.user_count }} gebruiker{{ 's' if project.user_count != 1 }}</span>
                            </div>
                        </div>
                        {% if project.last_deployed %}
                        <div class="project-deploy-time">
                            <c-icon icon="kalender" size="sm" />
                            <span class="rvo-text--sm" data-deploy-time="{{ project.last_deployed }}">
                                {{ project.last_deployed[:16]|replace('T', ' ') }} UTC
                            </span>
                        </div>
                        {% endif %}
                    </c-layout-flow>
                </c-card>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <c-card outline="true" padding="lg" backgroundColor="wit">
            <p class="rvo-text--md">Geen projecten gevonden.</p>
        </c-card>
        {% endif %}
    </c-layout-flow>

</c-layout-flow>
{% endblock %}

{% block additional_styles %}
    <link rel="stylesheet" href="{{ static_url('css/dashboard.css') }}">
{% endblock %}

{% block additional_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        animateCounters();
        animateResourceBar();
        formatDeployTimes();
    });

    /* Animated number counters */
    function animateCounters() {
        var counters = document.querySelectorAll('[data-count]');
        counters.forEach(function(el) {
            var target = parseInt(el.getAttribute('data-count'), 10);
            if (target === 0) { el.textContent = '0'; return; }
            var duration = 600;
            var start = performance.now();
            function step(now) {
                var progress = Math.min((now - start) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(eased * target);
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        });
    }

    /* Animate resource bar segments */
    function animateResourceBar() {
        var segments = document.querySelectorAll('.resource-segment[data-width]');
        setTimeout(function() {
            segments.forEach(function(seg) {
                seg.style.width = seg.getAttribute('data-width') + '%';
            });
        }, 200);
    }

    /* Convert UTC timestamps to relative time */
    function formatDeployTimes() {
        var els = document.querySelectorAll('[data-deploy-time]');
        els.forEach(function(el) {
            var raw = el.getAttribute('data-deploy-time');
            if (!raw) return;
            try {
                var ts = raw.endsWith('Z') ? raw : raw + 'Z';
                var date = new Date(ts);
                if (isNaN(date.getTime())) return;
                var now = new Date();
                var diffMs = now - date;
                var diffMin = Math.floor(diffMs / 60000);
                var diffHr = Math.floor(diffMs / 3600000);
                var diffDay = Math.floor(diffMs / 86400000);
                var relative;
                if (diffMin < 1) relative = 'zojuist';
                else if (diffMin < 60) relative = diffMin + ' min geleden';
                else if (diffHr < 24) relative = diffHr + ' uur geleden';
                else if (diffDay < 7) relative = diffDay + (diffDay === 1 ? ' dag' : ' dagen') + ' geleden';
                else relative = date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'short', year: 'numeric' });
                el.textContent = relative;
                el.title = date.toLocaleString('nl-NL', { dateStyle: 'full', timeStyle: 'short' });
            } catch(e) { /* keep original text */ }
        });
    }
</script>

{% if prometheus_available and metrics %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        initializeGauges();
        initializeCharts();
    });

    function getGaugeColor(percentage) {
        if (percentage >= 85) return '#d52b1e';      /* red */
        if (percentage >= 70) return '#e17000';       /* orange */
        return '#39870c';                              /* green */
    }

    function initializeGauges() {
        var cpuPct = {{ metrics.cpu_percentage }};
        var memPct = {{ metrics.memory_percentage }};
        var storagePct = {{ metrics.storage_percentage }};

        animateGauge('cpu-gauge', cpuPct, getGaugeColor(cpuPct));
        animateGauge('memory-gauge', memPct, getGaugeColor(memPct));
        animateGauge('storage-gauge', storagePct, getGaugeColor(storagePct));
    }

    function animateGauge(canvasId, targetPct, color) {
        var canvas = document.getElementById(canvasId);
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        canvas.width = 150;
        canvas.height = 150;
        var centerX = canvas.width / 2;
        var centerY = canvas.height / 2;
        var radius = 60;
        var duration = 800;
        var start = performance.now();

        function draw(now) {
            var progress = Math.min((now - start) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            var currentPct = eased * targetPct;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            /* Background arc */
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, Math.PI, 2 * Math.PI);
            ctx.strokeStyle = '#f0f0f0';
            ctx.lineWidth = 12;
            ctx.lineCap = 'butt';
            ctx.stroke();

            /* Progress arc */
            if (currentPct > 0) {
                var angle = Math.PI + (Math.PI * currentPct / 100);
                ctx.beginPath();
                ctx.arc(centerX, centerY, radius, Math.PI, angle);
                ctx.strokeStyle = color;
                ctx.lineWidth = 12;
                ctx.lineCap = 'round';
                ctx.stroke();
            }

            /* Center dot */
            ctx.beginPath();
            ctx.arc(centerX, centerY, 10, 0, 2 * Math.PI);
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.15 + 0.85 * eased;
            ctx.fill();
            ctx.globalAlpha = 1;

            if (progress < 1) requestAnimationFrame(draw);
        }
        requestAnimationFrame(draw);
    }

    function initializeCharts() {
        var networkInData = {{ metrics.network_in_data | tojson }};
        var networkOutData = {{ metrics.network_out_data | tojson }};

        var labels = networkInData.map(function(d) { return d.t; });
        var inValues = networkInData.map(function(d) { return d.v; });
        var outValues = networkOutData.map(function(d) { return d.v; });

        if (labels.length === 0) {
            labels = ['--'];
            inValues = [0];
            outValues = [0];
        }

        var networkCtx = document.getElementById('network-chart').getContext('2d');
        new Chart(networkCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Inbound (KB/s)',
                    data: inValues,
                    borderColor: '#007bc7',
                    backgroundColor: 'rgba(0, 123, 199, 0.1)',
                    fill: true,
                    tension: 0.4
                }, {
                    label: 'Outbound (KB/s)',
                    data: outValues,
                    borderColor: '#e17000',
                    backgroundColor: 'rgba(225, 112, 0, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        display: false
                    },
                    x: {
                        display: false
                    }
                }
            }
        });
    }
</script>
{% endif %}
{% endblock %}
