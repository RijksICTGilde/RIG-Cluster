{#
  Modal Wizard Step Fragment - server-driven wizard inside the edit modal.

  Required context:
    - steps: WizardSteps object
    - flow_id: FormFlow ID
    - section: FormSection for the current step
    - step_html: Pre-rendered form field HTML
    - project_name: str
    - errors: dict of field errors
    - global_errors: list of global error messages
    - step_base_url: URL prefix for step navigation
    - step_target: HTMX target selector
    - step_push_url: Whether to push URL on nav
    - step_query_params: Query string for step URLs
#}

{# Step indicator (only for multi-step flows) #}
{% if steps.count > 1 %}
<div class="edit-step-indicator" id="modal-wizard-steps">
    {% include "wizard/wizard_steps_indicator.html.j2" %}
</div>
{% endif %}

{# Step content #}
<div class="wizard-step" id="modal-wizard-step-inner">
    <div class="wizard-step__header">
        <c-heading type="h2">
            {% if section.icon %}<c-icon icon="{{ section.icon }}" size="xl" />{% endif %}
            {{ section.title }}
        </c-heading>
        {% if section.description %}
        <p class="wizard-step__description">{{ section.description }}</p>
        {% endif %}
    </div>

    {% if global_errors %}
    <c-alert kind="error" heading="Fouten">
        <ul>
            {% for err in global_errors %}
            <li>{{ err }}</li>
            {% endfor %}
        </ul>
    </c-alert>
    {% endif %}

    {% if warnings %}
    <c-alert kind="warning" heading="Let op">
        <ul>
            {% for msg in warnings %}
            <li>{{ msg }}</li>
            {% endfor %}
        </ul>
    </c-alert>
    {% endif %}

    {% set _step_url_prefix = step_base_url if step_base_url else "/projects/" ~ project_name ~ "/modal-wizard/" ~ flow_id ~ "/step/" %}
    {% set _token_qs = "?_wizard_token=" ~ wizard_token if wizard_token else "" %}
    <style>
        #modal-wizard-form .wizard-step__saving { display: none; }
        #modal-wizard-form.htmx-request .wizard-step__saving {
            display: inline-flex;
            align-items: center;
            gap: var(--rvo-space-xs);
            color: var(--rvo-color-grijs-700);
        }
    </style>
    <form id="modal-wizard-form"
          autocomplete="off"
          hx-ext="json-enc"
          hx-headers='{"X-CSRF-Token": "{{ request.state.csrf_token }}"}'
          hx-post="{{ _step_url_prefix }}{{ section.section_id }}{{ _token_qs }}"
          hx-target="#edit-section-inner"
          hx-swap="innerHTML"
          hx-disabled-elt="#modal-wizard-form button[type='submit']">

        {% if wizard_token %}
        <input type="hidden" name="_wizard_token" value="{{ wizard_token }}" />
        {% endif %}

        <div class="wizard-step__fields" id="edit-section-content">
            {{ step_html | safe }}
        </div>

        <div class="wizard-step__actions" id="edit-section-actions">
            {% if not steps.is_first %}
            <c-button kind="secondary" label="Vorige" showIcon="before" icon="delta-naar-links"
                      hx-get="{{ _step_url_prefix }}{{ steps.prev }}{{ _token_qs }}"
                      hx-target="#edit-section-inner" hx-swap="innerHTML" />
            {% else %}
            <c-button type="button" kind="tertiary" label="Annuleren" @click="closeEditModal()" />
            {% endif %}

            <div class="wizard-step__actions-right">
                {% if steps.is_last %}
                {% if not (flow_id is defined and flow_id in ('modal-backup', 'modal-restore')) %}
                <span class="wizard-step__saving" aria-hidden="true">
                    <c-icon icon="refresh" size="sm" />Bezig met opslaan&hellip;
                </span>
                {% endif %}
                <c-button type="submit" kind="primary" showIcon="before" icon="publicatie"
                    label="{% if flow_id is defined and flow_id in ('modal-backup', 'modal-restore') %}Verder{% else %}Opslaan{% endif %}" />
                {% else %}
                <c-button type="submit" kind="primary" label="Volgende"
                          showIcon="after" icon="delta-naar-rechts" />
                {% endif %}
            </div>
        </div>
    </form>
</div>
