{#
  Modal Wizard Progress - initial frame that starts HTMX polling.

  Required context:
    - task_id: str
    - project_name: str
#}
<div class="edit-progress-view">
    <div id="modal-progress-container"
         hx-get="/projects/{{ project_name }}/modal-wizard/progress/{{ task_id }}"
         hx-trigger="load, every 2s"
         hx-target="#modal-progress-container"
         hx-swap="outerHTML"
         hx-target-404="#modal-progress-container"
        <div class="edit-progress-bar-wrapper">
            <div class="edit-progress-bar" style="width: 0%"></div>
        </div>
        <p class="edit-progress-step">Verwerking gestart...</p>
    </div>
</div>
