{#
  Modal Wizard Progress Fragment — server-rendered progress with HTMX polling.

  Replaces itself every 2s until the task completes or fails.

  Required context:
    - task_id: str
    - project_name: str
    - progress: int (0-100)
    - current_step: str
    - tasks: list of task dicts (name, status, subtasks)
    - status: str ("running", "completed", "failed")
    - error: str | None
#}
<div id="modal-progress-container"
     {% if status not in ("completed", "failed") %}
     hx-get="/projects/{{ project_name }}/modal-wizard/progress/{{ task_id }}"
     hx-trigger="every 2s"
     hx-target="#modal-progress-container"
     hx-swap="outerHTML"
     {% endif %}>

    <div class="edit-progress-bar-wrapper">
        <div class="edit-progress-bar" style="width: {{ progress }}%"></div>
    </div>

    {% if status == "completed" %}
    <p class="edit-progress-step" style="color: var(--rvo-color-groen-700);">Wijzigingen succesvol verwerkt!</p>
    {% elif status == "failed" %}
    <p class="edit-progress-step edit-progress-error">Verwerking mislukt: {{ error or "Onbekende fout" }}</p>
    {% else %}
    <p class="edit-progress-step">{{ current_step }}</p>
    {% endif %}

    {% if tasks %}
    <div class="edit-progress-tasks">
        {% for task in tasks %}
        <div class="edit-progress-task-item">
            {% if task.status == "completed" %}
            <c-icon icon="vinkje" size="sm" color="groen" />
            {% elif task.status == "failed" %}
            <c-icon icon="kruis" size="sm" color="rood" />
            {% elif task.status == "running" %}
            <c-icon icon="pijl-naar-rechts" size="sm" color="hemelblauw" />
            {% else %}
            <c-icon icon="klok" size="sm" color="grijs-600" />
            {% endif %}
            <span>{{ task.name }}</span>
        </div>
        {% if task.subtasks %}
        {% for subtask in task.subtasks %}
        <div class="edit-progress-task-item" style="padding-left: var(--rvo-space-lg);">
            {% if subtask.status == "completed" %}
            <c-icon icon="vinkje" size="sm" color="groen" />
            {% elif subtask.status == "failed" %}
            <c-icon icon="kruis" size="sm" color="rood" />
            {% elif subtask.status == "running" %}
            <c-icon icon="pijl-naar-rechts" size="sm" color="hemelblauw" />
            {% else %}
            <c-icon icon="klok" size="sm" color="grijs-600" />
            {% endif %}
            <span>{{ subtask.name }}</span>
        </div>
        {% endfor %}
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    {% if status == "completed" %}
    <div class="edit-progress-actions">
        <c-button kind="tertiary" label="Bekijk volledige voortgang"
                  @click="window.open('/projects/progress/{{ task_id }}', '_blank')" />
        <c-button kind="primary" label="Ok" @click="closeEditModalAndReload()" />
    </div>
    {% elif status == "failed" %}
    <div class="edit-progress-actions">
        <c-button kind="tertiary" label="Bekijk details"
                  @click="window.open('/projects/progress/{{ task_id }}', '_blank')" />
        <c-button kind="primary" label="Sluiten" @click="closeEditModalAndReload()" />
    </div>
    {% endif %}
</div>
