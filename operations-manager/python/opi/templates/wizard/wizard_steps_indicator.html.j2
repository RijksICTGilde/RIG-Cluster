{#
  Wizard Step Indicator - shows progress through wizard steps.

  Required context:
    - steps: WizardSteps object
    - flow_id: FormFlow ID for building URLs
#}
<nav aria-label="Wizard voortgang" id="wizard-steps" class="wizard-steps">
    <ol class="wizard-steps__list">
        {% for section_id in steps.all %}
        {% set is_current = section_id == steps.current %}
        {% set is_completed = section_id in steps.completed %}
        {% set step_num = loop.index %}
        <li class="wizard-steps__item{% if is_current %} wizard-steps__item--active{% endif %}{% if is_completed %} wizard-steps__item--completed{% endif %}"
            {% if is_current %}aria-current="step"{% endif %}>
            {% if is_completed and not is_current %}
            <a href="/forms/wizard/{{ flow_id }}/step/{{ section_id }}"
               hx-get="/forms/wizard/{{ flow_id }}/step/{{ section_id }}"
               hx-target="#wizard-step-content"
               hx-swap="innerHTML"
               hx-push-url="true"
               class="wizard-steps__link">
                <span class="wizard-steps__number">
                    <c-icon icon="vinkje" size="sm" />
                </span>
                <span class="wizard-steps__label">{{ steps.titles[section_id] }}</span>
            </a>
            {% else %}
            <span class="wizard-steps__link{% if not is_current %} wizard-steps__link--disabled{% endif %}">
                <span class="wizard-steps__number">{{ step_num }}</span>
                <span class="wizard-steps__label">{{ steps.titles[section_id] }}</span>
            </span>
            {% endif %}
        </li>
        {% endfor %}
    </ol>
    <div class="wizard-steps__progress">
        <div class="wizard-steps__progress-bar" style="width: {{ steps.progress_pct }}%"></div>
    </div>
</nav>
