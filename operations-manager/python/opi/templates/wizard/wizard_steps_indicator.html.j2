{#
  Wizard Step Indicator - shows progress through wizard steps.

  Required context:
    - steps: WizardSteps object

  Optional context (for reuse outside wizard):
    - step_base_url: URL prefix for step links (default: /forms/wizard/<flow_id>/step/)
    - step_target: HTMX target selector (default: #wizard-step-content)
    - step_push_url: Whether to push URL on nav (default: true)
    - step_query_params: Query string to append to step URLs (default: "")
    - flow_id: FormFlow ID (required when step_base_url is not set)
#}
{% set base_url = step_base_url | default('/forms/wizard/' ~ flow_id ~ '/step/') %}
{% set target = step_target | default('#wizard-step-content') %}
{% set use_push_url = step_push_url | default(true) %}
{% set query_params = step_query_params | default('') %}

<nav aria-label="Wizard voortgang" id="wizard-steps" class="wizard-steps{% if step_base_url is defined %} edit-wizard-steps{% endif %}">
    <ol class="wizard-steps__list">
        {% for section_id in steps.all %}
        {% set is_current = section_id == steps.current %}
        {% set is_completed = section_id in steps.completed %}
        {% set step_num = loop.index %}
        <li class="wizard-steps__item{% if is_current %} wizard-steps__item--active{% endif %}{% if is_completed %} wizard-steps__item--completed{% endif %}"
            {% if is_current %}aria-current="step"{% endif %}>
            {% if is_completed and not is_current %}
            <a href="{{ base_url }}{{ section_id }}{{ query_params }}"
               hx-post="{{ base_url }}{{ steps.current }}{{ query_params }}"
               hx-target="{{ target }}"
               hx-swap="innerHTML"
               hx-include="#wizard-step-form"
               hx-vals='{"_goto": "{{ section_id }}"}'
               hx-ext="json-enc"
               hx-headers='{"X-CSRF-Token": "{{ request.state.csrf_token }}"}'
               class="wizard-steps__link">
                <span class="wizard-steps__number">{{ step_num }}</span>
                <span class="wizard-steps__label">{{ steps.titles[section_id] }}</span>
            </a>
            {% else %}
            <span class="wizard-steps__link{% if not is_current %} wizard-steps__link--disabled{% endif %}">
                <span class="wizard-steps__number">{{ step_num }}</span>
                <span class="wizard-steps__label">{{ steps.titles[section_id] }}</span>
            </span>
            {% endif %}
        </li>
        {% endfor %}
    </ol>
    <div class="wizard-steps__progress">
        <div class="wizard-steps__progress-bar" style="width: {{ steps.progress_pct }}%"></div>
    </div>
</nav>
