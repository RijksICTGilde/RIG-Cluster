{% extends "base.html.j2" %}

{% block page_title %}{{ flow_title }}{% endblock %}

{% block content %}
<c-layout-flow gap="lg" size="lg">
    {# Breadcrumb #}
    <nav aria-label="Breadcrumb">
        <ol class="rvo-breadcrumb">
            <li><a href="/projects">Projecten</a></li>
            {% if project_name %}
            <li><a href="/projects/details/{{ project_name }}">{{ project_name }}</a></li>
            <li aria-current="page">Bewerken</li>
            {% else %}
            <li aria-current="page">Nieuw project</li>
            {% endif %}
        </ol>
    </nav>

    <c-heading type="h1" textContent="{{ flow_title }}" />

    {# Step Indicator #}
    {% include "wizard/wizard_steps_indicator.html.j2" %}

    {# Step Content Area - HTMX target #}
    <div id="wizard-step-content" class="wizard-content">
        {% with embedded=True %}{% include "wizard/wizard_step.html.j2" %}{% endwith %}
    </div>
</c-layout-flow>

{% include "widgets/service_help_modal.html.j2" %}
{% endblock %}

{% block additional_styles %}
<link rel="stylesheet" href="/static/css/wizard.css">
{% endblock %}

{% block additional_scripts %}
<script src="/static/js/codemirror-bundle.js"></script>
<script src="/static/js/codemirror-kv.js"></script>
<script src="/static/js/wizard.js"></script>
{% endblock %}
