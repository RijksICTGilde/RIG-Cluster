{#
  Backup wizard step 1: Select deployment and resource types to back up.

  Expected context (via yaml_data):
    - _cluster_deployments: list of dicts with keys: name, namespace, resource_types (list of str)
    - _backupable_labels: list of dicts with keys: label, name, color (from ServiceAdapter)
    - _current_cluster: str
    - _project_name: str
    - _selected_deployment: str (optional, set by HTMX on dropdown change)
#}
{% set deployments = _cluster_deployments | default([]) %}
{% set labels = _backupable_labels | default([]) %}
{% set selected = _selected_deployment | default(deployments[0].name if deployments else '') %}
{% set ns = namespace(active_dep=none) %}
{% for dep in deployments %}
    {% if dep.name == selected %}
        {% set ns.active_dep = dep %}
    {% endif %}
{% endfor %}
{% if not ns.active_dep and deployments %}
    {% set ns.active_dep = deployments[0] %}
    {% set selected = ns.active_dep.name %}
{% endif %}

{# Build a lookup from label to metadata for easy access in the template #}
{% set label_meta = {} %}
{% for bl in labels %}
    {% set _ = label_meta.update({bl.label: bl}) %}
{% endfor %}

{% if deployments %}
<c-layout-flow gap="lg">
    <div class="rvo-form-field">
        <label class="rvo-form-field__label" for="deployment_name"><strong>Deployment</strong></label>
        <p class="rvo-text--sm rvo-text--subtle" style="margin-bottom: 8px;">
            Selecteer de deployment waarvoor u een backup wilt aanmaken.
        </p>
        <select
            id="deployment_name"
            name="deployment_name"
            class="rvo-select"
            hx-get="/projects/{{ _project_name }}/modal-wizard/modal-backup/select-deployment"
            hx-target="#edit-section-inner"
            hx-include="[name='deployment_name']"
            style="width: 100%; padding: 8px 12px; border: 1px solid var(--rvo-color-grijs-300); border-radius: 6px; font-size: 0.95rem;"
        >
            {% for dep in deployments %}
            <option value="{{ dep.name }}" {% if dep.name == selected %}selected{% endif %}>
                {{ dep.name }} ({{ dep.namespace }})
            </option>
            {% endfor %}
        </select>
    </div>

    {% if ns.active_dep %}
    <fieldset>
        <legend class="rvo-form-field__label"><strong>Resource types</strong></legend>
        <p class="rvo-text--sm rvo-text--subtle" style="margin-bottom: 8px;">
            Selecteer welke resource types u wilt back-uppen. Standaard worden alle beschikbare types geselecteerd.
        </p>
        {% for rt in ns.active_dep.resource_types %}
        {% set meta = label_meta.get(rt, {}) %}
        <label style="display: flex; align-items: center; gap: 8px; padding: 6px 12px; cursor: pointer;">
            <input type="checkbox" name="resource_types" value="{{ rt }}" checked
                   style="margin: 0;" />
            <span style="display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 500;
                background: var(--rvo-color-{{ meta.get('color', 'grijs-600') }}-200, var(--rvo-color-grijs-200));
                color: var(--rvo-color-{{ meta.get('color', 'grijs-600') }}-800, var(--rvo-color-grijs-800));">
                {{ meta.get('name', rt | upper) }}
            </span>
        </label>
        {% endfor %}
    </fieldset>
    {% endif %}
</c-layout-flow>
{% else %}
<c-card padding="md" outline="true" backgroundColor="grijs-050">
    <c-layout-row gap="md" verticalSpacing="center">
        <c-icon icon="info" size="md" color="grijs-500" />
        <p>Geen deployments met backup-mogelijkheden gevonden op het huidige cluster. Alleen deployments met persistent storage, databases of MinIO storage kunnen worden geback-upt.</p>
    </c-layout-row>
</c-card>
{% endif %}
