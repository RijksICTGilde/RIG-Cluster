{# Staged-attachments list fragment for the create wizard. Swapped into #wiz-att-status. #}
{% if staged and staged|length > 0 %}
<c-layout-flow gap="sm">
    {% for att in staged %}
    <c-card padding="sm" backgroundColor="grijs-050" outline="true">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem;">
            <div><strong>{{ att.filename }}</strong> <span class="rvo-text--sm rvo-text--subtle">(id: {{ att.id }})</span></div>
            <c-button type="button" kind="secondary" size="xs" label="Verwijderen"
                      hx-post="/forms/wizard/{{ flow_id }}/attachments/unstage"
                      hx-ext="ignore:json-enc"
                      hx-vals='{"attachment_id": "{{ att.id }}"}'
                      hx-target="#wiz-att-status"
                      hx-swap="innerHTML" />
        </div>
    </c-card>
    {% endfor %}
</c-layout-flow>
{% else %}
<p class="rvo-text--sm rvo-text--subtle"><em>Nog geen bijlagen geupload.</em></p>
{% endif %}
