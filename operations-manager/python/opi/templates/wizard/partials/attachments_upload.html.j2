{# Attachments: current list + upload. Used in the create wizard AND the services-edit modal. #}
{# CSRF inherits from the surrounding wizard step form's hx-headers. _wizard_token (modal flow) #}
{# routes staging to the modal session; absent => cookie session. No auto hx-trigger=load (it is #}
{# fragile inside the modal); freshly staged files appear in #wiz-att-status after upload. #}
<c-layout-flow gap="lg">
    <c-card outline="true" padding="md" backgroundColor="grijs-050">
        <c-layout-flow gap="sm">
            <c-heading type="h3" textContent="Bijlagen in dit project" />
            <div id="wiz-att-catalog">
                {% include "wizard/partials/attachments_catalog_list.html.j2" %}
            </div>
        </c-layout-flow>
    </c-card>

    <c-card outline="true" padding="md" backgroundColor="grijs-050">
        <c-layout-flow gap="sm">
            <c-heading type="h3" textContent="Nieuwe bijlage uploaden" />
            <p class="rvo-text--sm rvo-text--subtle">Max 256 KB (bijvoorbeeld een certificaat). Koppelen doe je per component.</p>
            <input type="hidden" id="wiz-att-token" name="_wizard_token" value="{{ _wizard_token | default('', true) }}">
            <div id="wiz-att-id-field">
                {% include "wizard/partials/attachments_id_field.html.j2" %}
            </div>
            <label class="utrecht-form-label" for="wiz-att-file" style="margin-top:0.5rem;">Bestand</label>
            <input type="file" id="wiz-att-file" name="file" class="rvo-file-input">
            <div style="margin-top:0.75rem;">
                <c-button type="button" kind="secondary" size="sm" label="Uploaden"
                          hx-post="/forms/wizard/create-project/attachments/stage"
                          hx-ext="ignore:json-enc"
                          hx-encoding="multipart/form-data"
                          hx-include="#wiz-att-id, #wiz-att-file, #wiz-att-token"
                          hx-target="#wiz-att-status"
                          hx-swap="innerHTML"
                          hx-disabled-elt="this" />
            </div>
            <div id="wiz-att-status"
                 hx-get="/forms/wizard/create-project/attachments/list"
                 hx-trigger="load"
                 hx-vals='{"_wizard_token": "{{ _wizard_token | default('', true) }}"}'
                 hx-target="this"
                 hx-swap="innerHTML"
                 hx-disabled-elt="this"></div>
        </c-layout-flow>
    </c-card>
</c-layout-flow>
