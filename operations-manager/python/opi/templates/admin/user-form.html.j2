{% extends "base.html.j2" %}

{% block page_title %}{{ page_heading }} - Self Service Portal{% endblock %}

{% block content %}
<c-layout-flow gap="xl">

    <div>
        <c-heading type="h1" textContent="{{ page_heading }}" />
    </div>

    <c-card outline="true" padding="xl" backgroundColor="wit">
        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />

            <c-layout-flow gap="lg">
                {{ form_html|safe }}

                <div class="user-form-actions">
                    <c-button
                        label="Opslaan"
                        kind="primary"
                        size="md"
                        type="submit" />
                    <c-button
                        label="Annuleren"
                        kind="tertiary"
                        size="md"
                        @click="window.location.href='/admin/users'" />
                </div>
            </c-layout-flow>
        </form>
    </c-card>

</c-layout-flow>
{% endblock %}

{% block additional_styles %}
<link rel="stylesheet" href="{{ static_url('css/admin.css') }}">
{% endblock %}
