{% extends "base.html.j2" %}

{% block page_title %}Metrics Explorer{% endblock %}

{% block content %}
    <div class="rvo-max-width-layout rvo-max-width-layout--lg">
        <c-layout-flow gap="lg">

            <c-heading type="h1" textContent="Metrics Explorer" />
            <p>Selecteer een service om de beschikbare Prometheus metrics te verkennen.</p>

            {# Controls row #}
            <div class="metrics-controls">
                <div class="metrics-controls__row">
                    {# Service selector #}
                    <div class="metrics-controls__field">
                        <label for="service-select"><strong>Service</strong></label>
                        <select id="service-select" class="rvo-select">
                            <option value="">-- Selecteer een service --</option>
                            {% for service in services %}
                                <option value="{{ service.id }}">{{ service.name }}</option>
                            {% endfor %}
                        </select>
                        <span id="service-description" class="rvo-text--sm rvo-text--subtle"></span>
                    </div>

                    {# Metric selector #}
                    <div class="metrics-controls__field">
                        <label for="metric-select"><strong>Metric</strong></label>
                        <select id="metric-select" class="rvo-select" disabled>
                            <option value="">-- Selecteer eerst een service --</option>
                        </select>
                        <span id="metric-count" class="rvo-text--sm rvo-text--subtle"></span>
                    </div>

                    {# Show button #}
                    <div class="metrics-controls__field metrics-controls__field--button">
                        <c-button kind="primary" id="show-btn" disabled @click="showMetric()">Tonen in Prometheus</c-button>
                    </div>
                </div>

                {# Metric filter #}
                <div class="metrics-controls__filter" id="filter-container" style="display: none;">
                    <label for="metric-filter" class="rvo-text--sm"><strong>Filter metrics:</strong></label>
                    <input type="text" id="metric-filter" class="rvo-input" placeholder="Type om te filteren..." oninput="filterMetrics()" />
                </div>
            </div>

            {# Loading indicator #}
            <div id="loading" style="display: none;">
                <p class="rvo-text--subtle">Metrics ophalen...</p>
            </div>

            {# Error display #}
            <div id="error-msg" style="display: none;">
                <c-card outline="true" padding="md">
                    <p id="error-text" style="color: var(--rvo-color-error, #d33);">Fout bij het ophalen van metrics.</p>
                </c-card>
            </div>

            {# Prometheus iframe #}
            <div id="prometheus-frame-container" style="display: none;">
                <c-heading type="h2" textContent="Prometheus Graph" />
                <iframe id="prometheus-frame"
                        style="width: 100%; height: 600px; border: 1px solid var(--rvo-color-grijs-300, #ccc); border-radius: 4px;"
                        sandbox="allow-same-origin allow-scripts allow-forms allow-popups"
                        title="Prometheus Graph UI">
                </iframe>
                <p class="rvo-text--sm rvo-text--subtle" style="margin-top: 0.5rem;">
                    <a id="prometheus-direct-link" href="#" target="_blank" rel="noopener">Open in nieuw tabblad</a>
                </p>
            </div>

        </c-layout-flow>
    </div>
{% endblock %}

{% block additional_styles %}
<style>
    .metrics-controls__row {
        display: flex;
        gap: 1.5rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }
    .metrics-controls__field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 200px;
        flex: 1;
    }
    .metrics-controls__field--button {
        flex: 0;
        min-width: auto;
    }
    .metrics-controls__filter {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.75rem;
    }
    .metrics-controls__filter input {
        max-width: 300px;
    }
    .rvo-select, .rvo-input {
        padding: 0.5rem;
        border: 1px solid var(--rvo-color-grijs-400, #999);
        border-radius: 4px;
        font-size: 0.95rem;
        width: 100%;
    }
</style>
{% endblock %}

{% block additional_scripts %}
<script>
    const PROMETHEUS_URL = "{{ prometheus_url }}";
    const SERVICE_INFO = {
        {% for service in services %}
            "{{ service.id }}": {
                "description": "{{ service.description }}",
                "range": "{{ service.range }}"
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    };

    // All metrics for the currently selected service (before filtering)
    let allMetrics = [];

    const serviceSelect = document.getElementById("service-select");
    const metricSelect = document.getElementById("metric-select");
    const showBtn = document.getElementById("show-btn");
    const loading = document.getElementById("loading");
    const errorMsg = document.getElementById("error-msg");
    const errorText = document.getElementById("error-text");
    const filterContainer = document.getElementById("filter-container");
    const metricFilter = document.getElementById("metric-filter");
    const metricCount = document.getElementById("metric-count");
    const serviceDescription = document.getElementById("service-description");

    serviceSelect.addEventListener("change", async function() {
        const serviceId = this.value;
        metricSelect.innerHTML = '<option value="">-- Laden... --</option>';
        metricSelect.disabled = true;
        showBtn.disabled = true;
        filterContainer.style.display = "none";
        metricFilter.value = "";
        metricCount.textContent = "";
        allMetrics = [];

        // Update description
        serviceDescription.textContent = serviceId ? (SERVICE_INFO[serviceId] || {}).description || "" : "";

        if (!serviceId) {
            metricSelect.innerHTML = '<option value="">-- Selecteer eerst een service --</option>';
            return;
        }

        loading.style.display = "block";
        errorMsg.style.display = "none";

        try {
            const response = await fetch(`/api/metrics-explorer/metrics/${serviceId}`);
            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || "Onbekende fout");
            }

            allMetrics = data.metrics || [];
            populateMetricDropdown(allMetrics);

            if (allMetrics.length > 10) {
                filterContainer.style.display = "flex";
            }
            metricCount.textContent = `${allMetrics.length} metrics beschikbaar`;

        } catch (err) {
            errorText.textContent = `Fout: ${err.message}`;
            errorMsg.style.display = "block";
            metricSelect.innerHTML = '<option value="">-- Fout bij ophalen --</option>';
        } finally {
            loading.style.display = "none";
        }
    });

    metricSelect.addEventListener("change", function() {
        showBtn.disabled = !this.value;
    });

    function populateMetricDropdown(metrics) {
        metricSelect.innerHTML = '<option value="">-- Selecteer een metric --</option>';
        for (const name of metrics) {
            const opt = document.createElement("option");
            opt.value = name;
            opt.textContent = name;
            metricSelect.appendChild(opt);
        }
        metricSelect.disabled = metrics.length === 0;
    }

    function filterMetrics() {
        const query = metricFilter.value.toLowerCase();
        const filtered = allMetrics.filter(m => m.toLowerCase().includes(query));
        populateMetricDropdown(filtered);
        metricCount.textContent = `${filtered.length} van ${allMetrics.length} metrics`;
    }

    function showMetric() {
        const metric = metricSelect.value;
        if (!metric) return;

        // Use the service's default range (e.g. 7d for 2h-scrape jobs, 1h for real-time)
        const serviceId = serviceSelect.value;
        const range = (SERVICE_INFO[serviceId] || {}).range || "1h";

        // Build the Prometheus graph URL with the metric as expression
        const params = new URLSearchParams({
            "g0.expr": metric,
            "g0.tab": "0",        // Graph tab
            "g0.range_input": range
        });

        const graphUrl = `${PROMETHEUS_URL}/graph?${params.toString()}`;

        // Update iframe
        const frameContainer = document.getElementById("prometheus-frame-container");
        const frame = document.getElementById("prometheus-frame");
        const directLink = document.getElementById("prometheus-direct-link");

        frame.src = graphUrl;
        directLink.href = graphUrl;
        frameContainer.style.display = "block";

        // Scroll to the iframe
        frameContainer.scrollIntoView({ behavior: "smooth" });
    }
</script>
{% endblock %}
