{% extends "project-creation-result.html.j2" %}

{% block page_title %}Project Aanmaak Fout{% endblock %}

{% block banner %}
{# Error Message #}
<c-alert
    kind="error"
    heading="Fout bij het aanmaken van het project"
    messages="Er is iets misgegaan bij het verwerken van je projectaanvraag."/>
{% endblock %}

{% block heading %}Project aanmaak mislukt{% endblock %}

{% block body %}
<p class="rvo-paragraph rvo-paragraph--lg">
    Er is iets misgegaan bij het verwerken van je projectaanvraag. Het project kon niet worden aangemaakt.
</p>

<c-layout-flow gap="sm">
    <p class="rvo-paragraph">
        <strong>Foutdetails:</strong>
    </p>
    <div class="rvo-code-block">
        <pre><code>{{ error_message }}</code></pre>
    </div>
</c-layout-flow>

<c-alert
    kind="info"
    heading="Mogelijke oplossingen"
    messages="Controleer je invoer en probeer het opnieuw. Blijft het misgaan, neem dan contact op met de systeembeheerder."/>

<c-layout-flow gap="md">
    <c-action-group
        :actions="[
            {
                'type': 'link',
                'kind': 'primary',
                'size': 'md',
                'label': 'Probeer Opnieuw',
                'showIcon': 'after',
                'icon': 'pijl-naar-rechts',
                'url': '/projects/new'
            },
            {
                'type': 'link',
                'kind': 'secondary',
                'size': 'md',
                'label': 'Ga naar Dashboard',
                'showIcon': 'after',
                'icon': 'pijl-naar-rechts',
                'url': '/dashboard'
            },
            {
                'type': 'link',
                'kind': 'tertiary',
                'size': 'md',
                'label': 'Hulp Zoeken',
                'url': '/help'
            }
        ]"/>
</c-layout-flow>
{% endblock %}
