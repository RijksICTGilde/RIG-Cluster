{#
  Self-Service Portal - Nieuw Project Aanvragen

  Een moderne, gebruiksvriendelijke interface voor het aanvragen van nieuwe projecten
  in het Kubernetes platform met geïntegreerde services.
#}

<c-page title="Nieuw Project - Self Service Portal" lang="nl" bodyClass="rvo-theme rvo-responsive">

    <div class="rvo-demo-page">
        {# Header #}
        <c-header
            text="Zelfservice voor Applicatie Deployment"
            subtitle="Rijksorganisatie voor Ontwikkeling, Digitalisering en Innovatie"
            link="/"/>

        <c-layout-flow gap="xl" size="lg">
            {# MenuBar #}
            <c-menubar
                size="md"
                :useIcons="true"
                iconPlacement="before"
                maxWidth="lg"
                :items="menu_items"/>

            <c-layout-flow gap="2xl" size="lg">
                <main>
                    <c-layout-flow gap="xl">

                        {# Page Header #}
                        <div>
                            <c-heading type="h1" textContent="Nieuw Project Aanmaken"/>
                            <p class="rvo-paragraph rvo-paragraph--zwart rvo-paragraph--lg">
                                Een applicatie bestaat uit 1 of meerdere onderdelen, gebouwd als een Docker / Container
                                image, deze onderdelen noemen we componenten.
                            </p>
                            <p class="rvo-paragraph rvo-paragraph--zwart rvo-paragraph--lg">
                                Daarnaast kan een applicatie services nodig hebben, zoals een database.
                            </p>
                            <p class="rvo-paragraph rvo-paragraph--zwart rvo-paragraph--lg">
                                Via een project kun je de configuratie van de benodigde services en één of meerdere
                                componenten die samen een applicatie vormen beheren.
                            </p>
                            <p class="rvo-paragraph rvo-paragraph--zwart rvo-paragraph--lg">
                                Services worden voor je ingericht en de benodigde gegevens worden aan de componenten
                                beschikbaar gesteld.
                            </p>
                            <p class="rvo-paragraph rvo-paragraph--zwart rvo-paragraph--lg">
                                Bij het uitvoeren van je configuratie, wordt alles voor je opzet en klaargezet en is je
                                applicatie beschikbaar voor gebruik.
                            </p>
                        </div>

                        {# Main Form #}
                        <form id="project-form" method="post" action="/projects/new" autocomplete="off">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                            <c-layout-flow gap="xl">

                                {# Section 1: Project Informatie #}
                                <c-fieldset legend="Projectgegevens">
                                    <c-layout-flow gap="md">
                                        <p class="rvo-text--subtle">
                                            Basis informatie over uw project. Deze gegevens worden gebruikt voor
                                            identificatie en documentatie.
                                        </p>

                                        <c-text-input-field

                                            id="display-name"
                                            name="display-name"
                                            label="Projectnaam"
                                            helperText="Een beschrijvende naam voor uw project"
                                            :required="true"
                                            placeholder="Mijn Nieuwe Applicatie"></c-text-input-field>

                                        <c-textarea-field
                                            id="project-description"
                                            name="project-description"
                                            label="Projectomschrijving"
                                            helperText="Korte beschrijving van het doel en de scope van het project"
                                            rows="4"
                                            :required="true"
                                            placeholder="Dit project heeft als doel..."/>

                                        <c-select-field
                                            id="cluster"
                                            name="cluster"
                                            label="Cluster"
                                            helperText="Selecteer het gewenste cluster voor uw project"
                                            required="true"
                                            value="{{ current_cluster }}"
                                            :options="cluster_options"></c-select-field>
                                    </c-layout-flow>
                                </c-fieldset>

                                {# Section 2: Gebruikersbeheer #}
                                <c-fieldset legend="Projectleden">
                                    <c-layout-flow gap="md">
                                        <p class="rvo-text--subtle">
                                            Voeg teamleden toe die toegang moeten krijgen tot het project. U kunt
                                            meerdere gebruikers toevoegen met verschillende rollen.
                                        </p>

                                        <div id="users-container">
                                            {# First user row (template) #}
                                            <div class="user-row rvo-card rvo-card--padding-sm"
                                                 style="background: var(--rvo-color-grijs-50); margin-bottom: var(--rvo-space-md);">
                                                <div
                                                    class="rvo-layout-row rvo-layout-gap--md rvo-layout-align-items-end">
                                                    <div style="flex: 3;">
                                                        <c-text-input-field
                                                            id="user-email-1"
                                                            name="user-email[]"
                                                            label="E-mailadres"
                                                            type="email"
                                                            :required="true"
                                                            placeholder="naam@organisatie.nl"
                                                            helperText="Rijksoverheid e-mailadres"
                                                            value="{{ user.email if user and user.email else '' }}"/>
                                                    </div>
                                                    <div style="flex: 2;">
                                                        <c-select-field
                                                            id="user-role-1"
                                                            name="user-role[]"
                                                            label="Rol"
                                                            :required="true"
                                                            value="admin"
                                                            :options="[
                                                                {'value': 'admin', 'label': 'Administrator'},
                                                                {'value': 'developer', 'label': 'Developer'},
                                                                {'value': 'operator', 'label': 'Operator'}
                                                            ]"/>
                                                    </div>
                                                    <div style="flex: 0 0 auto; padding-bottom: var(--rvo-space-xs);">
                                                        <c-button
                                                            label="Verwijderen"
                                                            kind="tertiary"
                                                            size="sm"
                                                            showIcon="before"
                                                            icon="verwijderen"
                                                            @click="removeUserRow(this)"></c-button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <c-button
                                                type="button"
                                                label="Gebruiker toevoegen"
                                                kind="tertiary"
                                                size="sm"
                                                showIcon="before"
                                                icon="plus"
                                                @click="addUserRow()"/>
                                        </div>

                                        <div class="rvo-alert rvo-alert--info">
                                            <c-icon icon="info" size="md"/>
                                            <div class="rvo-alert__content">
                                                <p><strong>Rollen uitleg:</strong></p>
                                                <c-ul bulletType="icon" bulletIcon="option-1">
                                                    <li><strong>Administrator:</strong> Volledige toegang tot alle
                                                        resources en instellingen
                                                    </li>
                                                    <li><strong>Developer:</strong> Kan applicaties deployen en logs
                                                        bekijken
                                                    </li>
                                                    <li><strong>Operator:</strong> Alleen-lezen toegang voor monitoring
                                                    </li>
                                                </c-ul>
                                            </div>
                                        </div>
                                    </c-layout-flow>
                                </c-fieldset>

                                {# Section 3: Services Selectie #}
                                <c-fieldset legend="Beschikbare Services">
                                    <c-layout-flow gap="md">
                                        <p class="rvo-text--subtle">
                                            Selecteer de services die u wilt activeren voor uw project. U kunt deze
                                            later altijd aanpassen.
                                        </p>

                                        <div class="rvo-layout-grid rvo-layout-gap--lg"
                                             style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">

                                            {# Service: Web Publishing #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="wereldbol" size="3xl" color="hemelblauw"
                                                                    ariaLabel="Web"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="Publiceren op het web"/>
                                                        <p class="rvo-text--sm">
                                                            Maak de applicatie toegankelijk via het publieke internet.
                                                        </p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox
                                                            id="service-web"
                                                            name="services[]"
                                                            value="publish-on-web"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                            {# Service: SSO #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="sleutel" size="3xl" color="groen"
                                                                    ariaLabel="SSO"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="Single Sign-On Rijk"/>
                                                        <p class="rvo-text--sm">
                                                            Integreer met de Rijksoverheid SSO voor veilige
                                                            authenticatie via
                                                            Keycloak.
                                                        </p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox
                                                            id="service-sso"
                                                            name="services[]"
                                                            value="keycloak"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                            {# Service: PVC #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="server" size="3xl" color="oranje-750"
                                                                    ariaLabel="Storage"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="Permanente opslag"/>
                                                        <p class="rvo-text--sm">
                                                            Gegevens blijven bewaard
                                                            tijdens de levenscyclus van de applicatie.
                                                        </p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox
                                                            id="service-pvc"
                                                            name="services[]"
                                                            value="persistent-storage"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                            {# Service: Temp Storage #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="klok" size="3xl" color="oranje"
                                                                    ariaLabel="Temp"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="Tijdelijke schijfruimte"/>
                                                        <p class="rvo-text--sm">
                                                            Gegevens worden
                                                            niet bewaard tijdens de levenscyclus van de applicatie.
                                                        </p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox id="service-temp"
                                                                    name="services[]"
                                                                    value="temp-storage"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                            {# Service: PostgreSQL #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="database" size="3xl" color="donkerblauw"
                                                                    ariaLabel="Database"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="PostgreSQL Database"/>
                                                        <p class="rvo-text--sm">Database service voor applicaties.</p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox id="service-postgres" name="services[]"
                                                                    value="postgresql-database"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                            {# Service: MinIO #}
                                            <c-card class="service-card" padding="md" background="color"
                                                    backgroundColor="wit" :outline="true">
                                                <div class="service-card-content">
                                                    <div class="service-card-info">
                                                        <div class="service-card-icon">
                                                            <c-icon icon="map" size="3xl" color="rood"
                                                                    ariaLabel="Object Storage"/>
                                                        </div>
                                                        <c-heading type="h3" textContent="MinIO Object Storage"/>
                                                        <p class="rvo-text--sm">
                                                            S3-compatible object storage voor documenten, afbeeldingen
                                                            en grote
                                                            bestanden.
                                                        </p>
                                                    </div>
                                                    <div class="service-card-checkbox">
                                                        <c-checkbox
                                                            id="service-minio"
                                                            name="services[]"
                                                            value="minio-storage"/>
                                                    </div>
                                                </div>
                                            </c-card>

                                        </div>
                                    </c-layout-flow>
                                </c-fieldset>

                                {# Section 4: Web Address Configuration #}
                                <c-fieldset legend="Web Adres Configuratie">
                                    <c-layout-flow gap="md">
                                        <c-text-input-field
                                            id="deployment-name"
                                            name="deployment-name"
                                            label="Deployment Naam"
                                            :value="'main'"
                                            placeholder="main"
                                            helperText="De naam voor deze deployment. Wordt gebruikt in URL-generatie en resource-identificatie. Standaard: 'main'"/>

                                        <div class="rvo-alert rvo-alert--info">
                                            <c-icon icon="info" size="md"/>
                                            <div class="rvo-alert__content">
                                                <c-p><strong>Hoe worden web adressen gegenereerd?</strong></c-p>

                                                <c-layout-flow gap="lg">
                                                    <div>
                                                        <c-p><strong>1. Component-specifiek (standaard)</strong></c-p>
                                                        <c-p>Elk component krijgt zijn eigen unieke URL zoals <code>frontend-prod-myapp.example.com</code> en <code>backend-prod-myapp.example.com</code>.</c-p>
                                                    </div>

                                                    <div>
                                                        <c-p><strong>2. Deployment-naam (gedeeld domein)</strong></c-p>
                                                        <c-p>Alle componenten delen dezelfde domeinnaam gebaseerd op de deployment-naam (bijvoorbeeld <code>prod-myapp.example.com</code>), maar verschillen in pad zoals <code>/</code> en <code>/api</code>.</c-p>
                                                        <c-p class="rvo-text--sm rvo-text--subtle">Dit voorkomt CORS-problemen tussen componenten.</c-p>
                                                    </div>

                                                    <div>
                                                        <c-p><strong>3. Aangepast subdomein</strong></c-p>
                                                        <c-p>Alle componenten delen een door u opgegeven domeinnaam (bijvoorbeeld <code>myapp.example.com</code>), met verschillende paden.</c-p>
                                                        <c-p class="rvo-text--sm rvo-text--subtle">Dit geeft u volledige controle over de URL-structuur.</c-p>
                                                    </div>

                                                    <div>
                                                        <c-p><strong>4. Nice URL (punt-gescheiden)</strong></c-p>
                                                        <c-p>Elk component krijgt een mooie punt-gescheiden URL zoals <code>frontend.mijnapp.rijks.app</code>. U kiest een uniek subdomein (bijv. <code>mijnapp</code>) dat voor alle componenten wordt gebruikt.</c-p>
                                                        <c-p class="rvo-text--sm rvo-text--subtle">Vereist een base-domein zoals rijks.app of rijksapps.nl. Optioneel kunt u een component als "root" markeren voor directe toegang via <code>mijnapp.rijks.app</code>.</c-p>
                                                    </div>
                                                </c-layout-flow>
                                            </div>
                                        </div>

                                        <c-form-select
                                            id="domain-mode"
                                            name="domain-mode"
                                            :options="[
                                                {'value': 'component-specific', 'label': 'Component-specifiek (standaard) — bijv. frontend.mijnproject-staging.odcn.nl'},
                                                {'value': 'deployment-name', 'label': 'Deployment-naam — bijv. staging.mijnproject.odcn.nl'},
                                                {'value': 'custom', 'label': 'Aangepast subdomein — bijv. custom-subdomain.odcn.nl'},
                                                {'value': 'nice-url', 'label': 'Eigen subdomein — bijv. frontend.mijnapp.rijks.app (root: mijnapp.rijks.app)'}
                                            ]"
                                            value="'component-specific'"
                                            @change="handleDomainModeChange()"/>

                                        <c-text-input-field
                                            id="subdomain"
                                            name="subdomain"
                                            label="Subdomein"
                                            helperText="Geef een custom subdomein op (bijvoorbeeld: myapp). Dit zal worden gebruikt als basis voor alle component URLs."
                                            placeholder="myapp"
                                            style="display: none;"/>

                                        <div id="nice-url-subdomain-container" style="display: none;">
                                            <div class="rvo-form-field">
                                                <label class="rvo-form-field__label" for="base-domain">Base Domain</label>
                                                <select id="base-domain" name="base-domain" class="rvo-select-field">
                                                    <option value="">Selecteer eerst een cluster</option>
                                                    {# Options will be populated dynamically based on selected cluster #}
                                                </select>
                                                <p class="rvo-form-field__helper-text">Selecteer het base domain voor uw nice URL (afhankelijk van gekozen cluster)</p>
                                            </div>
                                            <c-text-input-field
                                                id="nice-url-subdomain"
                                                name="subdomain"
                                                label="Subdomein (globaal uniek)"
                                                placeholder="mijnapp"
                                                helperText="Kies een uniek subdomein voor uw project. Dit wordt gebruikt als basis voor alle component URLs (bijv. frontend.mijnapp.rijks.app)."/>
                                            <div id="subdomain-availability" style="margin-top: 0.5rem;"></div>
                                            <div id="url-preview" style="display: none; margin-top: 1rem; padding: 0.75rem; background-color: #f5f5f5; border-radius: 4px; border-left: 3px solid #007bc7;">
                                                <p style="margin: 0 0 0.5rem 0; font-weight: bold; color: #333;">Uw URLs worden:</p>
                                                <code id="url-preview-text" style="font-size: 0.9rem; color: #154273;"></code>
                                            </div>
                                        </div>
                                    </c-layout-flow>
                                </c-fieldset>

                                {# Components Section #}
                                <c-fieldset legend="Components Configuratie">
                                    <div class="rvo-alert rvo-alert--info">
                                        <c-icon icon="info" size="md"/>
                                        <div class="rvo-alert__content">
                                            <p><strong>Components:</strong> Configureer de applicatie components die u
                                                wilt deployen. Elk component kan gekoppeld worden aan specifieke
                                                services.</p>
                                        </div>
                                    </div>

                                    <c-layout-flow gap="lg">
                                        <div id="components-list">
                                            {# Initial component block #}
                                            <div class="component-item rvo-card rvo-card--outline rvo-card--padding-lg">
                                                <c-layout-flow gap="md">
                                                    <div
                                                        style="display: flex; justify-content: space-between; align-items: center;">
                                                        <c-heading type="h3" textContent="Component"/>
                                                        <c-button
                                                            kind="quaternary"
                                                            size="sm"
                                                            :showIcon="'before'"
                                                            :icon="'verwijderen'"
                                                            @click="removeComponentRow(this)">
                                                            Verwijderen
                                                        </c-button>
                                                    </div>

                                                    <c-layout-row gap="md">
                                                        <c-layout-column size="md-6">
                                                            <c-select-field
                                                                id="component-type-1"
                                                                name="components[0][type]"
                                                                label="Component Type"
                                                                :options="[
                                                                        {'label': 'Single (All-in-one)', 'value': 'single'},
                                                                        {'label': 'Frontend', 'value': 'frontend'},
                                                                        {'label': 'Backend', 'value': 'backend'}
                                                                    ]"
                                                                :value="'single'"/>
                                                        </c-layout-column>
                                                        <c-layout-column size="md-6">
                                                            <c-text-input-field
                                                                id="component-port-1"
                                                                name="components[0][port]"
                                                                label="Poort"
                                                                type="number"
                                                                placeholder="8080"
                                                                helperText="Poort waarop de applicatie draait"/>
                                                        </c-layout-column>
                                                    </c-layout-row>

                                                    <c-text-input-field
                                                        id="component-image-1"
                                                        name="components[0][image]"
                                                        label="Container Image"
                                                        placeholder="registry.example.com/my-app:latest"
                                                        helperText="Docker image van uw applicatie. Moet een rootless image zijn (draait niet als root gebruiker)."
                                                        expandableHelperText="true"
                                                        expandableHelperTextTitle="Meer info over rootless images"/>

                                                    <c-text-input-field
                                                        id="component-path-1"
                                                        name="components[0][path]"
                                                        label="Publicatie Pad"
                                                        placeholder="/"
                                                        :value="'/'"
                                                        helperText="Het pad waarop dit component gepubliceerd wordt (bijvoorbeeld: /, /api, /aanleverapi). Bij gedeelde domeinen wordt dit pad gebruikt om verkeer naar het juiste component te routeren."/>

                                                    <div class="root-component-radio" style="display: none;">
                                                        <div class="rvo-form-field">
                                                            {# Hidden input for form submission - set to "true" when radio is selected #}
                                                            <input type="hidden" id="component-root-hidden-0" name="components[0][root]" value="false" />
                                                            <label class="rvo-form-field__label" for="component-root-0">
                                                                <input
                                                                    type="radio"
                                                                    id="component-root-0"
                                                                    name="root-component-selection"
                                                                    value="0"
                                                                    class="rvo-radio root-radio-selector"
                                                                    onchange="handleRootComponentChange(this)"/>
                                                                <span class="rvo-radio__label">Root component</span>
                                                            </label>
                                                            <p class="rvo-form-field__helper-text">Maak dit de hoofdcomponent die bereikbaar is op de basis-URL (bijv. mijnapp.rijks.app). Alleen 1 component kan root zijn. Kies hier typisch uw frontend of single-page app.</p>
                                                        </div>
                                                    </div>

                                                    <c-layout-row gap="md">
                                                        <c-layout-column size="md-6">
                                                            <c-select-field
                                                                id="component-cpu-1"
                                                                name="components[0][cpu_limit]"
                                                                label="CPU Limiet"
                                                                :options="[
                                                                        {'label': '1 CPU', 'value': '1'},
                                                                        {'label': '2 CPU', 'value': '2'},
                                                                        {'label': '3 CPU', 'value': '3'},
                                                                        {'label': '4 CPU', 'value': '4'}
                                                                    ]"
                                                                :value="'1'"
                                                                helperText="Aantal CPU cores toegewezen aan dit component"
                                                                :expandableHelperText="true"
                                                                expandableHelperTextTitle="Meer info over CPU limieten"/>
                                                        </c-layout-column>
                                                        <c-layout-column size="md-6">
                                                            <c-select-field
                                                                id="component-memory-1"
                                                                name="components[0][memory_limit]"
                                                                label="Memory Limiet"
                                                                :options="[
                                                                        {'label': '128 MB', 'value': '128Mi'},
                                                                        {'label': '256 MB', 'value': '256Mi'},
                                                                        {'label': '512 MB', 'value': '512Mi'},
                                                                        {'label': '768 MB', 'value': '768Mi'},
                                                                        {'label': '1 GB', 'value': '1Gi'}
                                                                    ]"
                                                                :value="'256Mi'"
                                                                helperText="Maximum RAM geheugen beschikbaar voor dit component"
                                                                :expandableHelperText="true"
                                                                expandableHelperTextTitle="Meer info over memory limieten"/>
                                                        </c-layout-column>
                                                    </c-layout-row>

                                                    <c-textarea-field
                                                        id="component-env-vars-1"
                                                        name="components[0][env_vars]"
                                                        label="Environment Variables"
                                                        placeholder="KEY=VALUE format:
EXAMPLE_VAR=value
DATABASE_URL=postgresql://...
DEBUG=false

Or YAML format:
EXAMPLE_VAR: value
DATABASE_URL: postgresql://...
DEBUG: false"
                                                        rows="6"
                                                        helperText="Environment variables voor dit component. Ondersteunt beide formaten: KEY=VALUE (een per regel) of YAML syntax"/>

                                                    <c-textarea-field
                                                        id="component-aliases-1"
                                                        name="components[0][aliases]"
                                                        label="Aliases"
                                                        placeholder="YAML format - reference system variables:
DATABASE_URL: $DATABASE_SERVER_HOST:$DATABASE_SERVER_PORT/$DATABASE_DB
S3_ENDPOINT: $OBJECT_STORE_URL
OIDC_URL: $OIDC_DISCOVERY_URL

Available variables depend on selected services:
- Database: DATABASE_SERVER_HOST, DATABASE_SERVER_PORT, DATABASE_DB, etc.
- MinIO: OBJECT_STORE_URL, OBJECT_STORE_USER, OBJECT_STORE_PASSWORD, etc.
- Keycloak: OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_DISCOVERY_URL"
                                                        rows="8"
                                                        helperText="Aliases voor systeemvariabelen. Gebruik $VARIABLE_NAME om naar service variabelen te verwijzen. Geen encoding nodig."
                                                        :expandableHelperText="true"
                                                        expandableHelperTextTitle="Meer info over aliases"/>

                                                    {# Service binding for this component #}
                                                    <div class="service-binding">
                                                        <c-heading type="h4" textContent="Gekoppelde Services"/>
                                                        <p class="rvo-text--sm">Selecteer welke services dit component
                                                            mag gebruiken:</p>

                                                        <c-layout-row gap="md" class="component-services-container">
                                                            {# Services will be dynamically added here based on selected main services #}
                                                        </c-layout-row>
                                                    </div>
                                                </c-layout-flow>
                                            </div>
                                        </div>

                                        <c-button
                                            type="button"
                                            kind="tertiary"
                                            size="sm"
                                            :showIcon="'before'"
                                            :icon="'plus'"
                                            @click="addComponentRow()">
                                            Component Toevoegen
                                        </c-button>

                                        <div class="rvo-alert rvo-alert--info">
                                            <c-icon icon="info" size="md"/>
                                            <div class="rvo-alert__content">
                                                <p><strong>Rootless Images:</strong> Voor beveiliging accepteert het
                                                    platform alleen container images die niet als root-gebruiker
                                                    draaien. Zorg ervoor dat uw Dockerfile een USER instructie bevat die
                                                    een non-root gebruiker specificeert (bijv. USER 1001).</p>
                                            </div>
                                        </div>
                                    </c-layout-flow>
                                </c-fieldset>

                                {# Action Buttons #}
                                <c-layout-flow gap="md">
                                    <c-action-group
                                        :actions="[
                                            {
                                                'type': 'button',
                                                'type': 'submit',
                                                'kind': 'primary',
                                                'size': 'md',
                                                'label': 'Project Aanmaken',
                                                'showIcon': 'after',
                                                'icon': 'pijl-naar-rechts',
                                                '@click': 'document.getElementById(\'project-form\').submit()'
                                            },
                                            {
                                                'type': 'button',
                                                'kind': 'tertiary',
                                                'size': 'md',
                                                'label': 'Annuleren',
                                                '@click': 'window.location.href=\'/dashboard/\''
                                            }
                                            ]" />

                                </c-layout-flow>

                            </c-layout-flow>
                        </form>
                    </c-layout-flow>
                </main>
            </c-layout-flow>

            {# Footer #}
            <c-footer
                maxWidth="lg"
                :primaryMenu="[
                    {
                        'label': 'Platform',
                        'items': [
                            {'content': 'Over het platform', 'link': '/about'},
                            {'content': 'Architectuur', 'link': '/architecture'},
                            {'content': 'Documentatie', 'link': '/docs'},
                            {'content': 'API Referentie', 'link': '/api'},
                            {'content': 'Status', 'link': '/status'}
                        ]
                    }
                ]"
                :secondaryMenu="[
                    {
                        'label': 'Organisatie',
                        'items': [
                            {'content': 'Over ODC-Noord', 'link': '/organization'},
                            {'content': 'Privacyverklaring', 'link': '/privacy'},
                            {'content': 'Toegankelijkheid', 'link': '/accessibility'},
                            {'content': 'Cookieverklaring', 'link': '/cookies'}
                        ]
                    }
                ]" />


        </c-layout-flow>
    </div>

    {# JavaScript for user row cloning #}
    <script>
      let userCount = 1;
      let componentCount = 1;

      // Handle domain mode changes
      function handleDomainModeChange() {
        const domainMode = document.getElementById('domain-mode').value;
        const subdomainField = document.getElementById('subdomain').closest('c-text-input-field');
        const displayNameField = document.getElementById('display-name');
        const niceUrlSubdomainContainer = document.getElementById('nice-url-subdomain-container');

        // Hide both optional fields by default
        if (subdomainField) {
          subdomainField.style.display = 'none';
        }
        if (niceUrlSubdomainContainer) {
          niceUrlSubdomainContainer.style.display = 'none';
        }

        if (domainMode === 'component-specific') {
          // Hide subdomain field
          document.getElementById('subdomain').value = '';
          document.getElementById('subdomain').removeAttribute('required');
        } else if (domainMode === 'deployment-name') {
          // Hide subdomain field but populate it from display name
          // Auto-populate with deployment name (convert to lowercase, replace spaces with hyphens)
          const deploymentName = displayNameField.value.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
          document.getElementById('subdomain').value = deploymentName;
          document.getElementById('subdomain').removeAttribute('required');
        } else if (domainMode === 'custom') {
          // Show subdomain field for custom input
          if (subdomainField) {
            subdomainField.style.display = 'block';
          }
          document.getElementById('subdomain').setAttribute('required', 'true');
        } else if (domainMode === 'nice-url') {
          // Show nice-url subdomain input for globally unique subdomain
          if (niceUrlSubdomainContainer) {
            niceUrlSubdomainContainer.style.display = 'block';
          }
          // Clear the custom subdomain field and use nice-url-subdomain
          document.getElementById('subdomain').value = '';
          document.getElementById('subdomain').removeAttribute('required');
          const niceUrlSubdomain = document.getElementById('nice-url-subdomain');
          if (niceUrlSubdomain) {
            niceUrlSubdomain.setAttribute('required', 'true');
          }
          // Also require base-domain for nice-url mode
          const baseDomainField = document.getElementById('base-domain');
          if (baseDomainField) {
            baseDomainField.setAttribute('required', 'true');
            // Update base domain options based on current cluster
            updateBaseDomainOptions();
          }
        } else {
          // For other modes, base-domain is not required
          const baseDomainField = document.getElementById('base-domain');
          if (baseDomainField) {
            baseDomainField.removeAttribute('required');
          }
        }

        // Toggle root component radio buttons visibility
        toggleRootRadios(domainMode === 'nice-url');
      }

      // Show/hide root component radio buttons based on domain mode
      function toggleRootRadios(show) {
        const rootRadios = document.querySelectorAll('.root-component-radio');
        rootRadios.forEach(radio => {
          radio.style.display = show ? 'block' : 'none';
        });
        // Clear root selection when hiding
        if (!show) {
          clearRootComponentSelection();
        }
      }

      // Handle root component radio button change
      // Updates the hidden inputs that the backend expects (components[{index}][root])
      function handleRootComponentChange(selectedRadio) {
        const componentIndex = selectedRadio.value;

        // Reset all hidden root inputs to "false"
        document.querySelectorAll('input[name^="components["][name$="][root]"]').forEach(input => {
          input.value = "false";
        });

        // Set the selected component's hidden root input to "true"
        const hiddenInput = document.getElementById(`component-root-hidden-${componentIndex}`);
        if (hiddenInput) {
          hiddenInput.value = "true";
        }

        // Update URL preview
        updateUrlPreview();
      }

      // Clear all root component selections (when switching away from nice-url mode)
      function clearRootComponentSelection() {
        // Uncheck all radio buttons
        document.querySelectorAll('input[name="root-component-selection"]').forEach(radio => {
          radio.checked = false;
        });
        // Reset all hidden inputs to false
        document.querySelectorAll('input[name^="components["][name$="][root]"]').forEach(input => {
          input.value = "false";
        });
      }

      // Base domain options per cluster (from server config)
      const clusterBaseDomains = {{ cluster_base_domains_json | safe }};

      // Update base domain options based on selected cluster
      function updateBaseDomainOptions() {
        const cluster = document.getElementById('cluster').value;
        const selectElement = document.getElementById('base-domain');
        const domainMode = document.getElementById('domain-mode').value;

        if (!selectElement) {
          return;
        }

        // Get options for this cluster
        const options = clusterBaseDomains[cluster] || [];

        // Determine the placeholder message based on whether cluster is selected
        const placeholder = cluster
          ? (options.length > 0 ? 'Selecteer een base domain' : 'Geen base domains beschikbaar voor dit cluster')
          : 'Selecteer eerst een cluster';

        // Clear existing options and add placeholder
        selectElement.innerHTML = `<option value="">${placeholder}</option>`;

        // Add cluster-specific options
        options.forEach(opt => {
          const option = document.createElement('option');
          option.value = opt.value;
          option.textContent = opt.label;
          selectElement.appendChild(option);
        });

        // If only one option, auto-select it
        if (options.length === 1) {
          selectElement.value = options[0].value;
        }

        // Clear availability check when base domain changes
        document.getElementById('subdomain-availability').innerHTML = '';
      }

      // Check subdomain availability for nice-url mode
      let subdomainCheckTimeout = null;

      // Error code to Dutch message mapping (for U3 fix - avoid fragile string matching)
      // NOTE: All "not available" codes use the same generic message to prevent enumeration attacks
      const errorCodeTranslations = {
        'SUBDOMAIN_EMPTY': 'Subdomein mag niet leeg zijn',
        'SUBDOMAIN_TOO_SHORT': 'Subdomein is te kort',
        'SUBDOMAIN_TOO_LONG': 'Maximaal 63 tekens toegestaan',
        'SUBDOMAIN_INVALID_START': 'Mag niet beginnen met een streepje',
        'SUBDOMAIN_INVALID_END': 'Mag niet eindigen met een streepje',
        'SUBDOMAIN_INVALID_CHARS': 'Alleen kleine letters, cijfers en streepjes toegestaan',
        'SUBDOMAIN_NOT_AVAILABLE': 'Subdomein niet beschikbaar',  // Generic for both reserved and taken
        'SUBDOMAIN_RESERVED': 'Subdomein niet beschikbaar',  // Legacy - same as NOT_AVAILABLE
        'SUBDOMAIN_INVALID': 'Ongeldig subdomein formaat',
        'SUBDOMAIN_TAKEN': 'Subdomein niet beschikbaar',  // Same as NOT_AVAILABLE
        'INVALID_BASE_DOMAIN': 'Ongeldig base domain',
        'UNKNOWN_ERROR': 'Onbekende fout'
      };

      function getErrorMessage(errorCode, fallbackMessage) {
        return errorCodeTranslations[errorCode] || fallbackMessage || errorCodeTranslations['UNKNOWN_ERROR'];
      }

      // Show typing indicator during debounce (U2 fix)
      function showTypingIndicator() {
        const availabilityDiv = document.getElementById('subdomain-availability');
        if (availabilityDiv) {
          availabilityDiv.innerHTML = '<span style="color: #999;">Wachten op typen...</span>';
        }
      }

      async function checkSubdomainAvailability() {
        const subdomain = document.getElementById('nice-url-subdomain').value.trim().toLowerCase();
        const baseDomainField = document.getElementById('base-domain');
        const baseDomain = baseDomainField?.value;
        const availabilityDiv = document.getElementById('subdomain-availability');

        // Require base domain to be selected first
        if (!baseDomain) {
          availabilityDiv.innerHTML = '<span style="color: orange;">&#x26A0; Selecteer eerst een base domain</span>';
          return;
        }

        if (!subdomain) {
          availabilityDiv.innerHTML = '';
          return;
        }

        // Show checking status
        availabilityDiv.innerHTML = '<span style="color: #666;">Beschikbaarheid controleren...</span>';

        try {
          // Use SSO-protected web endpoint instead of API endpoint
          const response = await fetch(`/subdomains/check?subdomain=${encodeURIComponent(subdomain)}&base_domain=${encodeURIComponent(baseDomain)}`);
          const data = await response.json();

          if (data.validation_error) {
            // Use error_code for translation if available, fallback to validation_error
            const errorMessage = getErrorMessage(data.error_code, data.validation_error);
            availabilityDiv.innerHTML = `<span class="rvo-text--warning">&#x26A0; ${errorMessage}</span>`;
            document.getElementById('subdomain').value = '';
          } else if (data.available) {
            availabilityDiv.innerHTML = '<span class="rvo-text--success">&#x2714; Beschikbaar</span>';
            // Copy to the main subdomain field for form submission
            document.getElementById('subdomain').value = subdomain;
          } else {
            // Not available (taken or reserved) - show in red with generic message
            const errorMessage = getErrorMessage(data.error_code, 'Subdomein niet beschikbaar');
            availabilityDiv.innerHTML = `<span class="rvo-text--error">&#x2718; ${errorMessage}</span>`;
            document.getElementById('subdomain').value = '';
          }
        } catch (error) {
          availabilityDiv.innerHTML = '<span style="color: orange;">&#x26A0; Kon beschikbaarheid niet controleren</span>';
          // Still allow form submission
          document.getElementById('subdomain').value = subdomain;
        }
        // Update URL preview after availability check
        updateUrlPreview();
      }

      // Update URL preview for nice-url mode
      function updateUrlPreview() {
        const domainMode = document.getElementById('domain-mode').value;
        const previewDiv = document.getElementById('url-preview');
        const previewText = document.getElementById('url-preview-text');

        if (!previewDiv || !previewText || domainMode !== 'nice-url') {
          if (previewDiv) previewDiv.style.display = 'none';
          return;
        }

        const subdomain = document.getElementById('nice-url-subdomain')?.value?.trim().toLowerCase();
        const baseDomain = document.getElementById('base-domain')?.value;

        if (subdomain && baseDomain) {
          // Get component types to show realistic URLs
          const componentTypes = [];
          document.querySelectorAll('.component-item select[name*="[type]"]').forEach(select => {
            if (select.value) componentTypes.push(select.value.toLowerCase());
          });

          // Check if any component is marked as root (via radio button)
          const hasRootComponent = document.querySelector('input[name="root-component-selection"]:checked') !== null;

          let previewHtml = '';
          if (componentTypes.length > 0) {
            componentTypes.forEach(type => {
              previewHtml += `https://${type}.${subdomain}.${baseDomain}<br>`;
            });
            if (hasRootComponent) {
              previewHtml += `<br><em>Root component: https://${subdomain}.${baseDomain}</em>`;
            }
          } else {
            previewHtml = `https://[componentnaam].${subdomain}.${baseDomain}`;
            if (hasRootComponent) {
              previewHtml += `<br><em>Root component: https://${subdomain}.${baseDomain}</em>`;
            }
          }
          previewText.innerHTML = previewHtml;
          previewDiv.style.display = 'block';
        } else {
          previewDiv.style.display = 'none';
        }
      }

      // Update subdomain when deployment name changes (if deployment-name mode is selected)
      // Also add event listener for nice-url subdomain availability check
      document.addEventListener('DOMContentLoaded', function() {
        const displayNameField = document.getElementById('display-name');
        if (displayNameField) {
          displayNameField.addEventListener('input', function() {
            const domainMode = document.getElementById('domain-mode').value;
            if (domainMode === 'deployment-name') {
              const deploymentName = this.value.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
              document.getElementById('subdomain').value = deploymentName;
            }
          });
        }

        // Add debounced availability check for nice-url subdomain
        const niceUrlSubdomain = document.getElementById('nice-url-subdomain');
        if (niceUrlSubdomain) {
          niceUrlSubdomain.addEventListener('input', function() {
            // Clear previous timeout
            if (subdomainCheckTimeout) {
              clearTimeout(subdomainCheckTimeout);
            }
            // Show typing indicator immediately (U2 fix)
            if (this.value.trim()) {
              showTypingIndicator();
            } else {
              document.getElementById('subdomain-availability').innerHTML = '';
            }
            // Debounce the check to avoid too many requests
            subdomainCheckTimeout = setTimeout(checkSubdomainAvailability, 500);
          });
        }

        // Also check availability when base domain changes
        const baseDomainField = document.getElementById('base-domain');
        if (baseDomainField) {
          baseDomainField.addEventListener('change', function() {
            const domainMode = document.getElementById('domain-mode').value;
            if (domainMode === 'nice-url') {
              updateUrlPreview();
              if (document.getElementById('nice-url-subdomain').value.trim()) {
                checkSubdomainAvailability();
              }
            }
          });
        }

        // Add cluster change listener to update base domain options
        // U2: Show warning when cluster changes and user had selected a base domain
        const clusterField = document.getElementById('cluster');
        if (clusterField) {
          clusterField.addEventListener('change', function() {
            const baseDomainField = document.getElementById('base-domain');
            const domainMode = document.getElementById('domain-mode').value;
            const previousBaseDomain = baseDomainField?.value;
            const availabilityDiv = document.getElementById('subdomain-availability');

            // Update options first
            updateBaseDomainOptions();

            // Show warning if user had a selection and we're in nice-url mode
            if (domainMode === 'nice-url' && previousBaseDomain && availabilityDiv) {
              // Check if the previous selection is still available in the new cluster
              const newBaseDomainValue = baseDomainField?.value;
              if (!newBaseDomainValue || newBaseDomainValue !== previousBaseDomain) {
                availabilityDiv.innerHTML = '<span style="color: orange;">&#x26A0; Base domain selectie is gereset door clusterwijziging. Selecteer opnieuw een base domain.</span>';
              }
            }
          });
        }

        // Add form submit validation for nice-url subdomain
        const projectForm = document.getElementById('project-form');
        // Flag to prevent double-submission
        let isSubmitting = false;

        if (projectForm) {
          projectForm.addEventListener('submit', async function(e) {
            // Prevent double-submission
            if (isSubmitting) {
              e.preventDefault();
              return;
            }

            const domainMode = document.getElementById('domain-mode').value;
            if (domainMode !== 'nice-url') {
              // For non-nice-url modes, just set loading state and allow submission
              isSubmitting = true;
              setFormLoadingState(true);
              return;
            }

            const subdomain = document.getElementById('nice-url-subdomain').value.trim().toLowerCase();
            const baseDomainField = document.getElementById('base-domain');
            const baseDomain = baseDomainField?.value;
            const availabilityDiv = document.getElementById('subdomain-availability');

            // Validate base domain is selected
            if (!baseDomain) {
              e.preventDefault();
              availabilityDiv.innerHTML = '<span style="color: red;">&#x2718; Selecteer eerst een base domain</span>';
              return;
            }

            if (!subdomain) {
              e.preventDefault();
              availabilityDiv.innerHTML = '<span style="color: red;">&#x2718; Subdomein is verplicht</span>';
              return;
            }

            // Re-validate before submit to handle stale availability
            e.preventDefault();
            isSubmitting = true;
            setFormLoadingState(true);
            availabilityDiv.innerHTML = '<span style="color: orange;">Beschikbaarheid controleren...</span>';

            try {
              // Use SSO-protected web endpoint
              const response = await fetch(`/subdomains/check?subdomain=${encodeURIComponent(subdomain)}&base_domain=${encodeURIComponent(baseDomain)}`);
              const data = await response.json();

              if (data.validation_error) {
                const errorMessage = getErrorMessage(data.error_code, data.validation_error);
                availabilityDiv.innerHTML = `<span style="color: red;">&#x2718; ${errorMessage}</span>`;
                isSubmitting = false;
                setFormLoadingState(false);
                return;
              } else if (!data.available) {
                availabilityDiv.innerHTML = '<span style="color: red;">&#x2718; Niet meer beschikbaar - kies een ander subdomein</span>';
                document.getElementById('subdomain').value = '';
                isSubmitting = false;
                setFormLoadingState(false);
                return;
              }

              // Available - proceed with submission
              document.getElementById('subdomain').value = subdomain;
              availabilityDiv.innerHTML = '<span style="color: green;">&#x2714; Project wordt aangemaakt...</span>';
              projectForm.submit();
            } catch (error) {
              isSubmitting = false;
              setFormLoadingState(false);
              // Allow submission on network error but warn user
              if (confirm('Kon beschikbaarheid niet controleren. Toch doorgaan?')) {
                isSubmitting = true;
                setFormLoadingState(true);
                document.getElementById('subdomain').value = subdomain;
                projectForm.submit();
              }
            }
          });
        }
      });

      // Set loading state for the form (disable buttons, show spinner)
      function setFormLoadingState(loading) {
        // Find the submit button within c-action-group
        const actionGroup = document.querySelector('c-action-group');
        if (actionGroup) {
          // Disable/enable the action group by adding a class
          if (loading) {
            actionGroup.style.opacity = '0.6';
            actionGroup.style.pointerEvents = 'none';
          } else {
            actionGroup.style.opacity = '1';
            actionGroup.style.pointerEvents = 'auto';
          }
        }
      }

      function addUserRow() {
        userCount++;
        const container = document.getElementById('users-container');
        const template = container.querySelector('.user-row');
        const newRow = template.cloneNode(true);

        // Update IDs and clear values
        newRow.querySelectorAll('input, select').forEach(element => {
          if (element.id) {
            element.id = element.id.replace(/\d+/, userCount);
          }
          element.value = '';
        });

        // Clear any validation messages
        newRow.querySelectorAll('.rvo-form-field__error-text, .rvo-form-field__warning-text').forEach(el => {
          el.remove();
        });

        container.appendChild(newRow);

        // Focus on the new email field
        const newEmailField = newRow.querySelector('input[type="email"]');
        if (newEmailField) {
          newEmailField.focus();
        }
      }

      function removeUserRow(button) {
        const container = document.getElementById('users-container');
        const rows = container.querySelectorAll('.user-row');

        // Keep at least one row
        if (rows.length > 1) {
          button.closest('.user-row').remove();
        } else {
          // Clear the last row instead of removing it
          const row = button.closest('.user-row');
          row.querySelectorAll('input, select').forEach(element => {
            element.value = '';
          });
        }
      }

      function addComponentRow() {
        componentCount++;
        const container = document.getElementById('components-list');
        const template = container.querySelector('.component-item');
        const newComponent = template.cloneNode(true);

        // Use 0-based index for array names and root input IDs
        const newArrayIndex = componentCount - 1;

        // Update all IDs and names with new component index
        newComponent.querySelectorAll('input, select, textarea').forEach(element => {
          if (element.id) {
            // Special handling for root hidden input - use 0-based index to match radio button value
            if (element.id.startsWith('component-root-hidden-')) {
              element.id = `component-root-hidden-${newArrayIndex}`;
            } else {
              // Other elements use 1-based display index (e.g., component-type-1 -> component-type-2)
              element.id = element.id.replace(/-\d+/, `-${componentCount}`);
            }
          }
          if (element.name) {
            // Replace array index in name (e.g., components[0][type] -> components[1][type])
            element.name = element.name.replace(/\[\d+\]/, `[${newArrayIndex}]`);
          }
          // Clear values
          if (element.type === 'checkbox') {
            element.checked = false;
          } else if (element.type === 'radio' && element.name === 'root-component-selection') {
            // Update radio button value to new component index (0-based) and uncheck
            element.value = String(newArrayIndex);
            element.checked = false;
          } else if (element.type === 'hidden' && element.name && element.name.endsWith('[root]')) {
            // Reset hidden root input to false for new component
            element.value = 'false';
          } else {
            element.value = '';
          }
        });

        // Update labels to reference new IDs
        newComponent.querySelectorAll('label').forEach(label => {
          const forAttr = label.getAttribute('for');
          if (forAttr) {
            // Special handling for root radio label - use 0-based index
            if (forAttr.startsWith('component-root-') && !forAttr.includes('hidden')) {
              label.setAttribute('for', `component-root-${newArrayIndex}`);
            } else {
              // Other labels use 1-based display index
              label.setAttribute('for', forAttr.replace(/-\d+/, `-${componentCount}`));
            }
          }
        });

        // Clear any validation messages
        newComponent.querySelectorAll('.rvo-form-field__error-text, .rvo-form-field__warning-text').forEach(el => {
          el.remove();
        });

        container.appendChild(newComponent);

        // Update component services based on selected main services
        updateComponentServices(newComponent, componentCount - 1);

        // Toggle root radio visibility based on current domain mode
        const domainMode = document.getElementById('domain-mode').value;
        const rootRadio = newComponent.querySelector('.root-component-radio');
        if (rootRadio) {
          rootRadio.style.display = domainMode === 'nice-url' ? 'block' : 'none';
        }

        // Focus on the new component type field
        const newTypeField = newComponent.querySelector('select');
        if (newTypeField) {
          newTypeField.focus();
        }
      }

      // Service template mapping: service value -> template ID
      const serviceTemplates = {
        'keycloak': 'service-sso-template',
        'postgresql-database': 'service-postgresql-template',
        'minio-storage': 'service-minio-template',
        'publish-on-web': 'service-web-publishing-template',
        'persistent-storage': 'service-pvc-template',
        'temp-storage': 'service-temp-storage-template'
      };

      // Update component services based on selected main services
      function updateComponentServices(componentElement = null, componentIndex = null) {
        // Get selected main services
        const selectedMainServices = [];
        document.querySelectorAll('input[name="services[]"]:checked').forEach(checkbox => {
          selectedMainServices.push(checkbox.value);
        });

        // If no component specified, update all components
        const componentsToUpdate = componentElement ? [componentElement] : document.querySelectorAll('.component-item');

        componentsToUpdate.forEach((component, index) => {
          const actualIndex = componentIndex !== null ? componentIndex : index;
          const serviceBindingContainer = component.querySelector('.component-services-container');

          if (serviceBindingContainer) {
            // Clear existing services
            serviceBindingContainer.innerHTML = '';

            // Add services that are selected in main services
            selectedMainServices.forEach(serviceKey => {
              const templateId = serviceTemplates[serviceKey];
              if (templateId) {
                const template = document.getElementById(templateId);
                if (template) {
                  const clone = template.content.cloneNode(true);

                  // Replace INDEX placeholders with actual component index
                  clone.querySelectorAll('*').forEach(el => {
                    ['id', 'name', 'for'].forEach(attr => {
                      if (el.hasAttribute(attr)) {
                        el.setAttribute(attr, el.getAttribute(attr).replace(/INDEX/g, actualIndex));
                      }
                    });
                  });

                  // Auto-check the service checkbox when it's added to a component
                  const serviceCheckbox = clone.querySelector('input[type="checkbox"]');
                  if (serviceCheckbox) {
                    serviceCheckbox.checked = true;
                  }

                  serviceBindingContainer.appendChild(clone);
                }
              }
            });
          }
        });
      }

      // Listen for changes in main service checkboxes
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('input[name="services[]"]').forEach(checkbox => {
          checkbox.addEventListener('change', function () {
            updateComponentServices();
          });
        });

        // Initialize component services on page load
        updateComponentServices();
      });

      function removeComponentRow(button) {
        const container = document.getElementById('components-list');
        const components = container.querySelectorAll('.component-item');

        // Keep at least one component
        if (components.length > 1) {
          button.closest('.component-item').remove();
        } else {
          // Clear the last component instead of removing it
          const component = button.closest('.component-item');
          component.querySelectorAll('input, select').forEach(element => {
            if (element.type === 'checkbox') {
              element.checked = false;
            } else {
              element.value = '';
            }
          });
        }
      }

      // Service card click to toggle checkbox
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.service-card').forEach(card => {
          card.addEventListener('click', function (e) {
            // Don't toggle if clicking directly on checkbox
            if (e.target.type !== 'checkbox') {
              const checkbox = this.querySelector('input[type="checkbox"]');
              if (checkbox) {
                checkbox.checked = !checkbox.checked;
                // Trigger change event to update component services
                checkbox.dispatchEvent(new Event('change'));
              }
            }

            // Visual feedback - keep white background, just change border
            if (this.querySelector('input[type="checkbox"]').checked) {
              this.style.borderColor = 'var(--rvo-color-hemelblauw)';
              this.style.borderWidth = '2px';
              this.style.boxShadow = '0 2px 8px rgba(0,0,0,0.15)';
            } else {
              this.style.borderColor = '';
              this.style.borderWidth = '';
              this.style.boxShadow = '';
            }
          });

          // Hover effect
          card.addEventListener('mouseenter', function () {
            if (!this.querySelector('input[type="checkbox"]').checked) {
              this.style.borderColor = 'var(--rvo-color-hemelblauw-300)';
            }
          });

          card.addEventListener('mouseleave', function () {
            if (!this.querySelector('input[type="checkbox"]').checked) {
              this.style.borderColor = '';
            }
          });

          // Apply initial styling for pre-checked cards
          const checkbox = card.querySelector('input[type="checkbox"]');
          if (checkbox && checkbox.checked) {
            card.style.borderColor = 'var(--rvo-color-hemelblauw)';
            card.style.borderWidth = '2px';
            card.style.boxShadow = '0 2px 8px rgba(0,0,0,0.15)';
          }
        });
      });
    </script>

