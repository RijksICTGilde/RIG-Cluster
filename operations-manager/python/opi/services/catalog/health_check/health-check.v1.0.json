{
  "additionalProperties": false,
  "properties": {
    "liveness-path": {
      "anyOf": [
        {
          "pattern": "^/[A-Za-z0-9/_.\\-]*\\Z",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Liveness-Path"
    },
    "port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Port"
    },
    "readiness-path": {
      "anyOf": [
        {
          "pattern": "^/[A-Za-z0-9/_.\\-]*\\Z",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readiness-Path"
    },
    "scheme": {
      "anyOf": [
        {
          "enum": [
            "none",
            "tcp",
            "http",
            "https"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheme"
    }
  },
  "title": "HealthCheckConfig",
  "type": "object"
}
