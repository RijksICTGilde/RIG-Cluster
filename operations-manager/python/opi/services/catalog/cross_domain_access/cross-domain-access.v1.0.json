  "additionalProperties": false,
  "description": "Project- or deployment-level cross-domain-access config: two lists of named rules.\n\nThis is the STORED shape (patch models), because a root rule may leave the peer\ndeployment open and a deployment rule is a partial patch keyed on ``name``. The\ncompleteness of a rule is judged after the merge, not here.",
  "properties": {
    "inbound": {
      "items": {
        "$ref": "#/$defs/InboundRulePatch"
      },
      "title": "Inbound",
      "type": "array"
