{# De LOTC-tegenhanger van section-detail.html.j2 (RC-64).

   Waarom een tweede bestand en niet een gedeeld sjabloon: zie de kop van
   attachments/section-detail.html.j2.

   Dezelfde gegevens uit dezelfde ``section.context``, dezelfde teksten, dezelfde knoppen
   met dezelfde aanroepen en hetzelfde htmx-gedrag.

   WAT LETTERLIJK GELIJK MOET BLIJVEN, want er hangt gedrag aan:
     - ``id="otp-code-<realm>"``: het fragment dat de knop ophaalt vervangt de INHOUD van
       die container en noemt daarin dezelfde id voor zijn eigen "Nieuwe code"-knop. Het is
       op de realm gesleuteld en niet op loop.index, precies daarom.
     - de klassen config-item / config-code / copy-btn: daar hangt copyToClipboard() aan.
     - het wachtwoord blijft een <c-secret-field>; de waarde staat ontsleuteld in de
       context, dus hem als gewone tekst tonen zou hem op het scherm zetten.

   De aanroepen gaan via :attrs; <c-button> laat geen onclick als los attribuut toe. De
   "Open Admin Console"-knop houdt zijn window.open() met data-url in plaats van een href:
   de meetlat tussen de twee bouwlijnen kijkt naar welke JS-functie een knop aanroept. #}
{% set kopieer = "copyToClipboard('.config-code', event, '.config-item')" %}
{% set console_openen = "window.open(this.dataset.url, '_blank')" %}
<c-card outline padding="lg">
    <c-stack gap="md">
        <c-section-head title="Keycloak" icon="shield-check-mark" />
        <c-paragraph size="sm">Keycloak realm configuratie en admin toegang</c-paragraph>

        {% for kc_config in section.context.realms %}
            <c-card outline padding="md">
                <c-stack gap="sm">
                    <c-heading type="h3" size="6" label="Realm: {{ kc_config.realm }}" />

                    <div class="config-item">
                        <c-stack gap="xs">
                            <strong>Admin Console</strong>
                            <c-cluster gap="sm" align="center">
                                <c-code class="config-code">{{ kc_config.host }}</c-code>
                                <c-button type="tertiary" size="sm" label="Kopieer" show-icon="before" icon="file-text"
                                          class="copy-btn" :attrs="{'onclick': kopieer}" />
                            </c-cluster>
                            {% set console_url = kc_config.host ~ '/admin/master/console/#/' ~ kc_config.realm %}
                            {% set console_attrs = {'data-url': console_url, 'onclick': console_openen} %}
                            <c-button type="secondary" size="sm" label="Open Admin Console" show-icon="after" icon="link"
                                      :attrs="console_attrs" />
                        </c-stack>
                    </div>

                    <div class="config-item">
                        <c-stack gap="xs">
                            <strong>Realm</strong>
                            <c-cluster gap="sm" align="center">
                                <c-code class="config-code">{{ kc_config.realm }}</c-code>
                                <c-button type="tertiary" size="sm" label="Kopieer" show-icon="before" icon="file-text"
                                          class="copy-btn" :attrs="{'onclick': kopieer}" />
                            </c-cluster>
                        </c-stack>
                    </div>

                    <div class="config-item">
                        <c-stack gap="xs">
                            <strong>Admin Gebruikersnaam</strong>
                            <c-cluster gap="sm" align="center">
                                <c-code class="config-code">{{ kc_config.username }}</c-code>
                                <c-button type="tertiary" size="sm" label="Kopieer" show-icon="before" icon="file-text"
                                          class="copy-btn" :attrs="{'onclick': kopieer}" />
                            </c-cluster>
                        </c-stack>
                    </div>

                    <c-stack gap="xs">
                        <strong>Admin Wachtwoord</strong>
                        <c-secret-field value="{{ kc_config.password }}" show-copy="true" />
                    </c-stack>

                    {% if kc_config.has_totp %}
                        <c-stack gap="xs">
                            <strong>Gedeelde OTP</strong>
                            <c-paragraph size="sm">Alle realm-admins delen deze OTP. De sleutel zelf blijft op de server; hier zie je alleen de code van dit moment, die je meteen invult bij het inloggen.</c-paragraph>
                            {% set otp_attrs = {
                                'hx-get': '/projects/' ~ project.name ~ '/keycloak/' ~ kc_config.realm ~ '/otp-code',
                                'hx-target': '#otp-code-' ~ kc_config.realm,
                                'hx-swap': 'innerHTML'
                            } %}
                            <div id="otp-code-{{ kc_config.realm }}">
                                <c-button type="tertiary" size="sm" label="Toon code" show-icon="before" icon="lock-closed"
                                          :attrs="otp_attrs" />
                            </div>
                        </c-stack>
                    {% endif %}
                </c-stack>
            </c-card>
        {% endfor %}
    </c-stack>
</c-card>
