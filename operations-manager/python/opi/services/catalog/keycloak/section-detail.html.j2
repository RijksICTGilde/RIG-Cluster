{# Keycloak detail-page section (WP2).

   Owned by the keycloak service: KeycloakService.realm_block builds the
   ``realms`` context and gates on the viewer's role, so this block no longer lives
   hardcoded in the general project-details template and no longer drifts away from the
   config when it moves (as it did in RC-5). Rendered via a ``section`` loop var, so it
   reads its data from ``section.context``. #}
<c-card outline="true" padding="xl" backgroundColor="wit">
    <c-layout-flow gap="lg">
        <c-heading type="h2" style="margin-bottom: 0;"><c-icon icon="beveiligingsscan" size="xl" color="hemelblauw" />Keycloak</c-heading>
        <p class="rvo-text--subtle">Keycloak realm configuratie en admin toegang</p>

        <div class="config-section">
            {% for kc_config in section.context.realms %}
            {% if not loop.first %}
            <div style="margin-top: var(--rvo-space-lg); padding-top: var(--rvo-space-lg); border-top: 1px solid var(--rvo-color-grijs-200);"></div>
            {% endif %}
            <c-heading type="h3" style="margin-bottom: var(--rvo-space-md);"><c-icon icon="beveiligingsscan" size="md" color="hemelblauw" />Realm: {{ kc_config.realm }}</c-heading>
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="server" size="md" color="hemelblauw" />
                    <strong>Admin Console</strong>
                </div>
                <div class="config-value config-value--inline">
                    <code class="config-code">{{ kc_config.host }}</code>
                    <c-button
                        kind="tertiary"
                        size="sm"
                        label="Kopieer"
                        showIcon="before"
                        icon="document-blanco"
                        class="copy-btn"
                        @click="copyToClipboard('.config-code', event, '.config-item')" />
                </div>
                <c-button
                    label="Open Admin Console"
                    kind="secondary"
                    size="sm"
                    showIcon="after"
                    icon="externe-link"
                    data-url="{{ kc_config.host }}/admin/master/console/#/{{ kc_config.realm }}"
                    @click="window.open(this.dataset.url, '_blank')" />
            </div>
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="applicatie" size="md" color="grijs-600" />
                    <strong>Realm</strong>
                </div>
                <div class="config-value config-value--inline">
                    <code class="config-code">{{ kc_config.realm }}</code>
                    <c-button
                        kind="tertiary"
                        size="sm"
                        label="Kopieer"
                        showIcon="before"
                        icon="document-blanco"
                        class="copy-btn"
                        @click="copyToClipboard('.config-code', event, '.config-item')" />
                </div>
            </div>
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="user" size="md" color="grijs-600" />
                    <strong>Admin Gebruikersnaam</strong>
                </div>
                <div class="config-value config-value--inline">
                    <code class="config-code">{{ kc_config.username }}</code>
                    <c-button
                        kind="tertiary"
                        size="sm"
                        label="Kopieer"
                        showIcon="before"
                        icon="document-blanco"
                        class="copy-btn"
                        @click="copyToClipboard('.config-code', event, '.config-item')" />
                </div>
            </div>
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="sleutel" size="md" color="rood" />
                    <strong>Admin Wachtwoord</strong>
                </div>
                <div class="config-value">
                    <c-secret-field value="{{ kc_config.password }}" />
                </div>
            </div>
            {% if kc_config.has_totp %}
            <div class="config-item">
                <div class="config-label">
                    <c-icon icon="sleutel" size="md" color="rood" />
                    <strong>Gedeelde OTP</strong>
                </div>
                <p class="rvo-text--subtle" style="margin: 0 0 var(--rvo-space-2xs) 0;">
                    Alle realm-admins delen deze OTP. De sleutel zelf blijft op de server; hier zie je
                    alleen de code van dit moment, die je meteen invult bij het inloggen.
                </p>
                {# Keyed on the realm, not loop.index: the swapped-in fragment has to
                   name this same container for its "Nieuwe code" button. #}
                <div id="otp-code-{{ kc_config.realm }}">
                    <c-button
                        kind="tertiary"
                        size="sm"
                        label="Toon code"
                        showIcon="before"
                        icon="sleutel"
                        hx-get="/projects/{{ project.name }}/keycloak/{{ kc_config.realm }}/otp-code"
                        hx-target="#otp-code-{{ kc_config.realm }}"
                        hx-swap="innerHTML" />
                </div>
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </c-layout-flow>
</c-card>
