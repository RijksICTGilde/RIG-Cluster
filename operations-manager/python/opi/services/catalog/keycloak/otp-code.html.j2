{# De LOTC-tegenhanger van otp-code.html.j2 (RC-64).

   Dit fragment komt binnen op de PROJECTDETAILPAGINA: de knop "Toon code" in het
   Keycloak-blok vervangt er de inhoud van #otp-code-<realm> mee. Die pagina staat in de
   nieuwe vormgeving, dus het fragment moet dat ook - anders staat er na een klik
   roos-HTML met rvo-klassen in een LOTC-pagina, en daar is geen stijlblad voor
   (lotc_rvo staat niet in DESIGN_SYSTEMS).

   Draagt net als het buurbestand de CODE en niet de sleutel: de sleutel zou wie de pagina
   ziet voor altijd codes laten maken, deze vergaat met zijn periode.

   De id in hx-target is dezelfde als die van de container in het Keycloak-blok, want dit
   fragment vervangt die inhoud opnieuw met zijn eigen "Nieuwe code"-knop. #}
{% set kopieer = "copyToClipboard('.config-code', event, '.config-item')" %}
<div class="config-item">
    <c-cluster gap="sm" align="center">
        <c-code class="config-code">{{ code }}</c-code>
        <c-button type="tertiary" size="sm" label="Kopieer" show-icon="before" icon="file-text"
                  class="copy-btn" :attrs="{'onclick': kopieer}" />
        {% set nieuwe_code_attrs = {
            'hx-get': '/projects/' ~ project_name ~ '/keycloak/' ~ realm ~ '/otp-code',
            'hx-target': '#otp-code-' ~ realm,
            'hx-swap': 'innerHTML'
        } %}
        <c-button type="tertiary" size="sm" label="Nieuwe code" show-icon="before" icon="arrow-2-counter-clockwise"
                  :attrs="nieuwe_code_attrs" />
    </c-cluster>
</div>
