{#
  Database console modal body (HTMX-driven).
  Expects: project_name, deployment_name, session (DbConsoleSession|None),
           state ('none'|'starting'|'running'), error, ttl_seconds, enabled.
  All swaps replace #db-console-modal-body.
#}
{% if state == 'starting' %}
<div id="db-console-modal-body"
     hx-get="/projects/{{ project_name }}/db-console/{{ deployment_name }}/status"
     hx-trigger="load delay:2s"
     hx-swap="outerHTML">
{% else %}
<div id="db-console-modal-body">
{% endif %}

{% if error %}
    <c-alert kind="error" heading="Databaseconsole" content="{{ error }}" closable="true" />
{% endif %}

{% if not enabled %}
    <c-card outline="true" padding="md" backgroundColor="wit">
        <c-p>De databaseconsole is uitgeschakeld op dit cluster.</c-p>
    </c-card>

{% elif state == 'running' and session %}
    <c-card outline="true" padding="lg" background="color" backgroundColor="groen-150">
        <c-layout-flow gap="md">
            <c-heading type="h5" textContent="Console actief" />
            <c-p>Tool: {{ session.tool }} &middot; Gestart door: {{ session.opened_by }}</c-p>
            <c-p>Verloopt om {{ session.expires_at.strftime("%H:%M") }} UTC (max {{ (ttl_seconds // 60) }} min).</c-p>
            <c-layout-row gap="md">
                <c-link href="{{ session.url }}" target="_blank" content="Console openen" />
                <c-button
                    kind="warning"
                    size="sm"
                    label="Nu stoppen"
                    hx-post="/projects/{{ project_name }}/db-console/{{ session.session_id }}/stop"
                    hx-headers="{&quot;X-CSRF-Token&quot;: &quot;{{ request.state.csrf_token }}&quot;}"
                    hx-vals="{&quot;deployment&quot;: &quot;{{ deployment_name }}&quot;}"
                    hx-target="#db-console-modal-body"
                    hx-swap="outerHTML" />
            </c-layout-row>
        </c-layout-flow>
    </c-card>

{% elif state == 'starting' %}
    <c-card outline="true" padding="md" backgroundColor="wit">
        <c-layout-flow gap="sm">
            <c-heading type="h5" textContent="Console wordt opgestart..." />
            <c-p>Even geduld, de databaseconsole start op. Dit kan een halve minuut duren.</c-p>
        </c-layout-flow>
    </c-card>

{% else %}
    <c-card outline="true" padding="lg" backgroundColor="wit">
        <c-layout-flow gap="md">
            <c-heading type="h5" textContent="Nieuwe databaseconsole" />
            <c-p>Start tijdelijk (max {{ (ttl_seconds // 60) }} min) een webconsole voor de database van deze deployment. Alleen projectleden kunnen inloggen.</c-p>
            <div id="db-console-form-{{ deployment_name }}">
                <c-layout-flow gap="md">
                    <c-layout-row gap="md">
                        {# Voorlopig alleen pgweb. dbgate is al ondersteund in de backend,
                           zet 'm later weer in de opties voor de keuze:
                           options='[{"label": "pgweb", "value": "pgweb"}, {"label": "dbgate", "value": "dbgate"}]' #}
                        <c-select-field
                            id="db-console-tool-{{ deployment_name }}"
                            name="tool"
                            label="Tool"
                            options='[{"label": "pgweb", "value": "pgweb"}]' />
                    </c-layout-row>
                    <c-button
                        kind="primary"
                        size="sm"
                        label="Console starten"
                        hx-post="/projects/{{ project_name }}/db-console"
                        hx-headers="{&quot;X-CSRF-Token&quot;: &quot;{{ request.state.csrf_token }}&quot;}"
                        hx-include="#db-console-form-{{ deployment_name }}"
                        hx-vals="{&quot;deployment&quot;: &quot;{{ deployment_name }}&quot;}"
                        hx-target="#db-console-modal-body"
                        hx-swap="outerHTML"
                        hx-disabled-elt="this" />
                </c-layout-flow>
            </div>
        </c-layout-flow>
    </c-card>
{% endif %}
</div>
