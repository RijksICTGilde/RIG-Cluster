{#
  Het backupblok van EEN deployment, in de nieuwe vormgeving.

  Overname van opi/services/catalog/shared/section-backups.html.j2. Dat sjabloon hoort bij
  de diensten die iets kunnen backuppen en wordt door de registry aangeleverd; het is
  geschreven in roos-componenten en kan daardoor niet in deze omgeving renderen (zie de
  kop van bg/_deployment-service-sections.html.j2). Dit is de LOTC-tegenhanger: dezelfde
  gegevens uit dezelfde ``section.context``, dezelfde teksten, dezelfde knoppen met
  dezelfde flow-id's, en hetzelfde htmx-gedrag.

  Wat LETTERLIJK gelijk moet blijven, want er hangt gedrag aan:
    - ``id="backups-snapshots-<naam>"`` en ``id="restore-btn-<naam>"``: die worden buiten
      de band gevuld (hx-swap-oob) door het ene project-brede /backups-verzoek;
    - dat ene verzoek zit op het blok van de EERSTE deployment (ctx.loads_snapshots). Per
      deployment een verzoek betekende achttien parallelle Kopia-verbindingen, en dat
      sloopte de pod;
    - de flow-id ``modal-edit-backup-schedule-<index>`` telt de deployments in het
      projectbestand, niet de gesorteerde lijst.
#}
{% set ctx = section.context %}
{% if not ctx.available %}
<c-card outline padding="lg">
    <c-cluster gap="md" align="center">
        <c-icon icon="info-circle" size="lg" />
        <c-stack gap="xs">
            <strong>Backups niet beschikbaar</strong>
            <c-span>De backup service is niet verbonden. Backup informatie wordt getoond wanneer de service beschikbaar is.</c-span>
        </c-stack>
    </c-cluster>
</c-card>
{% else %}
<c-card outline padding="lg">
    <c-stack gap="md">
        <c-section-head title="Backups" icon="database" />
        <c-paragraph size="sm">Backup beheer voor cluster: {{ ctx.current_cluster }}</c-paragraph>

        {% if ctx.loads_snapshots %}
        {# EEN lui verzoek voor het hele project. Het loopt elke namespace een keer langs
           en vult elk deploymentblok via hx-swap-oob. #}
        <div hx-get="/projects/details/{{ ctx.project_name }}/backups"
             hx-trigger="intersect once" hx-swap="none"></div>
        {% endif %}

        {% set schema_instellen = "openEditModal('modal-edit-backup-schedule-" ~ ctx.deployment_index ~ "', 'Backup schema instellen')" %}
        {% set backup_aanmaken = "openEditModal('modal-backup', 'Backup aanmaken', {deployment: '" ~ ctx.deployment_name ~ "'})" %}
        <c-cluster gap="sm" align="center" justify="between">
            <c-cluster gap="sm" align="center">
                {% if ctx.schedule %}
                <c-icon icon="check-mark-circle" size="md" />
                <c-span>Backups ingeschakeld: {{ ctx.schedule | rrule_schedule }}</c-span>
                <c-button type="secondary" size="sm" show-icon="before" icon="gear"
                          label="Schema wijzigen" :attrs="{'onclick': schema_instellen}" />
                {% else %}
                <c-icon icon="info-circle" size="md" />
                <c-span>Geen backup schema ingesteld</c-span>
                <c-button type="secondary" size="sm" show-icon="before" icon="gear"
                          label="Schema instellen" :attrs="{'onclick': schema_instellen}" />
                {% endif %}
            </c-cluster>
            <c-cluster gap="sm" align="center">
                <c-button type="secondary" size="sm" show-icon="before" icon="plus"
                          label="Backup aanmaken" :attrs="{'onclick': backup_aanmaken}" />
                {# Wordt door het snapshot-fragment gevuld (hx-swap-oob) zodra bekend is of
                   er iets te herstellen valt. Hier al renderen zou gokken zijn. #}
                <span id="restore-btn-{{ ctx.deployment_name }}"></span>
            </c-cluster>
        </c-cluster>

        <c-card outline padding="md">
            <c-stack gap="md">
                <c-cluster gap="sm" align="center">
                    <c-icon icon="rectangle-stack" size="md" />
                    <c-heading type="h4" size="5" label="{{ ctx.deployment_name }}" />
                    <c-tag type="default" label="{{ ctx.namespace }}" />
                </c-cluster>

                {# Buiten de band gevuld door het ene /backups-verzoek hierboven. #}
                <div id="backups-snapshots-{{ ctx.deployment_name }}">
                    <div role="status" aria-label="Backups worden geladen">
                        <c-cluster gap="sm" align="center">
                            <c-activity-indicator size="24" />
                            <c-paragraph>Backups worden opgehaald...</c-paragraph>
                        </c-cluster>
                    </div>
                </div>
            </c-stack>
        </c-card>
    </c-stack>
</c-card>
{% endif %}
