{# De toestand van de proxy-organisaties, met htmx opgehaald: dit leest het CLUSTER, en
   een blok dat rendert mag geen connector aanroepen. Wachten is hier normaal, de pod
   herstelt vanzelf zodra de proxy werkt. #}
{% if not applicable %}
    <c-paragraph size="sm">Op dit cluster halen de nodes je images rechtstreeks op; er is geen proxy die klaar moet staan.</c-paragraph>
{% elif not statuses %}
    <c-paragraph size="sm">Nog geen registries ingevuld.</c-paragraph>
{% else %}
    <c-stack gap="sm">
        {% for status in statuses %}
            <c-stack gap="xs">
                <c-cluster gap="sm" align="center">
                    <c-icon :icon="('check-mark-circle' if status.state == 'ready' else 'timer') | nldd_icon" size="md" />
                    <c-span><strong>{{ status.registry }}</strong> - {{ status.message }}</c-span>
                </c-cluster>
                {# De datum als variabele en niet in het attribuut afgesneden: de
                   LOTC-voorbewerker struikelt over de plak in een :attribuut. #}
                {% set verloopdag = status.expires_at[:10] if status.expires_at else "" %}
                {% if status.expires_soon %}
                    {% set waarschuwing = "Het token van deze proxy verloopt op " ~ verloopdag ~ ". Vul hier een nieuw token in voordat het zover is, anders kan het platform je images niet meer ophalen." %}
                    <c-alert type="warning" :heading="waarschuwing" />
                {% elif verloopdag %}
                    <c-paragraph size="sm">Het token van deze proxy verloopt op {{ verloopdag }}. Daarna moet je hier een nieuw token invullen.</c-paragraph>
                {% endif %}
            </c-stack>
        {% endfor %}
    </c-stack>
{% endif %}
