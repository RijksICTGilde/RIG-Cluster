{
  "$defs": {
    "DatabasePrivilege": {
      "description": "PostgreSQL role privileges accepted for the dedicated database user.\n\nMatches the allow-list previously enforced inline in DatabaseManager.",
      "enum": [
        "SUPERUSER",
        "NOSUPERUSER",
        "CREATEDB",
        "NOCREATEDB",
        "CREATEROLE",
        "NOCREATEROLE",
        "LOGIN",
        "NOLOGIN",
        "REPLICATION",
        "NOREPLICATION",
        "BYPASSRLS",
        "NOBYPASSRLS"
      ],
      "title": "DatabasePrivilege",
      "type": "string"
    },
    "DatabaseResources": {
      "additionalProperties": false,
      "description": "requests/limits pair, mirroring DEFAULT_CONFIG['resources'].",
      "properties": {
        "limits": {
          "$ref": "#/$defs/LimitsQuantities",
          "default": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "requests": {
          "$ref": "#/$defs/RequestsQuantities",
          "default": {
            "cpu": "100m",
            "memory": "256Mi"
          }
        }
      },
      "title": "DatabaseResources",
      "type": "object"
    },
    "LimitsQuantities": {
      "additionalProperties": false,
      "description": "CPU/memory *limits* (defaults differ from requests, as in DEFAULT_CONFIG).",
      "properties": {
        "cpu": {
          "default": "500m",
          "title": "Cpu",
          "type": "string"
        },
        "memory": {
          "default": "512Mi",
          "title": "Memory",
          "type": "string"
        }
      },
      "title": "LimitsQuantities",
      "type": "object"
    },
    "ProjectScopeConfig": {
      "additionalProperties": false,
      "description": "``scope: project`` -- one dedicated CNPG cluster per project, shared by all its\ndeployments. Carries the same CNPG-cluster fields as\n``namespace-postgresql-database``.",
      "properties": {
        "image": {
          "default": "ghcr.io/cloudnative-pg/postgresql:17",
          "title": "Image",
          "type": "string"
        },
        "instances": {
          "default": 1,
          "minimum": 1,
          "title": "Instances",
          "type": "integer"
        },
        "postInitSQL": {
          "items": {
            "type": "string"
          },
          "title": "Postinitsql",
          "type": "array"
        },
        "privileges": {
          "items": {
            "$ref": "#/$defs/DatabasePrivilege"
          },
          "title": "Privileges",
          "type": "array"
        },
        "registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry"
        },
        "resources": {
          "$ref": "#/$defs/DatabaseResources",
          "default": {
            "limits": {
              "cpu": "500m",
              "memory": "512Mi"
            },
            "requests": {
              "cpu": "100m",
              "memory": "256Mi"
            }
          }
        },
        "scope": {
          "const": "project",
          "title": "Scope",
          "type": "string"
        },
        "storage": {
          "default": "10Gi",
          "title": "Storage",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "ProjectScopeConfig",
      "type": "object"
    },
    "RequestsQuantities": {
      "additionalProperties": false,
      "description": "CPU/memory *requests*. Per-field defaults preserve the old deep-merge: a\nconfig overriding only ``requests.memory`` keeps the default ``cpu``.",
      "properties": {
        "cpu": {
          "default": "100m",
          "title": "Cpu",
          "type": "string"
        },
        "memory": {
          "default": "256Mi",
          "title": "Memory",
          "type": "string"
        }
      },
      "title": "RequestsQuantities",
      "type": "object"
    },
    "SharedScopeConfig": {
      "additionalProperties": false,
      "description": "``scope: shared`` -- a database on the shared cluster instance (the default).\n\nCarries no CNPG-cluster fields: ``extra=\"forbid\"`` means putting ``storage`` or\n``instances`` here fails validation with a message that names the offending key.",
      "properties": {
        "scope": {
          "const": "shared",
          "default": "shared",
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "SharedScopeConfig",
      "type": "object"
    }
  },
  "description": "Project-layer config: a ``scope``-discriminated union of the two shapes above.\n\n``scope`` defaults to ``shared`` when absent, so an existing project that sets no\nscope validates as a shared database and its behaviour is unchanged.",
  "discriminator": {
    "mapping": {
      "project": "#/$defs/ProjectScopeConfig",
      "shared": "#/$defs/SharedScopeConfig"
    },
    "propertyName": "scope"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SharedScopeConfig"
    },
    {
      "$ref": "#/$defs/ProjectScopeConfig"
    }
  ],
  "title": "PostgresqlDatabaseProjectConfig"
}
