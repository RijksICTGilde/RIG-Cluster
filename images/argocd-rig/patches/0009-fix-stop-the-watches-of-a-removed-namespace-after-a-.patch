diff --git a/gitops-engine/pkg/cache/cluster.go b/gitops-engine/pkg/cache/cluster.go
index 45855558f..5222e6e14 100644
--- a/gitops-engine/pkg/cache/cluster.go
+++ b/gitops-engine/pkg/cache/cluster.go
@@ -115,11 +115,30 @@ type apiMeta struct {
 	watchCancel context.CancelFunc
 	// watchCtx is the parent context for all watches of this API. Used to derive per-namespace contexts.
 	watchCtx context.Context
-	// namespaceCancels tracks per-namespace watch cancellation for incremental namespace operations.
-	// Only populated when using incremental namespace sync.
+	// namespaceCancels tracks per-namespace watch cancellation, so RemoveNamespace can stop the watches of
+	// one namespace. Populated by every path that starts a namespaced watch, see namespaceWatchContext.
 	namespaceCancels map[string]context.CancelFunc
 }
 
+// namespaceWatchContext derives the context for listing and watching one namespace of this API and registers
+// its cancel in namespaceCancels. Every path that starts a namespaced watch (full sync, startMissingWatches and
+// the incremental add) must go through here: RemoveNamespace can only stop watches it finds in namespaceCancels,
+// and upstream PR 25229 only registered the incremental add, so watches started by a full sync kept running
+// after their namespace was removed. A cluster-wide watch (ns == "") uses the API context directly. An earlier
+// watch for the same namespace is cancelled, so a re-added namespace does not leak its old watch.
+// The caller must hold the lock that guards namespaceCancels.
+func (m *apiMeta) namespaceWatchContext(ns string) context.Context {
+	if ns == "" {
+		return m.watchCtx
+	}
+	if cancel, ok := m.namespaceCancels[ns]; ok {
+		cancel()
+	}
+	ctx, cancel := context.WithCancel(m.watchCtx)
+	m.namespaceCancels[ns] = cancel
+	return ctx
+}
+
 type eventMeta struct {
 	event watch.EventType
 	un    *unstructured.Unstructured
@@ -707,15 +726,19 @@ func (c *clusterCache) RemoveNamespace(namespace string) error {
 	}
 
 	// Cancel watches for the removed namespace
+	stopped := 0
 	for _, meta := range c.apisMeta {
 		if cancel, exists := meta.namespaceCancels[namespace]; exists {
 			cancel()
 			delete(meta.namespaceCancels, namespace)
+			stopped++
 		}
 	}
 
 	c.lock.Unlock()
 
+	c.log.Info("Stop syncing namespace", "namespace", namespace, "stoppedWatches", stopped)
+
 	return nil
 }
 
@@ -762,11 +785,9 @@ func (c *clusterCache) syncNamespaceResources(namespace string, apisToSync map[s
 			continue
 		}
 
-		// Create per-namespace context derived from the API's parent context
-		nsCtx, nsCancel := context.WithCancel(meta.watchCtx)
 		// namespaceCancels is shared across goroutines, lock the write
 		c.lock.Lock()
-		meta.namespaceCancels[namespace] = nsCancel
+		nsCtx := meta.namespaceWatchContext(namespace)
 		c.lock.Unlock()
 
 		if err := c.loadNamespaceResources(nsCtx, client, clientset, api, namespace); err != nil {
@@ -878,9 +899,12 @@ func (c *clusterCache) startMissingWatches() error {
 			// into namespaceCancels, so an apiMeta created here (an API that appeared after
 			// the full sync, e.g. a new CRD) would otherwise panic on the first incremental
 			// namespace add. Upstream PR 25229 only initializes them in sync().
-			c.apisMeta[api.GroupKind] = &apiMeta{namespaced: api.Meta.Namespaced, watchCancel: cancel, watchCtx: ctx, namespaceCancels: make(map[string]context.CancelFunc)}
+			meta := &apiMeta{namespaced: api.Meta.Namespaced, watchCancel: cancel, watchCtx: ctx, namespaceCancels: make(map[string]context.CancelFunc)}
+			c.apisMeta[api.GroupKind] = meta
 
 			err := c.processApi(client, api, func(resClient dynamic.ResourceInterface, ns string) error {
+				// c.lock is held by our caller, which guards meta.namespaceCancels
+				ctx := meta.namespaceWatchContext(ns)
 				resourceVersion, err := c.loadInitialState(ctx, api, resClient, ns, false) // don't lock here, we are already in a lock before startMissingWatches is called inside watchEvents
 				if err != nil {
 					if ns != "" {
@@ -1013,6 +1037,15 @@ func (c *clusterCache) watchEvents(ctx context.Context, api kube.APIResourceInfo
 			}
 		}()
 
+		// Safety net for a namespace that was removed while its watch kept running. Once the namespace
+		// is gone, list and watch fail with 403 (its RoleBinding went with it), which stopWatching does
+		// not catch, so without this check the watch retries every watchResourcesRetryTimeout until the
+		// next full resync and saturates the client-side rate limiter.
+		if !c.watchesNamespace(ns) {
+			c.log.Info("Stop watching: namespace is no longer managed", "groupKind", api.GroupKind.String(), "namespace", ns)
+			return nil
+		}
+
 		// load API initial state if no resource version provided
 		if resourceVersion == "" {
 			resourceVersion, err = c.loadInitialState(ctx, api, resClient, ns, true)
@@ -1024,7 +1057,9 @@ func (c *clusterCache) watchEvents(ctx context.Context, api kube.APIResourceInfo
 		w, err := watchutil.NewRetryWatcherWithContext(ctx, resourceVersion, &cache.ListWatch{
 			WatchFuncWithContext: func(ctx context.Context, options metav1.ListOptions) (watch.Interface, error) {
 				res, err := resClient.Watch(ctx, options)
-				if apierrors.IsNotFound(err) {
+				// A 404 for a namespace we no longer manage says nothing about the API itself;
+				// stopWatching would drop the whole GVK for every namespace.
+				if apierrors.IsNotFound(err) && c.watchesNamespace(ns) {
 					c.stopWatching(api.GroupKind, ns)
 				}
 				//nolint:wrapcheck // wrap outside the retry
@@ -1460,6 +1495,9 @@ func (c *clusterCache) sync() error {
 		lock.Unlock()
 
 		return c.processApi(client, api, func(resClient dynamic.ResourceInterface, ns string) error {
+			// The namespaces of one API are processed sequentially by this goroutine, and c.lock is
+			// held for the whole sync, so nothing else touches info.namespaceCancels meanwhile.
+			ctx := info.namespaceWatchContext(ns)
 			resourceVersion, err := c.listResources(ctx, resClient, func(listPager *pager.ListPager) error {
 				return listPager.EachListItem(context.Background(), metav1.ListOptions{}, func(obj runtime.Object) error {
 					if un, ok := obj.(*unstructured.Unstructured); !ok {
@@ -1830,6 +1868,18 @@ func (c *clusterCache) managesNamespace(namespace string) bool {
 	return slices.Contains(c.namespaces, namespace)
 }
 
+// watchesNamespace reports whether a watch on ns should keep running: always for a cluster-wide watch
+// (ns == ""), and for a namespaced watch only while ns is still one of the managed namespaces.
+// It takes c.lock for reading, so the caller must not hold it.
+func (c *clusterCache) watchesNamespace(ns string) bool {
+	if ns == "" {
+		return true
+	}
+	c.lock.RLock()
+	defer c.lock.RUnlock()
+	return c.managesNamespace(ns)
+}
+
 // GetManagedLiveObjs helps finding matching live K8S resources for a given resources list.
 // The function returns all resources from cache for those `isManaged` function returns true and resources
 // specified in targetObjs list.
