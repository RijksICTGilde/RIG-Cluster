diff --git a/gitops-engine/pkg/cache/rig_namespace_watch_test.go b/gitops-engine/pkg/cache/rig_namespace_watch_test.go
new file mode 100644
index 000000000..2de5bad06
--- /dev/null
+++ b/gitops-engine/pkg/cache/rig_namespace_watch_test.go
@@ -0,0 +1,165 @@
+package cache
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/client-go/dynamic/fake"
+	"k8s.io/client-go/rest"
+	testcore "k8s.io/client-go/testing"
+)
+
+var rigPodGK = schema.GroupKind{Group: "", Kind: "Pod"}
+
+// rigNamespaceWatchCluster returns an incrementally syncing cache over ns-a and ns-b whose watches restart every
+// 100ms, so a watch that is still running keeps re-listing and re-watching its namespace.
+func rigNamespaceWatchCluster(t *testing.T, namespaces ...string) (*clusterCache, *fake.FakeDynamicClient) {
+	t.Helper()
+	client, mockKubectl := setupFakeCluster(createPod("pod-a", "ns-a"), createPod("pod-b", "ns-b"))
+	cache := NewClusterCache(
+		&rest.Config{Host: "https://test"},
+		SetKubectl(mockKubectl),
+		SetNamespaces(namespaces),
+		WithIncrementalNamespaceSync(true),
+		SetWatchResyncTimeout(100*time.Millisecond),
+		SetClientset(rigSSAR(false)),
+	)
+	t.Cleanup(func() { cache.Invalidate() })
+	return cache, client
+}
+
+// rigForbidNamespace makes every list and watch in ns answer 403, like the API server does once a namespace and
+// the controller's RoleBinding in it are gone, and counts those requests.
+func rigForbidNamespace(client *fake.FakeDynamicClient, ns string) *atomic.Int64 {
+	var calls atomic.Int64
+	forbid := func(a testcore.Action) (bool, runtime.Object, error) {
+		if a.GetNamespace() != ns {
+			return false, nil, nil
+		}
+		calls.Add(1)
+		return true, nil, apierrors.NewForbidden(schema.GroupResource{Resource: a.GetResource().Resource}, "", fmt.Errorf("namespace %q is gone", ns))
+	}
+	client.PrependReactor("list", "*", forbid)
+	client.PrependWatchReactor("*", func(a testcore.Action) (bool, watch.Interface, error) {
+		_, _, err := forbid(a)
+		if err != nil {
+			return true, nil, err
+		}
+		return false, nil, nil
+	})
+	return &calls
+}
+
+// assertNamespaceGoesQuiet fails if anything still lists or watches the namespace once in-flight requests had time
+// to finish. watchResourcesRetryTimeout is 1s, so a retry loop shows up well within the window.
+func assertNamespaceGoesQuiet(t *testing.T, calls *atomic.Int64, ns string) {
+	t.Helper()
+	time.Sleep(500 * time.Millisecond)
+	calls.Store(0)
+	time.Sleep(2500 * time.Millisecond)
+	assert.Zero(t, calls.Load(), "nothing may list or watch %s after it stopped being managed", ns)
+}
+
+func rigNamespaceCancels(c *clusterCache, ns string) int {
+	c.lock.RLock()
+	defer c.lock.RUnlock()
+	n := 0
+	for _, meta := range c.apisMeta {
+		if _, ok := meta.namespaceCancels[ns]; ok {
+			n++
+		}
+	}
+	return n
+}
+
+// A namespace picked up by a full sync must be stoppable by RemoveNamespace. Upstream PR 25229 only registered
+// per-namespace cancels for the incremental add, so after a full sync RemoveNamespace found nothing to cancel and
+// the watches of the removed namespace kept running (and, once it was deleted, retried on 403 every second).
+func TestRIG_RemoveNamespaceStopsWatchesFromFullSync(t *testing.T) {
+	cache, client := rigNamespaceWatchCluster(t, "ns-a", "ns-b")
+	require.NoError(t, cache.EnsureSynced())
+	require.Equal(t, 1, rigNamespaceCancels(cache, "ns-b"), "the full sync must register a cancel for ns-b")
+
+	require.NoError(t, cache.RemoveNamespace("ns-b"))
+	calls := rigForbidNamespace(client, "ns-b")
+
+	assert.Zero(t, rigNamespaceCancels(cache, "ns-b"))
+	assert.Equal(t, 1, rigNamespaceCancels(cache, "ns-a"), "ns-a keeps its watch")
+	assertNamespaceGoesQuiet(t, calls, "ns-b")
+	assertPodInCache(t, cache, "ns-a", "pod-a", "ns-a is still cached")
+}
+
+func TestRIG_RemoveNamespaceStopsWatchesFromIncrementalAdd(t *testing.T) {
+	cache, client := rigNamespaceWatchCluster(t, "ns-a")
+	require.NoError(t, cache.EnsureSynced())
+	require.NoError(t, cache.AddNamespace("ns-b"))
+	assertPodInCache(t, cache, "ns-b", "pod-b", "ns-b was added")
+
+	require.NoError(t, cache.RemoveNamespace("ns-b"))
+	calls := rigForbidNamespace(client, "ns-b")
+
+	assert.Zero(t, rigNamespaceCancels(cache, "ns-b"))
+	assertNamespaceGoesQuiet(t, calls, "ns-b")
+}
+
+// Safety net: a watch whose namespace is no longer managed stops by itself on the next retry, even when nothing
+// cancelled it, instead of retrying the 403 forever. A 404 for such a namespace must not drop the whole GVK.
+func TestRIG_WatchOnUnmanagedNamespaceStopsOnForbidden(t *testing.T) {
+	cache, client := rigNamespaceWatchCluster(t, "ns-a", "ns-b")
+	require.NoError(t, cache.EnsureSynced())
+
+	// Drop ns-b behind RemoveNamespace's back, so its watch is not cancelled.
+	cache.lock.Lock()
+	cache.namespaces = []string{"ns-a"}
+	cache.lock.Unlock()
+	calls := rigForbidNamespace(client, "ns-b")
+
+	assertNamespaceGoesQuiet(t, calls, "ns-b")
+	cache.lock.RLock()
+	assert.Contains(t, cache.apisMeta, rigPodGK, "the Pod watch of the managed namespaces must survive")
+	cache.lock.RUnlock()
+}
+
+func TestRIG_WatchOnUnmanagedNamespaceKeepsGVKOnNotFound(t *testing.T) {
+	cache, client := rigNamespaceWatchCluster(t, "ns-a", "ns-b")
+	require.NoError(t, cache.EnsureSynced())
+
+	cache.lock.Lock()
+	cache.namespaces = []string{"ns-a"}
+	cache.lock.Unlock()
+	client.PrependWatchReactor("*", func(a testcore.Action) (bool, watch.Interface, error) {
+		if a.GetNamespace() == "ns-b" {
+			return true, nil, apierrors.NewNotFound(schema.GroupResource{Resource: a.GetResource().Resource}, "")
+		}
+		return false, nil, nil
+	})
+
+	time.Sleep(1500 * time.Millisecond)
+	cache.lock.RLock()
+	defer cache.lock.RUnlock()
+	assert.Contains(t, cache.apisMeta, rigPodGK, "a 404 for an unmanaged namespace must not stop the Pod watch of ns-a")
+}
+
+// Re-registering a namespace cancels the watch context it replaces, so a re-added namespace does not leak its
+// previous watch.
+func TestRIG_NamespaceWatchContextCancelsPrevious(t *testing.T) {
+	parent := t.Context()
+	meta := &apiMeta{watchCtx: parent, namespaceCancels: map[string]context.CancelFunc{}}
+
+	first := meta.namespaceWatchContext("ns-b")
+	second := meta.namespaceWatchContext("ns-b")
+
+	require.ErrorIs(t, first.Err(), context.Canceled, "the replaced context must be cancelled")
+	require.NoError(t, second.Err())
+	assert.Same(t, parent, meta.namespaceWatchContext(""), "a cluster-wide watch uses the API context")
+	assert.Len(t, meta.namespaceCancels, 1)
+}
