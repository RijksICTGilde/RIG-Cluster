@@ -1,8 +1,11 @@
 package controller
 
 import (
+	"encoding/json"
 	"fmt"
 
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+
 	"github.com/argoproj/argo-cd/gitops-engine/pkg/health"
 	hookutil "github.com/argoproj/argo-cd/gitops-engine/pkg/sync/hook"
 	"github.com/argoproj/argo-cd/gitops-engine/pkg/sync/ignore"
@@ -102,3 +105,62 @@ func setApplicationHealth(resources []managedResource, statuses []appv1.Resource
 	}
 	return appHealthStatus, savedErr
 }
+
+// setAppHealthFromClusterCache recomputes the application's aggregated health against the
+// current cluster cache, reusing the target manifests persisted by the last full comparison.
+// The tree-only (ComparisonWithNothing) refresh path rebuilds the resource tree on every
+// cluster event, but left status.health untouched until the next full comparison, so the
+// persisted health could trail the (UI-visible) tree by however long that comparison took to
+// be scheduled and run. Aggregation goes through the same setApplicationHealth as the full
+// comparison so the two paths cannot disagree on semantics (hooks, ignore annotations, Lua
+// overrides, self-referencing apps).
+func (ctrl *ApplicationController) setAppHealthFromClusterCache(app *appv1.Application, destCluster *appv1.Cluster, cachedDiffs []*appv1.ResourceDiff) error {
+	resourceOverrides, err := ctrl.settingsMgr.GetResourceOverrides()
+	if err != nil {
+		return fmt.Errorf("error getting resource overrides: %w", err)
+	}
+
+	targetByKey := make(map[kubeutil.ResourceKey]*unstructured.Unstructured, len(cachedDiffs))
+	targets := make([]*unstructured.Unstructured, 0, len(cachedDiffs))
+	for _, cachedDiff := range cachedDiffs {
+		if cachedDiff.TargetState == "" || cachedDiff.TargetState == "null" {
+			continue
+		}
+		target := &unstructured.Unstructured{}
+		if err := json.Unmarshal([]byte(cachedDiff.TargetState), target); err != nil {
+			return fmt.Errorf("error unmarshaling cached target state of %s/%s %s/%s: %w", cachedDiff.Group, cachedDiff.Kind, cachedDiff.Namespace, cachedDiff.Name, err)
+		}
+		targetByKey[kubeutil.NewResourceKey(cachedDiff.Group, cachedDiff.Kind, cachedDiff.Namespace, cachedDiff.Name)] = target
+		targets = append(targets, target)
+	}
+
+	liveObjByKey, err := ctrl.stateCache.GetManagedLiveObjs(destCluster, app, targets)
+	if err != nil {
+		return fmt.Errorf("error getting managed live objects: %w", err)
+	}
+
+	resources := make([]managedResource, len(app.Status.Resources))
+	for i, res := range app.Status.Resources {
+		key := kubeutil.NewResourceKey(res.Group, res.Kind, res.Namespace, res.Name)
+		live := liveObjByKey[key]
+		if live == nil && res.Namespace == "" && app.Spec.Destination.Namespace != "" {
+			// Namespaced resources without an explicit namespace in the manifest live in the
+			// application's destination namespace.
+			live = liveObjByKey[kubeutil.NewResourceKey(res.Group, res.Kind, app.Spec.Destination.Namespace, res.Name)]
+		}
+		resources[i] = managedResource{
+			Group:     res.Group,
+			Version:   res.Version,
+			Kind:      res.Kind,
+			Namespace: res.Namespace,
+			Name:      res.Name,
+			Hook:      res.Hook,
+			Target:    targetByKey[key],
+			Live:      live,
+		}
+	}
+
+	healthStatus, err := setApplicationHealth(resources, app.Status.Resources, resourceOverrides, app, ctrl.persistResourceHealth)
+	app.Status.Health.Status = healthStatus
+	return err
+}
