From 4cdfa28ed7ed9e28c8bfb32327545a5c54b07fe8 Mon Sep 17 00:00:00 2001
From: robbertuittenbroek <robbert.uittenbroek@rijksoverheid.nl>
Date: Thu, 13 Aug 2026 23:27:10 +0200
Subject: [PATCH 3/7] fix: refresh app health from cluster cache on tree-only
 refresh

The ComparisonWithNothing refresh path, taken for cluster events on child
resources, rebuilds the resource tree (which the UI renders) but left
status.health untouched until the next full comparison. The persisted
health could therefore trail the tree by however long that comparison
took to be scheduled and run, making API consumers see a stale health
status while the UI already showed everything healthy.

Recompute the aggregated health in that path from the same live state:
fresh live objects from the cluster cache paired with the target
manifests persisted by the last comparison, run through the existing
setApplicationHealth so both paths share one set of semantics (hooks,
ignore annotations, Lua overrides, self-referencing apps).
---
 controller/appcontroller.go      |  8 +++
 controller/appcontroller_test.go | 84 ++++++++++++++++++++++++++++++++
 controller/health.go             | 62 +++++++++++++++++++++++
 3 files changed, 154 insertions(+)

diff --git a/controller/appcontroller.go b/controller/appcontroller.go
index ed0348ccd..41641a4f5 100644
--- a/controller/appcontroller.go
+++ b/controller/appcontroller.go
@@ -144,6 +144,7 @@ type ApplicationController struct {
 	projByNameCache               sync.Map
 	applicationNamespaces         []string
 	ignoreNormalizerOpts          normalizers.IgnoreNormalizerOpts
+	persistResourceHealth         bool
 
 	// dynamicClusterDistributionEnabled if disabled deploymentInformer is never initialized
 	dynamicClusterDistributionEnabled bool
@@ -219,6 +220,7 @@ func NewApplicationController(
 		applicationNamespaces:             applicationNamespaces,
 		dynamicClusterDistributionEnabled: dynamicClusterDistributionEnabled,
 		ignoreNormalizerOpts:              ignoreNormalizerOpts,
+		persistResourceHealth:             persistResourceHealth,
 		metricsClusterLabels:              metricsClusterLabels,
 	}
 	if hydratorEnabled {
@@ -1853,6 +1855,12 @@ func (ctrl *ApplicationController) processAppRefreshQueueItem() (processNext boo
 						logCtx.WithError(err).Error("Failed to cache resources tree")
 						return processNext
 					}
+					// The tree just rebuilt reflects the cluster event that triggered this
+					// refresh; recompute status.health from the same live state so the
+					// persisted health does not trail the tree until the next full comparison.
+					if err := ctrl.setAppHealthFromClusterCache(app, destCluster, managedResources); err != nil {
+						logCtx.WithError(err).Warn("Failed to refresh app health from cluster cache; keeping last health status")
+					}
 				}
 
 				patchDuration = ctrl.persistReconciliationStatus(origApp, &app.Status)
