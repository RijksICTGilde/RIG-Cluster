+// TestTreeOnlyRefreshUpdatesHealth verifies that the tree-only (ComparisonWithNothing)
+// refresh path recomputes status.health from the current cluster cache instead of leaving
+// the persisted health to trail the resource tree until the next full comparison.
+func TestTreeOnlyRefreshUpdatesHealth(t *testing.T) {
+	app := newFakeApp()
+	now := metav1.Now()
+	app.Status.ReconciledAt = &now
+	app.Status.Health = v1alpha1.AppHealthStatus{Status: health.HealthStatusProgressing}
+	app.Status.Sync = v1alpha1.SyncStatus{
+		Status:     v1alpha1.SyncStatusCodeSynced,
+		ComparedTo: v1alpha1.ComparedTo{Source: app.Spec.GetSource(), Destination: app.Spec.Destination},
+	}
+	app.Status.Resources = []v1alpha1.ResourceStatus{{
+		Group:     "apps",
+		Version:   "v1",
+		Kind:      "Deployment",
+		Namespace: test.FakeDestNamespace,
+		Name:      "my-deploy",
+		Status:    v1alpha1.SyncStatusCodeSynced,
+	}}
+
+	// A deployment that is fully rolled out, as the cluster cache now sees it.
+	liveDeploy := &unstructured.Unstructured{Object: map[string]any{
+		"apiVersion": "apps/v1",
+		"kind":       "Deployment",
+		"metadata": map[string]any{
+			"name":       "my-deploy",
+			"namespace":  test.FakeDestNamespace,
+			"generation": int64(1),
+		},
+		"spec": map[string]any{"replicas": int64(1)},
+		"status": map[string]any{
+			"observedGeneration": int64(1),
+			"replicas":           int64(1),
+			"updatedReplicas":    int64(1),
+			"readyReplicas":      int64(1),
+			"availableReplicas":  int64(1),
+		},
+	}}
+
+	ctrl := newFakeController(t.Context(), &fakeData{
+		apps: []runtime.Object{app, defaultProj.DeepCopy()},
+		managedLiveObjs: map[kube.ResourceKey]*unstructured.Unstructured{
+			kube.NewResourceKey("apps", "Deployment", test.FakeDestNamespace, "my-deploy"): liveDeploy,
+		},
+	}, nil)
+
+	// The cached comparison still holds the pre-rollout live state; only the cluster
+	// cache (mocked managedLiveObjs above) knows the deployment is ready.
+	staleDeploy := liveDeploy.DeepCopy()
+	require.NoError(t, unstructured.SetNestedField(staleDeploy.Object, int64(0), "status", "readyReplicas"))
+	staleJSON, err := json.Marshal(staleDeploy.Object)
+	require.NoError(t, err)
+	require.NoError(t, ctrl.cache.SetAppManagedResources(app.InstanceName(ctrl.namespace), []*v1alpha1.ResourceDiff{{
+		Group:       "apps",
+		Kind:        "Deployment",
+		Namespace:   test.FakeDestNamespace,
+		Name:        "my-deploy",
+		TargetState: string(staleJSON),
+		LiveState:   string(staleJSON),
+	}}))
+
+	ctrl.requestAppRefresh(app.QualifiedName(), ComparisonWithNothing.Pointer(), nil)
+
+	var patched map[string]any
+	fakeAppCs := ctrl.applicationClientset.(*appclientset.Clientset)
+	fakeAppCs.ReactionChain = nil
+	fakeAppCs.AddReactor("patch", "*", func(action kubetesting.Action) (bool, runtime.Object, error) {
+		if patchAction, ok := action.(kubetesting.PatchAction); ok {
+			require.NoError(t, json.Unmarshal(patchAction.GetPatch(), &patched))
+		}
+		return true, &v1alpha1.Application{}, nil
+	})
+
+	ctrl.processAppRefreshQueueItem()
+
+	require.NotNil(t, patched, "expected the tree-only refresh to persist a status patch")
+	statusPatch, ok := patched["status"].(map[string]any)
+	require.True(t, ok, "expected patch to contain a status section, got: %v", patched)
+	healthPatch, ok := statusPatch["health"].(map[string]any)
+	require.True(t, ok, "expected patch to contain status.health, got: %v", statusPatch)
+	assert.Equal(t, string(health.HealthStatusHealthy), healthPatch["status"])
+}
