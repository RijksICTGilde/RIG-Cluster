# Taskfile environment variables for SANDBOXED-LOCAL cluster
# This file contains cluster-specific configuration for the self-contained sandbox environment
# Uses in-cluster Forgejo as the git source for the entire GitOps loop

CLUSTER_TYPE=sandboxed-local
KIND_CLUSTER_NAME=rig-sandbox
RIG_NAMESPACE=rig-system
INFRASTRUCTURE_CLUSTER_FOLDER=sandboxed-local
BOOTSTRAP_CLUSTER_FOLDER=sandboxed-local

# AGE-sleutel voor SOPS. Expliciet per cluster: een ontbrekende waarde moet stoppen,
# niet stilzwijgend terugvallen op de productiesleutel van een ander cluster.
AGE_KEY_FILE=security/sandbox-key.txt
